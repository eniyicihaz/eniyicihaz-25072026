---
import "./ColorPicker.css";
import type { ColorPickerProps } from "./ColorPicker.types";

const {
  value = "#2563eb",
  name,
  id,
  disabled = false,
  class: className = "",
} = Astro.props as ColorPickerProps;
---

<label class={`ds-color-picker ${className}`}>
  <input
    class="ds-color-picker__input"
    type="color"
    value={value}
    name={name}
    id={id}
    disabled={disabled}
  />
</label>
---
import "./Stat.css";
import type { StatProps } from "./Stat.types";

const {
  label,
  value,
  description,
  icon,
  trend = "neutral",
  class: className = "",
} = Astro.props as StatProps;

const classes = [
  "ds-stat",
  className,
]
  .filter(Boolean)
  .join(" ");

const trendLabel =
  trend === "up"
    ? "▲"
    : trend === "down"
      ? "▼"
      : "•";
---

<div class={classes}>
  <div class="ds-stat__header">
    <span class="ds-stat__label">{label}</span>

    {
      icon && (
        <span class="ds-stat__icon" aria-hidden="true">
          {icon}
        </span>
      )
    }
  </div>

  <div class="ds-stat__value">
    {value}
  </div>

  {
    description && (
      <div class={`ds-stat__trend ds-stat__trend--${trend}`}>
        {trendLabel} {description}
      </div>
    )
  }

  <slot />
</div>
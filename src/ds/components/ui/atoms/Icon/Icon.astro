---
import "./Icon.css";
import type { IconProps } from "./Icon.types";

const {
  icon: Icon,
  size = 20,
  strokeWidth = 2,
  color = "currentColor",
  decorative = false,
  title,
  class: className = "",
} = Astro.props as IconProps;
---

<span
  class:list={[
    "ds-icon",
    className,
  ]}
  style={`
    --ds-icon-size:${size}px;
    --ds-icon-color:${color};
  `}
  aria-hidden={decorative}
  role={decorative ? undefined : "img"}
  aria-label={decorative ? undefined : (title ?? "Icon")}
>
  <Icon
    size={size}
    stroke-width={strokeWidth}
    color={color}
  />
</span>
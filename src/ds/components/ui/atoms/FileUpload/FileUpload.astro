---
import "./FileUpload.css";
import type { FileUploadProps } from "./FileUpload.types";

const {
  id = "file-upload",
  name,
  accept,
  multiple = false,
  disabled = false,
  required = false,
  label = "Dosya yüklemek için tıklayın",
  helperText = "veya dosyayı buraya sürükleyip bırakın",
  class: className = "",
} = Astro.props as FileUploadProps;

const classes = [
  "ds-file-upload",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<div class={classes}>
  <label
    for={id}
    class:list={[
      "ds-file-upload__label",
      disabled && "ds-file-upload__label--disabled",
    ]}
  >
    <div
      class="ds-file-upload__icon"
      aria-hidden="true"
    >
      📁
    </div>

    <p class="ds-file-upload__title">
      {label}
    </p>

    <p class="ds-file-upload__helper">
      {helperText}
    </p>

    <input
      id={id}
      class="ds-file-upload__input"
      type="file"
      name={name}
      accept={accept}
      multiple={multiple}
      disabled={disabled}
      required={required}
    />
  </label>

  <div class="ds-file-upload__actions">
    <slot />
  </div>
</div>
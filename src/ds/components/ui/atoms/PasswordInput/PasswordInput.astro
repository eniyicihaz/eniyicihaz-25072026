---
import "./PasswordInput.css";
import type { PasswordInputProps } from "./PasswordInput.types";

const {
  id,
  name,
  value = "",
  placeholder,
  autocomplete = "current-password",
  disabled = false,
  readonly = false,
  required = false,
  invalid = false,
  revealButton = true,
  class: className = "",
} = Astro.props as PasswordInputProps;

const classes = [
  "ds-password-input",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<div class={classes}>
  <input
    class:list={[
      "ds-password-input__field",
      invalid && "ds-password-input__field--invalid",
    ]}
    id={id}
    name={name}
    type="password"
    value={value}
    placeholder={placeholder}
    autocomplete={autocomplete}
    disabled={disabled}
    readonly={readonly}
    required={required}
    aria-invalid={invalid}
  />

  {
    revealButton && (
      <button
        class="ds-password-input__toggle"
        type="button"
        aria-label="Show password"
        disabled={disabled}
      >
        👁
      </button>
    )
  }
</div>
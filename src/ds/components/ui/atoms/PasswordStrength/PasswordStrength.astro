---
import "./PasswordStrength.css";
import type { PasswordStrengthProps } from "./PasswordStrength.types";

const {
  score = 0,
  label,
  class: className = "",
} = Astro.props as PasswordStrengthProps;

const segments = [0, 1, 2, 3];
---

<div class={`ds-password-strength ${className}`}>
  <div class="ds-password-strength__bar">
    {
      segments.map((segment) => (
        <span
          class:list={[
            "ds-password-strength__segment",
            segment < score &&
              "ds-password-strength__segment--active",
          ]}
        />
      ))
    }
  </div>

  {
    label && (
      <div class="ds-password-strength__label">
        {label}
      </div>
    )
  }
</div>
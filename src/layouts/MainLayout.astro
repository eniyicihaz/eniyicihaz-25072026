---
import "../ds/styles/base/variables.css";
import "../ds/styles/base/reset.css";
import "../ds/styles/base/fonts.css";
// Typography baseline: reset.css deliberately sets no font-family, so without
// this the page falls back to the UA serif. Imported instead of global.css to
// avoid its universal `*` transition rule, which would alter every hover.
import "../ds/styles/base/typography.css";
import Header from "../components/header/Header/Header.astro";
import Footer from "../components/footer/Footer/Footer.astro";
import ConsentManager from "../components/consent/ConsentManager/ConsentManager.astro";
import AnnouncementBar from "../components/announcement-bar/AnnouncementBar/AnnouncementBar.astro";

interface Props {
  title?: string;
  description?: string;
  /** Utility pages (404): emit robots noindex and no canonical/og:url. */
  noindex?: boolean;
}

const {
  title = "EniyiCihaz — İşitme Cihazları",
  description = "İşitme sağlığınız için en iyi çözümler.",
  noindex = false,
} = Astro.props;

// Canonical/OG URL — requires `site` in astro.config.mjs (set to the real
// production URL from COMPANY.md). No og:image yet: no real logo or share
// image asset exists in the repo, and a stock/product photo would misrepresent
// the brand in a social-share card — omitted rather than faked (PRINCIPLES.md
// §7). Add one real asset and this can be wired in with a single prop.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// One default share image for every page (real storefront photo, cropped to 1200×630 — public/images/og/og-default.jpg).
const ogImageURL = new URL("/images/og/og-default.jpg", Astro.site).toString();
const ogImageAlt = "Avrasya İşitme Cihazları, Darıca — cadde cephesi ve tabelalar";

// Site-wide Organization identity — the brand-level half of the two-part
// entity described in SEARCH_STRATEGY.md §11. The `/iletisim/` page adds a
// second JSON-LD block (MedicalBusiness) sharing this exact same `@id`, so
// search engines and AI systems resolve both as one real business, not two.
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://www.eniyicihaz.com/#organization",
  name: "Eniyicihaz.com",
  alternateName: "Avrasya İşitme Cihazları",
  url: "https://www.eniyicihaz.com/",
  telephone: "+905337733199",
};
---

<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonicalURL} />}

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Eniyicihaz.com" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Self-hosted Inter (see ds/styles/base/fonts.css): preload both subsets Turkish text needs, no third-party stylesheet. -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-ext.woff2" as="font" type="font/woff2" crossorigin />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
  </head>

  <body>
    <a href="#main" class="skip-link">İçeriğe geç</a>
    <ConsentManager />

    <AnnouncementBar pathname={Astro.url.pathname} />
    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    background: var(--color-surface);
    /* The mega menu breaks out to full viewport width; clip any sub-pixel
       horizontal overflow without affecting the sticky header. */
    overflow-x: hidden;
  }

  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: var(--space-4);
    z-index: var(--z-toast);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold);
    transform: translateY(-200%);
    transition: transform var(--transition-base);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>

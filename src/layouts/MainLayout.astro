---
import "../ds/styles/base/variables.css";
import "../ds/styles/base/reset.css";
// Typography baseline: reset.css deliberately sets no font-family, so without
// this the page falls back to the UA serif. Imported instead of global.css to
// avoid its universal `*` transition rule, which would alter every hover.
import "../ds/styles/base/typography.css";
import Header from "../components/header/Header/Header.astro";
import Footer from "../components/footer/Footer/Footer.astro";
import AnnouncementBar from "../components/announcement-bar/AnnouncementBar/AnnouncementBar.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "EniyiCihaz — İşitme Cihazları",
  description = "İşitme sağlığınız için en iyi çözümler.",
} = Astro.props;

// Canonical/OG URL — requires `site` in astro.config.mjs (set to the real
// production URL from COMPANY.md). No og:image yet: no real logo or share
// image asset exists in the repo, and a stock/product photo would misrepresent
// the brand in a social-share card — omitted rather than faked (PRINCIPLES.md
// §7). Add one real asset and this can be wired in with a single prop.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Site-wide Organization identity — the brand-level half of the two-part
// entity described in SEARCH_STRATEGY.md §11. The `/iletisim` page adds a
// second JSON-LD block (MedicalBusiness) sharing this exact same `@id`, so
// search engines and AI systems resolve both as one real business, not two.
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://www.eniyicihaz.com/#organization",
  name: "Eniyicihaz.com",
  alternateName: "Avrasya İşitme Cihazları",
  url: "https://www.eniyicihaz.com",
  telephone: "+905337733199",
};
---

<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Eniyicihaz.com" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
  </head>

  <body>
    <a href="#main" class="skip-link">İçeriğe geç</a>

    <AnnouncementBar />
    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    background: var(--color-surface);
    /* The mega menu breaks out to full viewport width; clip any sub-pixel
       horizontal overflow without affecting the sticky header. */
    overflow-x: hidden;
  }

  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: var(--space-4);
    z-index: var(--z-toast);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: var(--color-text-inverse);
    font-weight: var(--font-weight-semibold);
    transform: translateY(-200%);
    transition: transform var(--transition-base);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>

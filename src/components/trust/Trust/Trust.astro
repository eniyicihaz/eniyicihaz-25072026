---
// Trust — "Neden burası?". The quietest section on the page (moodboard:
// "○ fısıltı"). No CTA — Guide already gave one; repeating it here risks
// CTA fatigue (TRUST_SPECIFICATION.md §1).
// Spec: docs/TRUST_SPECIFICATION.md · DNA: PRINCIPLES §1 · Visual: DESIGN_SYSTEM §6.
import TrustFact from "./atoms/TrustFact/TrustFact.astro";
import { trust } from "./trust.data";
---

<section class="trust" aria-labelledby="trust-title">
  <div class="trust__inner">
    <h2 class="trust__heading" id="trust-title" data-rise>{trust.heading}</h2>
    <p class="trust__context" data-rise>{trust.contextSentence}</p>

    <div class="trust__facts">
      {
        trust.facts.map((fact) => (
          <TrustFact
            title={fact.title}
            description={fact.description}
            href={fact.href}
            linkLabel={fact.linkLabel}
          />
        ))
      }
    </div>

    <p class="trust__service-area" data-rise>
      {trust.serviceAreaSentence}{" "}
      <a href={trust.serviceAreaHref}>Hizmet bölgelerimizin tamamını görün →</a>
    </p>

    <p class="trust__closing" data-rise>{trust.closingSentence}</p>
  </div>
</section>

<script is:inline>
  (function () {
    var section = document.querySelector(".trust");
    if (!section) return;
    if (!("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    // Single-shot entrance (Solution/Guide's pattern) — no CTA, no
    // performative motion; the calmest reveal on the page.
    section.dataset.anim = "pending";

    var revealed = false;
    var ioAlive = false;
    var io;

    function reveal() {
      if (revealed) return;
      revealed = true;
      section.dataset.anim = "in";
      if (io) io.disconnect();
    }

    var failsafe = setTimeout(function () {
      if (!ioAlive) reveal();
    }, 1500);

    io = new IntersectionObserver(
      function (entries) {
        ioAlive = true;
        clearTimeout(failsafe);
        if (entries[0].isIntersecting) reveal();
      },
      { threshold: 0.15 }
    );

    io.observe(section);
  })();
</script>

<style>
  .trust {
    position: relative;
    background: var(--color-background);
    color: var(--color-text);
    /* Trimmed (was space-24 both), top more than bottom — homepage rhythm
       pass: the section read as floating with excess air above the label
       and between the three columns of facts. */
    padding-block: var(--space-12) var(--space-16);
    --trust-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --trust-rise-dur: 700ms;
  }

  /* Visible, but stays whisper-quiet (plan §J: not every sr-only heading
     gets promoted — this one is, because Trust is now a real, navigable
     "why here + where" section). Plain small-caps label, no pill/border —
     Brands/CategoryExplorer's eyebrow chrome would be too loud for
     Trust's deliberately flatter register (TRUST_SPECIFICATION.md §3). */
  .trust__heading {
    margin: 0;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .trust__inner {
    max-width: var(--container-lg);
    margin-inline: auto;
    padding-inline: var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
  }

  .trust__context,
  .trust__closing {
    margin: 0;
    max-width: 40rem;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
    text-align: center;
  }

  .trust__service-area {
    margin: 0;
    max-width: 32rem;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
    text-align: center;
  }

  .trust__service-area a {
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .trust__service-area a:hover {
    text-decoration: underline;
  }

  .trust__service-area a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  .trust__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    width: 100%;
  }

  /* Divider between facts — a border, not a decorative element (nothing
     for assistive tech to skip/announce). Desktop: vertical; stacked
     layouts: horizontal (§5). */
  :global(.trust-fact):not(:first-child) {
    border-left: 1px solid var(--color-border);
    padding-left: var(--space-6);
  }

  /* --- Entrance: organism owns the state machine (Solution/Guide's
     pattern) — facts get a light stagger; context/closing settle
     together. --- */

  .trust[data-anim="pending"] [data-rise] {
    opacity: 0;
  }

  .trust[data-anim="in"] [data-rise] {
    animation: trust-rise var(--trust-rise-dur) var(--trust-ease) both;
  }

  .trust[data-anim="in"] :global(.trust-fact):nth-child(1) {
    animation-delay: 0ms;
  }
  .trust[data-anim="in"] :global(.trust-fact):nth-child(2) {
    animation-delay: 120ms;
  }
  .trust[data-anim="in"] :global(.trust-fact):nth-child(3) {
    animation-delay: 240ms;
  }

  @keyframes trust-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* --- Responsive --- */

  @media (max-width: 1023px) {
    .trust__facts {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    :global(.trust-fact):not(:first-child) {
      border-left: none;
      border-top: 1px solid var(--color-border);
      padding-left: 0;
      padding-top: var(--space-6);
    }
  }

  @media (max-width: 640px) {
    .trust {
      padding-block: var(--space-10);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trust[data-anim="in"] [data-rise] {
      animation: none;
    }
  }
</style>

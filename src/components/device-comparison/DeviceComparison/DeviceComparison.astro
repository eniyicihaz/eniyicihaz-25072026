---
// DeviceComparison — "Görselli İşitme Cihazı Karşılaştırması". New homepage
// section right after CategoryExplorer (own spec:
// docs/DEVICE_COMPARISON_SPECIFICATION.md). Real <table> (not a div-grid —
// KulakArkasiComparison's precedent), 7 columns (same 7 real
// /isitme-cihazlari/* pages as CategoryExplorer). Mobile: horizontal-scroll
// with the criterion column pinned via `position: sticky`, per the
// specification's explicit responsive requirement — not an accordion,
// so the comparison stays scannable at a glance.
import ImagePlaceholder from "../../shared/ImagePlaceholder/ImagePlaceholder.astro";
import { deviceComparison } from "./device-comparison.data";
---

<section class="device-comparison" aria-labelledby="device-comparison-title">
  <div class="device-comparison__header">
    <p class="device-comparison__eyebrow" data-rise>{deviceComparison.eyebrow}</p>
    <h2 class="device-comparison__heading" id="device-comparison-title" data-rise>
      {deviceComparison.heading}
    </h2>
    <p class="device-comparison__intro" data-rise>{deviceComparison.intro}</p>
  </div>

  <div class="device-comparison__frame" data-rise>
   <div class="device-comparison__scroll" tabindex="0" role="region" aria-label="İşitme cihazı tipleri karşılaştırma tablosu — yatay kaydırılabilir">
    <table class="device-comparison__table">
      <caption class="sr-only">İşitme cihazı tiplerinin özellik karşılaştırması</caption>
      <thead>
        <tr>
          <th scope="col" class="device-comparison__corner"><span class="sr-only">Özellik</span></th>
          {deviceComparison.columns.map((col) => (
            <th scope="col" class="device-comparison__col-head">
              <a href={col.href} class="device-comparison__col-link">
                {/* TODO: gerçek/temsili cihaz görseli eklendiğinde ImagePlaceholder yerine <img src={col.image?.src} alt={col.imageAlt} loading="lazy" /> */}
                <ImagePlaceholder alt={col.imageAlt} ratio="1/1" />
                <span class="device-comparison__col-name">{col.name}</span>
              </a>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {deviceComparison.rows.map((row) => (
          <tr>
            <th scope="row" class="device-comparison__row-head">{row.criterion}</th>
            {row.values.map((value) => (
              <td class="device-comparison__cell">{value}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
   </div>
  </div>

  <p class="device-comparison__closing" data-rise>{deviceComparison.closing}</p>
</section>

<script is:inline>
  (function () {
    var section = document.querySelector(".device-comparison");
    if (!section) return;
    if (!("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    section.dataset.anim = "pending";

    var revealed = false;
    var ioAlive = false;
    var io;

    function reveal() {
      if (revealed) return;
      revealed = true;
      section.dataset.anim = "in";
      if (io) io.disconnect();
    }

    var failsafe = setTimeout(function () {
      if (!ioAlive) reveal();
    }, 1500);

    io = new IntersectionObserver(
      function (entries) {
        ioAlive = true;
        clearTimeout(failsafe);
        if (entries[0].isIntersecting) reveal();
      },
      { threshold: 0.15 }
    );

    io.observe(section);
  })();
</script>

<style>
  .device-comparison {
    position: relative;
    background: var(--color-surface);
    color: var(--color-text);
    padding-block: var(--space-14);
    --dc-ease: cubic-bezier(0.22, 1, 0.36, 1);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .device-comparison__header {
    max-width: var(--container-lg);
    margin-inline: auto;
    padding-inline: var(--space-6);
    text-align: left;
    max-width: var(--container-2xl);
  }

  .device-comparison__eyebrow {
    display: inline-block;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-background);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
  }

  .device-comparison__heading {
    margin: var(--space-4) 0 0;
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .device-comparison__intro {
    margin: var(--space-4) 0 0;
    max-width: 40rem;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  /* --- Table: horizontal scroll container, first column pinned --------- */

  /* Frame carries the page gutter; the scroll container (border + radius)
     sits inside it and is the ONLY overflow ancestor of the table, so the
     sticky first column pins to it. The <table> itself must never set
     overflow (that would make it the sticky's scroll container). */
  .device-comparison__frame {
    max-width: var(--container-2xl);
    margin: var(--space-8) auto 0;
    padding: 0 var(--space-6);
  }

  .device-comparison__scroll {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .device-comparison__scroll:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .device-comparison__table {
    width: 100%;
    min-width: 900px;
    border-collapse: separate;
    border-spacing: 0;
  }

  .device-comparison__corner,
  .device-comparison__row-head {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--color-background);
    border-right: 1px solid var(--color-border);
  }

  .device-comparison__corner {
    z-index: 2;
  }

  .device-comparison__col-head {
    padding: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
    vertical-align: top;
    min-width: 140px;
  }

  .device-comparison__col-head:first-of-type {
    border-left: none;
  }

  .device-comparison__col-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
  }

  .device-comparison__col-link :global(.image-placeholder) {
    width: 44px;
    padding: 0;
  }

  .device-comparison__col-name {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    text-align: center;
  }

  .device-comparison__col-link:hover .device-comparison__col-name {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .device-comparison__col-link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-md);
  }

  .device-comparison__row-head {
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    text-align: left;
    white-space: nowrap;
  }

  .device-comparison__cell {
    padding: var(--space-3);
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
    text-align: center;
  }

  .device-comparison__closing {
    max-width: var(--container-2xl);
    margin: var(--space-6) auto 0;
    padding: 0 var(--space-6);
    text-align: left;
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
  }

  /* --- Entrance --- */

  .device-comparison[data-anim="pending"] [data-rise] {
    opacity: 0;
  }

  .device-comparison[data-anim="in"] [data-rise] {
    animation: device-comparison-rise 600ms var(--dc-ease) both;
  }

  .device-comparison[data-anim="in"] .device-comparison__frame {
    animation-delay: 100ms;
  }

  .device-comparison[data-anim="in"] .device-comparison__closing {
    animation-delay: 160ms;
  }

  @keyframes device-comparison-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* --- Responsive --- */

  @media (max-width: 640px) {
    .device-comparison {
      padding-block: var(--space-12);
    }

    .device-comparison__frame {
      padding-inline: var(--space-4);
    }

    .device-comparison__table {
      min-width: 760px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .device-comparison[data-anim="in"] [data-rise] {
      animation: none;
    }
  }
</style>

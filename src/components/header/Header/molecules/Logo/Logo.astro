---
// Header logo — the real owner-supplied Avrasya İşitme Cihazları logo (ASSET_SOT §1, MASTER_PLAN A1).
// Served as a crisp vector (SVG) so the tagline stays sharp at every size and pixel density; the symbol,
// wordmark and colours are traced from the owner's artwork (no new design). Its own tagline stays part of the
// artwork; no tagline is added as site text (BRAND_SOT, MASTER_PLAN B3).
// The visible logo text and the accessible name are the same ("Avrasya İşitme Cihazları"), which also
// satisfies WCAG 2.5.3 Label in Name.
interface Props {
  name?: string;
  tagline?: string;
  href: string;
}

const { href } = Astro.props;
---

<a class="hd-logo" href={href}>
  <img
    class="hd-logo__img"
    src="/images/brand/avrasya-isitme-cihazlari-logo.svg"
    width="360"
    height="128"
    alt="Avrasya İşitme Cihazları"
    decoding="async"
  />
</a>

<style>
  .hd-logo {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .hd-logo:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .hd-logo__img {
    display: block;
    height: 56px;
    width: auto;
    aspect-ratio: 360 / 128;
  }

  @media (max-width: 640px) {
    .hd-logo__img {
      height: 48px;
    }
  }

  /* ≤ 359 px: üst çubuk 320 px'e sığsın diye logo bir kademe küçülür (oran aynı, yeniden çizim yok). */
  @media (max-width: 359px) {
    .hd-logo__img {
      height: 44px;
    }
  }
</style>

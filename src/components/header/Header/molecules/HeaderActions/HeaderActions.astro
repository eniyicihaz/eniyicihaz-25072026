---
import { Search, Phone } from "lucide-astro";
import { icons } from "../../icons";
import type { PhoneData, HeaderData } from "../../header.types";

interface Props {
  phone: PhoneData;
  cta: HeaderData["cta"];
}

const { phone, cta } = Astro.props;
const CtaIcon = icons[cta.icon] as any;
---

<div class="hd-actions">
  <button type="button" class="hd-actions__icon-btn" aria-label="Ara">
    <Search size={20} aria-hidden="true" />
  </button>

  <a class="hd-actions__phone" href={phone.href}>
    <span class="hd-actions__phone-icon" aria-hidden="true">
      <Phone size={18} />
    </span>
    <span class="hd-actions__phone-text">
      <span class="hd-actions__phone-number">{phone.number}</span>
      <span class="hd-actions__phone-label">{phone.label}</span>
    </span>
  </a>

  <a class="hd-actions__cta" href={cta.href}>
    <CtaIcon size={20} stroke-width={2} aria-hidden="true" class="hd-actions__cta-icon" />
    <span>{cta.label}</span>
  </a>
</div>

<style>
  .hd-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Search — secondary circular button */
  .hd-actions__icon-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-white);
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      color 280ms ease,
      border-color 280ms ease,
      background-color 280ms ease;
  }

  .hd-actions__icon-btn:hover {
    color: var(--color-text);
    border-color: var(--color-border-hover);
    background: var(--color-surface);
  }

  .hd-actions__icon-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* Phone — icon + number + label */
  .hd-actions__phone {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-md);
    transition: background-color 280ms ease;
  }

  .hd-actions__phone:hover {
    background: var(--color-surface);
  }

  .hd-actions__phone:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .hd-actions__phone-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-primary);
    flex: none;
  }

  .hd-actions__phone-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    line-height: 1.1;
  }

  /* Primary — the number reads at a glance: clean, aligned figures. */
  .hd-actions__phone-number {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
    line-height: 1.1;
    color: var(--color-text);
  }

  /* Secondary — a small uppercase caption, strong hierarchy vs the number. */
  .hd-actions__phone-label {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-soft);
  }

  /* CTA — primary action, built as a premium component (Apple/Stripe/Linear
     feel, health-brand warmth). Depth comes from layered light: an inset top
     highlight + inset bottom shade + soft blue ambient shadow — no gradient.
     Refined radius (not a pill), roomy padding, optically centred icon+text. */
  .hd-actions__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    /* A touch larger than the 56px height used elsewhere (Hero CTAs) —
       Header's CTA is the one place a slightly bigger, more confident
       button earns its keep, without becoming a different button style. */
    height: 60px;
    padding-inline: 36px;
    border-radius: var(--radius-lg);
    background: var(--color-primary);
    border: 1px solid var(--color-primary-hover);
    color: var(--color-text-inverse);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.01em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.25),
      inset 0 -1px 0 rgb(15 23 42 / 0.12),
      0 1px 2px rgb(15 23 42 / 0.10),
      0 10px 24px -10px rgb(37 99 235 / 0.55);
    transition:
      transform var(--transition-slow),
      box-shadow var(--transition-slow),
      background-color var(--transition-slow);
  }

  .hd-actions__cta-icon {
    /* Optical centring — nudge the calendar glyph onto the text baseline. */
    margin-top: -1px;
  }

  /* Hover — lifts, shadow deepens, blue comes a touch more alive. */
  .hd-actions__cta:hover {
    background: var(--color-primary-hover);
    transform: translateY(-2px);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.28),
      inset 0 -1px 0 rgb(15 23 42 / 0.14),
      0 2px 4px rgb(15 23 42 / 0.10),
      0 16px 34px -10px rgb(37 99 235 / 0.6);
  }

  .hd-actions__cta:active {
    transform: translateY(0);
    transition-duration: var(--transition-fast);
  }

  .hd-actions__cta:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  @media (prefers-reduced-motion: reduce) {
    .hd-actions__cta {
      transition: box-shadow var(--transition-base);
    }
    .hd-actions__cta:hover,
    .hd-actions__cta:active {
      transform: none;
    }
  }

  /* Below the desktop nav breakpoint, only search + CTA remain in the bar;
     the phone block folds into the mobile menu. */
  @media (max-width: 1023px) {
    .hd-actions__phone {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hd-actions__cta span {
      display: none;
    }
    .hd-actions__cta {
      padding-inline: 0;
      width: 60px;
      justify-content: center;
    }
  }
</style>

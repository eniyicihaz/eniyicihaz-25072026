---
// Header actions. Primary: the free hearing test (what most first-time visitors want). Secondary: the main
// number as a phone link and as WhatsApp (MASTER_PLAN K2: only the main number in the header). Search stays
// a quiet icon button. Below 1280 px the desktop nav is replaced by the drawer, and the bar keeps only the
// two direct-contact icon buttons (phone + WhatsApp) next to the burger so contact is always one tap away.
import { Search, Phone } from "lucide-astro";
import { icons } from "../../icons";
import WhatsAppIcon from "../../../../shared/WhatsAppIcon/WhatsAppIcon.astro";
import type { PhoneData, HeaderData } from "../../header.types";

interface Props {
  phone: PhoneData;
  whatsapp: HeaderData["whatsapp"];
  cta: HeaderData["cta"];
}

const { phone, whatsapp, cta } = Astro.props;
const CtaIcon = icons[cta.icon] as any;
---

<div class="hd-actions">
  <button type="button" class="hd-actions__icon-btn hd-actions__search" data-action="open-search" aria-label="Sitede ara">
    <Search size={22} aria-hidden="true" />
  </button>

  {/* Telefon: numara + "Bizi Arayın" + küçük "23:59'a kadar" (telefonla ulaşılabilirlik; merkez saati değildir).
      Etiketin iki parçası ayrı flex öğesidir: ölçüm (events.ts safeLabel) ilk metin satırını okur ve cta_label
      eskisi gibi "Bizi Arayın" kalır. */}
  <a
    class="hd-actions__phone"
    href={phone.href}
    aria-label={`${phone.number} ${phone.label}${phone.availability ? ` — telefonla ${phone.availability}` : ""}`}
    title={phone.availability ? `Telefonla ${phone.availability}` : undefined}
  >
    <span class="hd-actions__phone-icon" aria-hidden="true">
      <Phone size={20} />
    </span>
    <span class="hd-actions__phone-text">
      <span class="hd-actions__phone-number">{phone.number}</span>
      <span class="hd-actions__phone-label">
        <span class="hd-actions__phone-cta">{phone.label}</span>
        {phone.availability && <span class="hd-actions__phone-until">{phone.availability}</span>}
      </span>
    </span>
  </a>

  <a class="hd-actions__wa" href={whatsapp.href} aria-label={whatsapp.label}>
    <WhatsAppIcon size={22} class="hd-actions__wa-icon" />
    <span class="hd-actions__wa-text">WhatsApp</span>
  </a>

  <a class="hd-actions__cta" href={cta.href}>
    <CtaIcon size={20} stroke-width={2} aria-hidden="true" class="hd-actions__cta-icon" />
    <span>{cta.label}</span>
  </a>
</div>

<style>
  .hd-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Search — quiet circular button */
  .hd-actions__icon-btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-white);
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      color 280ms ease,
      border-color 280ms ease,
      background-color 280ms ease;
  }

  .hd-actions__icon-btn:hover {
    color: var(--color-text);
    border-color: var(--color-border-hover);
    background: var(--color-surface);
  }

  .hd-actions__icon-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* Phone — icon + number + caption (a text link, the number reads at a glance) */
  .hd-actions__phone {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 48px;
    text-decoration: none;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-md);
    transition: background-color 280ms ease;
  }

  .hd-actions__phone:hover {
    background: var(--color-surface);
  }

  .hd-actions__phone:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .hd-actions__phone-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background: var(--color-primary-50);
    color: var(--color-primary);
    flex: none;
  }

  .hd-actions__phone-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1.1;
  }

  .hd-actions__phone-number {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    color: var(--color-text);
  }

  .hd-actions__phone-label {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    line-height: 1.2;
    white-space: nowrap;
    color: var(--color-text-muted);
  }

  /* "23:59'a kadar" — telefonla ulaşılabilirlik; küçük, turkuaz (beyaz zeminde 5.9:1). */
  .hd-actions__phone-until {
    font-variant-numeric: tabular-nums;
    color: var(--color-accent-text);
  }

  /* ≥1720 px (numara görünür): ikinci satır yalnızca "23:59'a kadar" — "Bizi Arayın" etiketi ekran okuyucuda kalır,
     görsel olarak gizlenir; böylece telefon kümesinin genişliği eskisiyle (numara genişliği) aynı kalır ve menüyle
     arama düğmesi arasındaki boşluk daralmaz (ölçüm: aksi hâlde 1720 ve 1920 px'te menü arama düğmesine biniyordu). */
  .hd-actions__phone-cta {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* WhatsApp — secondary: white surface, official green glyph, thin border (same hierarchy as the page CTAs) */
  .hd-actions__wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 48px;
    height: 48px;
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border-hover);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    color: var(--color-text);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color var(--transition-base),
      background-color var(--transition-base);
  }

  .hd-actions__wa :global(.hd-actions__wa-icon) {
    color: #25d366;
    flex: none;
  }

  .hd-actions__wa:hover {
    background: var(--color-surface);
    border-color: var(--color-text-soft);
  }

  .hd-actions__wa:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* CTA — primary action */
  .hd-actions__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: 56px;
    padding-inline: 28px;
    border-radius: var(--radius-lg);
    background: var(--color-primary);
    border: 1px solid var(--color-primary-hover);
    color: var(--color-text-inverse);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.01em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.22),
      0 10px 24px -10px rgb(var(--color-primary-rgb) / 0.55);
    transition:
      transform var(--transition-slow),
      box-shadow var(--transition-slow),
      background-color var(--transition-slow);
  }

  .hd-actions__cta:hover {
    background: var(--color-primary-hover);
    transform: translateY(-2px);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.26),
      0 16px 32px -10px rgb(var(--color-primary-rgb) / 0.6);
  }

  .hd-actions__cta:active {
    transform: translateY(0);
    transition-duration: var(--transition-fast);
  }

  .hd-actions__cta:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  @media (prefers-reduced-motion: reduce) {
    .hd-actions__cta {
      transition: box-shadow var(--transition-base);
    }
    .hd-actions__cta:hover,
    .hd-actions__cta:active {
      transform: none;
    }
  }

  /* 1280–1719 px: nav and the full cluster do not fit side by side — the phone shows its icon only and the
     WhatsApp button yields to the floating contact dock (which holds WhatsApp + phone on every page). The primary
     CTA keeps its label. */
  @media (min-width: 1280px) and (max-width: 1719px) {
    .hd-actions {
      gap: var(--space-2);
    }
    .hd-actions__phone-text,
    .hd-actions__wa {
      display: none;
    }
    .hd-actions__phone {
      padding-inline: 0;
    }
    .hd-actions__cta {
      padding-inline: 20px;
    }
  }

  /* 1536–1719 px: numara sığmaz ama küçük iki satırlık etiket sığar — telefon simgesinin yanında "Bizi Arayın" ve
     altında "23:59'a kadar". 1280–1535 px'te yer yoktur (nav zaten sıkışık): yalnızca simge kalır; aynı bilgi sağ
     alttaki sabit iletişim düğmesinde (ContactDock) görünür. */
  @media (min-width: 1536px) and (max-width: 1719px) {
    .hd-actions__phone-text {
      display: flex;
    }
    .hd-actions__phone-number {
      display: none;
    }
    .hd-actions__phone {
      gap: var(--space-2);
      padding-inline: 0 var(--space-1);
    }
    .hd-actions__phone-label {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      font-size: 0.8125rem;
      line-height: 1.15;
    }
    .hd-actions__phone-cta {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip: auto;
      color: var(--color-text);
    }
  }

  /* Below the desktop-nav breakpoint: [phone icon][WhatsApp icon] stay in the bar next to the burger
     (direct contact is one tap away); the test CTA, search and the number text move into the drawer. */
  @media (max-width: 1279px) {
    .hd-actions__cta,
    .hd-actions__search,
    .hd-actions__phone-text,
    .hd-actions__wa-text {
      display: none;
    }
    .hd-actions {
      gap: var(--space-2);
    }
    .hd-actions__phone {
      padding: 0;
    }
    .hd-actions__phone-icon {
      border: 1px solid var(--color-primary);
      background: var(--color-primary);
      color: var(--color-text-inverse);
    }
    .hd-actions__wa {
      width: 48px;
      padding-inline: 0;
    }
  }
</style>

---
// Header actions. Primary (desktop, ≥1280 px): the "Bizi Arayın" phone button (owner decision 2026-11-17 — phone is the
// main conversion; it replaced the "Ücretsiz İşitme Testi" button, which stays on the home hero and in the drawer).
// Next to it: the main number with the small "23:59'a kadar" note and WhatsApp (MASTER_PLAN K2: only the main number
// in the header). Search stays a quiet icon button. Below 1280 px the desktop nav is replaced by the drawer, and the
// bar keeps only the two direct-contact icon buttons (phone + WhatsApp) next to the burger.
// Width tiers (≥1280): ≥1720 [search][number + 23:59][WhatsApp][Bizi Arayın] · 1536–1719 [search][number + 23:59]
// [Bizi Arayın] · 1280–1535 [search][Bizi Arayın + 23:59 inside the button] (no room for the number text; it stays in
// the button's accessible name/title and in the contact dock).
import { Search, Phone } from "lucide-astro";
import WhatsAppIcon from "../../../../shared/WhatsAppIcon/WhatsAppIcon.astro";
import type { PhoneData, HeaderData } from "../../header.types";

interface Props {
  phone: PhoneData;
  whatsapp: HeaderData["whatsapp"];
}

const { phone, whatsapp } = Astro.props;
const phoneName = `${phone.label} — ${phone.number}${phone.availability ? `, telefonla ${phone.availability}` : ""}`;
const phoneTitle = phone.availability ? `Telefonla ${phone.availability}` : undefined;
---

<div class="hd-actions">
  <button type="button" class="hd-actions__icon-btn hd-actions__search" data-action="open-search" aria-label="Sitede ara">
    <Search size={22} aria-hidden="true" />
  </button>

  {/* Telefon numarası + küçük "23:59'a kadar" (telefonla ulaşılabilirlik; merkez saati değildir). <1280 px'te yalnızca
      dolu telefon simgesi düğmesi (mobil çubuk); 1280–1535 px'te gizli (aynı hedef "Bizi Arayın" düğmesinde). */}
  <a class="hd-actions__phone" href={phone.href} aria-label={phoneName} title={phoneTitle}>
    <span class="hd-actions__phone-icon" aria-hidden="true">
      <Phone size={20} />
    </span>
    <span class="hd-actions__phone-text">
      <span class="hd-actions__phone-number">{phone.number}</span>
      <span class="hd-actions__phone-label">
        <span class="hd-actions__phone-cta">{phone.label}</span>
        {phone.availability && <span class="hd-actions__phone-until">{phone.availability}</span>}
      </span>
    </span>
  </a>

  <a class="hd-actions__wa" href={whatsapp.href} aria-label={whatsapp.label}>
    <WhatsAppIcon size={22} class="hd-actions__wa-icon" />
    <span class="hd-actions__wa-text">WhatsApp</span>
  </a>

  {/* Birincil CTA: telefon. Ölçüm href'ten (tel: → phone_click, link_location=header); etiketin ilk satırı "Bizi Arayın". */}
  <a class="hd-actions__cta" href={phone.href} aria-label={phoneName} title={phoneTitle}>
    <span class="hd-actions__cta-icon" aria-hidden="true"><Phone size={20} stroke-width={2.25} /></span>
    <span class="hd-actions__cta-text">
      <span class="hd-actions__cta-label">{phone.label}</span>
      {phone.availability && <span class="hd-actions__cta-until">{phone.availability}</span>}
    </span>
  </a>
</div>

<style>
  .hd-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Search — quiet circular button */
  .hd-actions__icon-btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-white);
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      color 280ms ease,
      border-color 280ms ease,
      background-color 280ms ease;
  }

  .hd-actions__icon-btn:hover {
    color: var(--color-text);
    border-color: var(--color-border-hover);
    background: var(--color-surface);
  }

  .hd-actions__icon-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* Phone — number + caption (a text link, the number reads at a glance) */
  .hd-actions__phone {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 48px;
    text-decoration: none;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-md);
    transition: background-color 280ms ease;
  }

  .hd-actions__phone:hover {
    background: var(--color-surface);
  }

  .hd-actions__phone:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .hd-actions__phone-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background: var(--color-primary-50);
    color: var(--color-primary);
    flex: none;
  }

  .hd-actions__phone-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1.1;
  }

  .hd-actions__phone-number {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    color: var(--color-text);
  }

  .hd-actions__phone-label {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    line-height: 1.2;
    white-space: nowrap;
    color: var(--color-text-muted);
  }

  /* "23:59'a kadar" — telefonla ulaşılabilirlik; küçük, turkuaz (beyaz zeminde 5.9:1). */
  .hd-actions__phone-until {
    font-variant-numeric: tabular-nums;
    color: var(--color-accent-text);
  }

  /* Numara bloğunun ikinci satırında "Bizi Arayın" etiketi görsel olarak gizlidir (ekran okuyucuda kalır): yalnızca
     "23:59'a kadar" görünür; düğme zaten "Bizi Arayın"dır. */
  .hd-actions__phone-cta {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* WhatsApp — secondary: white surface, official green glyph, thin border (same hierarchy as the page CTAs) */
  .hd-actions__wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 48px;
    height: 48px;
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border-hover);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    color: var(--color-text);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color var(--transition-base),
      background-color var(--transition-base);
  }

  .hd-actions__wa :global(.hd-actions__wa-icon) {
    color: #25d366;
    flex: none;
  }

  .hd-actions__wa:hover {
    background: var(--color-surface);
    border-color: var(--color-text-soft);
  }

  .hd-actions__wa:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* CTA — primary action: Bizi Arayın (telefon). Dolu kurumsal mavi, simge turkuaz yuvarlak içinde. */
  .hd-actions__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    height: 56px;
    padding-inline: 22px 26px;
    border-radius: var(--radius-lg);
    background: var(--color-primary);
    border: 1px solid var(--color-primary-hover);
    color: var(--color-text-inverse);
    text-decoration: none;
    white-space: nowrap;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.22),
      0 10px 24px -10px rgb(var(--color-primary-rgb) / 0.55);
    transition:
      transform var(--transition-slow),
      box-shadow var(--transition-slow),
      background-color var(--transition-slow);
  }

  .hd-actions__cta-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: var(--brand-teal-light);
    color: var(--brand-navy-deep);
  }

  .hd-actions__cta-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .hd-actions__cta-label {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
    line-height: 1;
  }

  /* "23:59'a kadar" yalnızca 1280–1535 px'te düğmenin içinde (numara metni için yer yok); ≥1536 px'te numaranın altında. */
  .hd-actions__cta-until {
    display: none;
    font-size: 0.8125rem;
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: rgb(255 255 255 / 0.94);
  }

  .hd-actions__cta:hover {
    background: var(--color-primary-hover);
    transform: translateY(-2px);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.26),
      0 16px 32px -10px rgb(var(--color-primary-rgb) / 0.6);
  }

  .hd-actions__cta:active {
    transform: translateY(0);
    transition-duration: var(--transition-fast);
  }

  .hd-actions__cta:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  @media (prefers-reduced-motion: reduce) {
    .hd-actions__cta {
      transition: box-shadow var(--transition-base);
    }
    .hd-actions__cta:hover,
    .hd-actions__cta:active {
      transform: none;
    }
  }

  /* ≥1280 px: telefon simgesi düğmesi (mobil çubuk) gerekmez — simge "Bizi Arayın" düğmesindedir. */
  @media (min-width: 1280px) {
    .hd-actions__phone-icon {
      display: none;
    }
    .hd-actions__phone {
      padding-inline: var(--space-1);
    }
  }

  /* 1280–1439 px: nav + tam küme yan yana sığmaz. Numara bloğu ve WhatsApp, sağ alttaki sabit iletişim düğmesine
     (ContactDock: WhatsApp + Ara) bırakılır; "Bizi Arayın" düğmesi "23:59'a kadar" bilgisini kendi içinde taşır. */
  @media (min-width: 1280px) and (max-width: 1439px) {
    .hd-actions {
      gap: var(--space-2);
    }
    .hd-actions__phone,
    .hd-actions__wa {
      display: none;
    }
    .hd-actions__cta {
      padding-inline: 18px 20px;
    }
    .hd-actions__cta-until {
      display: block;
    }
  }

  /* 1440–1535 px: numara + 23:59 başlıkta görünür (ölçüm: menü ile logo/eylemler arası boşluk 1440'ta ≥ 35 px (en dar nokta), 1480'de ≥ 55 px);
     WhatsApp yer olmadığı için sağ alttaki sabit iletişim düğmesinde kalır; "Bizi Arayın" düğmesi yalnızca etiketi taşır. */
  @media (min-width: 1440px) and (max-width: 1535px) {
    .hd-actions {
      gap: var(--space-2);
    }
    .hd-actions__wa {
      display: none;
    }
    .hd-actions__cta {
      padding-inline: 18px 20px;
    }
  }

  /* 1536–1719 px: numara + 23:59 görünür. WhatsApp 1536–1599 px'te sabit iletişim düğmesine bırakılır (yer yok);
     1600–1719 px'te yalnızca simge olarak başlıkta kalır (ölçüm: menü–arama boşluğu ≥ 50 px). */
  @media (min-width: 1536px) and (max-width: 1599px) {
    .hd-actions__wa {
      display: none;
    }
  }

  @media (min-width: 1600px) and (max-width: 1719px) {
    .hd-actions__wa {
      width: 48px;
      padding-inline: 0;
    }
    .hd-actions__wa-text {
      display: none;
    }
  }

  /* Below the desktop-nav breakpoint: [phone icon][WhatsApp icon] stay in the bar next to the burger
     (direct contact is one tap away); the call button, search and the number text move into the drawer. */
  @media (max-width: 1279px) {
    .hd-actions__cta,
    .hd-actions__search,
    .hd-actions__phone-text,
    .hd-actions__wa-text {
      display: none;
    }
    .hd-actions {
      gap: var(--space-2);
    }
    .hd-actions__phone {
      padding: 0;
    }
    .hd-actions__phone-icon {
      border: 1px solid var(--color-primary);
      background: var(--color-primary);
      color: var(--color-text-inverse);
    }
    .hd-actions__wa {
      width: 48px;
      padding-inline: 0;
    }
  }

  /* ≤ 309 px (ör. 360 px telefonda %125 tarayıcı yakınlaştırması = 288 px): logo + telefon + WhatsApp + menü düğmesi sığmıyor,
     menü düğmesi ekranın dışına çıkıyordu (ölçüm: 288 px'te +20 px). Üst çubukta yalnızca WhatsApp simgesi gizlenir;
     WhatsApp alt iletişim çubuğunda ve menüde aynen durur. Telefon simgesi ve menü düğmesi kalır. */
  @media (max-width: 309px) {
    .hd-actions__wa {
      display: none;
    }
  }
</style>

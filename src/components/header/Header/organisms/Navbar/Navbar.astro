---
import { ChevronDown } from "lucide-astro";
import type { NavItem } from "../../header.types";
import { isActive } from "../../isActive";

interface Props {
  items: NavItem[];
  currentPath: string;
}

const { items, currentPath } = Astro.props;
---

<nav class="hd-nav" aria-label="Ana menü">
  <ul class="hd-nav__list">
    {
      items.map((item) =>
        item.mega ? (
          <li class="hd-nav__item">
            <button
              type="button"
              class="hd-nav__trigger"
              data-mega-trigger={item.mega.id}
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls={`hd-mega-${item.mega.id}`}
              aria-current={isActive(item.href, currentPath) ? "true" : undefined}
            >
              <span>{item.label}</span>
              <ChevronDown class="hd-nav__chev" size={16} aria-hidden="true" />
            </button>
          </li>
        ) : (
          <li class="hd-nav__item">
            <a
              class="hd-nav__link"
              href={item.href}
              aria-current={isActive(item.href, currentPath) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        )
      )
    }
  </ul>
</nav>

<style>
  .hd-nav__list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
  }

  .hd-nav__item {
    display: flex;
    flex: 0 0 auto;
  }

  .hd-nav__link,
  .hd-nav__trigger {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    height: 44px;
    padding-inline: var(--space-2);
    border: none;
    background: transparent;
    border-radius: var(--radius-md);
    font-family: inherit;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.01em;
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    cursor: pointer;
    transition: color 280ms ease;
  }

  /* Underline indicator — hover, open, and active. Inset a touch further
     than the link's own padding (space-4 vs space-3) so it reads as a
     deliberate short accent under the label, not a bar spanning the whole
     clickable hit-area — and eases on the same soft curve as the rest of
     the site's premium micro-interactions instead of a flat linear "ease". */
  .hd-nav__link::after,
  .hd-nav__trigger::after {
    content: "";
    position: absolute;
    left: var(--space-4);
    right: var(--space-4);
    bottom: 6px;
    height: 2px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hd-nav__link:hover,
  .hd-nav__trigger:hover,
  .hd-nav__trigger[aria-expanded="true"],
  .hd-nav__trigger[aria-current="true"],
  .hd-nav__link[aria-current="page"] {
    color: var(--color-text);
  }

  .hd-nav__link:hover::after,
  .hd-nav__trigger:hover::after,
  .hd-nav__trigger[aria-expanded="true"]::after,
  .hd-nav__trigger[aria-current="true"]::after,
  .hd-nav__link[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .hd-nav__link:focus-visible,
  .hd-nav__trigger:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .hd-nav__chev {
    transition: transform var(--transition-base);
  }

  .hd-nav__trigger[aria-expanded="true"] .hd-nav__chev {
    transform: rotate(180deg);
  }

  /* Tightest desktop range (1280–1439px): trim item padding so the nav clears
     both the logo and the actions cluster without any overlap. */
  @media (min-width: 1280px) and (max-width: 1439px) {
    .hd-nav__link,
    .hd-nav__trigger {
      padding-inline: 6px;
    }
    .hd-nav__list {
      gap: 2px;
    }
  }

  /* Compact sizing is the default: the 6 items are 641px wide, which is what
     fits beside the logo and the full actions cluster from 1500px up. The
     roomy sizing (912px wide) only fits from 1780px, so it is opt-in there. */
  @media (min-width: 1780px) {
    .hd-nav__link,
    .hd-nav__trigger {
      font-size: var(--font-size-lg);
      padding-inline: var(--space-3);
    }
    .hd-nav__list {
      gap: 36px;
    }
  }
</style>

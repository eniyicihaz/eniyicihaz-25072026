---
import { ChevronRight, ArrowRight, Check } from "lucide-astro";
import { icons } from "../../icons";
import type { MegaMenuData } from "../../header.types";
import { isActive } from "../../isActive";

interface Props {
  data: MegaMenuData;
  currentPath: string;
}

const { data, currentPath } = Astro.props;
const PromoBg = icons.ear as any; // decorative placeholder illustration
---

<div
  class="hd-mega"
  id={`hd-mega-${data.id}`}
  data-mega-panel={data.id}
  role="region"
  aria-label={`${data.id} menüsü`}
>
  <div class="hd-mega__inner">
    <!-- Column 1: Promo (35%) -->
    <div class:list={["hd-mega__promo", { "hd-mega__promo--has-image": Boolean(data.promo.image) }]}>
      <div class="hd-mega__promo-body">
        {data.promo.badge && <p class="hd-mega__promo-badge">{data.promo.badge}</p>}
        <h2 class="hd-mega__promo-title">{data.promo.title}</h2>
        <p class="hd-mega__promo-text">{data.promo.text}</p>
        <a
          class="hd-mega__promo-cta"
          href={data.promo.cta.href}
          aria-current={isActive(data.promo.cta.href, currentPath) ? "page" : undefined}
        >
          <span>{data.promo.cta.label}</span>
          <ArrowRight class="hd-mega__promo-cta-arrow" size={16} aria-hidden="true" />
        </a>
        {
          data.promo.trustItems && (
            <ul class="hd-mega__promo-trust">
              {data.promo.trustItems.map((item) => (
                <li>
                  <Check size={14} stroke-width={2.5} aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          )
        }
        {
          data.promo.tags && (
            <ul class="hd-mega__promo-tags">
              {data.promo.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
      </div>
      {
        data.promo.image ? (
          <div class="hd-mega__promo-image" aria-hidden="true">
            <img src={data.promo.image} alt="" loading="lazy" />
          </div>
        ) : data.promo.badge ? (
          <div class="hd-mega__promo-illustration" aria-hidden="true">
            <span class="hd-mega__promo-ring hd-mega__promo-ring--1" />
            <span class="hd-mega__promo-ring hd-mega__promo-ring--2" />
            <span class="hd-mega__promo-ring hd-mega__promo-ring--3" />
            <span class="hd-mega__promo-illustration-icon">
              <PromoBg size={30} strokeWidth={1.75} />
            </span>
          </div>
        ) : (
          <div class="hd-mega__promo-art" aria-hidden="true">
            <PromoBg size={200} strokeWidth={1} />
          </div>
        )
      }
      {
        data.promo.floatingBadge && (
          <div class="hd-mega__promo-floating">
            <span class="hd-mega__promo-floating-icon" aria-hidden="true">
              <PromoBg size={16} stroke-width={2} />
            </span>
            <span>{data.promo.floatingBadge}</span>
          </div>
        )
      }
    </div>

    <!-- Columns 2-4: link groups -->
    {
      data.columns.map((col) => {
        const ColIcon = icons[col.icon] as any;
        return (
          <section class="hd-mega__col">
            <h3 class="hd-mega__col-title">
              <span class="hd-mega__col-icon" aria-hidden="true">
                <ColIcon size={18} />
              </span>
              {col.title}
            </h3>
            {col.description && <p class="hd-mega__col-desc">{col.description}</p>}
            <ul class="hd-mega__list">
              {col.links.map((link) => (
                <li>
                  <a
                    class="hd-mega__link"
                    href={link.href}
                    aria-current={isActive(link.href, currentPath) ? "page" : undefined}
                  >
                    <span class="hd-mega__link-label">
                      {link.logo && <img class="hd-mega__link-logo" src={link.logo} alt="" loading="lazy" />}
                      <span>{link.label}</span>
                    </span>
                    <ChevronRight class="hd-mega__link-chev" size={16} aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ul>
            <a
              class="hd-mega__more"
              href={col.footer.href}
              aria-current={isActive(col.footer.href, currentPath) ? "page" : undefined}
            >
              <span>{col.footer.label}</span>
              <ArrowRight class="hd-mega__more-arrow" size={15} aria-hidden="true" />
            </a>
          </section>
        );
      })
    }

    <!-- Column 5: support -->
    {
      (() => {
        const SupIcon = icons[data.support.icon] as any;
        return (
          <section class="hd-mega__col">
            <h3 class="hd-mega__col-title">
              <span class="hd-mega__col-icon" aria-hidden="true">
                <SupIcon size={18} />
              </span>
              {data.support.title}
            </h3>
            <div class="hd-mega__support-card">
            <ul class="hd-mega__support">
              {data.support.items.map((item) => {
                const ItemIcon = icons[item.icon] as any;
                return (
                  <li>
                    <a class="hd-mega__support-item" href={item.href ?? "#"}>
                      <span class="hd-mega__support-icon" aria-hidden="true">
                        <ItemIcon size={20} />
                      </span>
                      <span class="hd-mega__support-text">
                        <span class="hd-mega__support-title">{item.title}</span>
                        <span class="hd-mega__support-desc">{item.desc}</span>
                      </span>
                      <ChevronRight class="hd-mega__support-chev" size={16} aria-hidden="true" />
                    </a>
                  </li>
                );
              })}
            </ul>
            </div>
            <a class="hd-mega__more" href={data.support.footer.href}>
              <span>{data.support.footer.label}</span>
              <ArrowRight class="hd-mega__more-arrow" size={15} aria-hidden="true" />
            </a>
          </section>
        );
      })()
    }
  </div>
</div>

<style>
  /* Full-width panel — no card, no radius, spans the viewport */
  .hd-mega {
    /* Single shared floor for every promo panel's height, across all four
       menus (this component is the only mega-menu implementation) —
       "compact but premium": trimmed from a hardcoded 320px as part of an
       across-the-board height pass, named/scoped so future tuning has one
       place to happen rather than per-menu guesswork. */
    --hd-mega-promo-min-h: 280px;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-white);
    border-top: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);

    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition:
      opacity var(--transition-base),
      transform var(--transition-base),
      visibility var(--transition-base);
    pointer-events: none;
  }

  .hd-mega[data-open] {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .hd-mega__inner {
    display: grid;
    /* 35% promo, the remaining ~65% split evenly across all four right-side
       columns (~16.25% each) — the original spacious proportion. A prior
       pass over-narrowed the three discovery columns to 15% to hand the
       support column 20%, which cramped long labels (e.g. "Tinnitus
       (Kulak Çınlaması) Çözümleri"); reverted so every right-side column
       gets its fair, generous share again. */
    grid-template-columns: 35fr 16.25fr 16.25fr 16.25fr 16.25fr;
    gap: var(--space-8);
    /* Trimmed from space-10 — the outer air the whole compact-premium pass
       is aimed at; column gap stays untouched since it's horizontal, not
       part of the panel's height. */
    padding-block: var(--space-8);
    padding-inline: var(--hd-pad);
    align-items: stretch;
  }

  /* ---- Promo ----
     Content is vertically centred (not space-between) so the block reads
     intentionally composed regardless of how tall the row grows to match
     the longest discovery column — space-between was stranding the art in
     an oversized gap on tall rows. The Ear glyph moves out of flow into an
     absolutely-positioned corner watermark, layered under a soft primary
     glow for depth (the same "radial glow, existing tokens" recipe already
     used on Hero/Closing) — one intentional decoration, not a placeholder
     icon plus dead space. */
  .hd-mega__promo {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: var(--hd-mega-promo-min-h);
    /* Trimmed from space-8 — the panel's real height is driven by
       align-items: stretch matching its tallest sibling column, so this
       padding was the gap between the (vertically centred) title/CTA
       block and the panel's own edges; tightening it closes most of the
       "too much air above/below" the screenshot flagged. */
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--color-text);
    color: var(--color-text-inverse);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
    overflow: hidden;
  }

  /* Skipped when a real product photo is present (--has-image) — the photo
     already carries its own glow/light, a second CSS glow on top would just
     muddy it. */
  .hd-mega__promo:not(.hd-mega__promo--has-image)::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(55% 55% at 82% 100%, rgb(37 99 235 / 0.35), transparent 72%);
    pointer-events: none;
  }

  /* ---- Promo photo (İşitme Cihazları only — data.promo.image) ----
     object-fit: contain, never cover: the panel's height is driven by
     whichever sibling column is tallest (align-items: stretch on the grid),
     so its aspect ratio is unpredictable — a `cover` crop could plausibly
     eat into the device on a narrow-but-tall panel. `contain` guarantees
     the full photo, devices included, is always visible; anchoring
     right/bottom keeps the product hugging the corner it already occupies
     in the source photo, and lets any leftover space fall on the left —
     exactly the "boş sol alan" the photo already reserves for this text. */
  .hd-mega__promo-image {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hd-mega__promo-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right bottom;
    display: block;
    transition: transform var(--transition-base);
  }

  /* Very light left-to-right fade in the panel's own bg color — blends the
     photo's own (slightly deeper) navy into the panel background at the
     seams, and reinforces the dark zone the title/CTA sit on. Fully
     transparent by 38%, well before the device itself begins (~40%), so
     the product side is never dimmed. */
  .hd-mega__promo-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--color-text) 0%, rgb(15 23 42 / 0.6) 18%, transparent 38%);
    pointer-events: none;
  }

  /* Same restrained ambient-hover register as the icon variant below —
     a barely-there scale, never a pan/parallax that could hint at motion
     sickness or feel like a "hover effect" rather than quality material. */
  .hd-mega__promo:hover .hd-mega__promo-image img,
  .hd-mega__promo:focus-within .hd-mega__promo-image img {
    transform: scale(1.02);
  }

  .hd-mega__promo-body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }

  /* Small kicker bar above the headline — a purely decorative hierarchy
     cue (no new copy), the same "accent bar" register used elsewhere on
     the site to lead a section's headline. */
  .hd-mega__promo-title::before {
    content: "";
    display: block;
    width: 32px;
    height: 3px;
    margin-bottom: var(--space-4);
    border-radius: var(--radius-full);
    background: var(--color-primary);
  }

  .hd-mega__promo-title {
    /* The sitewide h1–h6 base rule (typography.css) sets a dark
       `color: var(--color-text)` on every heading with no override here —
       on this panel's dark background that rendered the headline
       invisible (same dark tone as the navy behind it). Pre-existing, not
       something this pass introduced, but squarely in scope: fixing it is
       what "strengthen typography hierarchy" requires. */
    color: var(--color-text-inverse);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-3);
  }

  /* Markalar's photo places its logo ring higher and further left (~52%
     of the panel width) than İşitme Cihazları's device (~38-40%, but low
     enough that the title's natural wrap never reaches it) — measured by
     rendering both and comparing the title's right edge against each
     photo's actual content start. Only Markalar's title collided with its
     photo, so only Markalar gets a width cap; İşitme Cihazları keeps its
     natural (already-safe) wrap. Scoped by the DOM id Astro already
     derives from data.id, not a new hardcoded value. */
  #hd-mega-markalar .hd-mega__promo-title {
    max-width: 46%;
  }

  /* İşitme Cihazları never had a title width cap (its device photo hugs
     the corner rather than climbing high like Markalar's ring) — but
     paired with `object-fit: cover` below the photo now reaches the full
     card, so the title needs the same safety cap as its two siblings to
     never run into the device's side of the panel. */
  #hd-mega-cihazlar .hd-mega__promo-title {
    max-width: 50%;
  }

  /* İşitme Cihazları / Markalar / Bilgi Merkezi — premium light-theme promo
     panel, mirroring the recipe already proven on #hd-mega-hizmetler below
     (duplicated per-ID rather than generalized into a shared rule, since
     the hizmetler rules must stay completely untouched). These three keep
     their real product/brand/content photo — only the panel's background
     and text colors move from dark-navy to light, matching the reference. */
  #hd-mega-cihazlar .hd-mega__promo,
  #hd-mega-markalar .hd-mega__promo,
  #hd-mega-bilgi .hd-mega__promo {
    background: linear-gradient(165deg, rgb(37 99 235 / 0.06), var(--color-white) 60%);
    border: 1px solid var(--color-border);
    box-shadow: none;
  }

  #hd-mega-cihazlar .hd-mega__promo-title,
  #hd-mega-markalar .hd-mega__promo-title,
  #hd-mega-bilgi .hd-mega__promo-title {
    color: var(--color-text);
  }

  #hd-mega-cihazlar .hd-mega__promo-text,
  #hd-mega-markalar .hd-mega__promo-text,
  #hd-mega-bilgi .hd-mega__promo-text {
    color: var(--color-text-muted);
  }

  #hd-mega-cihazlar .hd-mega__promo-cta,
  #hd-mega-markalar .hd-mega__promo-cta,
  #hd-mega-bilgi .hd-mega__promo-cta {
    background: var(--color-primary);
    color: var(--color-text-inverse);
  }

  #hd-mega-cihazlar .hd-mega__promo-cta:hover,
  #hd-mega-cihazlar .hd-mega__promo-cta:focus-visible,
  #hd-mega-cihazlar .hd-mega__promo-cta[aria-current="page"],
  #hd-mega-markalar .hd-mega__promo-cta:hover,
  #hd-mega-markalar .hd-mega__promo-cta:focus-visible,
  #hd-mega-markalar .hd-mega__promo-cta[aria-current="page"],
  #hd-mega-bilgi .hd-mega__promo-cta:hover,
  #hd-mega-bilgi .hd-mega__promo-cta:focus-visible,
  #hd-mega-bilgi .hd-mega__promo-cta[aria-current="page"] {
    background: var(--color-primary-hover);
  }

  /* İşitme Cihazları / Markalar photo: was `contain`, which only scales
     to the card's WIDTH — on a card taller than the photo's own aspect
     ratio (the common case once the row stretches to match a 6-7 item
     column) that leaves a band of bare card background above the photo,
     splitting the card into two visually disconnected halves. `cover`
     fills the card fully at every row height instead, so the photo and
     the text column read as one composed panel — matching how Bilgi
     Merkezi's photo (already `cover`, further below) and Hizmetlerimiz's
     illustration (always vertically centred) both behave. */
  #hd-mega-cihazlar .hd-mega__promo-image img,
  #hd-mega-markalar .hd-mega__promo-image img {
    object-fit: cover;
  }

  /* The photo's left-edge fade (base rule, further below) blends into a
     dark panel — on these now-light panels it must fade into white
     instead, or the photo's left edge shows an ugly dark seam. Widened
     from the original dark-panel recipe's 38% cutoff: with the photo now
     `cover`-filling the whole card, the opaque zone has to reach past
     the title's own 46-50% width cap above (plus a soft margin) so dark
     text is never read directly against the bare photo — the previous
     38% cutoff left the photo fully exposed under most of the title. */
  #hd-mega-cihazlar .hd-mega__promo-image::after,
  #hd-mega-markalar .hd-mega__promo-image::after,
  #hd-mega-bilgi .hd-mega__promo-image::after {
    background: linear-gradient(
      90deg,
      var(--color-white) 0%,
      var(--color-white) 46%,
      rgb(255 255 255 / 0.55) 56%,
      transparent 70%
    );
  }

  /* Hizmetlerimiz — premium light-theme promo panel (redesign pass).
     Deliberately the ONLY menu with no photo: no image-generation tool is
     available in this environment and the old dark illustrated graphic
     (mega-menu-hizmetlerimiz.webp) was retired rather than reused, so
     this panel gets a bespoke CSS/SVG illustration (concentric rings +
     an icon tile) instead — real assets or none, never a fabricated
     photo. Every rule here is scoped to #hd-mega-hizmetler; the dark
     panel + photo/Ear-glyph fallback used by the other three menus is
     completely untouched. */
  #hd-mega-hizmetler .hd-mega__promo {
    justify-content: flex-start;
    padding-top: var(--space-5);
    background: linear-gradient(165deg, rgb(37 99 235 / 0.06), var(--color-white) 60%);
    border: 1px solid var(--color-border);
    box-shadow: none;
  }

  #hd-mega-hizmetler .hd-mega__promo::before {
    display: none;
  }

  #hd-mega-hizmetler .hd-mega__promo-body {
    max-width: 60%;
  }

  #hd-mega-hizmetler .hd-mega__promo-title {
    color: var(--color-text);
    max-width: none;
    margin-bottom: var(--space-2);
  }

  #hd-mega-hizmetler .hd-mega__promo-title::before {
    margin-bottom: var(--space-2);
  }

  #hd-mega-hizmetler .hd-mega__promo-text {
    color: var(--color-text-muted);
    max-width: none;
  }

  #hd-mega-hizmetler .hd-mega__promo-cta {
    margin-top: var(--space-4);
    background: var(--color-primary);
    color: var(--color-text-inverse);
  }

  #hd-mega-hizmetler .hd-mega__promo-cta:hover,
  #hd-mega-hizmetler .hd-mega__promo-cta:focus-visible,
  #hd-mega-hizmetler .hd-mega__promo-cta[aria-current="page"] {
    background: var(--color-primary-hover);
  }

  /* Eyebrow badge above the title (data.promo.badge). */
  .hd-mega__promo-badge {
    display: inline-block;
    align-self: flex-start;
    margin: 0 0 var(--space-3);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background: var(--primary-light);
    color: var(--color-primary);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.04em;
  }

  /* Trust checklist under the CTA (data.promo.trustItems) — 2x2, quiet. */
  .hd-mega__promo-trust {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-3);
  }

  .hd-mega__promo-trust li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .hd-mega__promo-trust li svg {
    flex: none;
    color: var(--color-success);
  }

  /* Small real-category pill tags under the CTA (data.promo.tags) — for
     the dark photo-backed panels (İşitme Cihazları today). Semi-transparent
     white so it reads on the dark panel, matching the badge/trust chips'
     restrained register used elsewhere on this component. */
  .hd-mega__promo-tags {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    position: relative;
    z-index: 1;
  }

  .hd-mega__promo-tags li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: var(--radius-full);
    background: rgb(255 255 255 / 0.08);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: rgb(226 235 250 / 0.85);
  }

  /* CSS/SVG illustration — concentric rings + an icon tile, replacing the
     photo region for menus that set `promo.badge` (Hizmetlerimiz only).
     Sized/positioned to fill more of the panel's right side (closer to
     the edge, larger footprint) per the "azalt sağdaki boşluğu" pass —
     the text column's own max-width is untouched, only this element and
     its surrounding air changed. */
  .hd-mega__promo-illustration {
    position: absolute;
    right: 2%;
    top: 50%;
    z-index: 0;
    width: 264px;
    height: 264px;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  /* Faint "frequency lines" behind the rings — a bare-bones technical
     texture (varying-height bars via a repeating gradient), not a full
     graphic asset. Kept extremely subtle so it reads as ambient detail,
     never competes with the rings/icon in front of it. */
  .hd-mega__promo-illustration::before {
    content: "";
    grid-area: 1 / 1;
    width: 100%;
    height: 60%;
    background-image: repeating-linear-gradient(
      90deg,
      rgb(37 99 235 / 0.1) 0 2px,
      transparent 2px 14px
    );
    mask-image: linear-gradient(180deg, transparent, #000 30%, #000 70%, transparent);
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 30%, #000 70%, transparent);
  }

  .hd-mega__promo-ring {
    grid-area: 1 / 1;
    border-radius: 50%;
    border: 1.5px solid rgb(37 99 235 / 0.22);
  }

  .hd-mega__promo-ring--1 {
    width: 106px;
    height: 106px;
    border-color: rgb(37 99 235 / 0.3);
  }

  .hd-mega__promo-ring--2 {
    width: 176px;
    height: 176px;
    border-color: rgb(37 99 235 / 0.18);
  }

  .hd-mega__promo-ring--3 {
    width: 246px;
    height: 246px;
    border-color: rgb(37 99 235 / 0.1);
  }

  .hd-mega__promo-illustration-icon {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: var(--radius-xl);
    background: var(--color-white);
    color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  /* Floating badge card (data.promo.floatingBadge), overlapping the
     illustration's bottom-right corner — sized up and given a border for
     more presence per the "biraz daha belirgin" pass. */
  .hd-mega__promo-floating {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    max-width: 196px;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    box-shadow: var(--shadow-lg);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    line-height: 1.3;
    color: var(--color-text);
  }

  .hd-mega__promo-floating-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    background: var(--primary-light);
    color: var(--color-primary);
    flex: none;
  }

  /* Bilgi Merkezi's photo is requested as a `cover` fill rather than the
     `contain` used by the other three — its own aspect (1536×1024, 1.5:1)
     is close enough to this panel's rendered aspect (~1.59:1 measured at a
     1920px viewport) that a centered cover crop only trims a sliver off
     the top/bottom, never touching the laptop, books, hearing aid or the
     ear sculpture the source explicitly asks to keep intact — so no
     right/bottom anchoring is needed here, unlike the contain variants. */
  #hd-mega-bilgi .hd-mega__promo-image img {
    object-fit: cover;
    object-position: center;
  }

  /* Same shape of problem as Hizmetlerimiz: the photo's content (open book,
     stacked books, glowing ear sculpture) starts much further left than the
     other three photos, so the title/description need a width cap to stay
     clear of it. Measured safe at ~50%/40% against the rendered image. */
  #hd-mega-bilgi .hd-mega__promo-title {
    max-width: 50%;
  }

  #hd-mega-bilgi .hd-mega__promo-text {
    max-width: 40%;
  }

  .hd-mega__promo-text {
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: rgb(226 235 250 / 0.75);
    max-width: 32ch;
    margin: 0;
  }

  .hd-mega__promo-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
    height: 46px;
    padding-inline: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    color: var(--color-text);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.01em;
    text-decoration: none;
    align-self: flex-start;
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base);
  }

  .hd-mega__promo-cta:hover,
  .hd-mega__promo-cta:focus-visible,
  .hd-mega__promo-cta[aria-current="page"] {
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .hd-mega__promo-cta-arrow {
    transition: transform var(--transition-fast);
  }

  .hd-mega__promo-cta:hover .hd-mega__promo-cta-arrow,
  .hd-mega__promo-cta:focus-visible .hd-mega__promo-cta-arrow,
  .hd-mega__promo-cta[aria-current="page"] .hd-mega__promo-cta-arrow {
    transform: translateX(3px);
  }

  .hd-mega__promo-cta:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .hd-mega__promo-art {
    position: absolute;
    right: -28px;
    bottom: -28px;
    z-index: 0;
    color: rgb(255 255 255 / 0.10);
    pointer-events: none;
    transition: color var(--transition-base), transform var(--transition-base);
  }

  /* The ear glyph is decorative only — no hover target of its own. It
     just answers ambiently when the panel itself is engaged with,
     the smallest possible move + a touch more presence, never a
     "graphic that animates". */
  .hd-mega__promo:hover .hd-mega__promo-art,
  .hd-mega__promo:focus-within .hd-mega__promo-art {
    color: rgb(255 255 255 / 0.14);
    transform: translate(-3px, -3px);
  }

  /* ---- Link columns ---- */
  .hd-mega__col {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  /* Hairline rule under every heading — a shared alignment line across
     all four link columns (all columns should align top to bottom) and a
     clear break between heading and list, without boxing the column in a
     card. */
  .hd-mega__col-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    min-height: 32px;
  }

  .hd-mega__col-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    background: var(--primary-light);
    color: var(--color-primary);
    flex: none;
    transition: background-color var(--transition-fast);
  }

  /* Optional one-line column summary (col.description) — only
     Hizmetlerimiz sets this today; other menus simply never render it. */
  .hd-mega__col-desc {
    margin: calc(-1 * var(--space-2)) 0 var(--space-3);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-soft);
  }

  /* The heading itself stays static (it isn't a link) — only the icon
     gets a very restrained emphasis, and it responds to the whole column
     (mouse hover or keyboard focus anywhere inside it), not just the
     heading, so it reads as ambient "you're browsing this category". */
  .hd-mega__col:hover .hd-mega__col-icon,
  .hd-mega__col:focus-within .hd-mega__col-icon {
    background: rgb(37 99 235 / 0.16);
  }

  .hd-mega__list {
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    flex: 1;
  }

  .hd-mega__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    /* Vertical padding trimmed from space-2 — the biggest single lever on
       row height with 6-7 links per column; horizontal padding untouched
       so the hover pill keeps the same width/feel, just a touch shorter. */
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--font-size-md);
    line-height: 1.45;
    letter-spacing: -0.005em;
    color: var(--color-text-muted);
    text-decoration: none;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast),
      transform var(--transition-fast);
  }

  /* Wraps the optional logo + label as one flex group, so .hd-mega__link
     keeps exactly two top-level children (this group + the chevron) and
     `justify-content: space-between` still puts the chevron flush right —
     only Markalar's featured-brand links set `link.logo` today. */
  .hd-mega__link-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .hd-mega__link-logo {
    flex: none;
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .hd-mega__link-chev {
    color: var(--color-text-soft);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast),
      color var(--transition-fast);
    flex: none;
  }

  /* Premium hover: the same light-blue surface used across the panel
     (primary-light, not a neutral grey), text leaning into primary blue
     with a touch more weight, and a short rightward nudge — restrained,
     150ms. Keyboard focus gets the identical treatment (not just a ring)
     so the two input modes feel consistent. */
  .hd-mega__link:hover,
  .hd-mega__link:focus-visible,
  .hd-mega__link[aria-current="page"] {
    color: var(--color-primary);
    background: var(--primary-light);
    font-weight: var(--font-weight-medium);
    transform: translateX(4px);
  }

  .hd-mega__link:hover .hd-mega__link-chev,
  .hd-mega__link:focus-visible .hd-mega__link-chev,
  .hd-mega__link[aria-current="page"] .hd-mega__link-chev {
    color: var(--color-primary);
    opacity: 1;
    transform: translateX(0);
  }

  /* Ring drawn last so it wins over the shared hover treatment above for
     this one property — the a11y signal stays the clearest thing on the
     row, not competing with a decorative shadow. */
  .hd-mega__link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* The column's "see all" link, restyled as one row of a shared footer
     rail: full column width, a hairline top divider, identical across all
     four columns (three discovery + support) so — combined with the
     grid's stretch-aligned row height, which already bottom-anchors every
     one of them at the same baseline — they read as one continuous
     navigation strip rather than four unrelated links. */
  .hd-mega__more {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding: var(--space-3) var(--space-3) var(--space-1);
    border-top: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.01em;
    color: var(--color-primary);
    text-decoration: none;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  /* Stronger than the discovery links (these are destination CTAs) — a
     light-blue fill across the row plus a deepened primary. The arrow
     itself carries the "movement" (transform-only, not a `gap` animation,
     so nothing about the row's own box ever reflows). */
  .hd-mega__more:hover,
  .hd-mega__more:focus-visible,
  .hd-mega__more[aria-current="page"] {
    background: var(--primary-light);
    color: var(--color-primary-hover);
  }

  .hd-mega__more-arrow {
    transition: transform var(--transition-fast);
  }

  .hd-mega__more:hover .hd-mega__more-arrow,
  .hd-mega__more:focus-visible .hd-mega__more-arrow,
  .hd-mega__more[aria-current="page"] .hd-mega__more-arrow {
    transform: translateX(3px);
  }

  .hd-mega__more:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* ---- Support column (title outside, items in a card) ----
     A quieter surface than the discovery columns (kept lighter than the
     main content area on purpose): each row is its own distinct,
     interactive service entry, with a restrained hover — surface lift +
     icon tint + a slight nudge, the same register as the discovery links
     so the whole panel reads as one system, not a heavier competing one. */
  .hd-mega__support-card {
    display: flex;
    flex-direction: column;
    flex: 1;
    margin-bottom: var(--space-3);
    padding: var(--space-2);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
  }

  .hd-mega__support {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .hd-mega__support-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    /* Vertical padding trimmed to match the discovery links' proportion;
       horizontal untouched (keeps the icon/text/chevron rhythm intact). */
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      transform var(--transition-fast);
  }

  /* A "premium service selector": more noticeable than the discovery
     links (a light-blue fill instead of white, the icon deepens toward
     primary and lifts slightly) but still restrained — the icon stays
     white so it keeps reading against the now-tinted row. */
  .hd-mega__support-item:hover,
  .hd-mega__support-item:focus-visible {
    background: var(--primary-light);
    transform: translateX(3px);
  }

  .hd-mega__support-item:hover .hd-mega__support-icon,
  .hd-mega__support-item:focus-visible .hd-mega__support-icon {
    color: var(--color-primary-hover);
    box-shadow: var(--shadow-xs);
  }

  .hd-mega__support-item:hover .hd-mega__support-desc,
  .hd-mega__support-item:focus-visible .hd-mega__support-desc {
    color: var(--color-text-muted);
  }

  .hd-mega__support-item:hover .hd-mega__support-chev,
  .hd-mega__support-item:focus-visible .hd-mega__support-chev {
    opacity: 1;
    transform: translateX(0);
  }

  .hd-mega__support-item:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .hd-mega__support-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-lg);
    background: var(--color-white);
    color: var(--color-primary);
    flex: none;
    transition: color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .hd-mega__support-text {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    line-height: 1.25;
  }

  .hd-mega__support-title {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .hd-mega__support-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-soft);
    transition: color var(--transition-fast);
  }

  /* Optional trailing arrow (same reveal recipe as the discovery links'
     chevron) — always in the DOM/flow at its full size, just invisible at
     rest, so the row's width/text area is identical before and after
     hover: nothing shifts. */
  .hd-mega__support-chev {
    color: var(--color-primary);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--transition-fast), transform var(--transition-fast);
    flex: none;
  }

  /* Hizmetlerimiz — "Hızlı Erişim" as 4 individual pastel cards instead of
     one unified list card. Markup is untouched (still one <ul><li> list);
     every rule below is scoped to #hd-mega-hizmetler, so the other three
     menus' support column keeps its existing unified-card look exactly
     as before. */
  #hd-mega-hizmetler .hd-mega__support-card {
    background: transparent;
    padding: 0;
  }

  #hd-mega-hizmetler .hd-mega__support {
    gap: var(--space-3);
  }

  #hd-mega-hizmetler .hd-mega__support-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--hd-support-tint, var(--color-surface));
    box-shadow: var(--shadow-xs);
    padding: var(--space-4);
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  #hd-mega-hizmetler .hd-mega__support-item:hover,
  #hd-mega-hizmetler .hd-mega__support-item:focus-visible {
    transform: translateY(-2px);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  /* Very light per-card pastel tint, in list order — no data-schema
     change needed, the order (Randevu Al/Bizi Arayın/Merkezimiz/SGK) is
     already fixed in header.data.ts. */
  #hd-mega-hizmetler .hd-mega__support li:nth-child(1) .hd-mega__support-item {
    --hd-support-tint: rgb(37 99 235 / 0.06);
  }
  #hd-mega-hizmetler .hd-mega__support li:nth-child(2) .hd-mega__support-item {
    --hd-support-tint: rgb(22 163 74 / 0.06);
  }
  #hd-mega-hizmetler .hd-mega__support li:nth-child(3) .hd-mega__support-item {
    --hd-support-tint: rgb(217 119 6 / 0.06);
  }
  #hd-mega-hizmetler .hd-mega__support li:nth-child(4) .hd-mega__support-item {
    --hd-support-tint: rgb(124 58 237 / 0.06);
  }

  #hd-mega-hizmetler .hd-mega__support-icon {
    background: var(--color-white);
    box-shadow: var(--shadow-xs);
  }

  /* The chevron becomes an always-visible circular arrow button (reference
     shows a solid circle, not a hover-reveal chevron). */
  #hd-mega-hizmetler .hd-mega__support-chev {
    opacity: 1;
    transform: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-white);
    color: var(--color-primary);
    box-shadow: var(--shadow-xs);
    transition: transform var(--transition-fast), background-color var(--transition-fast), color var(--transition-fast);
  }

  #hd-mega-hizmetler .hd-mega__support-item:hover .hd-mega__support-chev,
  #hd-mega-hizmetler .hd-mega__support-item:focus-visible .hd-mega__support-chev {
    transform: translateX(2px);
    background: var(--color-primary);
    color: var(--color-text-inverse);
  }

  /* İşitme Cihazları / Markalar / Bilgi Merkezi — support column as 4
     individual pastel cards, mirroring the #hd-mega-hizmetler pattern
     above rule-for-rule (duplicated per-ID, not generalized, so the
     hizmetler rules stay completely untouched). Markup is unchanged —
     still one <ul><li> list per menu. */
  #hd-mega-cihazlar .hd-mega__support-card,
  #hd-mega-markalar .hd-mega__support-card,
  #hd-mega-bilgi .hd-mega__support-card {
    background: transparent;
    padding: 0;
  }

  #hd-mega-cihazlar .hd-mega__support,
  #hd-mega-markalar .hd-mega__support,
  #hd-mega-bilgi .hd-mega__support {
    gap: var(--space-3);
  }

  #hd-mega-cihazlar .hd-mega__support-item,
  #hd-mega-markalar .hd-mega__support-item,
  #hd-mega-bilgi .hd-mega__support-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--hd-support-tint, var(--color-surface));
    box-shadow: var(--shadow-xs);
    padding: var(--space-4);
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  #hd-mega-cihazlar .hd-mega__support-item:hover,
  #hd-mega-cihazlar .hd-mega__support-item:focus-visible,
  #hd-mega-markalar .hd-mega__support-item:hover,
  #hd-mega-markalar .hd-mega__support-item:focus-visible,
  #hd-mega-bilgi .hd-mega__support-item:hover,
  #hd-mega-bilgi .hd-mega__support-item:focus-visible {
    transform: translateY(-2px);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  /* Same blue/green/amber/purple pastel sequence, in list order, on all
     three menus. */
  #hd-mega-cihazlar .hd-mega__support li:nth-child(1) .hd-mega__support-item,
  #hd-mega-markalar .hd-mega__support li:nth-child(1) .hd-mega__support-item,
  #hd-mega-bilgi .hd-mega__support li:nth-child(1) .hd-mega__support-item {
    --hd-support-tint: rgb(37 99 235 / 0.06);
  }
  #hd-mega-cihazlar .hd-mega__support li:nth-child(2) .hd-mega__support-item,
  #hd-mega-markalar .hd-mega__support li:nth-child(2) .hd-mega__support-item,
  #hd-mega-bilgi .hd-mega__support li:nth-child(2) .hd-mega__support-item {
    --hd-support-tint: rgb(22 163 74 / 0.06);
  }
  #hd-mega-cihazlar .hd-mega__support li:nth-child(3) .hd-mega__support-item,
  #hd-mega-markalar .hd-mega__support li:nth-child(3) .hd-mega__support-item,
  #hd-mega-bilgi .hd-mega__support li:nth-child(3) .hd-mega__support-item {
    --hd-support-tint: rgb(217 119 6 / 0.06);
  }
  #hd-mega-cihazlar .hd-mega__support li:nth-child(4) .hd-mega__support-item,
  #hd-mega-markalar .hd-mega__support li:nth-child(4) .hd-mega__support-item,
  #hd-mega-bilgi .hd-mega__support li:nth-child(4) .hd-mega__support-item {
    --hd-support-tint: rgb(124 58 237 / 0.06);
  }

  #hd-mega-cihazlar .hd-mega__support-icon,
  #hd-mega-markalar .hd-mega__support-icon,
  #hd-mega-bilgi .hd-mega__support-icon {
    background: var(--color-white);
    box-shadow: var(--shadow-xs);
  }

  #hd-mega-cihazlar .hd-mega__support-chev,
  #hd-mega-markalar .hd-mega__support-chev,
  #hd-mega-bilgi .hd-mega__support-chev {
    opacity: 1;
    transform: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-white);
    color: var(--color-primary);
    box-shadow: var(--shadow-xs);
    transition: transform var(--transition-fast), background-color var(--transition-fast), color var(--transition-fast);
  }

  #hd-mega-cihazlar .hd-mega__support-item:hover .hd-mega__support-chev,
  #hd-mega-cihazlar .hd-mega__support-item:focus-visible .hd-mega__support-chev,
  #hd-mega-markalar .hd-mega__support-item:hover .hd-mega__support-chev,
  #hd-mega-markalar .hd-mega__support-item:focus-visible .hd-mega__support-chev,
  #hd-mega-bilgi .hd-mega__support-item:hover .hd-mega__support-chev,
  #hd-mega-bilgi .hd-mega__support-item:focus-visible .hd-mega__support-chev {
    transform: translateX(2px);
    background: var(--color-primary);
    color: var(--color-text-inverse);
  }

  /* Promo is the most important area — it is preserved, not hidden.
     Ratios scale down gently as the viewport narrows. */
  @media (max-width: 1439px) {
    .hd-mega__inner {
      grid-template-columns: 31fr 17.25fr 17.25fr 17.25fr 17.25fr;
    }
  }

  @media (max-width: 1279px) {
    .hd-mega__inner {
      grid-template-columns: 29fr 17.75fr 17.75fr 17.75fr 17.75fr;
      gap: var(--space-6);
    }
  }

  /* Guarantees the three discovery-column footer CTAs ("Değerlendirme
     Hizmetleri" / "Uygulama Hizmetleri" / "Servis Hizmetleri") never wrap
     to a second line — a 2-line footer breaks the shared bottom-aligned
     baseline the three columns are meant to share (margin-top:auto on
     .hd-mega__more, grid stretch on the row). Scoped so other menus'
     footer labels (which may legitimately be longer) keep wrapping if
     they need to. */
  #hd-mega-hizmetler .hd-mega__col .hd-mega__more {
    white-space: nowrap;
  }

  /* Hizmetlerimiz's own grid ratios (35/45/20, matching the reference
     layout's more generous "Hızlı Erişim" column) — scoped so the other
     three menus keep their existing 35/65-split-four-ways ratios at every
     breakpoint. */
  #hd-mega-hizmetler .hd-mega__inner {
    grid-template-columns: 35fr 15fr 15fr 15fr 20fr;
  }

  @media (max-width: 1439px) {
    #hd-mega-hizmetler .hd-mega__inner {
      grid-template-columns: 32fr 15.5fr 15.5fr 15.5fr 21.5fr;
    }
  }

  @media (max-width: 1279px) {
    #hd-mega-hizmetler .hd-mega__inner {
      grid-template-columns: 29fr 16fr 16fr 16fr 23fr;
    }
  }

  /* İşitme Cihazları / Markalar / Bilgi Merkezi — same 35/45/20-ish

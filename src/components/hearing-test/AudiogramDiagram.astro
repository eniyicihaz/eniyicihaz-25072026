---
// AudiogramDiagram — SCHEMATIC, EMPTY audiogram that explains how to read one.
// It plots NO result: no curve, no measured points — only the axes (frequency in
// Hz across, hearing level in dB HL down, 0 dB at the top), the standard
// degree bands and the symbol legend (right ear ○, left ear ×). Drawn as inline
// SVG so it is crisp at any width, accessible (role="img" + title/desc + a
// visible figcaption) and its labels are real, crawlable text. It never
// represents a person's test result (PRINCIPLES.md §5: no fabricated medical data).
//
// Two layouts of the SAME data are rendered and CSS shows one of them:
//   desktop (≥641px) → wide 720×490 drawing;
//   mobile  (≤640px) → narrower 400×560 drawing with larger relative type, so band labels,
//                      axis titles and BOTH ear symbols are readable without any sideways scrolling.
// The hidden one is display:none, so assistive tech only ever sees one graphic.
//
// All copy and the degree bands come from data (src/data/ucretsiz-isitme-testi/
// results.ts) so the component holds no content of its own.
export interface AudiogramBand {
  label: string;
  /** dB HL range shown in the label, e.g. "26–40 dB". */
  range: string;
  from: number;
  to: number;
  /** 0 = lightest … 5 = strongest tint. */
  tone: 0 | 1 | 2 | 3 | 4 | 5;
}

export interface AudiogramContent {
  title: string;
  description: string;
  caption: string;
  freqs: number[];
  freqAxisLabel: string;
  lowLabel: string;
  highLabel: string;
  dbAxisLabel: string;
  dbTicks: number[];
  dbMin: number;
  dbMax: number;
  bands: AudiogramBand[];
  legend: { right: string; left: string };
  topNote: string;
  bottomNote: string;
}

interface Props {
  data: AudiogramContent;
}

const { data } = Astro.props;

const span = data.dbMax - data.dbMin;
const tint = ["#ffffff", "#eef4ff", "#dce8ff", "#c8dbfd", "#b3cbf8", "#9dbcf1"];

// One layout = plot box + a few positions. Everything else derives from it.
const makeLayout = (key: "desktop" | "mobile") => {
  const m = key === "mobile";
  const L = m ? 58 : 84;
  const R = m ? 388 : 700;
  const T = m ? 84 : 88;
  const B = m ? T + span * 3 : 418;
  const W = m ? 400 : 720;
  const H = B + (m ? 96 : 72);
  return {
    key,
    W,
    H,
    L,
    R,
    T,
    B,
    x: (i: number) => L + ((R - L) / (data.freqs.length - 1)) * i,
    y: (db: number) => T + ((db - data.dbMin) / span) * (B - T),
    freqTitleY: m ? 20 : 24,
    hintY: m ? 42 : 52,
    freqTickY: T - (m ? 10 : 12),
    dbTitleX: m ? 14 : 20,
    tickDy: m ? 5 : 6,
    labelDy: m ? 5 : 6,
    labelInset: m ? 6 : 8,
  };
};
const layouts = [makeLayout("desktop"), makeLayout("mobile")];
---

<figure class="audiogram">
  {
    layouts.map((g) => (
      <svg
        class={`audiogram__svg audiogram__svg--${g.key}`}
        viewBox={`0 0 ${g.W} ${g.H}`}
        role="img"
        aria-labelledby={`audiogram-title-${g.key} audiogram-desc-${g.key}`}
        preserveAspectRatio="xMidYMid meet"
      >
        <title id={`audiogram-title-${g.key}`}>{data.title}</title>
        <desc id={`audiogram-desc-${g.key}`}>{data.description}</desc>

        {/* degree bands (fills only; labels are drawn after the grid so grid lines never strike through them) */}
        {data.bands.map((b) => <rect x={g.L} y={g.y(b.from)} width={g.R - g.L} height={g.y(b.to) - g.y(b.from)} fill={tint[b.tone]} />)}

        {/* grid: dB lines */}
        {
          data.dbTicks.map((t) => (
            <g>
              <line x1={g.L} x2={g.R} y1={g.y(t)} y2={g.y(t)} class="audiogram__grid" />
              <text x={g.L - 8} y={g.y(t) + g.tickDy} text-anchor="end" class="audiogram__tick">{t}</text>
            </g>
          ))
        }

        {/* grid: frequency lines */}
        {
          data.freqs.map((f, i) => (
            <g>
              <line x1={g.x(i)} x2={g.x(i)} y1={g.T} y2={g.B} class="audiogram__grid audiogram__grid--v" />
              <text x={g.x(i)} y={g.freqTickY} text-anchor="middle" class="audiogram__tick">{f}</text>
            </g>
          ))
        }

        <rect x={g.L} y={g.T} width={g.R - g.L} height={g.B - g.T} fill="none" class="audiogram__frame" />

        {/* degree labels */}
        {
          data.bands.map((b) => (
            <text
              x={g.R - g.labelInset}
              y={(g.y(b.from) + g.y(b.to)) / 2 + g.labelDy}
              text-anchor="end"
              class="audiogram__band-label"
              style={`stroke:${tint[b.tone]}`}
            >
              {b.label} · {b.range}
            </text>
          ))
        }

        {/* axis labels */}
        <text x={(g.L + g.R) / 2} y={g.freqTitleY} text-anchor="middle" class="audiogram__axis">{data.freqAxisLabel}</text>
        <text x={g.L} y={g.hintY} text-anchor="start" class="audiogram__hint">← {data.lowLabel}</text>
        <text x={g.R} y={g.hintY} text-anchor="end" class="audiogram__hint">{data.highLabel} →</text>
        <text transform={`translate(${g.dbTitleX} ${(g.T + g.B) / 2}) rotate(-90)`} text-anchor="middle" class="audiogram__axis">{data.dbAxisLabel}</text>
        <text x={g.L} y={g.B + 28} text-anchor="start" class="audiogram__hint">↑ {data.topNote}</text>
        <text x={g.L} y={g.B + 50} text-anchor="start" class="audiogram__hint">↓ {data.bottomNote}</text>

        {/* legend: symbols only (no plotted result). Desktop: to the right of the notes; mobile: own row below them. */}
        <g transform={g.key === "mobile" ? `translate(${g.L} ${g.B + 80})` : `translate(${g.L + 300} ${g.B + 40})`}>
          <circle cx="10" cy="0" r="9" fill="none" class="audiogram__sym audiogram__sym--right" />
          <text x="28" y="6" class="audiogram__legend">{data.legend.right}</text>
          <g transform={g.key === "mobile" ? "translate(150 0)" : "translate(200 0)"}>
            <line x1="1" y1="-9" x2="19" y2="9" class="audiogram__sym audiogram__sym--left" />
            <line x1="19" y1="-9" x2="1" y2="9" class="audiogram__sym audiogram__sym--left" />
            <text x="28" y="6" class="audiogram__legend">{data.legend.left}</text>
          </g>
        </g>
      </svg>
    ))
  }
  <figcaption class="audiogram__caption">{data.caption}</figcaption>
</figure>

<style>
  .audiogram {
    margin: 0;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background: var(--color-background);
  }

  .audiogram__svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .audiogram__svg--mobile {
    display: none;
  }

  .audiogram__grid {
    stroke: #c7d2e6;
    stroke-width: 1;
  }

  .audiogram__grid--v {
    stroke-dasharray: 3 4;
  }

  .audiogram__frame {
    stroke: #64748b;
    stroke-width: 1.5;
  }

  .audiogram__tick {
    font-size: 17px;
    fill: #475569;
    font-family: inherit;
  }

  .audiogram__axis {
    font-size: 18px;
    font-weight: 600;
    fill: #0f172a;
    font-family: inherit;
  }

  .audiogram__hint {
    font-size: 15px;
    fill: #64748b;
    font-family: inherit;
  }

  .audiogram__band-label {
    paint-order: stroke;
    stroke-width: 5px;
    stroke-linejoin: round;
    font-size: 15px;
    font-weight: 600;
    fill: #1e3a8a;
    font-family: inherit;
  }

  .audiogram__legend {
    font-size: 17px;
    fill: #0f172a;
    font-family: inherit;
  }

  .audiogram__sym {
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .audiogram__sym--right {
    stroke: #dc2626;
  }

  .audiogram__sym--left {
    stroke: #2563eb;
  }

  .audiogram__caption {
    margin: var(--space-3) 0 0;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  /* Mobile drawing: 400-unit wide viewBox shown at ~340px, so ~0.85 scale; sizes below are in viewBox units. */
  @media (max-width: 640px) {
    .audiogram {
      padding: var(--space-2);
    }

    .audiogram__svg--desktop {
      display: none;
    }

    .audiogram__svg--mobile {
      display: block;
    }

    .audiogram__svg--mobile .audiogram__tick {
      font-size: 13px;
    }

    .audiogram__svg--mobile .audiogram__axis {
      font-size: 14px;
    }

    .audiogram__svg--mobile .audiogram__hint {
      font-size: 12px;
    }

    .audiogram__svg--mobile .audiogram__band-label {
      font-size: 13px;
      stroke-width: 4px;
    }

    .audiogram__svg--mobile .audiogram__legend {
      font-size: 14px;
    }
  }
</style>

---
// ContactDock — persistent contact actions (research report R1).
//   • Below 1024 px: a fixed bottom bar with three equal 56 px actions: Ara · WhatsApp · Yol tarifi. It keeps the
//     main number one tap away on every page (mobile is ~64–79 % of the traffic). The bar publishes its own height
//     as `--dock-h` so the page gets matching bottom padding and the consent banner stacks above it.
//   • From 1024 px: a small floating pair (WhatsApp + Ara) in the bottom-right corner.
// Only the main number is used (MASTER_PLAN K2); the directions link is the verified Business Profile link.
// No new analytics: clicks are classified by href (tel: / wa.me / maps) by lib/consent/events.ts, and
// `data-track-location` names this surface "contact_dock". Nothing is sent without consent.
import { Phone, Navigation } from "lucide-astro";
import WhatsAppIcon from "../../shared/WhatsAppIcon/WhatsAppIcon.astro";
import { contactConfig } from "../../../config/contact";
import { company } from "../../footer/Footer/data/company";
---

<aside class="contact-dock" aria-label="Hızlı iletişim" data-contact-dock data-track-location="contact_dock">
  {/* Ara düğmesi iki satırdır: üstte etiket, altta küçük "23:59'a kadar" (telefonla ulaşılabilirlik — merkez saati
      değildir). Düğme yüksekliği DEĞİŞMEZ (52 px), dolayısıyla --dock-h ve çerez bandının konumu da değişmez.
      Etiket ayrı satırda kaldığı için ölçümdeki cta_label eskisi gibidir ("Ara" / "Bizi Arayın"). */}
  <a class="contact-dock__btn contact-dock__btn--call" href={contactConfig.phone.href}>
    <Phone size={22} aria-hidden="true" />
    <span class="contact-dock__stack">
      <span class="contact-dock__label contact-dock__label--short">Ara</span>
      <span class="contact-dock__label contact-dock__label--long">Bizi Arayın</span>
      <span class="contact-dock__until">{contactConfig.phoneReach.untilLabel}</span>
    </span>
    <span class="contact-dock__sr"> {contactConfig.phone.display}</span>
  </a>
  <a class="contact-dock__btn contact-dock__btn--wa" href={contactConfig.whatsapp.href} aria-label="WhatsApp'tan yazın">
    <WhatsAppIcon size={22} class="contact-dock__wa-icon" />
    <span class="contact-dock__label contact-dock__label--short">WhatsApp</span>
    <span class="contact-dock__label contact-dock__label--long">WhatsApp'tan Yazın</span>
  </a>
  <a class="contact-dock__btn contact-dock__btn--map" href={company.directionsHref} aria-label="Yol tarifi al" target="_blank" rel="noopener">
    <Navigation size={22} aria-hidden="true" />
    <span class="contact-dock__label">Yol tarifi</span>
  </a>
</aside>

<script>
  // Büyük yazı (Android "büyük yazı", tarayıcı yazı boyutu, sitedeki A+ ayarı) altında üç düğme yan yana sığmayabilir:
  // taşma görülürse çubuk "geniş" düzene (data-roomy: simge üstte/etiket altta, "23:59'a kadar" gerekirse alt satıra sarar) geçer
  // ve gerçek yüksekliğini --dock-h olarak yayınlar (gövde boşluğu ve yüzen düğmeler çubuğun altında kalmasın).
  // Varsayılan yazı boyutunda hiçbir şey değişmez: taşma yoksa nitelik hiç eklenmez, --dock-h CSS'teki 68 px olarak kalır.
  const dock = document.querySelector<HTMLElement>("[data-contact-dock]");
  if (dock) {
    const root = document.documentElement;
    const mq = window.matchMedia("(max-width: 1023px)");
    const overflows = (): boolean =>
      [...dock.querySelectorAll<HTMLElement>("a")].some((a) => {
        const r = a.getBoundingClientRect();
        return [...a.querySelectorAll<HTMLElement>("*")].some((k) => {
          if (k.classList.contains("contact-dock__sr")) return false;
          const q = k.getBoundingClientRect();
          return q.width > 0 && (q.right > r.right + 0.5 || q.left < r.left - 0.5);
        });
      });
    let raf = 0;
    const measure = () => {
      raf = 0;
      if (!mq.matches) {
        delete dock.dataset.roomy;
        root.style.removeProperty("--dock-h");
        return;
      }
      delete dock.dataset.roomy;
      root.style.removeProperty("--dock-h");
      if (root.dataset.a11yText || overflows()) dock.dataset.roomy = "";
      // Gerçek yükseklik yalnızca geniş düzende yayınlanır (varsayılanda CSS değeri geçerli kalır).
      const h = Math.ceil(dock.getBoundingClientRect().height);
      if (dock.dataset.roomy !== undefined) root.style.setProperty("--dock-h", `${h}px`);
    };
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(measure);
    };
    window.addEventListener("resize", schedule, { passive: true });
    new MutationObserver(schedule).observe(root, { attributes: true, attributeFilter: ["data-a11y-text"] });
    document.fonts?.ready.then(schedule);
    schedule();
  }
</script>

<style is:global>
  /* Mobile: reserve the bar's height so no content (footer, last CTA) ends up underneath it. */
  @media (max-width: 1023px) {
    :root {
      --dock-h: calc(68px + env(safe-area-inset-bottom, 0px));
    }
    body {
      padding-bottom: var(--dock-h);
    }
  }
</style>

<style>
  .contact-dock {
    position: fixed;
    z-index: var(--z-fixed);
    display: grid;
  }

  .contact-dock__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 52px;
    border: 1px solid var(--color-border-hover);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    color: var(--color-text);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--transition-base),
      border-color var(--transition-base),
      transform var(--transition-base);
  }

  .contact-dock__btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .contact-dock__btn--call {
    background: var(--color-primary);
    border-color: var(--color-primary-hover);
    color: var(--color-text-inverse);
  }
  .contact-dock__btn--call:hover {
    background: var(--color-primary-hover);
  }

  .contact-dock__btn--wa:hover,
  .contact-dock__btn--map:hover {
    background: var(--color-surface);
  }
  .contact-dock :global(.contact-dock__wa-icon) {
    color: #25d366;
    flex: none;
  }

  .contact-dock__btn--map {
    background: var(--color-primary-50);
    border-color: var(--color-primary-100);
    color: var(--color-primary);
  }
  .contact-dock__btn--map:hover {
    background: var(--color-primary-100);
  }

  .contact-dock__label--long {
    display: none;
  }

  /* Ara düğmesinin iki satırı: etiket + "23:59'a kadar". */
  .contact-dock__stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    min-width: 0;
  }

  .contact-dock__until {
    font-size: 0.75rem;
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
    color: rgb(255 255 255 / 0.95);
  }

  /* Erişilebilir ad = görünen metin + numara (WCAG 2.5.3 "Label in Name"); numara yalnızca ekran okuyucuya. */
  .contact-dock__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ---- Mobile / tablet bar ---- */
  @media (max-width: 1023px) {
    .contact-dock {
      inset: auto 0 0 0;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-2);
      padding: var(--space-2) var(--space-3) max(var(--space-2), env(safe-area-inset-bottom));
      background: rgb(255 255 255 / 0.96);
      border-top: 1px solid var(--color-border-hover);
      box-shadow: 0 -8px 24px -12px rgb(var(--brand-navy-deep-rgb) / 0.25);
      backdrop-filter: blur(6px);
    }
    .contact-dock__btn {
      min-height: 52px;
      padding-inline: var(--space-2);
      font-size: var(--font-size-sm);
    }
  }

  @media (max-width: 420px) {
    .contact-dock {
      gap: 6px;
      padding-inline: 8px;
    }
    .contact-dock__btn {
      gap: 6px;
      padding-inline: 4px;
    }
    .contact-dock__btn :global(svg) {
      width: 20px;
      height: 20px;
    }
  }

  @media (max-width: 369px) {
    /* ≤ 369 px: "Ara" + "23:59'a kadar" iki satırı simgeyle birlikte sütuna sığmıyordu (ölçüm: 320 ve 360 px'te
       içerik taşıyordu). Yalnızca bu düğmede simge gizlenir, metin ortalanır; düğme "Ara" etiketini ve 23:59 bilgisini
       korur, WhatsApp ve Yol tarifi aynen kalır. Erişilebilir ad değişmez (simge zaten aria-hidden). */
    .contact-dock__btn--call > svg {
      display: none;
    }
    .contact-dock__btn--call .contact-dock__stack {
      align-items: center;
    }
  }

  @media (max-width: 359px) {
    /* Üç eşit sütunda "WhatsApp" düğmesi (simge + yazı ≈ 106 px) 97 px'lik sütuna sığmıyor, simge kenarlığa
       biniyordu (ölçüm: 320 px). Sütunlar içerik uzunluğuyla orantılanır. Ara düğmesi artık "23:59'a kadar"
       satırını da taşıdığı için eskisinden geniştir (0.72fr → 1fr); yer açmak için en dar ekranda simgeler 18 px'e
       iner ve iç boşluklar daralır. */
    .contact-dock {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr) minmax(0, 1fr);
      gap: 4px;
      padding-inline: 6px;
    }
    .contact-dock__btn {
      gap: 4px;
      padding-inline: 2px;
    }
    .contact-dock__btn :global(svg) {
      width: 18px;
      height: 18px;
    }
    .contact-dock__label {
      font-size: var(--font-size-xs);
    }
    .contact-dock__until {
      font-size: 0.6875rem;
    }
  }

  /* ---- Geniş (büyük yazı) düzeni: script taşma görünce data-roomy ekler; sitedeki A+ ayarı (data-a11y-text) da bunu açar ----
     Simge üstte/etiket altta; Ara düğmesinde simge gizlenir ve "23:59'a kadar" gerekirse iki satıra sarar (satır başı
     "23:59'a" / "kadar"), böylece metin düğmenin dışına taşmaz. Sütun oranları a11y-prefs.css ile aynıdır. */
  @media (max-width: 1023px) {
    .contact-dock[data-roomy] {
      grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.28fr) minmax(0, 1.1fr);
    }
    .contact-dock[data-roomy] .contact-dock__btn {
      flex-direction: column;
      gap: 4px;
      padding-inline: 2px;
      min-height: 68px;
      font-size: var(--font-size-sm);
      line-height: 1.15;
    }
    .contact-dock[data-roomy] .contact-dock__btn--call > svg {
      display: none;
    }
    .contact-dock[data-roomy] .contact-dock__stack {
      align-items: center;
    }
    .contact-dock[data-roomy] .contact-dock__until {
      white-space: normal;
      text-align: center;
      line-height: 1.15;
      font-size: 0.6875rem;
    }
  }

  /* ---- Desktop: small floating pair ---- */
  @media (min-width: 1024px) {
    .contact-dock__label--long {
      display: inline;
    }
    .contact-dock {
      right: var(--space-5);
      bottom: var(--space-5);
      gap: var(--space-2);
    }
    .contact-dock__btn {
      padding-inline: var(--space-5);
      min-height: 52px;
      box-shadow: var(--shadow-lg);
    }
    .contact-dock__btn--map {
      display: none;
    }
    .contact-dock__btn:hover {
      transform: translateY(-2px);
    }
    .contact-dock__label--short {
      display: none;
    }
  }

  @media (min-width: 1024px) and (max-height: 560px) {
    .contact-dock {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-dock__btn {
      transition: none;
    }
    .contact-dock__btn:hover {
      transform: none;
    }
  }

  @media print {
    .contact-dock {
      display: none;
    }
  }
</style>

---
// Closing — "Bir konuşmayla başlayalım." The homepage's only closing/CTA
// section (CLOSING_SPECIFICATION.md — architecture decision: FooterCta is
// removed, its glow/grain visual recipe migrates here unchanged).
// Spec: docs/CLOSING_SPECIFICATION.md · DNA: PRINCIPLES §1 · Visual: DESIGN_SYSTEM §6.
import CtaButton from "../../shared/CtaButton/CtaButton.astro";
import { closing } from "./closing.data";
---

<section class="closing" aria-labelledby="closing-title">
  <div class="closing__inner" data-rise>
    <h2 class="closing__message" id="closing-title">{closing.message}</h2>

    <p class="closing__supporting">{closing.supportingSentence}</p>

    <div class="closing__actions">
      <CtaButton label={closing.cta.label} href={closing.cta.href} />

      <p class="closing__secondary">
        {closing.secondaryContact.lead}{" "}
        <a class="closing__phone" href={closing.secondaryContact.href}>
          {closing.secondaryContact.label}
        </a>
      </p>
    </div>

    <p class="closing__reassurance">{closing.reassurance}</p>
  </div>
</section>

<script is:inline>
  (function () {
    var section = document.querySelector(".closing");
    if (!section) return;
    if (!("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    // Single-shot entrance — same shared IntersectionObserver + failsafe +
    // reduced-motion pattern as every other section on the page. If this
    // script never runs, the section renders fully visible.
    section.dataset.anim = "pending";

    var revealed = false;
    var ioAlive = false;
    var io;

    function reveal() {
      if (revealed) return;
      revealed = true;
      section.dataset.anim = "in";
      if (io) io.disconnect();
    }

    var failsafe = setTimeout(function () {
      if (!ioAlive) reveal();
    }, 1500);

    io = new IntersectionObserver(
      function (entries) {
        ioAlive = true;
        clearTimeout(failsafe);
        if (entries[0].isIntersecting) reveal();
      },
      { threshold: 0.15 }
    );

    io.observe(section);
  })();
</script>

<style>
  .closing {
    position: relative;
    isolation: isolate;
    /* Lifts the panel above the dark Footer that follows so its shadow
       falls onto the dark surface instead of being painted over — migrated
       from FooterCta unchanged. */
    z-index: 1;
    /* The last stretch cools to the surface tone, so the hand-off to the
       dark footer is a settle rather than a cut — migrated from FooterCta. */
    background:
      linear-gradient(to bottom, transparent 72%, var(--color-surface)),
      var(--color-background);
    box-shadow: 0 24px 48px -24px rgb(15 23 42 / 0.45);
    color: var(--color-text);
    padding-block: var(--space-24) var(--space-20);
    --closing-ease: cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Layer 1 — brand glow + dotted grid, both barely there. Migrated from
     FooterCta unchanged (§3/§6): no new visual language. Own compositor
     layer: the mask-image below is expensive to recompute on every
     scroll-driven repaint otherwise. */
  .closing::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    will-change: transform;
    background:
      radial-gradient(
        60% 45% at 30% 0%,
        rgb(37 99 235 / 0.06),
        transparent 70%
      ),
      radial-gradient(
        50% 40% at 92% 8%,
        rgb(37 99 235 / 0.04),
        transparent 72%
      ),
      radial-gradient(
        circle,
        rgb(15 23 42 / 0.055) 1px,
        transparent 1px
      );
    background-size:
      auto,
      auto,
      24px 24px;
    /* Fades the dots out at the edges so the texture never reads as a block. */
    mask-image: radial-gradient(75% 65% at 50% 30%, #000 40%, transparent 100%);
  }

  /* Layer 2 — film grain. Migrated from FooterCta unchanged: small
     repeating tile (not stretched across the section), so it rasterizes
     once cheaply instead of on every scroll repaint (Hero's performance
     lesson). will-change promotes it to its own layer. */
  .closing::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.03;
    pointer-events: none;
    will-change: transform;
    background-image: var(--texture-grain);
    background-size: 220px 220px;
    background-repeat: repeat;
  }

  .closing__inner {
    position: relative;
    z-index: 1;
    max-width: var(--container-lg);
    margin-inline: auto;
    padding-inline: var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-6);
  }

  /* Display type, deliberately smaller than Hero's headline scale — this
     section is warm but never louder than Hero (spec §3/§6). */
  .closing__message {
    margin: 0;
    font-size: clamp(2rem, 1.6rem + 1.6vw, 3rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-wrap: balance;
  }

  .closing__supporting {
    margin: 0;
    max-width: 34rem;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .closing__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  /* Secondary contact: plain text + a plain link, never styled as a
     button — it must never compete visually with the primary CTA.
     text-muted, not text-soft: text-soft fails WCAG AA here (~2.6:1 on
     white vs muted's ~7.6:1) — the same fix already applied in Hero. */
  .closing__secondary {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .closing__phone {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: var(--font-weight-medium);
  }

  .closing__phone:hover {
    color: var(--color-text);
  }

  .closing__phone:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  .closing__reassurance {
    margin: var(--space-2) 0 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  /* --- Entrance: gentle data-rise only, no stagger, no celebration. --- */

  .closing[data-anim="pending"] [data-rise] {
    opacity: 0;
  }

  .closing[data-anim="in"] [data-rise] {
    animation: closing-rise 420ms var(--closing-ease) both;
  }

  @keyframes closing-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* --- Responsive --- */

  @media (max-width: 1023px) {
    .closing {
      padding-block: var(--space-20) var(--space-16);
    }
  }

  @media (max-width: 640px) {
    .closing__actions {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .closing[data-anim="in"] [data-rise] {
      animation: none;
    }
  }
</style>

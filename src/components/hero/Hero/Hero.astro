---
// Hero — 6-slide carousel shell. Slide 1 is the existing "Darıca / Yerel
// Güven + Premium" content (real photo, 3 CTAs, brandLock); slides 2–6
// are new, single-CTA slides. All slide markup lives in HeroSlide.astro —
// this file only owns the carousel mechanics (track, arrows, dots,
// play/pause, autoplay, swipe, keyboard) and the trust bar, which is
// slide-1-only content that stays outside the sliding track entirely (see
// `.hero__trust` below) so it is never subject to slide-transition motion
// and never contributes to per-slide height variance.
//
// No carousel library: vanilla JS, matching this project's framework-free,
// zero-new-dependency architecture (same hand-rolled-script convention as
// Header/MegaMenu/SearchOverlay/SoundRoom). The DS `Carousel` atom
// (src/ds/components/ui/atoms/Carousel/) was reviewed and is demo-only —
// no client script, English aria-labels, not wired to any real page — the
// same "DS atom is a catalog piece, real UI is hand-built" pattern already
// established for Modal/Search.
import HeroSlide from "./HeroSlide.astro";
import { hero } from "./hero.data";
import {
  Award,
  ShieldCheck,
  Users,
  Gem,
  ChevronLeft,
  ChevronRight,
  Pause,
  Play,
  Ear,
  Headphones,
  BatteryCharging,
  Bluetooth,
  MessageCircle,
  Activity,
  ClipboardCheck,
  Lightbulb,
  LayoutGrid,
  Cpu,
  Shapes,
  UserCheck,
  MapPin,
  Navigation,
  MapPinned,
  Map,
  Battery,
  Layers,
} from "lucide-astro";

const trustIcons = { award: Award, shield: ShieldCheck, users: Users, gem: Gem } as const;
const infoCardIcons = {
  ear: Ear,
  headphones: Headphones,
  "battery-charging": BatteryCharging,
  bluetooth: Bluetooth,
  "message-circle": MessageCircle,
  activity: Activity,
  "clipboard-check": ClipboardCheck,
  lightbulb: Lightbulb,
  "layout-grid": LayoutGrid,
  cpu: Cpu,
  shapes: Shapes,
  "user-check": UserCheck,
  "map-pin": MapPin,
  navigation: Navigation,
  "map-pinned": MapPinned,
  map: Map,
  battery: Battery,
  layers: Layers,
} as const;
const { slides, trustItems } = hero;
// Slide-specific footer info-cards (currently slides 2–6). Each is
// rendered as a sibling occupying the SAME reserved grid cell as
// trustItems (see `.hero__footer-cards` below) and shown purely via CSS
// `:has()` keyed off that slide's own JS-managed `aria-hidden` — no
// carousel script changes.
const slide2InfoCards = slides[1]?.infoCards;
const slide3InfoCards = slides[2]?.infoCards;
const slide4InfoCards = slides[3]?.infoCards;
const slide5InfoCards = slides[4]?.infoCards;
const slide6InfoCards = slides[5]?.infoCards;
---

<section class="hero" aria-label="Öne çıkan hizmetler">
  <div class="hero__inner">
    <div
      class="hero__carousel"
      role="region"
      aria-roledescription="carousel"
      aria-label="Öne çıkan hizmetler"
      data-hero-carousel
    >
      <div class="hero__viewport">
        <div class="hero__clip">
        <div class="hero__track" data-hero-track>
          {
            slides.map((slide, index) => (
              <HeroSlide slide={slide} index={index} total={slides.length} isActive={index === 0} />
            ))
          }
        </div>
        </div>
      </div>

      <button
        class="hero__arrow hero__arrow--prev"
        type="button"
        aria-label="Önceki slayt"
        data-hero-prev
      >
        <ChevronLeft size={22} stroke-width={2} aria-hidden="true" />
      </button>
      <button
        class="hero__arrow hero__arrow--next"
        type="button"
        aria-label="Sonraki slayt"
        data-hero-next
      >
        <ChevronRight size={22} stroke-width={2} aria-hidden="true" />
      </button>

      <div class="hero__controls">
        <button
          class="hero__play-pause"
          type="button"
          data-hero-playpause
          data-state="playing"
          aria-label="Otomatik geçişi duraklat"
        >
          <Pause size={16} stroke-width={2} aria-hidden="true" class="hero__play-pause-icon hero__play-pause-icon--pause" />
          <Play size={16} stroke-width={2} aria-hidden="true" class="hero__play-pause-icon hero__play-pause-icon--play" />
        </button>

        <div class="hero__dots" data-hero-dots>
          {
            slides.map((_slide, index) => (
              <button
                class="hero__dot"
                type="button"
                aria-label={`${index + 1}. slayta git`}
                aria-current={index === 0 ? "true" : "false"}
                data-hero-dot
                data-index={index}
              />
            ))
          }
        </div>
      </div>
    </div>

    <div class="hero__footer-cards">
      <div class="hero__trust" data-hero-trust>
        {
          trustItems.map((item) => {
            const Icon = trustIcons[item.icon];
            return (
              <div class="hero-trust-item">
                <span class="hero-trust-item__icon" aria-hidden="true">
                  <Icon size={22} stroke-width={1.75} />
                </span>
                <div class="hero-trust-item__text">
                  <p class="hero-trust-item__value">{item.value}</p>
                  <p class="hero-trust-item__label">{item.label}</p>
                </div>
              </div>
            );
          })
        }
      </div>

      {
        slide2InfoCards && (
          <div class="hero__info-cards" data-hero-info-cards="1">
            {slide2InfoCards.map((card) => {
              const Icon = infoCardIcons[card.icon];
              return (
                <div class="hero-trust-item">
                  <span class="hero-trust-item__icon" aria-hidden="true">
                    <Icon size={22} stroke-width={1.75} />
                  </span>
                  <div class="hero-trust-item__text">
                    <p class="hero-trust-item__value">{card.title}</p>
                    <p class="hero-trust-item__label">{card.description}</p>
                  </div>
                </div>
              );
            })}
          </div>
        )
      }

      {
        slide3InfoCards && (
          <div class="hero__info-cards" data-hero-info-cards="2">
            {slide3InfoCards.map((card) => {
              const Icon = infoCardIcons[card.icon];
              return (
                <div class="hero-trust-item">
                  <span class="hero-trust-item__icon" aria-hidden="true">
                    <Icon size={22} stroke-width={1.75} />
                  </span>
                  <div class="hero-trust-item__text">
                    <p class="hero-trust-item__value">{card.title}</p>
                    <p class="hero-trust-item__label">{card.description}</p>
                  </div>
                </div>
              );
            })}
          </div>
        )
      }

      {
        slide4InfoCards && (
          <div class="hero__info-cards" data-hero-info-cards="3">
            {slide4InfoCards.map((card) => {
              const Icon = infoCardIcons[card.icon];
              return (
                <div class="hero-trust-item">
                  <span class="hero-trust-item__icon" aria-hidden="true">
                    <Icon size={22} stroke-width={1.75} />
                  </span>
                  <div class="hero-trust-item__text">
                    <p class="hero-trust-item__value">{card.title}</p>
                    <p class="hero-trust-item__label">{card.description}</p>
                  </div>
                </div>
              );
            })}
          </div>
        )
      }

      {
        slide5InfoCards && (
          <div class="hero__info-cards" data-hero-info-cards="4">
            {slide5InfoCards.map((card) => {
              const Icon = infoCardIcons[card.icon];
              return (
                <div class="hero-trust-item">
                  <span class="hero-trust-item__icon" aria-hidden="true">
                    <Icon size={22} stroke-width={1.75} />
                  </span>
                  <div class="hero-trust-item__text">
                    <p class="hero-trust-item__value">{card.title}</p>
                    <p class="hero-trust-item__label">{card.description}</p>
                  </div>
                </div>
              );
            })}
          </div>
        )
      }

      {
        slide6InfoCards && (
          <div class="hero__info-cards" data-hero-info-cards="5">
            {slide6InfoCards.map((card) => {
              const Icon = infoCardIcons[card.icon];
              return (
                <div class="hero-trust-item">
                  <span class="hero-trust-item__icon" aria-hidden="true">
                    <Icon size={22} stroke-width={1.75} />
                  </span>
                  <div class="hero-trust-item__text">
                    <p class="hero-trust-item__value">{card.title}</p>
                    <p class="hero-trust-item__label">{card.description}</p>
                  </div>
                </div>
              );
            })}
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  (function () {
    const carousel = document.querySelector<HTMLElement>("[data-hero-carousel]");
    const track = document.querySelector<HTMLElement>("[data-hero-track]");
    if (!carousel || !track) return;

    const slideEls = Array.from(
      carousel.querySelectorAll<HTMLElement>("[data-hero-slide]")
    );
    const dotEls = Array.from(
      carousel.querySelectorAll<HTMLButtonElement>("[data-hero-dot]")
    );
    const prevBtn = carousel.querySelector<HTMLButtonElement>("[data-hero-prev]");
    const nextBtn = carousel.querySelector<HTMLButtonElement>("[data-hero-next]");
    const playPauseBtn = carousel.querySelector<HTMLButtonElement>(
      "[data-hero-playpause]"
    );
    const trustEl = document.querySelector<HTMLElement>("[data-hero-trust]");
    const total = slideEls.length;
    if (!total) return;

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    var activeIndex = 0;
    var userPaused = false;
    var isHovering = false;
    var hasFocusWithin = false;
    var inView = true;

    // Stacked (mobile/tablet) layout: the clip follows the ACTIVE slide's
    // height, so short slides (2-6) do not carry the tallest slide's empty
    // space. Desktop keeps the uniform, layout-shift-free height (inline
    // height cleared).
    const stackedMq = window.matchMedia("(max-width: 1023px)");
    const clip = carousel.querySelector<HTMLElement>(".hero__clip");
    const syncHeight = () => {
      if (!clip) return;
      if (!stackedMq.matches) {
        clip.style.height = "";
        return;
      }
      clip.style.height = slideEls[activeIndex].offsetHeight + "px";
    };
    stackedMq.addEventListener("change", syncHeight);
    if ("ResizeObserver" in window) {
      const heightObserver = new ResizeObserver(syncHeight);
      slideEls.forEach(function (slide) {
        heightObserver.observe(slide);
      });
    }

    // With a height that follows the active slide, an off-screen autoplay
    // tick would resize the hero above the content the visitor is reading
    // and shift it. So on the stacked layout autoplay only advances while the
    // hero is actually in view.
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (entries) {
        inView = entries[0].isIntersecting;
      }).observe(carousel);
    }

    if (reducedMotion) {
      track.style.transition = "none";
      if (playPauseBtn) playPauseBtn.hidden = true;
    }

    // Arrow-function consts (not `function` declarations) so TypeScript's
    // control-flow narrowing of the `const carousel`/`track`/`playPauseBtn`
    // null-checks above carries into these closures.
    const render = () => {
      track.style.transform = "translateX(" + -100 * activeIndex + "%)";

      slideEls.forEach(function (slide, i) {
        var active = i === activeIndex;
        slide.setAttribute("aria-hidden", active ? "false" : "true");
        // `inert` removes the whole inactive slide (its links/buttons)
        // from the tab order and from assistive tech in one step — no
        // need to manage tabindex on every interactive descendant.
        slide.inert = !active;
      });

      dotEls.forEach(function (dot, i) {
        dot.setAttribute("aria-current", i === activeIndex ? "true" : "false");
      });

      // Trust bar is slide-1-only content, but its box is never removed
      // from flow — only its visibility/opacity toggles — so Hero's total
      // height (and the next section's position) never shifts when
      // switching slides (§6 "büyüyüp küçülmesin" / layout-shift = 0).
      if (trustEl) {
        var showTrust = activeIndex === 0;
        trustEl.setAttribute("aria-hidden", showTrust ? "false" : "true");
        trustEl.inert = !showTrust;
        trustEl.classList.toggle("hero__trust--hidden", !showTrust);
      }

      syncHeight();
    };

    const goTo = (index: number) => {
      activeIndex = ((index % total) + total) % total;
      render();
    };

    const next = () => {
      goTo(activeIndex + 1);
    };

    const prev = () => {
      goTo(activeIndex - 1);
    };

    const tick = () => {
      if (
        reducedMotion ||
        userPaused ||
        isHovering ||
        hasFocusWithin ||
        document.hidden ||
        (stackedMq.matches && !inView)
      ) {
        return;
      }
      next();
    };

    const setPlaying = (playing: boolean) => {
      userPaused = !playing;
      if (!playPauseBtn) return;
      playPauseBtn.dataset.state = playing ? "playing" : "paused";
      playPauseBtn.setAttribute(
        "aria-label",
        playing ? "Otomatik geçişi duraklat" : "Otomatik geçişi başlat"
      );
    };

    if (prevBtn) prevBtn.addEventListener("click", prev);
    if (nextBtn) nextBtn.addEventListener("click", next);

    dotEls.forEach(function (dot) {
      dot.addEventListener("click", function () {
        goTo(Number(dot.dataset.index));
      });
    });

    if (playPauseBtn) {
      playPauseBtn.addEventListener("click", function () {
        setPlaying(playPauseBtn.dataset.state !== "playing");
      });
    }

    carousel.addEventListener("mouseenter", function () {
      isHovering = true;
    });
    carousel.addEventListener("mouseleave", function () {
      isHovering = false;
    });

    carousel.addEventListener("focusin", function () {
      hasFocusWithin = true;
    });
    carousel.addEventListener("focusout", function () {
      // focusout fires before the next element receives focus — defer the
      // check so `document.activeElement` reflects where focus landed.
      setTimeout(function () {
        hasFocusWithin = carousel.contains(document.activeElement);
      }, 0);
    });

    carousel.addEventListener("keydown", function (event: KeyboardEvent) {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        prev();
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        next();
      }
    });

    // Swipe: only counts as a horizontal swipe if the horizontal delta
    // clearly dominates the vertical one, so a normal vertical page-scroll
    // gesture starting on the carousel is never hijacked.
    var touchStartX = 0;
    var touchStartY = 0;
    track.addEventListener(
      "touchstart",
      function (event: TouchEvent) {
        var touch = event.changedTouches[0];
        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
      },
      { passive: true }
    );
    track.addEventListener(
      "touchend",
      function (event: TouchEvent) {
        var touch = event.changedTouches[0];
        var dx = touch.clientX - touchStartX;
        var dy = touch.clientY - touchStartY;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) {
          if (dx < 0) next();
          else prev();
        }
      },
      { passive: true }
    );

    document.addEventListener("visibilitychange", function () {
      // no-op hook point; `tick()` already checks document.hidden.
    });

    render();

    if (!reducedMotion) {
      window.setInterval(tick, 7000);
    }
  })();
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--color-surface);
    color: var(--color-text);
    /* Tightened from space-8/space-16, then again from space-6/space-8 —
       purely spacing, never content. Each round shaves a bit more off
       Hero's total footprint so the next section can peek at the bottom of
       common viewport heights (900px+) without touching font sizes, CTAs,
       or trust cards. */
    padding-block: var(--space-5) var(--space-6);
  }

  /* Very faint dot-grid, same technique as Hero/Footer's established
     texture (radial-gradient tiled circles) — no new visual technique. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(
      circle,
      rgb(37 99 235 / 0.06) 1px,
      transparent 1px
    );
    background-size: 22px 22px;
    mask-image: linear-gradient(to bottom left, #000 15%, transparent 45%);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding-inline: var(--space-12);
  }

  /* --- Carousel shell --------------------------------------------------- */

  .hero__carousel {
    position: relative;
  }

  /* At exactly 1024–1279px the 45/55 grid's copy column becomes uncomfortably
     narrow (measured: 1024px is the single worst case for wrapping — slide
     1's copy grew to ~730px tall there, vs ~540px at 1366px+), which is what
     was blowing up Hero's height in that narrow band. Giving copy a little
     more of the split reduces wrapping without touching the arrow gutter
     (`.hero__viewport`'s 64px padding must stay ≥ the 56px the arrows
     actually need, so that gutter itself isn't a safe place to cut here). */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .hero__track :global(.hero-slide) {
      grid-template-columns: 50fr 50fr;
    }
  }

  /* Horizontal padding reserves a real gutter for the prev/next arrows
     (positioned against `.hero__carousel`'s edges, outside this padded
     box) so they sit beside the slide's text/visual content instead of
     overlapping it — found via visual QA: an unpadded viewport let the
     "prev" arrow sit directly on top of body copy at desktop widths.
     Removed at ≤767px, where the arrows themselves are hidden (swipe/dots
     cover mobile navigation) so the extra inset isn't needed there. */
  .hero__viewport {
    padding-inline: 64px;
  }

  /* `overflow: hidden` (and the rounded corners it actually clips to) live
     on this SEPARATE inner element, not on the padded `.hero__viewport`
     itself — CSS clips at an element's own padding-box edge, so if the
     same element carried both the padding and the clip, the padding strip
     would remain part of the visible/unclipped area and let the adjacent
     (off-screen) slide peek into it. Nesting the clip inside the padding
     fixes that: the clip boundary sits at the post-padding edge, exactly
     where content should actually end. */
  .hero__clip {
    overflow: hidden;
    border-radius: var(--radius-2xl);
  }

  .hero__track {
    display: flex;
    width: 100%;
    transition: transform 550ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Reserves space for the tallest slide (slide 1: 3 CTAs + brandLock) so
     switching to a shorter slide (2–6: single CTA) never collapses Hero's
     height — this is what keeps layout stable across slides (§6). */
  .hero__track :global(.hero-slide) {
    flex: 0 0 100%;
    min-width: 0;
    min-height: 26rem;
  }

  .hero__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-white);
    color: var(--color-text);
    box-shadow: var(--shadow-md);
    transition: background-color var(--transition-base), border-color var(--transition-base);
  }

  .hero__arrow:hover {
    background: var(--color-surface);
    border-color: var(--color-border-hover);
  }

  .hero__arrow:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .hero__arrow--prev {
    left: var(--space-2);
  }

  .hero__arrow--next {
    right: var(--space-2);
  }

  .hero__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  .hero__play-pause {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-white);
    color: var(--color-text-muted);
    transition: background-color var(--transition-base), border-color var(--transition-base);
  }

  .hero__play-pause:hover {
    background: var(--color-surface);
    border-color: var(--color-border-hover);
  }

  .hero__play-pause:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .hero__play-pause-icon--play {
    display: none;
  }

  .hero__play-pause[data-state="paused"] .hero__play-pause-icon--pause {
    display: none;
  }

  .hero__play-pause[data-state="paused"] .hero__play-pause-icon--play {
    display: block;
  }

  .hero__dots {
    display: flex;
    align-items: center;
  }

  /* Real ≥44px touch target: the button's own box IS the hit area (not an
     oversized invisible ::before), so adjacent dots' hit areas never
     overlap regardless of gap — each dot's real box just butts up against
     its neighbour's. The small visible dot is a centered ::after inside
     that real box. (An earlier inset:-17px ::before version made adjacent
     dots' invisible hit areas overlap enough that clicking one dot could
     activate its neighbour — caught by automated interaction QA.) */
  .hero__dot {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    background: transparent;
  }

  .hero__dot::after {
    content: "";
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    background: var(--color-border-hover);
    transition: background-color var(--transition-base), transform var(--transition-base);
  }

  .hero__dot[aria-current="true"]::after {
    background: var(--color-primary);
    transform: scale(1.25);
  }

  .hero__dot:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* --- Footer cards ---------------------------------------------------------
     Reserved footer-card area, kept OUTSIDE the sliding track. Slide 1's
     trustItems and slide 2's infoCards are two different card SETS that
     share this one slot: both are placed in the same CSS Grid cell
     (`grid-area: 1 / 1`), so the wrapper's height is set once — by
     whichever set is naturally taller — and switching between them can
     never shift Hero's total height (same mechanism/goal as the older
     single-set opacity toggle, just extended to more than one set without
     touching the carousel's own JS: visibility here is driven purely by a
     `:has()` rule keyed off the slide's existing JS-managed aria-hidden). */
  .hero__footer-cards {
    display: grid;
    margin-top: var(--space-5);
  }

  .hero__trust,
  .hero__info-cards {
    grid-area: 1 / 1;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    transition: opacity 300ms ease;
  }

  .hero__trust {
    opacity: 1;
  }

  .hero__trust--hidden {
    opacity: 0;
  }

  /* No JS toggle exists for these sets (unlike .hero__trust, which the
     carousel script already manages) — `visibility` (not just opacity)
     does the accessibility-hiding work that `inert` does for the trust
     bar, keeping this text out of the a11y tree whenever its own slide
     isn't active. Each info-cards block carries a `data-hero-info-cards`
     value matching its slide's index, so the five (slides 2–6) never show
     at the same time. */
  .hero__info-cards {
    opacity: 0;
    visibility: hidden;
  }

  .hero__inner:has(.hero-slide[data-index="1"][aria-hidden="false"]) .hero__info-cards[data-hero-info-cards="1"],
  .hero__inner:has(.hero-slide[data-index="2"][aria-hidden="false"]) .hero__info-cards[data-hero-info-cards="2"],
  .hero__inner:has(.hero-slide[data-index="3"][aria-hidden="false"]) .hero__info-cards[data-hero-info-cards="3"],
  .hero__inner:has(.hero-slide[data-index="4"][aria-hidden="false"]) .hero__info-cards[data-hero-info-cards="4"],
  .hero__inner:has(.hero-slide[data-index="5"][aria-hidden="false"]) .hero__info-cards[data-hero-info-cards="5"] {
    opacity: 1;

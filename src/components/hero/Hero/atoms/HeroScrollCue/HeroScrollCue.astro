---
// Quiet scroll invitation at the base of the hero. Decorative (aria-hidden):
// it hints at the journey below but is not a navigation target yet.
import { ChevronDown } from "lucide-astro";

interface Props {
  label: string;
}
const { label } = Astro.props;
---

<div class="hero-scroll-cue" aria-hidden="true">
  <span class="hero-scroll-cue__label">{label}</span>
  <span class="hero-scroll-cue__icon"><ChevronDown size={18} aria-hidden="true" /></span>
</div>

<style>
  .hero-scroll-cue {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-soft);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.02em;
  }

  .hero-scroll-cue__icon {
    display: inline-flex;
    animation: hero-cue-drift 2.4s var(--hero-ease, ease-in-out) infinite;
  }

  @keyframes hero-cue-drift {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.7;
    }
    50% {
      transform: translateY(3px);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-cue__icon {
      animation: none;
    }
  }
</style>

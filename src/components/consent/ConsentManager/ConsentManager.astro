---
// ConsentManager — çerez bandı + tercih paneli + izin mantığı.
//   • İlk ziyarette (kayıt yok) altta bir bant açılır: “Tümünü kabul et”, “Tümünü reddet”,
//     “Tercihleri yönet” — üçü aynı görsel ağırlıkta. Kullanıcı seçene kadar HİÇBİR kayıt yazılmaz ve
//     hiçbir Google isteği gitmez; “seçilmemiş” durumu “reddedildi” veya “kabul edildi” diye saklanmaz.
//   • Tercih paneli (<dialog>) bant, footer “Çerez Tercihleri” bağlantısı ([data-consent-open]) ile açılır.
//   • Kategoriler: Zorunlu (kilitli) · Analitik (GA4) · Reklam ölçüm (Google Ads dönüşüm ölçümü).
//     Kişiselleştirilmiş reklam izni hiçbir durumda verilmez (bkz. lib/consent/google.ts).
//   • Harita/video gibi gömme içerikler kategori değildir: her biri kendi “yükle” düğmesiyle, yalnızca
//     o tek içerik ve yalnızca o sayfa ziyareti için yüklenir; kalıcı tercih yazılmaz.
// Kütüphane yok: yerel <dialog>, Design System Button sınıfları ve küçük bir modül script'i.
import "../../../ds/components/ui/atoms/Button/Button.css";

const categories = [
  {
    key: "necessary",
    label: "Zorunlu çerezler",
    text: "Güvenlik, oturum, tercihlerin teknik olarak uygulanması ve sitenin çalışması için gerekir.",
    locked: true,
  },
  {
    key: "analytics",
    label: "Analitik çerezler",
    text: "Google Analytics 4 ile ziyaret ve kullanım ölçümü. Sağlık bilgisi veya test sonucu gönderilmez.",
    locked: false,
  },
  {
    key: "marketing",
    label: "Reklam ölçüm çerezleri",
    text: "Google Ads dönüşüm ölçümü (ör. reklamdan gelen telefon / WhatsApp tıklaması). Kişiselleştirilmiş reklam izni verilmez.",
    locked: false,
  },
] as const;
---

<section class="consent-banner" data-consent-banner hidden aria-labelledby="consent-banner-title">
  <h2 class="consent-banner__title" id="consent-banner-title">Çerez tercihleriniz</h2>
  <p class="consent-banner__text">
    Zorunlu çerezler sitenin çalışması için kullanılır. Analitik ve reklam ölçüm çerezleri yalnızca sizin onayınızla
    açılır; seçim yapana kadar Google’a hiçbir istek gönderilmez.
  </p>
  <div class="consent-banner__actions">
    <button type="button" class="btn btn--outline btn--md" data-consent-action="accept-all"><span>Tümünü kabul et</span></button>
    <button type="button" class="btn btn--outline btn--md" data-consent-action="reject-all"><span>Tümünü reddet</span></button>
    <button type="button" class="btn btn--outline btn--md" data-consent-open><span>Tercihleri yönet</span></button>
  </div>
</section>

<dialog class="consent-dialog" data-consent-dialog aria-labelledby="consent-dialog-title">
  <form method="dialog" class="consent-dialog__form" data-consent-form>
    <div class="consent-dialog__head">
      <h2 class="consent-dialog__title" id="consent-dialog-title">Çerez Tercihleri</h2>
      <button type="button" class="consent-dialog__close" data-consent-close aria-label="Kapat">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
    <p class="consent-dialog__intro">
      Zorunlu çerezler her zaman açıktır. Diğer kategoriler varsayılan olarak kapalıdır ve yalnızca siz açarsanız etkinleşir.
      Tercihinizi daha sonra sayfa altındaki “Çerez Tercihleri” bağlantısından değiştirebilirsiniz.
    </p>
    <ul class="consent-dialog__list">
      {
        categories.map((c) => (
          <li class="consent-cat">
            <div class="consent-cat__body">
              <label class="consent-cat__label" for={`consent-${c.key}`}>{c.label}</label>
              <p class="consent-cat__text" id={`consent-${c.key}-desc`}>{c.text}</p>
            </div>
            <div class="consent-cat__control">
              {c.locked ? (
                <span class="consent-cat__locked" id={`consent-${c.key}`}>Her zaman açık</span>
              ) : (
                <input
                  class="consent-switch"
                  type="checkbox"
                  role="switch"
                  id={`consent-${c.key}`}
                  name={c.key}
                  aria-describedby={`consent-${c.key}-desc`}
                  data-consent-toggle={c.key}
                />
              )}
            </div>
          </li>
        ))
      }
    </ul>
    <div class="consent-dialog__actions">
      <button type="button" class="btn btn--outline btn--md" data-consent-action="accept-all"><span>Tümünü kabul et</span></button>
      <button type="button" class="btn btn--outline btn--md" data-consent-action="reject-all"><span>Tümünü reddet</span></button>
      <button type="button" class="btn btn--outline btn--md" data-consent-action="save"><span>Seçimimi kaydet</span></button>
    </div>
  </form>
</dialog>

<p class="consent-live" data-consent-live aria-live="polite" role="status"></p>

<script>
  import { ALL_DENIED, CONSENT_STORAGE_KEY, OPTIONAL_CATEGORIES, type ConsentChoices, type ConsentMethod } from "../../../lib/consent/config";
  import { consentFromStorageValue, readConsent, writeConsent } from "../../../lib/consent/store";
  import { applyGoogleConsent, gtmIsActive, setConsentDefault } from "../../../lib/consent/google";

  const dialog = document.querySelector<HTMLDialogElement>("[data-consent-dialog]");
  const banner = document.querySelector<HTMLElement>("[data-consent-banner]");
  const live = document.querySelector<HTMLElement>("[data-consent-live]");
  const toggles = Array.from(document.querySelectorAll<HTMLInputElement>("[data-consent-toggle]"));

  let current: ConsentChoices = { ...ALL_DENIED };
  let lastOpener: HTMLElement | null = null;

  function announce(msg: string): void {
    if (!live) return;
    live.textContent = "";
    window.setTimeout(() => (live.textContent = msg), 30);
  }

  function syncToggles(): void {
    for (const t of toggles) {
      const k = t.dataset.consentToggle as keyof ConsentChoices;
      t.checked = current[k] === true;
    }
  }

  function showBanner(show: boolean): void {
    if (banner) banner.hidden = !show;
  }

  // --- Gömme içerik (Maps / YouTube): yalnızca tıklanan içerik yüklenir, tercih yazılmaz ----
  function loadEmbed(host: HTMLElement): void {
    const tpl = host.querySelector<HTMLTemplateElement>("template");
    if (!tpl) return;
    host.replaceChildren(tpl.content.cloneNode(true) as DocumentFragment);
    host.setAttribute("data-consent-embed-state", "loaded");
  }

  // İzin GERİ ALMA: bir kategori granted → denied olduğunda ve GTM bu sayfada zaten yüklüyse, yüklü
  // Google etiketleri (Google Tag, Linker) bu sayfa ömrü boyunca bellekte kalır ve kendi otomatik
  // davranışlarını sürdürebilir. Bu yüzden, yeni tercih kaydedilip `consent update (denied)` gönderildikten
  // SONRA sayfa bir kez yenilenir; yeni yüklemede GTM ya hiç yüklenmez ya da yalnızca kalan izinle yüklenir.
  // Yenileme YALNIZCA geri almada olur: ilk kayıt, yalnızca izin verme ve sayfa açılışında uygulanan kayıtlı
  // tercih ("load") yenileme üretmez; dolayısıyla sonsuz döngü oluşmaz. `reloadScheduled` aynı anda birden
  // fazla kategori geri alınsa bile tek yenileme garanti eder.
  let reloadScheduled = false;

  function revoked(prev: ConsentChoices, next: ConsentChoices): boolean {
    return OPTIONAL_CATEGORIES.some((k) => prev[k] && !next[k]);
  }

  function reloadAfterRevoke(): void {
    if (reloadScheduled) return;
    reloadScheduled = true;
    // consent update zaten dataLayer'a yazıldı (senkron); kısa gecikme yalnızca GTM'in kuyruğu işlemesine
    // ve kaydın tamamlanmasına yer açar.
    window.setTimeout(() => window.location.reload(), 150);
  }

  function apply(choices: ConsentChoices, source: "load" | "user" | "storage"): void {
    const prev = current;
    current = { ...choices };
    applyGoogleConsent(current); // 2) consent update (denied) burada gönderilir
    window.dispatchEvent(new CustomEvent("consent:change", { detail: { choices: { ...current }, source } }));
    // 3) GTM yüklenmişse ve bir kategori geri alındıysa sayfa bir kez yenilenir.
    if (source !== "load" && gtmIsActive() && revoked(prev, current)) reloadAfterRevoke();
  }

  function save(choices: ConsentChoices, method: ConsentMethod, message: string): void {
    writeConsent(choices, method);
    apply(choices, "user");
    showBanner(false);
    if (dialog?.open) dialog.close();
    announce(message);
  }

  function openPreferences(opener: HTMLElement | null): void {
    if (!dialog) return;
    lastOpener = opener;
    syncToggles();
    if (!dialog.open) dialog.showModal();
    dialog.querySelector<HTMLElement>("[data-consent-toggle], button")?.focus();
  }

  // --- Başlangıç: önce varsayılan (hepsi denied), sonra kayıtlı tercih, sonra Google etiketleri ----
  setConsentDefault();
  const stored = readConsent();
  if (stored) {
    apply(stored.choices, "load");
    showBanner(false);
  } else {
    // Kayıt YOK: hiçbir şey yazılmaz, GTM yüklenmez; kullanıcı bir seçenek seçene kadar bant görünür.
    current = { ...ALL_DENIED };
    showBanner(true);
  }

  // --- Olaylar ---------------------------------------------------------------
  document.addEventListener("click", (e) => {
    const t = (e.target as Element | null)?.closest<HTMLElement>("[data-consent-action], [data-consent-open], [data-consent-close], [data-consent-enable-embed]");
    if (!t) return;

    if (t.hasAttribute("data-consent-open")) {
      e.preventDefault();
      openPreferences(t);
      return;
    }
    if (t.hasAttribute("data-consent-close")) {
      dialog?.close();
      return;
    }
    if (t.hasAttribute("data-consent-enable-embed")) {
      const host = t.closest<HTMLElement>("[data-consent-embed]");
      if (host) {
        loadEmbed(host);
        host.querySelector<HTMLElement>("iframe")?.focus();
      }
      return;
    }
    const action = t.getAttribute("data-consent-action");
    if (action === "accept-all") {
      const all = { ...ALL_DENIED };
      for (const k of OPTIONAL_CATEGORIES) all[k] = true;
      save(all, "accept_all", "Tüm çerez tercihleri kabul edildi.");
    } else if (action === "reject-all") {
      save({ ...ALL_DENIED }, "reject_all", "Zorunlu olmayan çerezler reddedildi.");
    } else if (action === "save") {
      const next = { ...ALL_DENIED };
      for (const tg of toggles) next[tg.dataset.consentToggle as keyof ConsentChoices] = tg.checked;
      save(next, "custom", "Çerez tercihleriniz kaydedildi.");
    }
  });

  // Panel kapandığında odak, açan öğeye (yoksa ana içeriğe) döner.
  dialog?.addEventListener("close", () => {
    const visible = lastOpener && document.contains(lastOpener) && (lastOpener as HTMLElement).offsetParent !== null;
    const target = visible ? lastOpener : document.getElementById("main");
    if (target) {
      if (!target.hasAttribute("tabindex") && target.id === "main") target.setAttribute("tabindex", "-1");
      target.focus();
    }
    lastOpener = null;
  });

  // Panelin dışına (arka plana) tıklamak kapatır (karar vermiş sayılmaz).
  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });

  // Başka sekmede yapılan tercih bu sekmeye de yansır (silinmişse izinler kapatılır).
  // `newValue` esas alınır: null (silindi) / geçersiz / method'suz / eski sürüm → eski bellek kaydına DÖNÜLMEZ,
  // tüm isteğe bağlı izinler denied. Bu yol localStorage'a YAZMAZ (sekmeler arası olay döngüsü olmaz).
  // Geri alma varsa apply() consent update'i gönderir ve (GTM yüklüyse) sayfayı tek kez yeniler.
  window.addEventListener("storage", (e) => {
    if (e.storageArea !== window.localStorage) return;
    if (e.key !== null && e.key !== CONSENT_STORAGE_KEY) return;
    const raw = e.key === null ? window.localStorage.getItem(CONSENT_STORAGE_KEY) : e.newValue; // key === null: clear()
    const s = consentFromStorageValue(raw);
    const next = s ? s.choices : { ...ALL_DENIED };
    showBanner(!s);
    if (OPTIONAL_CATEGORIES.every((k) => next[k] === current[k])) return; // değişiklik yok → tekrar uygulama/yenileme yok
    apply(next, "storage");
  });
</script>

<style>
  /* --- Çerez bandı -------------------------------------------------------- */
  .consent-banner {
    position: fixed;
    inset: auto var(--space-3) var(--space-3) var(--space-3);
    z-index: 1000;
    display: grid;
    gap: var(--space-3);
    max-width: 44rem;
    margin-inline: auto;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-white);
    color: var(--color-text);
    box-shadow: var(--shadow-xl);
  }

  .consent-banner[hidden] {
    display: none;
  }

  .consent-banner__title {
    margin: 0;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
  }

  .consent-banner__text {
    margin: 0;
    font-size: var(--font-size-sm);
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .consent-banner__actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .consent-banner__actions :global(.btn) {
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 520px) {
    .consent-banner__actions {
      grid-template-columns: 1fr;
    }
  }

  /* --- Tercih paneli ------------------------------------------------------ */
  .consent-dialog {
    width: min(36rem, calc(100vw - var(--space-6)));
    max-height: calc(100dvh - var(--space-6));
    margin: auto;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-white);
    color: var(--color-text);
    box-shadow: var(--shadow-xl);
    overflow: auto;
  }

  .consent-dialog::backdrop {
    background: rgba(15, 23, 42, 0.55);
  }

  .consent-dialog__form {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
  }

  .consent-dialog__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .consent-dialog__title {
    margin: 0;
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
  }

  .consent-dialog__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: var(--radius-lg);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .consent-dialog__close:hover {
    background: var(--color-surface-hover);
  }

  .consent-dialog__intro {
    margin: 0;
    font-size: var(--font-size-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .consent-dialog__list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .consent-cat {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .consent-cat__label {
    font-weight: var(--font-weight-semibold, 600);
    font-size: var(--font-size-md);
  }

  .consent-cat__text {
    margin: var(--space-1) 0 0;
    font-size: var(--font-size-sm);
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .consent-cat__locked {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold, 600);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* Anahtar (switch): yerel checkbox + CSS — ek kütüphane yok. */
  .consent-switch {
    appearance: none;
    position: relative;
    width: 3rem;
    height: 1.75rem;
    margin: 0;
    border-radius: 999px;
    background: #64748b;
    cursor: pointer;
    transition: background 160ms ease;
  }

  .consent-switch::after {
    content: "";
    position: absolute;
    top: 0.1875rem;
    left: 0.1875rem;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 50%;
    background: var(--color-white);
    transition: transform 160ms ease;
  }

  .consent-switch:checked {
    background: var(--color-primary-hover);
  }

  .consent-switch:checked::after {
    transform: translateX(1.25rem);
  }

  .consent-switch:focus-visible,
  .consent-dialog__close:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .consent-dialog__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (max-width: 520px) {
    .consent-dialog__form {
      padding: var(--space-4);
    }

    .consent-dialog__actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .consent-dialog__actions :global(.btn) {
      width: 100%;
      justify-content: center;
    }
  }

  .consent-live {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .consent-switch,
    .consent-switch::after {
      transition: none;
    }
  }
</style>

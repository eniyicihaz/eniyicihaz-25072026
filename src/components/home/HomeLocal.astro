---
// HomeLocal — ana sayfanın 2. bölümü: "Merkezimiz ve Ulaşım" (Faz 2 P2,
// onay V1). Önceki sürümdeki güven pill'leri ("Uzman kadro" vb.), bölge
// merdiveni ve SGK kutusu buradan çıkarıldı; güven bilgileri HomeTrust'ta,
// SGK hizmet akışında. Bu bölüm yalnızca ziyareti planlamak için gereken
// doğrulanmış bilgiyi verir: gerçek fotoğraflar, adres, tarif, erişim,
// randevusuz ziyaret, çalışma saatleri, otopark, harita ve yol tarifi.
// Gebze ve Çayırova yalnızca kısa destek satırı.
import { MapPin, Navigation, Clock, Car, ArrowRight } from "lucide-astro";
import HomeBlockHeader from "./HomeBlockHeader.astro";
import ConsentEmbed from "../consent/ConsentEmbed/ConsentEmbed.astro";
import { homeCenterGallery as data } from "../../data/home/center-gallery";
import { company } from "../footer/Footer/data/company";
---

<section class="home-local" aria-labelledby="home-local-title" data-track-location="home_local">
  <div class="home-local__inner">
    <div class="home-local__photos">
      <div class="home-local__feature">
        <img
          class="home-local__feature-img"
          src={data.featureImage.src}
          alt={data.featureImage.alt}
          width={data.featureImage.width}
          height={data.featureImage.height}
          loading="lazy"
          decoding="async"
        />
        <div class="home-local__location">
          <img
            class="home-local__location-img"
            src={data.locationImage.src}
            alt={data.locationImage.alt}
            width={data.locationImage.width}
            height={data.locationImage.height}
            loading="lazy"
            decoding="async"
          />
          <p class="home-local__location-caption">{data.locationCaption}</p>
        </div>
      </div>
      <div class="home-local__support">
        {data.supportImages.map((image) => (
          <img
            class="home-local__support-img"
            src={image.src}
            alt={image.alt}
            width={image.width}
            height={image.height}
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
    </div>

    <div class="home-local__content">
      <HomeBlockHeader id="home-local-title" eyebrow={data.eyebrow} heading={data.heading} intro={data.intro} />

      <div class="home-local__address">
        <MapPin size={20} stroke-width={1.75} aria-hidden="true" class="home-local__icon" />
        <address>{company.address}</address>
      </div>

      <dl class="home-local__facts">
        {data.facts.map((fact) => (
          <div class="home-local__fact">
            <dt>{fact.label}</dt>
            <dd>{fact.text}</dd>
          </div>
        ))}
      </dl>

      <div class="home-local__meta">
        <div class="home-local__hours">
          <p class="home-local__meta-title">
            <Clock size={18} stroke-width={1.75} aria-hidden="true" class="home-local__icon" />
            Çalışma Saatleri
          </p>
          <dl>
            {company.hours.map((entry) => (
              <div class="home-local__hours-row">
                <dt>{entry.days}</dt>
                <dd>{entry.time}</dd>
              </div>
            ))}
          </dl>
        </div>
        <p class="home-local__parking">
          <Car size={18} stroke-width={1.75} aria-hidden="true" class="home-local__icon" />
          {data.parking}
        </p>
      </div>

      <div class="home-local__actions">
        <a class="home-local__btn" href={company.directionsHref}>
          <Navigation size={20} stroke-width={2} aria-hidden="true" />
          <span>Yol Tarifi Al</span>
        </a>
        <a class="home-local__hub" href={data.hubLink.href}>
          <span>{data.hubLink.label}</span>
          <ArrowRight size={18} stroke-width={2} aria-hidden="true" />
        </a>
      </div>

      <p class="home-local__regions">
        {data.regions.text}{" "}
        {data.regions.links.map((link, i) => (
          <>
            {i > 0 && " · "}
            <a href={link.href}>{link.label}</a>
          </>
        ))}
      </p>
    </div>
  </div>

  <div class="home-local__map">
    <ConsentEmbed
      provider="Google Maps"
      title="Darıca merkezimizin konum haritası"
      loadLabel="Haritayı yükle"
      directLabel="Google Haritalar’da aç"
      directHref={company.directionsHref}
    >
      <iframe
        class="home-local__map-frame"
        src={company.mapEmbedSrc}
        title="Avrasya İşitme Cihazları — Darıca konum haritası"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </ConsentEmbed>
  </div>
</section>

<style>
  .home-local {
    background: var(--color-background);
    color: var(--color-text);
    padding-block: var(--space-16);
  }

  .home-local__inner,
  .home-local__map {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .home-local__inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-12);
    align-items: start;
  }

  /* --- Real photos --- */
  .home-local__photos {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--space-3);
  }

  .home-local__feature {
    position: relative;
  }

  .home-local__feature-img,
  .home-local__support-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-md);
  }

  .home-local__feature-img {
    aspect-ratio: 1214 / 1295;
  }

  .home-local__support {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: var(--space-3);
  }

  .home-local__location {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    max-width: 16rem;
    padding: var(--space-2);
    border-radius: var(--radius-lg);
    background: var(--color-background);
    box-shadow: var(--shadow-md);
  }

  .home-local__location-img {
    width: 44px;
    height: 44px;
    flex: none;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .home-local__location-caption {
    margin: 0;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    line-height: 1.35;
  }

  /* --- Content --- */
  .home-local__content {
    min-width: 0;
  }

  .home-local__icon {
    flex: none;
    color: var(--color-primary);
  }

  .home-local__address {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    margin-top: var(--space-6);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-relaxed);
  }

  .home-local__address address {
    font-style: normal;
  }

  .home-local__facts {
    margin: var(--space-4) 0 0;
    display: grid;
    gap: var(--space-3);
  }

  .home-local__fact {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: var(--space-3);
  }

  .home-local__fact dt {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-muted);
  }

  .home-local__fact dd {
    margin: 0;
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
  }

  .home-local__meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .home-local__meta-title,
  .home-local__parking {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
  }

  .home-local__hours dl {
    margin: var(--space-2) 0 0;
  }

  .home-local__hours-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
  }

  .home-local__hours-row dd {
    margin: 0;
    font-weight: var(--font-weight-semibold);
  }

  .home-local__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .home-local__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 56px;
    padding-inline: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-primary);
    color: var(--color-text-inverse);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .home-local__btn:hover {
    background: var(--color-primary-hover);
  }

  .home-local__hub {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 48px;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .home-local__btn:focus-visible,
  .home-local__hub:focus-visible,
  .home-local__regions a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .home-local__regions {
    margin: var(--space-5) 0 0;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .home-local__regions a {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
  }

  .home-local__map {
    margin-top: var(--space-10);
  }

  .home-local__map-frame {
    display: block;
    width: 100%;
    height: 360px;
    border: 0;
    border-radius: var(--radius-2xl);
  }

  @media (max-width: 1023px) {
    .home-local__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  @media (max-width: 640px) {
    .home-local {
      padding-block: var(--space-12);
    }

    .home-local__inner,
    .home-local__map {
      padding-inline: var(--space-4);
    }

    .home-local__meta {
      grid-template-columns: minmax(0, 1fr);
    }

    .home-local__fact {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }

    .home-local__btn {
      width: 100%;
    }

    .home-local__map-frame {
      height: 280px;
    }
  }
</style>

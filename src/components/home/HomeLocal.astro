---
// HomeLocal — homepage block 8: Trust + CenterGallery + ServiceNetwork +
// SGK teaser merged into ONE local/entity section, Darıca first. Left: the
// real center photos (same four /images/pages/hakkimizda-*.webp used on
// /hakkimizda and /darica-isitme-cihazlari — no new image). Right: who we
// are (Trust's three verified facts as a compact strip), then COMPANY.md
// §17's hierarchy as a ladder — Darıca (primary) → Gebze + Çayırova →
// Kocaeli (regional) → Dilovası/Tuzla/Pendik as plain helper text — and a
// compact SGK info box (not a separate section). The four landing pages
// each get a visible, arrowed link.
import { MapPin, Navigation, ArrowRight, ShieldCheck } from "lucide-astro";
import HomeBlockHeader from "./HomeBlockHeader.astro";
import { homeCenterGallery } from "../../data/home/center-gallery";
import { serviceNetwork } from "../service-network/ServiceNetwork/service-network.data";
import { trust } from "../trust/Trust/trust.data";

const gallery = homeCenterGallery;
---

<section class="home-local" aria-labelledby="home-local-title">
  <div class="home-local__inner">
    <div class="home-local__photos">
      <div class="home-local__feature">
        <img
          class="home-local__feature-img"
          src={gallery.featureImage.src}
          alt={gallery.featureImage.alt}
          loading="lazy"
        />
        <div class="home-local__location">
          <img
            class="home-local__location-img"
            src={gallery.locationImage.src}
            alt={gallery.locationImage.alt}
            loading="lazy"
          />
          <p class="home-local__location-caption">{gallery.locationCaption}</p>
        </div>
      </div>
      <div class="home-local__support">
        <img class="home-local__support-img" src={gallery.supportImages[0].src} alt={gallery.supportImages[0].alt} loading="lazy" />
        <img class="home-local__support-img" src={gallery.supportImages[1].src} alt={gallery.supportImages[1].alt} loading="lazy" />
      </div>
    </div>

    <div class="home-local__content">
      <HomeBlockHeader
        id="home-local-title"
        eyebrow="Merkezimiz"
        heading="Darıca'daki Gerçek Merkezimiz"
        intro={gallery.paragraphs[0]}
      />

      <ul class="home-local__facts">
        {trust.facts.map((fact) => <li>{fact.title}</li>)}
      </ul>

      <div class="home-local__ladder">
        <a class="home-local__primary" href={serviceNetwork.primary.href}>
          <span class="home-local__primary-icon" aria-hidden="true">
            <MapPin size={22} stroke-width={1.75} />
          </span>
          <span class="home-local__primary-body">
            <span class="home-local__primary-name">{serviceNetwork.primary.name}</span>
            <span class="home-local__primary-desc">{serviceNetwork.primary.description}</span>
          </span>
          <span class="home-local__arrow home-local__arrow--light" aria-hidden="true">
            <ArrowRight size={20} stroke-width={2} />
          </span>
        </a>

        <div class="home-local__row">
          {
            serviceNetwork.priority.map((region) => (
              <a class="home-local__region" href={region.href}>
                <Navigation size={16} stroke-width={2} aria-hidden="true" />
                <span class="home-local__region-name">{region.name}</span>
                <span class="home-local__arrow" aria-hidden="true">
                  <ArrowRight size={16} stroke-width={2} />
                </span>
              </a>
            ))
          }
          <a class="home-local__region" href={serviceNetwork.regional.href}>
            <span class="home-local__region-name">{serviceNetwork.regional.name}</span>
            <span class="home-local__region-note">bölge geneli</span>
            <span class="home-local__arrow" aria-hidden="true">
              <ArrowRight size={16} stroke-width={2} />
            </span>
          </a>
        </div>

        <p class="home-local__helper">
          {serviceNetwork.secondarySentence}
        </p>
      </div>

      <a class="home-local__sgk" href="/sgk-isitme-cihazi-odemesi/">
        <span class="home-local__sgk-icon" aria-hidden="true">
          <ShieldCheck size={20} stroke-width={1.75} />
        </span>
        <span class="home-local__sgk-body">
          <span class="home-local__sgk-title">SGK anlaşmalı merkez</span>
          <span class="home-local__sgk-link">SGK işitme cihazı desteği hakkında bilgi alın →</span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .home-local {
    background: var(--color-background);
    color: var(--color-text);
    padding-block: var(--space-12);
  }

  .home-local__inner {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: var(--space-12);
    align-items: center;
  }

  /* --- Real photos: one feature + two support + a floating location card --- */

  .home-local__photos {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--space-3);
  }

  .home-local__feature {
    position: relative;
  }

  .home-local__feature-img,
  .home-local__support-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-md);
  }

  .home-local__feature-img {
    min-height: 420px;
  }

  .home-local__support {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: var(--space-3);
  }

  .home-local__location {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    max-width: 16rem;
    padding: var(--space-2);
    border-radius: var(--radius-lg);
    background: var(--color-background);
    box-shadow: var(--shadow-md);
  }

  .home-local__location-img {
    width: 44px;
    height: 44px;
    flex: none;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .home-local__location-caption {
    margin: 0;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    line-height: 1.35;
    color: var(--color-text);
  }

  /* --- Content --- */

  .home-local__content {
    min-width: 0;
  }

  .home-local__facts {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .home-local__facts li {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background: rgb(37 99 235 / 0.08);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
  }

  .home-local__ladder {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .home-local__primary {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius-2xl);
    background: var(--color-primary);
    color: var(--color-text-inverse);
    text-decoration: none;
    box-shadow: var(--shadow-lg);
    transition: transform var(--transition-base);
  }

  .home-local__primary:hover {
    transform: translateY(-2px);
  }

  .home-local__primary-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.15);
  }

  .home-local__primary-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .home-local__primary-name {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
  }

  .home-local__primary-desc {
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: #ffffff;
  }

  .home-local__row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .home-local__region {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-background);
    color: var(--color-primary);
    text-decoration: none;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .home-local__region:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .home-local__region-name {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  .home-local__region-note {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .home-local__arrow {
    display: inline-flex;
    margin-left: auto;
    transition: transform var(--transition-base);
  }

  .home-local__arrow--light {
    color: var(--color-text-inverse);
  }

  a:hover > .home-local__arrow,
  a:focus-visible > .home-local__arrow {
    transform: translateX(4px);
  }

  .home-local__primary:focus-visible,
  .home-local__region:focus-visible,
  .home-local__sgk:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .home-local__helper {
    margin: 0;
    padding-inline: var(--space-1);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  /* SGK: a compact info box, not a section. */
  .home-local__sgk {
    margin-top: var(--space-5);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid rgb(37 99 235 / 0.3);
    border-radius: var(--radius-lg);
    background: rgb(37 99 235 / 0.05);
    text-decoration: none;
  }

  .home-local__sgk-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: rgb(37 99 235 / 0.12);
    color: var(--color-primary);
  }

  .home-local__sgk-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .home-local__sgk-title {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
  }

  .home-local__sgk-link {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
  }

  .home-local__sgk:hover .home-local__sgk-link {
    text-decoration: underline;
  }

  @media (max-width: 1023px) {
    .home-local__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }

    .home-local__feature-img {
      min-height: 320px;
    }
  }

  @media (max-width: 640px) {
    .home-local {
      padding-block: var(--space-12);
    }

    .home-local__inner {
      padding-inline: var(--space-4);
    }

    .home-local__feature-img {
      min-height: 240px;
    }

    .home-local__row {
      grid-template-columns: minmax(0, 1fr);
    }

    .home-local__primary {
      padding: var(--space-4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-local__primary:hover,
    a:hover > .home-local__arrow {
      transform: none;
    }
  }
</style>

---
// HomeTrust — ana sayfanın 4. bölümü: "Güven / Kurumsal Bilgiler" (Faz 2
// P2, onay V1). Yalnızca SoT'ta doğrulanmış bilgiler; kaynak notları
// data/home/trust.ts içinde. Tek bağlamsal link: /hakkimizda/.
import { ArrowRight } from "lucide-astro";
import HomeBlockHeader from "./HomeBlockHeader.astro";
import { homeTrust } from "../../data/home/trust";
---

<section class="home-trust" aria-labelledby="home-trust-title">
  <div class="home-trust__inner">
    <HomeBlockHeader id="home-trust-title" eyebrow={homeTrust.eyebrow} heading={homeTrust.heading} intro={homeTrust.intro} />

    <dl class="home-trust__grid">
      {homeTrust.items.map((item) => (
        <div class="home-trust__item">
          <dt class="home-trust__value">{item.value}</dt>
          <dd class="home-trust__label">{item.label}</dd>
        </div>
      ))}
    </dl>

    <a class="home-trust__link" href={homeTrust.aboutLink.href}>
      <span>{homeTrust.aboutLink.label}</span>
      <ArrowRight size={18} stroke-width={2} aria-hidden="true" />
    </a>
  </div>
</section>

<style>
  .home-trust {
    background: var(--color-surface);
    color: var(--color-text);
    padding-block: var(--space-16);
  }

  .home-trust__inner {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .home-trust__grid {
    margin: var(--space-8) 0 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .home-trust__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-background);
  }

  .home-trust__value {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    line-height: var(--line-height-tight);
  }

  .home-trust__label {
    margin: 0;
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text);
  }

  .home-trust__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 48px;
    margin-top: var(--space-6);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .home-trust__link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  @media (max-width: 1023px) {
    .home-trust__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .home-trust {
      padding-block: var(--space-12);
    }

    .home-trust__inner {
      padding-inline: var(--space-4);
    }

    .home-trust__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }
  }
</style>

---
// HomeShowroom — homepage block 6: Brands + Model Showcase merged into ONE
// section (was two: logo strip, then a separate model grid). The brand
// marquee (Brands, embedded) proves range; the compact model row
// (BrandPageModels, embedded + compact) proves it with real, verified
// products and their real product photos. Both reuse existing components
// and data (brands.data.ts, data/home/models.ts) — nothing new is claimed.
import Brands from "../brands/Brands/Brands.astro";
import BrandPageModels from "../brand-page/BrandPageModels/BrandPageModels.astro";
import HomeBlockHeader from "./HomeBlockHeader.astro";
import { brands } from "../brands/Brands/brands.data";
import { homeModels } from "../../data/home/models";
---

<section class="home-showroom" aria-labelledby="home-showroom-title">
  <div class="home-showroom__inner">
    <HomeBlockHeader
      id="home-showroom-title"
      eyebrow="Markalar ve Modeller"
      heading="18 Marka, Gerçek Modeller"
      intro="Tek bir markaya bağlı değiliz; işitme kaybınıza ve yaşam tarzınıza uygun olanı birlikte seçiyoruz."
    />

    <div class="home-showroom__brands">
      <Brands embedded />
    </div>

    <BrandPageModels data={homeModels} compact embedded />

    <p class="home-showroom__footer">
      <a class="home-showroom__link" href={brands.hubCta.href}>{brands.hubCta.label} →</a>
    </p>
  </div>
</section>

<style>
  .home-showroom {
    background: var(--color-background);
    color: var(--color-text);
    padding-block: var(--space-12);
  }

  .home-showroom__inner {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .home-showroom__brands {
    margin-block: var(--space-8) var(--space-8);
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-border);
    overflow: hidden;
  }

  .home-showroom__footer {
    margin: var(--space-6) 0 0;
    text-align: right;
  }

  .home-showroom__link {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .home-showroom__link:hover {
    text-decoration: underline;
  }

  .home-showroom__link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  @media (max-width: 640px) {
    .home-showroom {
      padding-block: var(--space-12);
    }

    .home-showroom__inner {
      padding-inline: var(--space-4);
    }

    .home-showroom__footer {
      text-align: left;
    }
  }
</style>

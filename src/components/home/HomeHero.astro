---
// HomeHero — ana sayfanın tek, statik hero'su. Tek H1, ilk ekranda telefonla ulaşılabilirlik ve ziyaret bilgisi.
// Hiyerarşi (işletme sahibi kararı, 2026-11-17): birincil = TELEFON — "Telefonla Bize Ulaşın · 23:59'a kadar · numara ·
// Bizi Arayın" (ortak PhoneReach bloğu; numara ve buton aynı tel: bağlantısına gider); ikincil = Ücretsiz İşitme
// Testi (aynı blokta, çerçeveli); üçüncül = WhatsApp'tan Yazın ve yol tarifi (ziyaret kutusunun altında).
// Önceki hiyerarşide (araştırma raporu U1) birincil CTA Ücretsiz İşitme Testi idi.
//
// Görsel gerçek merkez fotoğrafıdır (D1) ve üzerindeki kart yalnızca LOCAL_SOT'taki doğrulanmış MERKEZ ZİYARET
// saatlerini gösterir. Kartın "Şu an açık/kapalı" satırı (OpenStatus) fiziksel merkeze aittir; telefonla
// ulaşılabilirlik (23:59) ayrı bloktadır ve bu kartın hesabına girmez.
//
// Mobilde sıra: üst başlık → H1 → telefon bloğu → açıklama → ziyaret kutusu (telefon bilgisi ilk ekranda kalsın diye
// yalnızca görsel sıra `order` ile değişir; kaynak sırası ve odak sırası aynıdır).
//
// Ölçüm: CTA'lar mevcut href desenlerini kullanır (tel:, wa.me, maps.app.goo.gl, /degerlendirme/ucretsiz-isitme-testi/);
// events.ts sınıf adındaki "hero" kalıbından link_location="hero" üretir. Olay adları değişmedi.
import { Stethoscope, MapPin, Navigation, Clock } from "lucide-astro";
import WhatsAppIcon from "../shared/WhatsAppIcon/WhatsAppIcon.astro";
import HeroDeviceStage from "./HeroDeviceStage.astro";
import OpenStatus from "../shared/OpenStatus/OpenStatus.astro";
import PhoneReach from "../shared/PhoneReach/PhoneReach.astro";
import { company } from "../footer/Footer/data/company";
import { contactConfig } from "../../config/contact";
import type { HomeHeroContent } from "../../data/home/hero";

interface Props {
  data: HomeHeroContent;
}

const { data } = Astro.props;
// Süzülen cihaz görseli dik (uzun) ise fotoğrafın üstünde ayrılan boşluk görselin oranından hesaplanır (aşağıdaki stil).
const stage = data.deviceStage;
const stageTall = !!stage && stage.height > stage.width;
---

<section class:list={["home-hero", { "home-hero--with-image": !!data.image }]} aria-labelledby="home-hero-title">
  <div class="home-hero__inner">
    <div class="home-hero__copy">
      <p class="home-hero__eyebrow">{data.eyebrow}</p>
      <h1 class="home-hero__title" id="home-hero-title">{data.heading}</h1>
      <p class="home-hero__description">{data.description}</p>

      <PhoneReach
        variant="hero"
        class="home-hero__reach"
        headingId="home-hero-reach-title"
        secondaryCta={{ ...data.secondaryCta, icon: Stethoscope }}
      />

      <p class="home-hero__visit">
        <MapPin size={22} stroke-width={1.75} aria-hidden="true" class="home-hero__visit-icon" />
        <span>{data.visit}</span>
      </p>

      <div class="home-hero__links">
        <a class="home-hero__btn home-hero__btn--secondary home-hero__btn--wa" href={data.whatsappCta.href}>
          <WhatsAppIcon size={22} class="home-hero__wa-icon" />
          <span>{data.whatsappCta.label}</span>
        </a>
        <a class="home-hero__text-link" href={data.textLink.href} target="_blank" rel="noopener">
          <Navigation size={18} stroke-width={2} aria-hidden="true" />
          <span>{data.textLink.label}</span>
        </a>
      </div>
    </div>

    {
      data.image && (
        <div
          class:list={["home-hero__media", { "home-hero__media--stage": !!stage && !stageTall, "home-hero__media--stage-tall": stageTall }]}
          style={stage && stageTall ? `--device-stage-ratio:${(stage.height / stage.width).toFixed(4)};` : undefined}
        >
          {stage && <HeroDeviceStage {...stage} />}
          <img
            class="home-hero__image"
            src={data.image.src}
            srcset={data.image.srcset}
            sizes={data.image.sizes ?? "(min-width: 1024px) 50vw, 100vw"}
            alt={data.image.alt}
            width={data.image.width}
            height={data.image.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="home-hero__hours" role="group" aria-labelledby="home-hero-hours-title">
            <Clock size={20} stroke-width={1.75} aria-hidden="true" class="home-hero__hours-icon" />
            <div class="home-hero__hours-body">
              <p class="home-hero__hours-title" id="home-hero-hours-title">{contactConfig.phoneReach.visitHoursLabel}</p>
              <OpenStatus />
              <dl>
                {company.hours.map((h) => (
                  <div>
                    <dt>{h.days}</dt>
                    <dd>{h.time}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .home-hero {
    /* Süzülen cihazın yumuşak hâlesi kenardan taşabilir; yatay kaydırma oluşturmasın (özellikle büyük yazı boyutunda). */
    overflow-x: clip;
    background:
      radial-gradient(ellipse 50% 70% at 92% 8%, rgb(var(--brand-teal-rgb) / 0.16) 0%, transparent 62%),
      linear-gradient(180deg, var(--color-primary-50) 0%, var(--color-background) 100%);
    color: var(--color-text);
    /* Telefon bloğu eklendiği için üst/alt boşluk 64 → 48 px (hero'nun toplam yüksekliği gereksiz büyümesin). */
    padding-block: var(--space-12);
    border-bottom: 1px solid var(--color-border);
  }

  .home-hero__inner {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .home-hero--with-image .home-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: var(--space-12);
    align-items: center;
  }

  .home-hero__copy {
    max-width: 46rem;
  }

  .home-hero__eyebrow {
    margin: 0 0 var(--space-3);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.01em;
    color: var(--color-accent-text);
  }

  .home-hero__title {
    margin: 0;
    font-size: clamp(2.25rem, 1.6rem + 3vw, 3.75rem);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    letter-spacing: -0.02em;
    color: var(--brand-navy);
  }

  .home-hero__description {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text);
  }

  /* Telefon bloğu (PhoneReach) — hero'nun birincil aksiyonu. */
  .home-hero__copy :global(.home-hero__reach) {
    margin-top: var(--space-5);
  }

  .home-hero__visit {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border-hover);
    border-radius: var(--radius-lg);
    background: var(--color-background);
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text);
  }

  .home-hero__visit-icon {
    flex: none;
    margin-top: 2px;
    color: var(--color-primary);
  }

  /* Üçüncül satır: WhatsApp (beyaz, 48 px) + yol tarifi (metin bağlantı). Birincil/ikincil CTA telefon bloğundadır. */
  .home-hero__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-3);
  }

  /* Minimum 48 px dokunma hedefi (K5). */
  .home-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 48px;
    padding-inline: var(--space-5);
    border-radius: var(--radius-lg);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    line-height: 1.2;
    text-decoration: none;
    transition: background-color var(--transition-base), border-color var(--transition-base), color var(--transition-base);
  }

  .home-hero__btn--secondary {
    background: var(--color-background);
    color: var(--color-text);
    border: 1px solid var(--color-border-hover);
  }

  .home-hero__btn--secondary :global(.home-hero__wa-icon) {
    color: #25d366;
  }

  .home-hero__btn--secondary:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-50);
  }

  .home-hero__btn:focus-visible,
  .home-hero__text-link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .home-hero__text-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 48px;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .home-hero__media {
    position: relative;
    min-width: 0;
  }

  /* Süzülen cihaz için fotoğrafın üstünde ayrılan sahne boşluğu (cihaz fotoğrafın sağ üst köşesine biner). */
  .home-hero__media--stage {
    padding-top: 124px;
  }

  /* Dik (uzun) cihaz görseli — 3B modelin karesi. Sahne genişliği fotoğrafın genişliğiyle orantılıdır, böylece her ekran
     genişliğinde aynı kompozisyon korunur. Üstte ayrılan boşluk = sahne yüksekliği − cihazın fotoğrafa bindiği pay
     (fotoğraf genişliğinin %4,4'ü: pil kapağı duvardaki tabelanın üst kenarına inmeden kalır). Yüzdeler bu kutunun
     genişliğine göredir; `--device-stage-w` değerini HeroDeviceStage de sahne genişliği olarak kullanır. */
  .home-hero__media--stage-tall {
    --device-stage-w: clamp(100px, 23.5%, 150px);
    padding-top: calc(var(--device-stage-w) * var(--device-stage-ratio, 1.3333) - 4.4%);
  }

  .home-hero__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-lg);
  }

  .home-hero__hours {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    max-width: calc(100% - var(--space-8));
    padding: var(--space-3) var(--space-4);
    border: 1px solid rgb(255 255 255 / 0.6);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.94);
    box-shadow: var(--shadow-md);
    backdrop-filter: blur(6px);
  }

  .home-hero__hours-icon {
    flex: none;
    margin-top: 3px;
    color: var(--color-primary);
  }

  .home-hero__hours-body {
    min-width: 0;
  }

  /* Kartın neyi gösterdiğini adlandırır: FİZİKSEL merkezin ziyaret saatleri (telefonla ulaşılabilirlik değil). */
  .home-hero__hours-title {
    margin: 0 0 2px;
    font-size: 0.8125rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .home-hero__hours dl {
    margin: 0;
    display: grid;
    gap: 2px;
  }

  .home-hero__hours dl div {
    display: flex;
    gap: var(--space-3);
    justify-content: space-between;
    font-size: var(--font-size-sm);
    line-height: 1.4;
  }

  .home-hero__hours dt {
    color: var(--color-text-muted);
  }

  .home-hero__hours dd {
    margin: 0;
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }

  @media (max-width: 1023px) {
    .home-hero--with-image .home-hero__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  @media (max-width: 640px) {
    .home-hero {
      padding-block: var(--space-8);
    }

    .home-hero__inner {
      padding-inline: var(--space-4);
    }

    /* Mobilde telefon bloğu H1'in hemen altına gelir (ilk ekranda görünsün); açıklama ve ziyaret kutusu onu izler.
       Yalnızca görsel sıra değişir; kaynak ve odak sırası aynıdır. */
    .home-hero__copy {
      display: flex;
      flex-direction: column;
    }

    .home-hero__copy :global(.home-hero__reach) {
      order: 1;
      margin-top: var(--space-4);
    }

    .home-hero__description {
      order: 2;
      font-size: var(--font-size-md);
    }

    .home-hero__visit {
      order: 3;
    }

    .home-hero__links {
      order: 4;
    }

    .home-hero__btn {
      padding-inline: var(--space-4);
    }

    .home-hero__media--stage {
      padding-top: 92px;
    }

    .home-hero__hours {
      position: static;
      margin-top: var(--space-3);
      max-width: none;
      background: var(--color-background);
      border-color: var(--color-border-hover);
    }
  }
</style>

---
// HomeExplore — ana sayfanın 5. bölümü: "İşitme Cihazları ve Markalar" kısa
// özeti (Faz 2 P2, onay V1). Önceki sürümdeki karşılaştırma tablosu ve
// ayrı HomeShowroom model vitrini ana sayfadan kaldırıldı; ayrıntılı
// karşılaştırma ve seçim kriterleri kendi pillar sayfalarında kalır.
// Burada: cihaz türü başına tek kart (tek link) + 18 markanın logo şeridi
// (Brands, embedded) + iki hub linki. Kart metinleri mevcut kilitli
// category-explorer verisinden; yeni iddia yok.
import { ArrowRight } from "lucide-astro";
import HomeBlockHeader from "./HomeBlockHeader.astro";
import Brands from "../brands/Brands/Brands.astro";
import { categoryExplorer } from "../../data/category-explorer/category-explorer.data";
---

<section class="home-explore" aria-labelledby="home-explore-title">
  <div class="home-explore__inner">
    <HomeBlockHeader
      id="home-explore-title"
      eyebrow="İşitme Cihazları ve Markalar"
      heading="İşitme Cihazı Türleri ve 18 Marka"
      intro={categoryExplorer.intro}
    />

    <ul class="home-explore__grid">
      {
        categoryExplorer.items.map((item) => {
          const Icon = item.icon;
          return (
            <li>
              <a class="home-explore__card" href={item.href}>
                <span class="home-explore__icon" aria-hidden="true">
                  <Icon size={20} stroke-width={1.75} />
                </span>
                <span class="home-explore__name">{item.name}</span>
                <span class="home-explore__desc">{item.description}</span>
              </a>
            </li>
          );
        })
      }
    </ul>

    <p class="home-explore__brands-lead">
      Tek bir markaya bağlı değiliz; 18 marka satıyor ve tamamında teknik servis veriyoruz.
    </p>
    <div class="home-explore__brands">
      <Brands embedded />
    </div>

    <p class="home-explore__footer">
      <a class="home-explore__hub" href={categoryExplorer.hubCta.href}>
        <span>{categoryExplorer.hubCta.label}</span>
        <ArrowRight size={18} stroke-width={2} aria-hidden="true" />
      </a>
      <a class="home-explore__hub" href="/markalar/">
        <span>Tüm markaları inceleyin</span>
        <ArrowRight size={18} stroke-width={2} aria-hidden="true" />
      </a>
    </p>
  </div>
</section>

<style>
  .home-explore {
    background: var(--color-background);
    color: var(--color-text);
    padding-block: var(--space-16);
  }

  .home-explore__inner {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .home-explore__grid {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .home-explore__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    min-height: 48px;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-background);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .home-explore__card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .home-explore__card:focus-visible,
  .home-explore__hub:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .home-explore__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-lg);
    background: rgb(37 99 235 / 0.08);
    color: var(--color-primary);
  }

  .home-explore__name {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
  }

  .home-explore__desc {
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .home-explore__brands-lead {
    margin: var(--space-10) 0 0;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
  }

  .home-explore__brands {
    margin-top: var(--space-4);
  }

  .home-explore__footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin: var(--space-6) 0 0;
  }

  .home-explore__hub {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 48px;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 1023px) {
    .home-explore__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .home-explore {
      padding-block: var(--space-12);
    }

    .home-explore__inner {
      padding-inline: var(--space-4);
    }

    .home-explore__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }

    .home-explore__card {
      padding: var(--space-4);
    }
  }
</style>

---
// HomeExplore — ana sayfanın 5. bölümü: "İşitme Cihazları ve Markalar" kısa
// özeti (Faz 2 P2, onay V1). Önceki sürümdeki karşılaştırma tablosu ve
// ayrı HomeShowroom model vitrini ana sayfadan kaldırıldı; ayrıntılı
// karşılaştırma ve seçim kriterleri kendi pillar sayfalarında kalır.
// Burada: cihaz türü başına tek kart (tek link) bir CAROUSEL'de (mobilde dokunmatik kaydırma, masaüstünde oklar;
// görseller temsili) + 18 markanın logo şeridi (Brands, embedded) + iki hub linki. Kart metinleri mevcut kilitli
// category-explorer verisinden; yeni iddia yok.
import { ArrowRight } from "lucide-astro";
import HomeBlockHeader from "./HomeBlockHeader.astro";
import Brands from "../brands/Brands/Brands.astro";
import DeviceTypeCarousel from "../device-types/DeviceTypeCarousel.astro";
import { categoryExplorer } from "../../data/category-explorer/category-explorer.data";
import { deviceTypeCards, deviceFeatureLinks } from "../../data/device-types/carousel";
---

<section class="home-explore" aria-labelledby="home-explore-title">
  <div class="home-explore__inner">
    <HomeBlockHeader
      id="home-explore-title"
      eyebrow="İşitme Cihazları ve Markalar"
      heading="İşitme Cihazı Türleri ve 18 Marka"
      intro={categoryExplorer.intro}
    />

    <div class="home-explore__carousel">
      <DeviceTypeCarousel items={deviceTypeCards} label="İşitme cihazı türleri" />
    </div>

    {
      deviceFeatureLinks.length > 0 && (
        <nav class="home-explore__features" aria-label="Özelliğe göre işitme cihazları">
          <p class="home-explore__features-label">Özelliğe göre:</p>
          <ul class="home-explore__features-list">
            {deviceFeatureLinks.map((l) => (
              <li>
                <a class="home-explore__feature" href={l.href}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <p class="home-explore__brands-lead">
      Tek bir markaya bağlı değiliz; 18 marka satıyor ve tamamında teknik servis veriyoruz.
    </p>
    <div class="home-explore__brands">
      <Brands embedded />
    </div>

    <p class="home-explore__footer">
      <a class="home-explore__hub" href={categoryExplorer.hubCta.href}>
        <span>{categoryExplorer.hubCta.label}</span>
        <ArrowRight size={18} stroke-width={2} aria-hidden="true" />
      </a>
      <a class="home-explore__hub" href="/markalar/">
        <span>Tüm markaları inceleyin</span>
        <ArrowRight size={18} stroke-width={2} aria-hidden="true" />
      </a>
    </p>
  </div>
</section>

<style>
  .home-explore {
    background: var(--color-background);
    color: var(--color-text);
    padding-block: var(--space-16);
  }

  .home-explore__inner {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .home-explore__carousel {
    margin-top: var(--space-8);
  }



  .home-explore__hub:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }




  /* Özelliğe göre ayrılan sayfalar (şarjlı, Bluetooth, çocuk, suya dayanıklı): carousel'in altında bağlantı satırı. */
  .home-explore__features {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .home-explore__features-label {
    margin: 0;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
  }

  .home-explore__features-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-explore__feature {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border-hover);
    border-radius: var(--radius-full);
    background: var(--color-background);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    transition:
      background-color var(--transition-base),
      border-color var(--transition-base);
  }

  .home-explore__feature:hover {
    background: var(--color-primary-50);
    border-color: var(--color-primary);
  }

  .home-explore__feature:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .home-explore__brands-lead {
    margin: var(--space-10) 0 0;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
  }

  .home-explore__brands {
    margin-top: var(--space-4);
  }

  .home-explore__footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin: var(--space-6) 0 0;
  }

  .home-explore__hub {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 48px;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
  }


  @media (max-width: 640px) {
    .home-explore {
      padding-block: var(--space-12);
    }

    .home-explore__inner {
      padding-inline: var(--space-4);
    }


  }
</style>

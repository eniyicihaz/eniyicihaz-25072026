---
// BrandHero — M1 of the /markalar ("Tüm Markalar") page. This page is
// built up modularly (M1, M2, M3…); this component is only ever M1 (Hero).
// Do not add later modules here — each gets its own component.
import CtaButton from "../../shared/CtaButton/CtaButton.astro";
import { Phone, Check } from "lucide-astro";
import { brandHero } from "../../../data/brands/hero";
import "./BrandHero.css";
---

<section class="brand-hero" aria-labelledby="brand-hero-title">
  <div class="brand-hero__inner">
    <div class="brand-hero__copy" data-rise>
      <p class="brand-hero__badge">{brandHero.badge}</p>

      <h1 class="brand-hero__heading" id="brand-hero-title">
        {
          brandHero.headingLines.map((line) => (
            <span class="brand-hero__heading-line">{line}</span>
          ))
        }
      </h1>

      {brandHero.description.map((paragraph) => <p class="brand-hero__desc">{paragraph}</p>)}

      <div class="brand-hero__actions">
        <CtaButton
          label={brandHero.ctaPrimary.label}
          href={brandHero.ctaPrimary.href}
          iconLeft={Phone}
        />
        {
          /* Hand-written (not <CtaButton>) only because CtaButton's
             iconLeft prop expects an Astro component reference, and the
             real WhatsApp glyph is a one-off inline SVG, not a
             lucide-astro icon (lucide is a generic set and deliberately
             carries no brand logos — a generic chat bubble was standing
             in for it before). The class below (.brand-hero__whatsapp-btn)
             mirrors CtaButton's exact recipe in BrandHero.css, so the
             size/radius/hover-lift/focus-ring all match — same premium
             quality, just not routed through the shared component for
             this one icon. */
        }
        <a
          class="brand-hero__whatsapp-btn"
          href={brandHero.ctaSecondary.href}
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.99c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413" />
          </svg>
          <span>{brandHero.ctaSecondary.label}</span>
        </a>
      </div>

      <ul class="brand-hero__pills">
        {
          brandHero.trustPills.map((pill) => (
            <li class="brand-hero__pill">
              <Check size={14} stroke-width={2.5} aria-hidden="true" />
              <span>{pill}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="brand-hero__visual" data-rise>
      <div class="brand-hero__floating-card">
        <span class="brand-hero__floating-value">{brandHero.floatingCard.value}</span>
        <span class="brand-hero__floating-label">{brandHero.floatingCard.label}</span>
        <p class="brand-hero__floating-desc">{brandHero.floatingCard.description}</p>
      </div>

      <div class="brand-hero__frame">
        <img
          class="brand-hero__photo"
          src={brandHero.image.src}
          alt={brandHero.image.alt}
          width="600"
          height="600"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    // Same entrance state-machine as every other section on the site
    // (Hero/Brands/Trust…): IntersectionObserver, a failsafe timeout, and a
    // prefers-reduced-motion bail.
    var section = document.querySelector(".brand-hero");
    if (!section) return;
    if (!("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    section.dataset.anim = "pending";

    var revealed = false;
    var ioAlive = false;
    var io;

    function reveal() {
      if (revealed) return;
      revealed = true;
      section.dataset.anim = "in";
      if (io) io.disconnect();
    }

    var failsafe = setTimeout(function () {
      if (!ioAlive) reveal();
    }, 1500);

    io = new IntersectionObserver(
      function (entries) {
        ioAlive = true;
        clearTimeout(failsafe);
        if (entries[0].isIntersecting) reveal();
      },
      { threshold: 0.15 }
    );

    io.observe(section);
  })();
</script>

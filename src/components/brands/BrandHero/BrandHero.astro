---
// BrandHero — M1 of the modular hub-page system (originally built for
// /markalar's "Tüm Markalar" page; now also reused by /isitme-cihazlari,
// /hizmetlerimiz and /bilgi-merkezi). Always M1 (Hero) of its page — do
// not add later modules here, each gets its own component. Generic:
// takes its content via the `data` prop rather than a fixed import, so
// every hub page can supply its own copy while sharing this exact
// markup/CSS.
import CtaButton from "../../shared/CtaButton/CtaButton.astro";
import { Check } from "lucide-astro";
import "./BrandHero.css";

export interface BrandHeroCta {
  label: string;
  href: string;
}

export interface BrandHeroImage {
  src: string;
  alt: string;
}

export interface BrandHeroFloatingCard {
  value: string;
  label: string;
  description: string;
}

export interface BrandHeroContent {
  badge: string;
  headingLines: string[];
  description: string[];
  ctaPrimary: BrandHeroCta;
  ctaSecondary: BrandHeroCta;
  trustPills: string[];
  // Optional: when `image` is omitted the hero renders as a single text column.
  image?: BrandHeroImage;
  floatingCard?: BrandHeroFloatingCard;
}

interface Props {
  data: BrandHeroContent;
}

const { data: brandHero } = Astro.props;
---

<section class="brand-hero" aria-labelledby="brand-hero-title">
  <div class:list={["brand-hero__inner", { "brand-hero__inner--text-only": !brandHero.image }]}>
    <div class="brand-hero__copy" data-rise>
      <p class="brand-hero__badge">{brandHero.badge}</p>

      <h1 class="brand-hero__heading" id="brand-hero-title">
        {
          brandHero.headingLines.map((line) => (
            <span class="brand-hero__heading-line">{line}</span>
          ))
        }
      </h1>

      {brandHero.description.map((paragraph) => <p class="brand-hero__desc">{paragraph}</p>)}

      <div class="brand-hero__actions">
        {/* Telefon birincil, WhatsApp ikincil; görünüm href'ten gelir (contact-actions.css). */}
        <CtaButton label={brandHero.ctaPrimary.label} href={brandHero.ctaPrimary.href} />
        <CtaButton label={brandHero.ctaSecondary.label} href={brandHero.ctaSecondary.href} />
      </div>

      <ul class="brand-hero__pills">
        {
          brandHero.trustPills.map((pill) => (
            <li class="brand-hero__pill">
              <Check size={14} stroke-width={2.5} aria-hidden="true" />
              <span>{pill}</span>
            </li>
          ))
        }
      </ul>
    </div>

    {brandHero.image && (
    <div class="brand-hero__visual" data-rise>
      {brandHero.floatingCard && (
      <div class="brand-hero__floating-card">
        <span class="brand-hero__floating-value">{brandHero.floatingCard.value}</span>
        <span class="brand-hero__floating-label">{brandHero.floatingCard.label}</span>
        <p class="brand-hero__floating-desc">{brandHero.floatingCard.description}</p>
      </div>
      )}

      <div class="brand-hero__frame">
        <img
          class="brand-hero__photo"
          src={brandHero.image.src}
          alt={brandHero.image.alt}
          width="600"
          height="600"
          loading="eager"
        />
      </div>
    </div>
    )}
  </div>
</section>

<script is:inline>
  (function () {
    // Same entrance state-machine as every other section on the site
    // (Hero/Brands/Trust…): IntersectionObserver, a failsafe timeout, and a
    // prefers-reduced-motion bail.
    var section = document.querySelector(".brand-hero");
    if (!section) return;
    if (!("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    section.dataset.anim = "pending";

    var revealed = false;
    var ioAlive = false;
    var io;

    function reveal() {
      if (revealed) return;
      revealed = true;
      section.dataset.anim = "in";
      if (io) io.disconnect();
    }

    var failsafe = setTimeout(function () {
      if (!ioAlive) reveal();
    }, 1500);

    io = new IntersectionObserver(
      function (entries) {
        ioAlive = true;
        clearTimeout(failsafe);
        if (entries[0].isIntersecting) reveal();
      },
      { threshold: 0.15 }
    );

    io.observe(section);
  })();
</script>

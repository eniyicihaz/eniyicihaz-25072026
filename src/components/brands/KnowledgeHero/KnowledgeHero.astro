---
// KnowledgeHero — /bilgi-merkezi sayfasına özel hero.
// Ortak BrandHero'nun görselsiz (text-only) modu tek sütundur ve geniş
// ekranda sağ yarıyı boş bırakır; bu sayfa bir içerik dizini olduğu için
// sağ kolon dekoratif görsel yerine sayfanın kendi bölümlerine giden
// işlevsel bir "Ne arıyorsunuz?" paneli taşır. İçerik (rozet, başlık,
// açıklama, CTA'lar, güven etiketleri) mevcut data/knowledge/hero.ts'ten
// aynen alınır; ortak BrandHero'ya dokunulmaz. JavaScript yoktur.
import CtaButton from "../../shared/CtaButton/CtaButton.astro";
import { Check, ArrowRight, BookOpen, Landmark, Compass, HelpCircle } from "lucide-astro";
import type { BrandHeroContent } from "../BrandHero/BrandHero.astro";
import type { KnowledgeHeroPanel } from "../../../data/knowledge/hero-panel";

interface Props {
  data: BrandHeroContent;
  panel: KnowledgeHeroPanel;
}

const { data, panel } = Astro.props;

const icons = {
  guides: BookOpen,
  "sgk-blog": Landmark,
  match: Compass,
  faq: HelpCircle,
};
---

<section class="kh" aria-labelledby="brand-hero-title" data-track-location="hero">
  <div class="kh__inner">
    <div class="kh__copy">
      <p class="kh__badge">{data.badge}</p>

      <h1 class="kh__heading" id="brand-hero-title">
        {data.headingLines.map((line) => <span class="kh__heading-line">{line}</span>)}
      </h1>

      {data.description.map((p) => <p class="kh__desc">{p}</p>)}

      <div class="kh__actions">
        {/* Telefon birincil, WhatsApp ikincil; görünüm href'ten gelir (contact-actions.css). */}
        <CtaButton label={data.ctaPrimary.label} href={data.ctaPrimary.href} />
        <CtaButton label={data.ctaSecondary.label} href={data.ctaSecondary.href} />
      </div>

      <ul class="kh__pills">
        {
          data.trustPills.map((pill) => (
            <li class="kh__pill">
              <Check size={14} stroke-width={2.5} aria-hidden="true" />
              <span>{pill}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <nav class="kh__panel" aria-labelledby="kh-panel-title">
      <h2 class="kh__panel-title" id="kh-panel-title">{panel.title}</h2>

      <ul class="kh__links">
        {
          panel.links.map((link) => {
            const Icon = icons[link.icon];
            return (
              <li>
                <a class="kh__link" href={link.href}>
                  <span class="kh__link-icon">
                    <Icon size={22} stroke-width={1.85} aria-hidden="true" />
                  </span>
                  <span class="kh__link-label">{link.label}</span>
                  <ArrowRight class="kh__link-arrow" size={16} stroke-width={2} aria-hidden="true" />
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</section>

<style>
  .kh {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 92vh;
    background: var(--color-surface);
    color: var(--color-text);
    padding-block: var(--space-8);
  }

  .kh__inner {
    width: 100%;
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding-inline: var(--space-12);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: var(--space-12);
  }

  /* --- Left: content (BrandHero ile aynı tarif) --------------------------- */

  .kh__badge {
    display: inline-block;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-background);
    box-shadow: var(--shadow-xs);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
  }

  .kh__heading {
    margin: var(--space-3) 0 0;
    font-size: clamp(2.5rem, 1.6rem + 2.6vw, 4rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .kh__heading-line {
    display: block;
  }

  .kh__desc {
    margin: var(--space-3) 0 0;
    max-width: 36rem;
    font-size: var(--font-size-md);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .kh__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .kh__pills {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
  }

  .kh__pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-background);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .kh__pill :global(svg) {
    flex: none;
    color: var(--color-primary);
  }

  /* --- Right: navigation panel -------------------------------------------- */

  .kh__panel {
    padding: var(--space-8) var(--space-6);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-lg);
  }

  .kh__panel-title {
    margin: 0;
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    line-height: 1.3;
    color: var(--color-text);
  }

  .kh__links {
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .kh__link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color 250ms ease, background-color 250ms ease, box-shadow 250ms ease;
  }

  .kh__link:hover {
    background: #eff6ff;
    border-color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .kh__link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .kh__link-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    background: rgb(37 99 235 / 0.1);
    color: var(--color-primary);
  }

  .kh__link-label {
    flex: 1;
    min-width: 0;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    line-height: 1.35;
  }

  .kh__link :global(.kh__link-arrow) {
    flex: none;
    color: var(--color-text-muted);
    transition: color 250ms ease, transform 250ms ease;
  }

  .kh__link:hover :global(.kh__link-arrow) {
    color: var(--color-primary);
    transform: translateX(3px);
  }

  /* --- Responsive ---------------------------------------------------------- */

  @media (max-width: 1023px) {
    .kh {
      min-height: 0;
      padding-block: var(--space-12);
    }

    .kh__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-10);
      padding-inline: var(--space-6);
    }

    .kh__panel {
      max-width: 36rem;
    }
  }

  @media (max-width: 640px) {
    .kh {
      padding-block: var(--space-8);
    }

    .kh__inner {
      padding-inline: var(--space-5);
      gap: var(--space-8);
    }

    .kh__heading {
      font-size: clamp(2.125rem, 1.9rem + 1.2vw, 2.5rem);
    }

    .kh__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .kh__panel {
      padding: var(--space-6) var(--space-4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kh__link,
    .kh__link :global(.kh__link-arrow) {
      transition: none;
    }

    .kh__link:hover :global(.kh__link-arrow) {
      transform: none;
    }
  }
</style>

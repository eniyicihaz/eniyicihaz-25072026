---
// BrandExpertSupport — M7 of the /markalar ("Tüm Markalar") page, directly
// under BrandExtended (M6). This page is built up modularly (M1...M7…);
// this component is only ever M7 and is the page's final major section
// before the Footer. Do not add later modules here — each gets its own
// component.
//
// M2–M6 already did the informing. This section sells no brand and adds no
// new information — it's the page's strongest conversion moment. Two
// columns inside one quiet card, roles kept strictly distinct:
//   - left = the ask: badge, heading, paragraph, a two-column trust
//     checklist, both CTAs, a free-of-commitment reassurance line.
//   - right = editorial reassurance only: a quote mark, its own short
//     statement, nothing actionable — no second CTA, no second checklist.
// A thin full-width trust band closes the section underneath both columns.
// Premium here comes only from typography/spacing/alignment/hierarchy — no
// new gradient, no heavy shadow, no decorative effects: the card carries a
// single hairline border and nothing else.
import { ShieldCheck } from "lucide-astro";
import CtaButton from "../../shared/CtaButton/CtaButton.astro";
import { brandExpertSupport } from "../../../data/brands/expert-support";

const checklistColOne = brandExpertSupport.trustPoints.slice(0, 3);
const checklistColTwo = brandExpertSupport.trustPoints.slice(3);
---

<section class="brand-expert-support" aria-labelledby="brand-expert-support-title">
  <div class="brand-expert-support__frame">
    <div class="brand-expert-support__card" data-rise>
      <div class="brand-expert-support__grid">
        <div class="brand-expert-support__ask">
          <p class="brand-expert-support__eyebrow">
            <span class="brand-expert-support__eyebrow-dot" aria-hidden="true"></span>
            {brandExpertSupport.eyebrow}
          </p>

          <h2 class="brand-expert-support__heading" id="brand-expert-support-title">
            {brandExpertSupport.heading}
          </h2>

          <p class="brand-expert-support__paragraph">{brandExpertSupport.paragraph}</p>

          <div class="brand-expert-support__checklist">
            <ul>
              {
                checklistColOne.map((point) => (
                  <li>
                    <span class="brand-expert-support__check-mark" aria-hidden="true">
                      &#10003;
                    </span>
                    <span>{point}</span>
                  </li>
                ))
              }
            </ul>
            <ul>
              {
                checklistColTwo.map((point) => (
                  <li>
                    <span class="brand-expert-support__check-mark" aria-hidden="true">
                      &#10003;
                    </span>
                    <span>{point}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="brand-expert-support__actions">
            <CtaButton
              label={brandExpertSupport.ctaPrimary.label}
              href={brandExpertSupport.ctaPrimary.href}
            />
            <CtaButton
              label={brandExpertSupport.ctaSecondary.label}
              href={brandExpertSupport.ctaSecondary.href}
              variant="outline"
            />
          </div>

          <p class="brand-expert-support__reassurance">
            <ShieldCheck size={16} stroke-width={2} aria-hidden="true" />
            <span>{brandExpertSupport.reassurance}</span>
          </p>
        </div>

        <div class="brand-expert-support__editorial">
          <span class="brand-expert-support__quote" aria-hidden="true">&#8220;</span>
          <p class="brand-expert-support__panel-heading">{brandExpertSupport.panelHeading}</p>
          <span class="brand-expert-support__rule" aria-hidden="true"></span>
          <p class="brand-expert-support__panel-body">{brandExpertSupport.panelBody}</p>
        </div>
      </div>

      <ul class="brand-expert-support__band">
        {
          brandExpertSupport.band.map((item) => {
            const Icon = item.icon;
            return (
              <li>
                <Icon size={20} stroke-width={1.75} aria-hidden="true" />
                <span>{item.label}</span>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    // Same entrance state-machine as every other section on the site
    // (Hero/Showcase/Criteria/Decision/BuyingGuide/Extended…):
    // IntersectionObserver, a failsafe timeout, and a
    // prefers-reduced-motion bail.
    var section = document.querySelector(".brand-expert-support");
    if (!section) return;
    if (!("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    section.dataset.anim = "pending";

    var revealed = false;
    var ioAlive = false;
    var io;

    function reveal() {
      if (revealed) return;
      revealed = true;
      section.dataset.anim = "in";
      if (io) io.disconnect();
    }

    var failsafe = setTimeout(function () {
      if (!ioAlive) reveal();
    }, 1500);

    io = new IntersectionObserver(
      function (entries) {
        ioAlive = true;
        clearTimeout(failsafe);
        if (entries[0].isIntersecting) reveal();
      },
      { threshold: 0.15 }
    );

    io.observe(section);
  })();
</script>

<style>
  .brand-expert-support {
    background: var(--color-surface);
    padding-block: var(--space-24);
  }

  .brand-expert-support__frame {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  /* One quiet card holding everything (both columns + the band below).
     A single hairline border is the only definition it gets — no shadow,
     no gradient — per the brief, premium here is typography/space/
     alignment/ratio only. */
  .brand-expert-support__card {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-16);
  }

  .brand-expert-support__grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-16);
  }

  /* --- Left: the ask -------------------------------------------------------- */

  .brand-expert-support__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
  }

  .brand-expert-support__eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
  }

  .brand-expert-support__heading {
    margin: var(--space-5) 0 0;
    max-width: 22ch;
    font-size: clamp(1.875rem, 1.5rem + 1.8vw, 2.75rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .brand-expert-support__paragraph {
    margin: var(--space-5) 0 0;
    max-width: 34rem;
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .brand-expert-support__checklist {
    margin: var(--space-8) 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-6);
  }

  .brand-expert-support__checklist ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .brand-expert-support__checklist li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    line-height: 1.4;
  }

  .brand-expert-support__check-mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 1px;
    border-radius: var(--radius-full);
    border: 1.5px solid var(--color-primary);
    color: var(--color-primary);
    font-size: 10px;
    line-height: 1;
  }

  .brand-expert-support__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-10);
  }

  .brand-expert-support__reassurance {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .brand-expert-support__reassurance svg {
    flex: none;
    color: var(--color-primary);
  }

  /* --- Right: editorial reassurance only — no CTA, no checklist ------------- */

  .brand-expert-support__editorial {
    padding-left: var(--space-16);
    border-left: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .brand-expert-support__quote {
    display: block;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 3.5rem;
    line-height: 1;
    color: var(--color-border-hover);
  }

  .brand-expert-support__panel-heading {
    margin: var(--space-4) 0 0;
    max-width: 20ch;
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-text);
  }

  .brand-expert-support__rule {
    display: block;
    width: 40px;
    height: 2px;
    margin-top: var(--space-5);
    background: var(--color-primary);
  }

  .brand-expert-support__panel-body {
    margin: var(--space-5) 0 0;
    max-width: 30ch;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  /* --- Band: closes the section, full width, no card chrome ---------------- */

  .brand-expert-support__band {
    list-style: none;
    margin: var(--space-14) 0 0;
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .brand-expert-support__band li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-inline: var(--space-6);
    border-left: 1px solid var(--color-border);
    color: var(--color-primary);
  }

  .brand-expert-support__band li:first-child {
    border-left: none;
    padding-left: 0;
  }

  .brand-expert-support__band li span {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    color: var(--color-text);
  }

  /* --- Entrance: the card rises as one object. --- */

  .brand-expert-support[data-anim="pending"] [data-rise] {
    opacity: 0;
  }

  .brand-expert-support[data-anim="in"] [data-rise] {
    animation: brand-expert-support-rise 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes brand-expert-support-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* --- Responsive ---------------------------------------------------------- */

  @media (max-width: 1023px) {
    .brand-expert-support__card {
      padding: var(--space-10);
    }

    .brand-expert-support__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-10);
    }

    .brand-expert-support__editorial {
      padding-left: 0;
      padding-top: var(--space-8);
      border-left: none;
      border-top: 1px solid var(--color-border);
    }

    .brand-expert-support__band {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--space-6);
    }

    .brand-expert-support__band li:nth-child(2n + 1) {
      border-left: none;
      padding-left: 0;
    }
  }

  @media (max-width: 640px) {
    .brand-expert-support {
      padding-block: var(--space-16);
    }

    .brand-expert-support__card {
      padding: var(--space-8) var(--space-6);
    }

    .brand-expert-support__checklist {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-4);
    }

    .brand-expert-support__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .brand-expert-support__band {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-5);
    }

    .brand-expert-support__band li {
      border-left: none;
      padding-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-expert-support[data-anim="in"] [data-rise] {
      animation: none;
    }
  }
</style>

---
// SikSorulanSorularHero — /blog/sik-sorulan-sorular sayfasına özel hero.
// Ortak BrandPageHero'nun görselsiz (textOnly) modu tek sütundur ve geniş
// ekranda sağ yarıyı boş bırakır; bu sayfa bir SSS dizini olduğu için sağ
// kolon dekoratif görsel yerine sayfanın kendi bölümlerine giden işlevsel
// bir gezinme paneli taşır. İçerik (rozet, başlık, paragraflar, CTA'lar ve
// renkler) mevcut hero.ts'ten aynen alınır; ortak BrandPageHero'ya dokunulmaz.
// Giriş animasyonu ve JavaScript yoktur.
import { Phone, MessageCircle, ArrowRight } from "lucide-astro";
import WhatsAppIcon from "../../shared/WhatsAppIcon/WhatsAppIcon.astro";
import { contactAction } from "../../../lib/contact-action";
import { readableTextOn } from "../../../lib/contrast";
import { standardCtaLabel } from "../../../lib/cta-labels";
import type { BrandPageHeroContent } from "../BrandPageHero/BrandPageHero.astro";
import type { SikSorulanSorularHeroPanel } from "../../../data/sik-sorulan-sorular/hero-panel";

interface Props {
  data: BrandPageHeroContent;
  panel: SikSorulanSorularHeroPanel;
}

const { data, panel } = Astro.props;

const accent = data.heroAccent || data.accentColor;
const style = [
  `--ssh-accent:${accent};`,
  `--ssh-accent-hover:${data.heroAccentHover || data.accentColorHover};`,
  `--ssh-accent-soft:${data.accentColorSoft};`,
  `--ssh-accent-border:${data.accentColorBorder};`,
  `--ssh-cta-text:${readableTextOn(accent, data.ctaTextColor)};`,
  data.heroBackground ? `--ssh-bg-image:${data.heroBackground};` : "",
  data.heroBaseBg ? `--ssh-base-bg:${data.heroBaseBg};` : "",
  data.heroWaveColor ? `--ssh-wave-color:${data.heroWaveColor};` : "",
  data.heroWaveOpacity ? `--ssh-wave-opacity:${data.heroWaveOpacity};` : "",
].join(" ");
---

<section class="ssh" aria-labelledby="brand-page-hero-title" style={style} data-track-location="hero">
  <div class="ssh__bg" aria-hidden="true"></div>
  <div class="ssh__wave" aria-hidden="true"></div>

  <div class="ssh__inner">
    <div class="ssh__content">
      <p class="ssh__badge">{data.badge}</p>

      <h1 class="ssh__heading" id="brand-page-hero-title">
        {data.headingLines.map((line) => <span class="ssh__heading-line">{line}</span>)}
      </h1>

      {data.paragraphs.map((p) => <p class="ssh__paragraph">{p}</p>)}

      <div class="ssh__actions">
        <a class="ssh__cta ssh__cta--solid" href={data.ctaPrimary.href} data-track-location="hero" data-contact-action={contactAction(data.ctaPrimary.href)}>
          <Phone size={18} stroke-width={2} aria-hidden="true" />
          <span>{standardCtaLabel(data.ctaPrimary.label, data.ctaPrimary.href)}</span>
        </a>
        <a class="ssh__cta ssh__cta--outline" href={data.ctaSecondary.href} data-track-location="hero" data-contact-action={contactAction(data.ctaSecondary.href)}>
          {contactAction(data.ctaSecondary.href) === "whatsapp" ? <WhatsAppIcon size={20} /> : <MessageCircle size={18} stroke-width={2} aria-hidden="true" />}
          <span>{standardCtaLabel(data.ctaSecondary.label, data.ctaSecondary.href)}</span>
        </a>
      </div>
    </div>

    <nav class="ssh__panel" aria-labelledby="ssh-panel-title">
      <h2 class="ssh__panel-title" id="ssh-panel-title">{panel.title}</h2>

      <ol class="ssh__links">
        {
          panel.links.map((link, i) => (
            <li>
              <a class="ssh__link" href={link.href}>
                <span class="ssh__link-number" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span class="ssh__link-label">{link.label}</span>
                <ArrowRight class="ssh__link-arrow" size={16} stroke-width={2} aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
</section>

<style>
  .ssh {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    background: var(--ssh-base-bg, #050505);
    color: var(--color-text-inverse);
    padding-block: var(--space-16);
  }

  .ssh__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: var(--ssh-bg-image, none);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .ssh__wave {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ssh-wave-color, transparent);
    opacity: var(--ssh-wave-opacity, 0);
    -webkit-mask: url("/images/hero/wave-lines.svg") center / cover no-repeat;
    mask: url("/images/hero/wave-lines.svg") center / cover no-repeat;
  }

  .ssh__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: var(--space-12);
  }

  /* --- Left: content --------------------------------------------------- */

  .ssh__badge {
    display: inline-block;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--ssh-accent-border);
    border-radius: var(--radius-full);
    background: var(--ssh-accent-soft);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--ssh-accent) 42%, #ffffff);
  }

  .ssh__heading {
    margin: var(--space-5) 0 0;
    font-size: clamp(2rem, 1.5rem + 2.4vw, 3.5rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text-inverse);
  }

  .ssh__heading-line {
    display: block;
  }

  .ssh__paragraph {
    margin: var(--space-4) 0 0;
    max-width: 36rem;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: rgb(255 255 255 / 0.72);
  }

  .ssh__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .ssh__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 56px;
    padding-inline: var(--space-8);
    border-radius: var(--radius-lg);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    white-space: nowrap;
    transition: transform 300ms ease, background-color 300ms ease, border-color 300ms ease;
  }

  .ssh__cta--solid {
    background: var(--ssh-accent);
    border: 1px solid var(--ssh-accent);
    color: var(--ssh-cta-text);
  }

  .ssh__cta--solid:hover {
    background: var(--ssh-accent-hover);
    transform: translateY(-2px);
  }

  .ssh__cta--outline {
    background: transparent;
    border: 1px solid rgb(255 255 255 / 0.28);
    color: var(--color-text-inverse);
  }

  .ssh__cta--outline:hover {
    background: rgb(255 255 255 / 0.06);
    border-color: rgb(255 255 255 / 0.45);
    transform: translateY(-2px);
  }

  .ssh__cta:focus-visible,
  .ssh__link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--ssh-accent-border);
  }

  /* --- Right: navigation panel ------------------------------------------ */

  .ssh__panel {
    padding: var(--space-8) var(--space-6);
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: var(--radius-2xl);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
  }

  .ssh__panel-title {
    margin: 0;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    line-height: 1.3;
    color: var(--color-text-inverse);
  }

  .ssh__links {
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .ssh__link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: var(--radius-xl);
    color: var(--color-text-inverse);
    text-decoration: none;
    transition: border-color 250ms ease, background-color 250ms ease;
  }

  .ssh__link:hover {
    background: rgb(255 255 255 / 0.1);
    border-color: var(--ssh-accent-border);
  }

  .ssh__link-number {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background: var(--ssh-accent-soft);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: color-mix(in srgb, var(--ssh-accent) 42%, #ffffff);
  }

  .ssh__link-label {
    flex: 1;
    min-width: 0;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    line-height: 1.35;
  }

  .ssh__link :global(.ssh__link-arrow) {
    flex: none;
    color: rgb(255 255 255 / 0.55);
    transition: color 250ms ease;
  }

  .ssh__link:hover :global(.ssh__link-arrow) {
    color: var(--color-text-inverse);
  }

  /* --- Responsive ------------------------------------------------------- */

  @media (max-width: 1023px) {
    .ssh__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-10);
    }

    .ssh__panel {
      max-width: 36rem;
    }
  }

  @media (max-width: 640px) {
    .ssh {
      padding-block: var(--space-10);
    }

    .ssh__inner {
      padding-inline: var(--space-5);
      gap: var(--space-8);
    }

    .ssh__heading {
      font-size: clamp(1.625rem, 1.2rem + 2.2vw, 2rem);
      line-height: 1.15;
    }

    .ssh__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .ssh__panel {
      padding: var(--space-6) var(--space-4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ssh__cta,
    .ssh__link {
      transition: none;
    }

    .ssh__cta--solid:hover,
    .ssh__cta--outline:hover {
      transform: none;
    }
  }
</style>

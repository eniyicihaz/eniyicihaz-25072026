---
// BrandPageSignalList — shared, cross-brand "quiet list" section: no card
// chrome, no shadow, no bento grid. Generic/prop-driven sibling of the
// homepage's Trust component (src/components/trust/Trust/Trust.astro),
// which uses the exact same whisper-quiet visual register but imports its
// own fixed data and is therefore not reusable on a content page. Built
// per DESIGN_SYSTEM_GUIDE §26 (Component Decision Tree): existing card
// grids (BrandPageIdealUser/BrandPageAdvantages) don't have this register,
// composition can't produce it, and the one component that does isn't
// generic — so a generic sibling is the minimal justified addition.
//
// Deliberately count-agnostic (used with 3 items and with 7 items on the
// same page — Ücretsiz İşitme Testi redesign, plan §2): an auto-fit grid,
// not a fixed 3-column layout, so it never breaks the way
// BrandPageTechEvolution's hardcoded 3-column grid does with 4 items.
export interface BrandPageSignal {
  icon?: any;
  title: string;
  description: string;
}

export interface BrandPageSignalListContent {
  badge: string;
  heading: string;
  intro?: string;
  signals: BrandPageSignal[];
  closing?: string;
  accentColor: string;
  accentColorBadgeBg: string;
  accentColorBadgeBorder: string;
  accentColorBadgeText: string;
}

interface Props {
  data: BrandPageSignalListContent;
}

const { data } = Astro.props;
---

<section
  class="brand-page-signals"
  aria-labelledby="brand-page-signals-title"
  style={`--bpsl-accent:${data.accentColor}; --bpsl-badge-bg:${data.accentColorBadgeBg}; --bpsl-badge-border:${data.accentColorBadgeBorder}; --bpsl-badge-text:${data.accentColorBadgeText};`}
>
  <div class="brand-page-signals__inner">
    <div class="brand-page-signals__header">
      <p class="brand-page-signals__badge" data-rise>{data.badge}</p>
      <h2 class="brand-page-signals__heading" id="brand-page-signals-title" data-rise>
        {data.heading}
      </h2>
      {data.intro && <p class="brand-page-signals__intro" data-rise>{data.intro}</p>}
    </div>

    <ul class="brand-page-signals__list" data-rise>
      {
        data.signals.map((signal) => {
          const Icon = signal.icon;
          return (
            <li class="brand-page-signals__item">
              {Icon && (
                <span class="brand-page-signals__icon" aria-hidden="true">
                  <Icon size={20} stroke-width={1.75} />
                </span>
              )}
              <div class="brand-page-signals__body">
                <p class="brand-page-signals__item-title">{signal.title}</p>
                <p class="brand-page-signals__item-desc">{signal.description}</p>
              </div>
            </li>
          );
        })
      }
    </ul>

    {data.closing && <p class="brand-page-signals__closing" data-rise>{data.closing}</p>}
  </div>
</section>

<script is:inline>
  (function () {
    // querySelectorAll + forEach — this component is used more than once
    // on the same page (e.g. Ücretsiz İşitme Testi's awareness list and
    // local-trust list), and Astro deduplicates identical `is:inline`
    // scripts across repeated instances, so this script must wire up
    // every instance itself rather than assuming a single match.
    document.querySelectorAll(".brand-page-signals").forEach(function (section) {
      if (section.dataset.ready === "true") return;
      section.dataset.ready = "true";

      if (!("IntersectionObserver" in window)) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      section.dataset.anim = "pending";

      var revealed = false;
      var ioAlive = false;
      var io;

      function reveal() {
        if (revealed) return;
        revealed = true;
        section.dataset.anim = "in";
        if (io) io.disconnect();
      }

      var failsafe = setTimeout(function () {
        if (!ioAlive) reveal();
      }, 1500);

      io = new IntersectionObserver(
        function (entries) {
          ioAlive = true;
          clearTimeout(failsafe);
          if (entries[0].isIntersecting) reveal();
        },
        { threshold: 0.15 }
      );

      io.observe(section);
    });
  })();
</script>

<style>
  .brand-page-signals {
    background: var(--color-background);
    color: var(--color-text);
    padding-block: var(--space-20);
  }

  .brand-page-signals__inner {
    max-width: var(--container-lg);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .brand-page-signals__header {
    max-width: 42rem;
    margin-inline: auto;
    text-align: center;
  }

  .brand-page-signals__badge {
    display: inline-block;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--bpsl-badge-border);
    border-radius: var(--radius-full);
    background: var(--bpsl-badge-bg);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    color: var(--bpsl-badge-text);
  }

  .brand-page-signals__heading {
    margin: var(--space-4) 0 0;
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .brand-page-signals__intro {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  /* Count-agnostic — same grid recipe works for 3 items or 7 without a
     hardcoded column count (see BrandPageTechEvolution's known bug). */
  .brand-page-signals__list {
    list-style: none;
    margin: var(--space-12) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6) var(--space-10);
  }

  .brand-page-signals__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .brand-page-signals__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--bpsl-accent);
  }

  .brand-page-signals__body {
    min-width: 0;
  }

  .brand-page-signals__item-title {
    margin: 0;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  .brand-page-signals__item-desc {
    margin: var(--space-1) 0 0;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .brand-page-signals__closing {
    margin: var(--space-10) auto 0;
    max-width: 34rem;
    text-align: center;
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .brand-page-signals[data-anim="pending"] [data-rise] {
    opacity: 0;
  }

  .brand-page-signals[data-anim="in"] [data-rise] {
    animation: brand-page-signals-rise 600ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .brand-page-signals[data-anim="in"] .brand-page-signals__list {
    animation-delay: 100ms;
  }

  @keyframes brand-page-signals-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .brand-page-signals {
      padding-block: var(--space-14);
    }
    .brand-page-signals__list {
      margin-top: var(--space-8);
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-page-signals[data-anim="in"] [data-rise] {
      animation: none;
    }
  }
</style>

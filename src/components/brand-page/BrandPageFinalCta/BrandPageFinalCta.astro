---
// BrandPageFinalCta — shared, cross-brand closing CTA section. Generic
// counterpart of Oticon's original OticonFinalCta; data-driven so every
// brand page can reuse it.
import { Phone, MessageCircle, CheckCircle2 } from "lucide-astro";

export interface BrandPageFinalCtaAction {
  label: string;
  href: string;
}

export interface BrandPageFinalCtaContent {
  badge: string;
  heading: string;
  description: string;
  ctaPrimary: BrandPageFinalCtaAction;
  ctaSecondary: BrandPageFinalCtaAction;
  trustItems: string[];
  accentColor: string;
  accentColorHover: string;
  accentColorGlow: string;
  accentColorShadow: string;
  accentColorShadowHover: string;
  accentColorFocus: string;
  accentColorTrustBg: string;
  // Optional per-brand overrides — see BrandPageHero's equivalent fields
  // for why these exist. Omit and the original hardcoded value is used;
  // every brand page built before the Signia theme revision omits all of
  // these. The card itself is always a solid color block distinct from
  // the page background (originally a dark navy on a white page); a
  // *light* card (Signia v2) needs its own border since it no longer
  // contrasts against the page by darkness alone, plus its own
  // dark-on-light text/border set for the same reason as Hero's.
  cardBg?: string; // .brand-page-final-cta__card background — default: #0f2547
  cardBorder?: string; // card border — default: none (transparent)
  ctaTextColor?: string; // solid button text color — default: #0a1408
  badgeBg?: string; // default: rgb(255 255 255 / 0.06)
  badgeBorder?: string; // default: rgb(255 255 255 / 0.2)
  badgeText?: string; // default: rgb(255 255 255 / 0.85)
  headingColor?: string; // default: #ffffff
  descColor?: string; // default: rgb(255 255 255 / 0.5)
  outlineText?: string; // secondary button text — default: rgb(255 255 255 / 0.9)
  outlineBorder?: string; // secondary button border — default: rgb(255 255 255 / 0.28)
  outlineHoverBg?: string; // default: rgb(255 255 255 / 0.08)
  outlineHoverBorder?: string; // default: rgb(255 255 255 / 0.45)
  outlineHoverText?: string; // default: #ffffff
  trustBorderTop?: string; // default: rgb(255 255 255 / 0.1)
  trustItemBg?: string; // default: rgb(255 255 255 / 0.04)
  trustItemBorder?: string; // default: rgb(255 255 255 / 0.08)
  trustLabelColor?: string; // default: rgb(255 255 255 / 0.8)
  // Maico contrast fix (2026-07) — see BrandPageHero's heroAccent/
  // heroAccentHover for the full rationale: some brands' real
  // accentColor (e.g. Maico's near-black navy #10233F) is too dark to
  // use directly for the solid button's background or the trust-icon
  // color against this card's own dark background, even though that
  // same accentColor is correct everywhere else on the page. These
  // override just the *within-this-card* UI uses; accentColor/Hover stay
  // the true brand color for every other section. Omit both and nothing
  // changes — every brand page built before this fix supplies neither.
  ctaAccent?: string; // overrides --bpfc-accent (button bg, trust-icon color) — default: accentColor
  ctaAccentHover?: string; // overrides --bpfc-accent-hover (button hover bg) — default: accentColorHover
}

interface Props {
  data: BrandPageFinalCtaContent;
}

const { data } = Astro.props;

const finalCtaStyleOverrides = [
  data.cardBg ? `--bpfc-card-bg:${data.cardBg};` : "",
  data.cardBorder ? `--bpfc-card-border:${data.cardBorder};` : "",
  data.ctaTextColor ? `--bpfc-cta-text:${data.ctaTextColor};` : "",
  data.badgeBg ? `--bpfc-badge-bg:${data.badgeBg};` : "",
  data.badgeBorder ? `--bpfc-badge-border:${data.badgeBorder};` : "",
  data.badgeText ? `--bpfc-badge-text:${data.badgeText};` : "",
  data.headingColor ? `--bpfc-heading:${data.headingColor};` : "",
  data.descColor ? `--bpfc-desc:${data.descColor};` : "",
  data.outlineText ? `--bpfc-outline-text:${data.outlineText};` : "",
  data.outlineBorder ? `--bpfc-outline-border:${data.outlineBorder};` : "",
  data.outlineHoverBg ? `--bpfc-outline-hover-bg:${data.outlineHoverBg};` : "",
  data.outlineHoverBorder ? `--bpfc-outline-hover-border:${data.outlineHoverBorder};` : "",
  data.outlineHoverText ? `--bpfc-outline-hover-text:${data.outlineHoverText};` : "",
  data.trustBorderTop ? `--bpfc-trust-border-top:${data.trustBorderTop};` : "",
  data.trustItemBg ? `--bpfc-trust-item-bg:${data.trustItemBg};` : "",
  data.trustItemBorder ? `--bpfc-trust-item-border:${data.trustItemBorder};` : "",
  data.trustLabelColor ? `--bpfc-trust-label:${data.trustLabelColor};` : "",
].join(" ");
---

<section
  class="brand-page-final-cta"
  aria-labelledby="brand-page-final-cta-title"
  style={`--bpfc-accent:${data.ctaAccent || data.accentColor}; --bpfc-accent-hover:${data.ctaAccentHover || data.accentColorHover}; --bpfc-glow:${data.accentColorGlow}; --bpfc-shadow:${data.accentColorShadow}; --bpfc-shadow-hover:${data.accentColorShadowHover}; --bpfc-focus:${data.accentColorFocus}; --bpfc-trust-bg:${data.accentColorTrustBg}; ${finalCtaStyleOverrides}`}
>
  <div class="brand-page-final-cta__frame">
    <div class="brand-page-final-cta__card" data-rise>
      <div class="brand-page-final-cta__glow" aria-hidden="true"></div>

      <p class="brand-page-final-cta__badge">{data.badge}</p>

      <h2 class="brand-page-final-cta__heading" id="brand-page-final-cta-title">
        {data.heading}
      </h2>

      <p class="brand-page-final-cta__desc">{data.description}</p>

      <div class="brand-page-final-cta__actions">
        <a class="brand-page-final-cta__button brand-page-final-cta__button--solid" href={data.ctaPrimary.href}>
          <Phone size={22} stroke-width={2} aria-hidden="true" />
          <span>{data.ctaPrimary.label}</span>
        </a>
        <a class="brand-page-final-cta__button brand-page-final-cta__button--outline" href={data.ctaSecondary.href}>
          <MessageCircle size={22} stroke-width={2} aria-hidden="true" />
          <span>{data.ctaSecondary.label}</span>
        </a>
      </div>

      <div class="brand-page-final-cta__trust">
        {
          data.trustItems.map((item) => (
            <span class="brand-page-final-cta__trust-item">
              <span class="brand-page-final-cta__trust-icon">
                <CheckCircle2 size={18} stroke-width={2} aria-hidden="true" />
              </span>
              <span class="brand-page-final-cta__trust-label">{item}</span>
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var section = document.querySelector(".brand-page-final-cta");
    if (!section) return;
    if (!("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    section.dataset.anim = "pending";

    var revealed = false;
    var ioAlive = false;
    var io;

    function reveal() {
      if (revealed) return;
      revealed = true;
      section.dataset.anim = "in";
      if (io) io.disconnect();
    }

    var failsafe = setTimeout(function () {
      if (!ioAlive) reveal();
    }, 1500);

    io = new IntersectionObserver(
      function (entries) {
        ioAlive = true;
        clearTimeout(failsafe);
        if (entries[0].isIntersecting) reveal();
      },
      { threshold: 0.15 }
    );

    io.observe(section);
  })();
</script>

<style>
  .brand-page-final-cta {
    background: var(--color-background);
    padding-block: var(--space-20);
  }

  .brand-page-final-cta__frame {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .brand-page-final-cta__card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-20) var(--space-10);
    background: var(--bpfc-card-bg, #0f2547);
    border: var(--bpfc-card-border, none);
    border-radius: var(--radius-2xl);
  }

  .brand-page-final-cta[data-anim="pending"] .brand-page-final-cta__card {
    opacity: 0;
  }

  .brand-page-final-cta[data-anim="in"] .brand-page-final-cta__card {
    animation: brand-page-final-cta-rise 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes brand-page-final-cta-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .brand-page-final-cta__glow {
    position: absolute;
    top: -25%;
    left: 50%;
    transform: translateX(-50%);
    z-index: -1;
    width: 1100px;
    max-width: 160%;
    height: 600px;
    background: radial-gradient(closest-side, var(--bpfc-glow), transparent);
  }

  .brand-page-final-cta__badge {
    display: inline-block;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--bpfc-badge-border, rgb(255 255 255 / 0.2));
    border-radius: var(--radius-full);
    background: var(--bpfc-badge-bg, rgb(255 255 255 / 0.06));
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    color: var(--bpfc-badge-text, rgb(255 255 255 / 0.85));
  }

  .brand-page-final-cta__heading {
    margin: var(--space-6) 0 0;
    max-width: 18ch;
    font-size: clamp(2.75rem, 2.1rem + 3vw, 4.25rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--bpfc-heading, #ffffff);
  }

  .brand-page-final-cta__desc {
    margin: var(--space-3) 0 0;
    max-width: 40ch;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--bpfc-desc, rgb(255 255 255 / 0.5));
  }

  .brand-page-final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-10);
  }

  .brand-page-final-cta__button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 72px;
    border-radius: var(--radius-lg);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    white-space: nowrap;
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1), background-color 300ms cubic-bezier(0.22, 1, 0.36, 1), border-color 300ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .brand-page-final-cta__button--solid {
    padding-inline: var(--space-10);
    font-size: var(--font-size-xl);
    background: var(--bpfc-accent);
    border: 1px solid var(--bpfc-accent);
    color: var(--bpfc-cta-text, #0a1408);
    box-shadow: 0 14px 32px -10px var(--bpfc-shadow);
  }

  .brand-page-final-cta__button--solid:hover {
    background: var(--bpfc-accent-hover);
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 20px 40px -10px var(--bpfc-shadow-hover);
  }

  .brand-page-final-cta__button--outline {
    padding-inline: var(--space-8);
    font-size: var(--font-size-md);
    background: transparent;
    border: 1px solid var(--bpfc-outline-border, rgb(255 255 255 / 0.28));
    color: var(--bpfc-outline-text, rgb(255 255 255 / 0.9));
  }

  .brand-page-final-cta__button--outline:hover {
    background: var(--bpfc-outline-hover-bg, rgb(255 255 255 / 0.08));
    border-color: var(--bpfc-outline-hover-border, rgb(255 255 255 / 0.45));
    color: var(--bpfc-outline-hover-text, #ffffff);
    transform: translateY(-2px);
  }

  .brand-page-final-cta__button:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--bpfc-focus);
  }

  .brand-page-final-cta__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--bpfc-trust-border-top, rgb(255 255 255 / 0.1));
    width: 100%;
    max-width: 46rem;
  }

  .brand-page-final-cta__trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    flex: 1 1 140px;
    max-width: 180px;
    padding: var(--space-5) var(--space-3);
    border-radius: var(--radius-xl);
    background: var(--bpfc-trust-item-bg, rgb(255 255 255 / 0.04));
    border: 1px solid var(--bpfc-trust-item-border, rgb(255 255 255 / 0.08));
  }

  .brand-page-final-cta__trust-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-lg);
    background: var(--bpfc-trust-bg);
    color: var(--bpfc-accent);
  }

  .brand-page-final-cta__trust-label {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    line-height: 1.4;
    color: var(--bpfc-trust-label, rgb(255 255 255 / 0.8));
  }

  @media (max-width: 1023px) {
    .brand-page-final-cta__card {
      padding: var(--space-16) var(--space-8);
    }
  }

  @media (max-width: 640px) {
    .brand-page-final-cta {
      padding-block: var(--space-16);
    }

    .brand-page-final-cta__card {
      padding: var(--space-12) var(--space-6);
    }

    .brand-page-final-cta__actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .brand-page-final-cta__button {
      width: 100%;
    }

    .brand-page-final-cta__trust {
      gap: var(--space-3);
    }

    .brand-page-final-cta__trust-item {
      flex: 1 1 42%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-page-final-cta[data-anim="in"] .brand-page-final-cta__card {
      animation: none;
    }

    .brand-page-final-cta__button {
      transition: none;
    }
  }
</style>

---
import { readableTextOn } from "../../../lib/contrast";
import { standardCtaLabel } from "../../../lib/cta-labels";
// BrandPageFinalCta — shared, cross-brand closing CTA section. Generic
// counterpart of Oticon's original OticonFinalCta; data-driven so every
// brand page can reuse it.
import { Phone, MessageCircle, CheckCircle2, Navigation, ChevronRight } from "lucide-astro";
import { trustHref, isInfoTestLink } from "../../../lib/trust-links";
import WhatsAppIcon from "../../shared/WhatsAppIcon/WhatsAppIcon.astro";
import { contactAction } from "../../../lib/contact-action";

export interface BrandPageFinalCtaAction {
  label: string;
  href: string;
}

export interface BrandPageFinalCtaContent {
  badge: string;
  heading: string;
  description: string;
  ctaPrimary: BrandPageFinalCtaAction;
  ctaSecondary: BrandPageFinalCtaAction;
  // Optional third action (e.g. the Darıca hub's "Yol Tarifi Al"), rendered
  // in the secondary/outline style. Every page that omits it renders
  // exactly as before.
  ctaTertiary?: BrandPageFinalCtaAction;
  trustItems: string[];
  // Optional page-specific chip links (label -> target), e.g. a same-page "#section" anchor. Chips whose label
  // is in src/lib/trust-links.ts are linked automatically; everything else stays a plain chip.
  trustLinks?: Record<string, string>;
  accentColor: string;
  accentColorHover: string;
  accentColorGlow: string;
  accentColorShadow: string;
  accentColorShadowHover: string;
  accentColorFocus: string;
  accentColorTrustBg: string;
  // Optional per-brand overrides — see BrandPageHero's equivalent fields
  // for why these exist. Omit and the original hardcoded value is used;
  // every brand page built before the Signia theme revision omits all of
  // these. The card itself is always a solid color block distinct from
  // the page background (originally a dark navy on a white page); a
  // *light* card (Signia v2) needs its own border since it no longer
  // contrasts against the page by darkness alone, plus its own
  // dark-on-light text/border set for the same reason as Hero's.
  cardBg?: string; // .brand-page-final-cta__card background — default: #0f2547
  cardBorder?: string; // card border — default: none (transparent)
  ctaTextColor?: string; // solid button text color — default: #0a1408
  badgeBg?: string; // default: rgb(255 255 255 / 0.06)
  badgeBorder?: string; // default: rgb(255 255 255 / 0.2)
  badgeText?: string; // default: rgb(255 255 255 / 0.85)
  headingColor?: string; // default: #ffffff
  headingMobileFontSize?: string; // heading font-size at 640px and below. Default: same clamp as above 640px (unchanged). Opt-in for headings with a long unbreakable word.
  descColor?: string; // default: rgb(255 255 255 / 0.5)
  outlineText?: string; // secondary button text — default: rgb(255 255 255 / 0.9)
  outlineBorder?: string; // secondary button border — default: rgb(255 255 255 / 0.28)
  outlineHoverBg?: string; // default: rgb(255 255 255 / 0.08)
  outlineHoverBorder?: string; // default: rgb(255 255 255 / 0.45)
  outlineHoverText?: string; // default: #ffffff
  trustBorderTop?: string; // default: rgb(255 255 255 / 0.1)
  trustItemBg?: string; // default: rgb(255 255 255 / 0.04)
  trustItemBorder?: string; // default: rgb(255 255 255 / 0.08)
  trustLabelColor?: string; // default: rgb(255 255 255 / 0.8)
  // Maico contrast fix (2026-07) — see BrandPageHero's heroAccent/
  // heroAccentHover for the full rationale: some brands' real
  // accentColor (e.g. Maico's near-black navy #10233F) is too dark to
  // use directly for the solid button's background or the trust-icon
  // color against this card's own dark background, even though that
  // same accentColor is correct everywhere else on the page. These
  // override just the *within-this-card* UI uses; accentColor/Hover stay
  // the true brand color for every other section. Omit both and nothing
  // changes — every brand page built before this fix supplies neither.
  ctaAccent?: string; // overrides --bpfc-accent (button bg, trust-icon color) — default: accentColor
  ctaAccentHover?: string; // overrides --bpfc-accent-hover (button hover bg) — default: accentColorHover
}

interface Props {
  data: BrandPageFinalCtaContent;
}

const { data } = Astro.props;

// Chip icon colour: the brand accent is often too dark for the dark navy card (e.g. Sonic #3D4C59 = 1.7:1),
// so on dark cards chips use a light tone; on light cards (Signia) the brand accent stays.
const darkCard = readableTextOn(data.cardBg || "#0f2547") === "#ffffff";
const chipIcon = darkCard ? "#bfdbfe" : data.ctaAccent || data.accentColor;
const currentPath = Astro.url.pathname;
const chips = data.trustItems.map((label) => ({ label, href: trustHref(label, data.trustLinks, currentPath) }));

const finalCtaStyleOverrides = [
  data.cardBg ? `--bpfc-card-bg:${data.cardBg};` : "",
  data.cardBorder ? `--bpfc-card-border:${data.cardBorder};` : "",
  `--bpfc-cta-text:${readableTextOn(data.ctaAccent || data.accentColor, data.ctaTextColor)};`,
  data.badgeBg ? `--bpfc-badge-bg:${data.badgeBg};` : "",
  data.badgeBorder ? `--bpfc-badge-border:${data.badgeBorder};` : "",
  data.badgeText ? `--bpfc-badge-text:${data.badgeText};` : "",
  data.headingColor ? `--bpfc-heading:${data.headingColor};` : "",
  data.headingMobileFontSize ? `--bpfc-heading-size-mobile:${data.headingMobileFontSize};` : "",
  data.descColor ? `--bpfc-desc:${data.descColor};` : "",
  data.outlineText ? `--bpfc-outline-text:${data.outlineText};` : "",
  data.outlineBorder ? `--bpfc-outline-border:${data.outlineBorder};` : "",
  data.outlineHoverBg ? `--bpfc-outline-hover-bg:${data.outlineHoverBg};` : "",
  data.outlineHoverBorder ? `--bpfc-outline-hover-border:${data.outlineHoverBorder};` : "",
  data.outlineHoverText ? `--bpfc-outline-hover-text:${data.outlineHoverText};` : "",
  data.trustBorderTop ? `--bpfc-trust-border-top:${data.trustBorderTop};` : "",
  data.trustItemBg ? `--bpfc-trust-item-bg:${data.trustItemBg};` : "",
  data.trustItemBorder ? `--bpfc-trust-item-border:${data.trustItemBorder};` : "",
  data.trustLabelColor ? `--bpfc-trust-label:${data.trustLabelColor};` : "",
].join(" ");
---

<section
  class="brand-page-final-cta"
  aria-labelledby="brand-page-final-cta-title"
  style={`--bpfc-accent:${data.ctaAccent || data.accentColor}; --bpfc-accent-hover:${data.ctaAccentHover || data.accentColorHover}; --bpfc-glow:${data.accentColorGlow}; --bpfc-shadow:${data.accentColorShadow}; --bpfc-shadow-hover:${data.accentColorShadowHover}; --bpfc-focus:${data.accentColorFocus}; --bpfc-trust-bg:${data.accentColorTrustBg}; --bpfc-chip-icon:${chipIcon}; ${finalCtaStyleOverrides}`}
>
  <div class="brand-page-final-cta__frame">
    <div class="brand-page-final-cta__card" data-rise>
      <div class="brand-page-final-cta__glow" aria-hidden="true"></div>

      <p class="brand-page-final-cta__badge">{data.badge}</p>

      <h2 class="brand-page-final-cta__heading" id="brand-page-final-cta-title">
        {data.heading}
      </h2>

      <p class="brand-page-final-cta__desc">{data.description}</p>

      <div class="brand-page-final-cta__actions">
        <a class="brand-page-final-cta__button brand-page-final-cta__button--solid" href={data.ctaPrimary.href} data-contact-action={contactAction(data.ctaPrimary.href)}>
          {contactAction(data.ctaPrimary.href) === "whatsapp" ? <WhatsAppIcon size={20} /> : <Phone size={22} stroke-width={2} aria-hidden="true" />}
          <span>{standardCtaLabel(data.ctaPrimary.label, data.ctaPrimary.href)}</span>
        </a>
        <a class="brand-page-final-cta__button brand-page-final-cta__button--outline" href={data.ctaSecondary.href} data-contact-action={contactAction(data.ctaSecondary.href)}>
          {contactAction(data.ctaSecondary.href) === "whatsapp" ? <WhatsAppIcon size={20} /> : contactAction(data.ctaSecondary.href) === "directions" ? <Navigation size={22} stroke-width={2} aria-hidden="true" /> : contactAction(data.ctaSecondary.href) === "phone" ? <Phone size={22} stroke-width={2} aria-hidden="true" /> : <MessageCircle size={22} stroke-width={2} aria-hidden="true" />}
          <span>{standardCtaLabel(data.ctaSecondary.label, data.ctaSecondary.href)}</span>
        </a>
        {data.ctaTertiary && (
          <a class="brand-page-final-cta__button brand-page-final-cta__button--outline" href={data.ctaTertiary.href} data-contact-action={contactAction(data.ctaTertiary.href)}>
            <Navigation size={22} stroke-width={2} aria-hidden="true" />
            <span>{data.ctaTertiary.label}</span>
          </a>
        )}
      </div>

      <ul class="brand-page-final-cta__trust">
        {
          chips.map((chip) => (
            <li class="brand-page-final-cta__trust-li">
              {chip.href ? (
                <a
                  class="brand-page-final-cta__trust-item brand-page-final-cta__trust-item--link"
                  href={chip.href}
                  data-track-event={isInfoTestLink(chip.href) ? "hearing_test_info_click" : undefined}
                >
                  <CheckCircle2 class="brand-page-final-cta__trust-icon" size={18} stroke-width={2} aria-hidden="true" />
                  <span class="brand-page-final-cta__trust-label">{chip.label}</span>
                  <ChevronRight class="brand-page-final-cta__trust-go" size={16} stroke-width={2.25} aria-hidden="true" />
                </a>
              ) : (
                <span class="brand-page-final-cta__trust-item">
                  <CheckCircle2 class="brand-page-final-cta__trust-icon" size={18} stroke-width={2} aria-hidden="true" />
                  <span class="brand-page-final-cta__trust-label">{chip.label}</span>
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var section = document.querySelector(".brand-page-final-cta");
    if (!section) return;
    if (!("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    section.dataset.anim = "pending";

    var revealed = false;
    var ioAlive = false;
    var io;

    function reveal() {
      if (revealed) return;
      revealed = true;
      section.dataset.anim = "in";
      if (io) io.disconnect();
    }

    var failsafe = setTimeout(function () {
      if (!ioAlive) reveal();
    }, 1500);

    io = new IntersectionObserver(
      function (entries) {
        ioAlive = true;
        clearTimeout(failsafe);
        if (entries[0].isIntersecting) reveal();
      },
      { threshold: 0.15 }
    );

    io.observe(section);
  })();
</script>

<style>
  .brand-page-final-cta {
    background: var(--color-background);
    padding-block: var(--space-12);
  }

  .brand-page-final-cta__frame {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .brand-page-final-cta__card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-12) var(--space-8);
    background: var(--bpfc-card-bg, #0f2547);
    border: var(--bpfc-card-border, none);
    border-radius: var(--radius-2xl);
  }

  .brand-page-final-cta[data-anim="pending"] .brand-page-final-cta__card {
    opacity: 0;
  }

  .brand-page-final-cta[data-anim="in"] .brand-page-final-cta__card {
    animation: brand-page-final-cta-rise 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes brand-page-final-cta-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .brand-page-final-cta__glow {
    position: absolute;
    top: -25%;
    left: 50%;
    transform: translateX(-50%);
    z-index: -1;
    width: 1100px;
    max-width: 160%;
    height: 600px;
    background: radial-gradient(closest-side, var(--bpfc-glow), transparent);
  }

  .brand-page-final-cta__badge {
    display: inline-block;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--bpfc-badge-border, rgb(255 255 255 / 0.2));
    border-radius: var(--radius-full);
    background: var(--bpfc-badge-bg, rgb(255 255 255 / 0.06));
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    color: var(--bpfc-badge-text, rgb(255 255 255 / 0.85));
  }

  .brand-page-final-cta__heading {
    margin: var(--space-4) 0 0;
    max-width: 26ch;
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--bpfc-heading, #ffffff);
  }

  .brand-page-final-cta__desc {
    margin: var(--space-3) 0 0;
    max-width: 54ch;
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--bpfc-desc, rgb(255 255 255 / 0.78));
  }

  .brand-page-final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .brand-page-final-cta__button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 56px;
    border-radius: var(--radius-lg);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    white-space: nowrap;
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1), background-color 300ms cubic-bezier(0.22, 1, 0.36, 1), border-color 300ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .brand-page-final-cta__button--solid {
    padding-inline: var(--space-8);
    font-size: var(--font-size-lg);
    background: var(--bpfc-accent);
    border: 1px solid var(--bpfc-accent);
    color: var(--bpfc-cta-text, #0a1408);
    box-shadow: 0 14px 32px -10px var(--bpfc-shadow);
  }

  .brand-page-final-cta__button--solid:hover {
    background: var(--bpfc-accent-hover);
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 20px 40px -10px var(--bpfc-shadow-hover);
  }

  .brand-page-final-cta__button--outline {
    padding-inline: var(--space-6);
    font-size: var(--font-size-md);
    background: transparent;
    border: 1px solid var(--bpfc-outline-border, rgb(255 255 255 / 0.28));
    color: var(--bpfc-outline-text, rgb(255 255 255 / 0.9));
  }

  .brand-page-final-cta__button--outline:hover {
    background: var(--bpfc-outline-hover-bg, rgb(255 255 255 / 0.08));
    border-color: var(--bpfc-outline-hover-border, rgb(255 255 255 / 0.45));
    color: var(--bpfc-outline-hover-text, #ffffff);
    transform: translateY(-2px);
  }

  .brand-page-final-cta__button:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--bpfc-focus);
  }

  /* Güven çipleri: yatay, kompakt (>= 44 px). Marka vurgusu koyu kartta ikon rengi olarak kullanılmaz
     (--bpfc-chip-icon: koyu kartta açık ton, açık kartta marka rengi). */
  .brand-page-final-cta__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: var(--space-5) 0 0;
    list-style: none;
    border-top: 1px solid var(--bpfc-trust-border-top, rgb(255 255 255 / 0.12));
    width: 100%;
    max-width: 56rem;
  }

  .brand-page-final-cta__trust-li {
    display: flex;
  }

  .brand-page-final-cta__trust-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-4) 0 var(--space-3);
    border-radius: var(--radius-full);
    background: var(--bpfc-trust-item-bg, rgb(255 255 255 / 0.1));
    border: 1px solid var(--bpfc-trust-item-border, rgb(255 255 255 / 0.24));
    text-decoration: none;
    transition: background-color 160ms ease, border-color 160ms ease;
  }

  .brand-page-final-cta__trust-item :global(.brand-page-final-cta__trust-icon) {
    flex: none;
    color: var(--bpfc-chip-icon);
  }

  .brand-page-final-cta__trust-label {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    color: var(--bpfc-trust-label, rgb(255 255 255 / 0.95));
  }

  .brand-page-final-cta__trust-item :global(.brand-page-final-cta__trust-go) {
    flex: none;
    margin-left: calc(-1 * var(--space-1));
    color: var(--bpfc-trust-label, rgb(255 255 255 / 0.95));
    opacity: 0.7;
    transition: transform 160ms ease, opacity 160ms ease;
  }

  @media (hover: hover) {
    .brand-page-final-cta__trust-item--link:hover {
      background: var(--bpfc-trust-item-hover-bg, rgb(255 255 255 / 0.18));
      border-color: var(--bpfc-chip-icon);
    }

    .brand-page-final-cta__trust-item--link:hover :global(.brand-page-final-cta__trust-go) {
      opacity: 1;
      transform: translateX(2px);
    }
  }

  .brand-page-final-cta__trust-item--link:focus-visible {
    outline: 2px solid var(--bpfc-chip-icon);
    outline-offset: 2px;
  }

  @media (max-width: 1023px) {
    .brand-page-final-cta__card {
      padding: var(--space-10) var(--space-6);
    }
  }

  @media (max-width: 640px) {
    .brand-page-final-cta {
      padding-block: var(--space-10);
    }

    .brand-page-final-cta__frame {
      padding-inline: var(--space-4);
    }

    .brand-page-final-cta__card {
      padding: var(--space-8) var(--space-5);
    }

    /* Slightly tighter than the base clamp() so long headings stay within 3-4 lines on phones;
       pages that set headingMobileFontSize keep their own value. */
    .brand-page-final-cta__heading {
      font-size: var(--bpfc-heading-size-mobile, clamp(1.5rem, 1rem + 2.4vw, 2.75rem));
    }

    .brand-page-final-cta__actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .brand-page-final-cta__button {
      width: 100%;
    }

    .brand-page-final-cta__trust {
      margin-top: var(--space-5);
      padding-top: var(--space-4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-page-final-cta[data-anim="in"] .brand-page-final-cta__card {
      animation: none;
    }

    .brand-page-final-cta__button,
    .brand-page-final-cta__trust-item,
    .brand-page-final-cta__trust-item :global(.brand-page-final-cta__trust-go) {
      transition: none;
    }

    .brand-page-final-cta__trust-item--link:hover :global(.brand-page-final-cta__trust-go) {
      transform: none;
    }
  }

  /* Long labels ("Cihaz Denemesi Için Randevu Al", "Ücretsiz Işitme Değerlendirmesi") were clipped at 390-430px by nowrap; wrap instead. */
  @media (max-width: 640px) {
    .brand-page-final-cta__button {
      height: auto;
      min-height: 56px;
      padding-block: var(--space-3);
      white-space: normal;
      text-align: center;
      line-height: 1.25;
    }
  }
</style>

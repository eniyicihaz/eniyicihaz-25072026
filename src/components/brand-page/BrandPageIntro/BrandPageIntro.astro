---
// BrandPageIntro — shared, cross-brand "brand story" section combining
// editorial copy (left) with a stat list (right). New component, not a
// migration of an existing Oticon component: Phonak's blueprint folds
// Oticon's separate About (M2) + Heritage (M4) sections into a single
// introData section (see PHONAK MASTER BLUEPRINT §3.1/§6.3). Visually
// modeled on the same "editorial trust list — no cards, no KPI boxes"
// language Oticon's Heritage section established.

export interface BrandPageIntroStat {
  value: string;
  label: string;
}

export interface BrandPageIntroContent {
  badge: string;
  heading: string;
  paragraphs: string[];
  stats: BrandPageIntroStat[];
  accentColor: string;
  accentColorBadgeBg: string;
  accentColorBadgeBorder: string;
  accentColorBadgeText: string;
}

interface Props {
  data: BrandPageIntroContent;
}

const { data } = Astro.props;
---

<section
  class="brand-page-intro"
  aria-labelledby="brand-page-intro-title"
  style={`--bpi-accent:${data.accentColor}; --bpi-badge-bg:${data.accentColorBadgeBg}; --bpi-badge-border:${data.accentColorBadgeBorder}; --bpi-badge-text:${data.accentColorBadgeText};`}
>
  <div class="brand-page-intro__inner">
    <div class="brand-page-intro__content">
      <p class="brand-page-intro__badge" data-rise>{data.badge}</p>
      <h2 class="brand-page-intro__heading" id="brand-page-intro-title" data-rise>
        {data.heading}
      </h2>
      {
        data.paragraphs.map((p) => (
          <p class="brand-page-intro__paragraph" data-rise>
            {p}
          </p>
        ))
      }
    </div>

    <div class="brand-page-intro__stats" data-rise>
      {
        data.stats.map((stat) => (
          <div class="brand-page-intro__stat">
            <p class="brand-page-intro__stat-value">{stat.value}</p>
            <p class="brand-page-intro__stat-label">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var section = document.querySelector(".brand-page-intro");
    if (!section) return;
    if (!("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    section.dataset.anim = "pending";

    var revealed = false;
    var ioAlive = false;
    var io;

    function reveal() {
      if (revealed) return;
      revealed = true;
      section.dataset.anim = "in";
      if (io) io.disconnect();
    }

    var failsafe = setTimeout(function () {
      if (!ioAlive) reveal();
    }, 1500);

    io = new IntersectionObserver(
      function (entries) {
        ioAlive = true;
        clearTimeout(failsafe);
        if (entries[0].isIntersecting) reveal();
      },
      { threshold: 0.15 }
    );

    io.observe(section);
  })();
</script>

<style>
  .brand-page-intro {
    background: var(--color-background);
    color: var(--color-text);
    padding-block: var(--space-24);
    --bpi-ease: cubic-bezier(0.22, 1, 0.36, 1);
  }

  .brand-page-intro__inner {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-16);
    align-items: start;
  }

  .brand-page-intro__badge {
    display: inline-block;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--bpi-badge-border);
    border-radius: var(--radius-full);
    background: var(--bpi-badge-bg);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    color: var(--bpi-badge-text);
  }

  .brand-page-intro__heading {
    margin: var(--space-5) 0 0;
    max-width: 20ch;
    font-size: clamp(1.875rem, 1.5rem + 1.8vw, 2.75rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .brand-page-intro__paragraph {
    margin: var(--space-5) 0 0;
    max-width: 46ch;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .brand-page-intro__stats {
    display: flex;
    flex-direction: column;
  }

  .brand-page-intro__stat {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .brand-page-intro__stat:first-child {
    border-top: none;
    padding-top: 0;
  }

  .brand-page-intro__stat-value {
    margin: 0;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--color-text);
  }

  .brand-page-intro__stat-label {
    margin: var(--space-1) 0 0;
    font-size: var(--font-size-sm);
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }

  .brand-page-intro[data-anim="pending"] [data-rise] {
    opacity: 0;
  }

  .brand-page-intro[data-anim="in"] [data-rise] {
    animation: brand-page-intro-rise 600ms var(--bpi-ease) both;
  }

  .brand-page-intro[data-anim="in"] .brand-page-intro__stats {
    animation-delay: 120ms;
  }

  @keyframes brand-page-intro-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 1023px) {
    .brand-page-intro__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-10);
    }
  }

  @media (max-width: 640px) {
    .brand-page-intro {
      padding-block: var(--space-16);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-page-intro[data-anim="in"] [data-rise] {
      animation: none;
    }
  }
</style>

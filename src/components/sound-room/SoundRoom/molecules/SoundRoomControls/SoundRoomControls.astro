---
// Netlik control (SOUND_ROOM_SPECIFICATION.md §3/§8/§12). Wraps the existing
// DS Slider atom — a native <input type="range"> — rather than inventing a
// new drag control (§10 Component Decision Tree). The fixed ethical
// disclaimer lives here too, always visible, never a tooltip (§2).
import Slider from "../../../../../ds/components/ui/atoms/Slider/Slider.astro";

interface Props {
  clarityLabel: string;
  noiseLabel: string;
  signalLabel: string;
  disclaimer: string;
}
const { clarityLabel, noiseLabel, signalLabel, disclaimer } = Astro.props;
---

<div class="sound-room-controls">
  <label class="sound-room-controls__label" for="sound-room-clarity">
    {clarityLabel}
  </label>

  <div class="sound-room-controls__row">
    <span class="sound-room-controls__end" aria-hidden="true">{noiseLabel}</span>
    <Slider
      id="sound-room-clarity"
      name="clarity"
      min={0}
      max={100}
      step={1}
      value={0}
      class="sound-room-controls__slider"
    />
    <span class="sound-room-controls__end" aria-hidden="true">{signalLabel}</span>
  </div>

  <p class="sound-room-controls__disclaimer">{disclaimer}</p>
</div>

<style>
  .sound-room-controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    width: min(100%, 640px);
    margin-inline: auto;
  }

  .sound-room-controls__label {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-primary-hover);
  }

  .sound-room-controls__row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
  }

  .sound-room-controls__slider {
    flex: 1;
  }

  .sound-room-controls__end {
    font-size: var(--font-size-xs);
    color: var(--color-text-soft);
    white-space: nowrap;
  }

  .sound-room-controls__disclaimer {
    margin: 0;
    max-width: 40rem;
    font-size: var(--font-size-xs);
    color: var(--color-text-soft);
    text-align: center;
  }

  /* Idle invitation: a few gentle pulses on the slider before first touch,
     then silent — never continuous (§9). data-touched is set by
     SoundRoom.astro's script on first `input`. */
  :global(.sound-room[data-touched="false"]) .sound-room-controls__slider {
    animation: sound-room-invite 2.4s
      var(--sound-room-ease, cubic-bezier(0.22, 1, 0.36, 1)) 3;
  }

  @keyframes sound-room-invite {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.015);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.sound-room[data-touched="false"]) .sound-room-controls__slider {
      animation: none;
    }
  }
</style>

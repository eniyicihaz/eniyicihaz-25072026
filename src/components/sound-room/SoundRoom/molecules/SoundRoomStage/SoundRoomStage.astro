---
// The thread field — six acoustic threads (SOUND_ROOM_SPECIFICATION.md §3/§7).
// Purely decorative (aria-hidden): meaning is carried for assistive tech via
// the slider's aria-valuetext in SoundRoom.astro, not repeated here (§12).
import SoundRoomThread from "../../atoms/SoundRoomThread/SoundRoomThread.astro";
import type { SoundRoomThreadData } from "../../sound-room.types";

interface Props {
  threads: SoundRoomThreadData[];
}
const { threads } = Astro.props;
---

<div class="sound-room-stage" aria-hidden="true">
  <div class="sound-room-stage__band">
    {
      threads.map((t) => (
        <SoundRoomThread
          label={t.label}
          alignThreshold={t.alignThreshold}
          order={t.order}
        />
      ))
    }
  </div>
</div>

<style>
  .sound-room-stage {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .sound-room-stage__band {
    position: relative;
    width: min(100%, 640px);
    height: clamp(220px, 32vh, 320px);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    /* Same faint dot-grid technique as Hero (radial-gradient tiled
       circles) — not a new visual motif, just reused here so the band
       reads as a defined "stage" at rest instead of empty space (visual
       QA round: this was flagged as looking like a placeholder). */
    background-image: radial-gradient(
      circle,
      rgb(37 99 235 / 0.06) 1px,
      transparent 1px
    );
    background-size: 22px 22px;
  }
</style>

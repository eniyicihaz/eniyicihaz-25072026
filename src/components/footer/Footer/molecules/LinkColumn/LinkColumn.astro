---
import FooterHeading from "../../atoms/FooterHeading/FooterHeading.astro";
import FooterLink from "../../atoms/FooterLink/FooterLink.astro";
import type { LinkColumn } from "../../footer.types";

type Props = LinkColumn;

const { title, links } = Astro.props;
---

<nav class="link-column" aria-label={title}>
  <FooterHeading title={title} />
  <ul class="link-column__list">
    {
      links.map((link) => (
        <li>
          <FooterLink label={link.label} href={link.href} />
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .link-column {
    min-width: 0;
  }

  .link-column__list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>

---
import type { BrandItem } from "../../footer.types";

interface Props {
  title: string;
  items: BrandItem[];
}

const { title, items } = Astro.props;
---

<div class="brand-strip">
  <p class="brand-strip__title">{title}</p>
  <ul class="brand-strip__list">
    {
      items.map((item) => (
        <li>
          <a class="brand-strip__item" href={item.href}>
            {item.name}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .brand-strip {
    display: flex;
    align-items: baseline;
    gap: var(--space-4) var(--space-8);
  }

  .brand-strip__title {
    flex: none;
    margin: 0;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--footer-muted);
  }

  /* Any number of brands simply wraps onto the next line. */
  .brand-strip__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .brand-strip__item {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    border: 1px solid var(--footer-border);
    background: var(--footer-surface);
    font-size: var(--font-size-sm);
    letter-spacing: -0.005em;
    line-height: 1.5;
    color: var(--footer-link);
    text-decoration: none;
    transition:
      color var(--transition-base),
      background-color var(--transition-base),
      border-color var(--transition-base);
  }

  .brand-strip__item:hover {
    color: var(--footer-link-hover);
    background: var(--footer-surface-hover);
    border-color: var(--footer-accent-border);
  }

  .brand-strip__item:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  @media (max-width: 767px) {
    .brand-strip {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
  }
</style>

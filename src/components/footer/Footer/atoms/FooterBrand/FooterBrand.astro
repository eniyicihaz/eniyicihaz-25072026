---
interface Props {
  brand: string;
  tagline: string;
  href?: string;
}

// The real Avrasya İşitme Cihazları logo (ASSET_SOT §1, MASTER_PLAN A1). The artwork is navy/teal/grey on a
// transparent background, so on the navy footer it sits on a white plate — unaltered, never recoloured or redrawn.
// The accessible name is the brand name (the same words the logo shows).
const { tagline, href = "/" } = Astro.props;
---

<div class="footer-brand">
  <a class="footer-brand__link" href={href}>
    <span class="footer-brand__plate">
      <img
        src="/images/brand/avrasya-isitme-cihazlari-logo-header-720.webp"
        srcset="/images/brand/avrasya-isitme-cihazlari-logo-header-360.webp 360w, /images/brand/avrasya-isitme-cihazlari-logo-header-720.webp 720w"
        sizes="220px"
        width="720"
        height="255"
        alt="Avrasya İşitme Cihazları"
        loading="lazy"
        decoding="async"
      />
    </span>
  </a>
  <p class="footer-brand__tagline">{tagline}</p>
</div>

<style>
  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .footer-brand__link {
    display: inline-block;
    text-decoration: none;
    border-radius: var(--radius-lg);
  }

  .footer-brand__link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--footer-bg), 0 0 0 5px var(--brand-teal-light);
  }

  .footer-brand__plate {
    display: block;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--color-white);
  }

  .footer-brand__plate img {
    display: block;
    width: 200px;
    height: auto;
    aspect-ratio: 720 / 255;
  }

  .footer-brand__tagline {
    margin: 0;
    font-size: var(--font-size-sm);
    line-height: 1.5;
    color: var(--footer-muted);
  }
</style>

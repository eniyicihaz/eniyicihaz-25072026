---
// GuideHero — H1 + lead + the two conversion CTAs + trust chips, with a
// visual slot on the right. The visual is a NEUTRAL PLACEHOLDER until the
// hero image is produced (`data.imageNeeded` documents what to make); it
// renders no visible text, so it can never read as a finished design. When
// `data.image` is supplied, the same slot renders the real <img>.
import { Phone, MessageCircle, ShieldCheck } from "lucide-astro";
import CtaButton from "../shared/CtaButton/CtaButton.astro";
import ImagePlaceholder from "../shared/ImagePlaceholder/ImagePlaceholder.astro";
import type { PriceGuideHeroContent } from "../../data/isitme-cihazi-fiyatlari/hero";

interface Props {
  data: PriceGuideHeroContent;
  /** Optional CTA icon overrides (defaults suit the price guide's phone/WhatsApp CTAs). */
  icons?: { primary?: any; secondary?: any };
  /** Optional third, quieter action rendered as a text link after the two buttons. */
  extraCta?: { label: string; href: string };
}

const { data, icons, extraCta } = Astro.props;
---

<section class="guide-hero" aria-labelledby="guide-hero-title">
  <div class:list={["guide-hero__inner", { "guide-hero__inner--text-only": data.textOnly }]}>
    <div class="guide-hero__copy">
      <p class="guide-hero__eyebrow">{data.eyebrow}</p>
      <h1 class="guide-hero__heading" id="guide-hero-title">{data.heading}</h1>
      <p class="guide-hero__lead">{data.lead}</p>
      <p class="guide-hero__supporting">{data.supporting}</p>

      <div class="guide-hero__actions">
        <CtaButton label={data.ctaPrimary.label} href={data.ctaPrimary.href} iconLeft={icons?.primary ?? Phone} />
        <CtaButton label={data.ctaSecondary.label} href={data.ctaSecondary.href} variant="outline" iconLeft={icons?.secondary ?? MessageCircle} />
      </div>
      {extraCta && <a class="guide-hero__extra" href={extraCta.href}>{extraCta.label} →</a>}

      <ul class="guide-hero__chips">
        {
          data.chips.map((chip) => (
            <li>
              <ShieldCheck size={14} stroke-width={2} aria-hidden="true" />
              <span>{chip}</span>
            </li>
          ))
        }
      </ul>
    </div>

    {!data.textOnly && (
    <div class="guide-hero__visual" data-image-slot="hero">
      {
        data.image ? (
          <img
            class="guide-hero__image"
            src={data.image.src}
            alt={data.image.alt}
            width={data.image.width}
            height={data.image.height}
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          <ImagePlaceholder alt={data.imageNeeded ?? "Görsel alanı"} ratio="16/9" />
        )
      }
    </div>
    )}
  </div>
</section>

<style>
  .guide-hero {
    background: var(--color-surface);
    color: var(--color-text);
    padding-block: var(--space-10) var(--space-16);
  }

  .guide-hero__inner {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-12);
    align-items: center;
  }

  /* Görselsiz kısa mod: tek kolon. */
  .guide-hero__inner--text-only {
    grid-template-columns: minmax(0, 1fr);
  }

  .guide-hero__eyebrow {
    display: inline-block;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-background);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
  }

  .guide-hero__heading {
    margin: var(--space-4) 0 0;
    font-size: clamp(2.25rem, 1.6rem + 3vw, 3.75rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .guide-hero__lead {
    margin: var(--space-5) 0 0;
    max-width: 38rem;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-relaxed);
    color: var(--color-text);
  }

  .guide-hero__supporting {
    margin: var(--space-3) 0 0;
    max-width: 38rem;
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .guide-hero__actions {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .guide-hero__extra {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: var(--space-3);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .guide-hero__extra:hover {
    text-decoration: underline;
  }

  .guide-hero__extra:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  .guide-hero__chips {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .guide-hero__chips li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .guide-hero__chips :global(svg) {
    color: var(--color-primary);
  }

  .guide-hero__visual {
    min-width: 0;
  }

  .guide-hero__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-lg);
  }

  .guide-hero__visual :global(.image-placeholder) {
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 1023px) {
    .guide-hero__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  @media (max-width: 640px) {
    .guide-hero {
      padding-block: var(--space-6) var(--space-10);
    }

    .guide-hero__inner {
      padding-inline: var(--space-4);
    }

    .guide-hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .guide-hero__actions :global(.cta-button) {
      width: 100%;
      justify-content: center;
    }
  }
</style>

---
// InfoGrid — responsive grid of explanatory cards, used for the price
// factors, total-cost items, features, scenarios, SGK blocks, included
// services and brand links. A card may carry an icon, a tag, a qualitative
// "fiyata etkisi" chip (never a number), bullets and a link.
import { ArrowRight } from "lucide-astro";
import type { GuideCard } from "./price-guide.types";

interface Props {
  cards: GuideCard[];
  /** Columns at desktop width; tablet always 2, mobile 1. */
  columns?: 2 | 3 | 4;
  /** Render each card's title as this heading level (the parent section owns the H2). */
  headingLevel?: "h3" | "h4";
}

const { cards, columns = 3, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;

const impactClass: Record<string, string> = {
  yüksek: "high",
  orta: "mid",
  düşük: "low",
  değişken: "var",
};

const impactLabel: Record<string, string> = {
  yüksek: "Yüksek",
  orta: "Orta",
  düşük: "Düşük",
  değişken: "Değişken",
};
---

<ul class:list={["info-grid", `info-grid--${columns}`]}>
  {
    cards.map((card) => {
      const Icon = card.icon;
      const Wrapper = card.href ? "a" : "div";
      return (
        <li class="info-grid__item">
          <Wrapper class:list={["info-card", { "info-card--link": !!card.href }]} href={card.href}>
            <span class="info-card__top">
              {Icon && (
                <span class="info-card__icon" aria-hidden="true">
                  <Icon size={20} stroke-width={1.75} />
                </span>
              )}
              {card.tag && <span class="info-card__tag">{card.tag}</span>}
              {card.impact && (
                <span class={`info-card__impact info-card__impact--${impactClass[card.impact]}`}>
                  Fiyata etkisi: {impactLabel[card.impact]}
                </span>
              )}
            </span>
            <Heading class="info-card__title">{card.title}</Heading>
            <span class="info-card__text">{card.text}</span>
            {card.bullets && (
              <span class="info-card__bullets">
                {card.bullets.map((b) => <span class="info-card__bullet">{b}</span>)}
              </span>
            )}
            {card.href && (
              <span class="info-card__link">
                {card.linkLabel ?? "Devamını okuyun"}
                <ArrowRight size={16} stroke-width={2} aria-hidden="true" />
              </span>
            )}
          </Wrapper>
        </li>
      );
    })
  }
</ul>

<style>
  .info-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .info-grid--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .info-grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .info-grid--4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .info-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-background);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transition-base), box-shadow var(--transition-base), transform var(--transition-base);
  }

  .info-card--link:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .info-card--link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .info-card__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .info-card__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-lg);
    background: rgb(37 99 235 / 0.08);
    color: var(--color-primary);
  }

  .info-card__tag {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .info-card__impact {
    margin-left: auto;
    padding: 2px var(--space-2);
    border-radius: var(--radius-full);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    background: var(--color-surface);
  }

  .info-card__impact--high {
    border-color: rgb(37 99 235 / 0.4);
    background: rgb(37 99 235 / 0.1);
    color: var(--color-primary-hover);
  }

  .info-card__impact--mid {
    border-color: rgb(37 99 235 / 0.25);
    background: rgb(37 99 235 / 0.05);
    color: var(--color-primary);
  }

  .info-card__title {
    margin: 0;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    line-height: 1.25;
    color: var(--color-text);
  }

  .info-card__text {
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .info-card__bullets {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .info-card__bullet {
    padding: 2px var(--space-3);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .info-card__link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-1);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
  }

  .info-card--link:hover .info-card__link {
    text-decoration: underline;
  }

  @media (max-width: 1279px) {
    .info-grid--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .info-grid--3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .info-grid--2,
    .info-grid--3,
    .info-grid--4 {
      grid-template-columns: minmax(0, 1fr);
    }

    .info-card {
      padding: var(--space-4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .info-card--link:hover {
      transform: none;
    }
  }
</style>

---
// GuideTable — real, semantic <table> for the price guide's comparisons.
// The horizontal scroll container sits OUTSIDE the table (border + radius
// on the scroller) so the first (criterion) column can stay `position:
// sticky` while the data columns scroll on small screens — the same proven
// structure as the homepage's HomeExplore table (the <table> itself must
// never set overflow, or sticky would pin to the table instead of the
// scroller). Column headers may link to a real page.
import type { GuideTableContent } from "./price-guide.types";

interface Props {
  data: GuideTableContent;
  /** When the parent section already renders the H2/intro, skip this block's own header. */
  bare?: boolean;
  /** Opt-in small-screen behaviour (default: horizontal scroll with a sticky first column).
   *  "stack" → each row becomes a labelled card at ≤640px, so no column is hidden behind a sideways scroll.
   *  "fit"   → the table shrinks to the screen width and cells wrap (for 3 short columns). */
  mobile?: "stack" | "fit";
  /** Opt-in görünüm (yalnızca /isitme-cihazi-fiyatlari/): renkli başlık satırı, zebra satırlar,
   *  satır vurgusu (fare: hover · klavye: focus-within) ve `kind: "impact"` sütunlarında rozet.
   *  Verilmezse çıktı ve görünüm önceki hâliyle birebir aynıdır. */
  variant?: "enhanced";
}

const { data, bare = false, mobile, variant } = Astro.props;

/** `kind: "impact"` hücre metni → InfoGrid'in "Fiyata etkisi" rozet skalası (yalnızca renk sınıfı; metin aynen görünür). */
const impactTone = (value: string) => {
  const v = value.toLocaleLowerCase("tr");
  if (v.startsWith("yüksek")) return "high";
  if (v.startsWith("orta")) return "mid";
  if (v.startsWith("düşük")) return "low";
  return "var";
};
---

<div class:list={["guide-table", { "guide-table--stack": mobile === "stack", "guide-table--fit": mobile === "fit", "guide-table--enhanced": variant === "enhanced" }]} id={data.id}>
  {
    !bare && (
      <div class="guide-table__header">
        <p class="guide-table__eyebrow">{data.eyebrow}</p>
        <h3 class="guide-table__heading">{data.heading}</h3>
        {data.intro && <p class="guide-table__intro">{data.intro}</p>}
      </div>
    )
  }

  <div class="guide-table__scroll" tabindex="0" role="region" aria-label={`${data.caption} — yatay kaydırılabilir tablo`}>
    <table class="guide-table__table">
      <caption class="guide-table__caption">{data.caption}</caption>
      <thead>
        <tr>
          <th scope="col" class="guide-table__corner">{data.criterionLabel}</th>
          {
            data.columns.map((col) => (
              <th scope="col" class="guide-table__col-head">
                {col.href ? <a href={col.href}>{col.name}</a> : col.name}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          data.rows.map((row) => (
            <tr>
              <th scope="row" class="guide-table__row-head">{row.href ? <a href={row.href}>{row.label}</a> : row.label}</th>
              {
                row.cells.map((cell, ci) => (
                  <td class:list={["guide-table__cell", { "guide-table__cell--stack-hidden": data.columns[ci]?.stackHidden }]} data-label={data.columns[ci]?.name}>
                    {data.columns[ci]?.kind === "impact" ? <span class={`guide-table__impact guide-table__impact--${impactTone(cell)}`}>{cell}</span> : cell}
                  </td>
                ))
              }
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {data.note && <p class="guide-table__note">{data.note}</p>}
  {
    data.links && data.links.length > 0 && (
      <p class="guide-table__links">
        {data.links.map((link) => <a href={link.href}>{link.label} →</a>)}
      </p>
    )
  }
</div>

<style>
  .guide-table + .guide-table {
    margin-top: var(--space-12);
  }

  .guide-table {
    scroll-margin-top: calc(var(--space-16) + var(--space-4));
  }

  .guide-table__header {
    max-width: 44rem;
    margin-bottom: var(--space-5);
  }

  .guide-table__eyebrow {
    margin: 0;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
  }

  .guide-table__heading {
    margin: var(--space-2) 0 0;
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .guide-table__intro {
    margin: var(--space-3) 0 0;
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .guide-table__scroll {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .guide-table__scroll:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .guide-table__table {
    width: 100%;
    min-width: 640px;
    border-collapse: separate;
    border-spacing: 0;
  }

  .guide-table__caption {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .guide-table__corner,
  .guide-table__row-head {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--color-background);
    border-right: 1px solid var(--color-border);
    text-align: left;
  }

  .guide-table__corner {
    z-index: 2;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .guide-table__col-head {
    min-width: 150px;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
    background: var(--color-surface);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    text-align: left;
    vertical-align: bottom;
  }

  .guide-table__col-head a,
  .guide-table__row-head a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .guide-table__col-head a:hover,
  .guide-table__row-head a:hover {
    text-decoration: underline;
  }

  .guide-table__col-head a:focus-visible,
  .guide-table__row-head a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  .guide-table__row-head {
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    min-width: 132px;
  }

  .guide-table__cell {
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
    vertical-align: top;
  }

  .guide-table__note {
    margin: var(--space-4) 0 0;
    max-width: 52rem;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .guide-table__links {
    margin: var(--space-3) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }

  .guide-table__links a {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .guide-table__links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .guide-table + .guide-table {
      margin-top: var(--space-10);
    }

    .guide-table__heading {
      font-size: var(--font-size-xl);
    }

    .guide-table__col-head {
      min-width: 132px;
    }

    .guide-table__row-head {
      min-width: 104px;
      padding-inline: var(--space-3);
    }

    /* mobile="fit": no sideways scroll, cells wrap. */
    .guide-table--fit .guide-table__table {
      min-width: 0;
    }

    .guide-table--fit .guide-table__col-head,
    .guide-table--fit .guide-table__row-head {
      min-width: 0;
    }

    .guide-table--fit .guide-table__row-head,
    .guide-table--fit .guide-table__cell,
    .guide-table--fit .guide-table__col-head,
    .guide-table--fit .guide-table__corner {
      padding-inline: var(--space-2);
    }

    .guide-table--fit .guide-table__cell:first-of-type {
      white-space: nowrap;
    }

    /* mobile="stack": every row is a card — title = row header, then "column name → value" lines. */
    .guide-table--stack .guide-table__scroll {
      overflow: visible;
      border: 0;
      border-radius: 0;
      background: transparent;
    }

    .guide-table--stack .guide-table__table,
    .guide-table--stack tbody,
    .guide-table--stack tr,
    .guide-table--stack th,
    .guide-table--stack td {
      display: block;
      min-width: 0;
      width: auto;
    }

    /* Header row stays in the DOM for assistive tech but is visually hidden (each cell carries its own label). */
    .guide-table--stack thead {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }

    .guide-table--stack tbody {
      display: grid;
      gap: var(--space-3);
    }

    .guide-table--stack tr {
      padding: var(--space-4);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      background: var(--color-background);
    }

    .guide-table--stack .guide-table__row-head {
      position: static;
      padding: 0 0 var(--space-2);
      border: 0;
      font-size: var(--font-size-md);
    }

    .guide-table--stack .guide-table__cell {
      padding: var(--space-2) 0 0;
      border: 0;
    }

    .guide-table--stack .guide-table__cell::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 2px;
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-semibold);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-muted);
    }

    .guide-table--stack .guide-table__cell--stack-hidden {
      display: none;
    }
  }
  /* --- Opt-in `variant="enhanced"` (yalnızca fiyat sayfası) ---------------------------
     Renk yalnızca mavi yoğunluk skalası + nötr; "iyi/kötü" çağrışımı yapan kırmızı/yeşil yok.
     Satır vurgusu okuma çizgisini takip etmeye yarar: fare için hover (yalnızca hover destekleyen
     cihazlarda), klavye için focus-within. Hiçbir bilgi hover'a bağlı değildir. Yapışkan ilk sütun
     zebra ve vurgu renginde de opak kalır (kayan hücreler altından görünmez). */
  .guide-table--enhanced .guide-table__scroll {
    border-color: rgb(37 99 235 / 0.22);
    box-shadow: var(--shadow-sm);
  }

  /* Başlık hücreleri dikeyde ortalanır: bağlantılı sütun başlığı (48 px dokunma alanı) ile düz
     metin başlığı ve iki satıra kayan başlıklar aynı hizada durur (varsayılan: bottom). */
  .guide-table--enhanced .guide-table__corner,
  .guide-table--enhanced .guide-table__col-head {
    vertical-align: middle;
    background: #eff6ff;
    border-bottom: 2px solid var(--color-primary);
  }

  .guide-table--enhanced .guide-table__corner {
    color: var(--color-primary-hover);
  }

  .guide-table--enhanced .guide-table__col-head {
    color: #1e3a8a;
  }

  .guide-table--enhanced tbody tr > * {
    transition: background-color 150ms ease, box-shadow 150ms ease;
  }

  .guide-table--enhanced tbody tr:nth-child(even) > * {
    background: var(--color-surface);
  }

  .guide-table--enhanced .guide-table__row-head {
    color: var(--color-text);
  }

  .guide-table--enhanced .guide-table__cell {
    color: #334155;
  }

  @media (hover: hover) {
    .guide-table--enhanced tbody tr:hover > * {
      background: #eff6ff;
    }

    .guide-table--enhanced tbody tr:hover > .guide-table__row-head {
      box-shadow: inset 3px 0 0 var(--color-primary);
    }
  }

  .guide-table--enhanced tbody tr:focus-within > * {
    background: #eff6ff;
  }

  .guide-table--enhanced tbody tr:focus-within > .guide-table__row-head {
    box-shadow: inset 3px 0 0 var(--color-primary);
  }

  /* `kind: "impact"` rozeti — InfoGrid "Fiyata etkisi" ile aynı skala. */
  .guide-table__impact {
    display: inline-flex;
    padding: 2px var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-background);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    line-height: 1.5;
    white-space: nowrap;
    color: var(--color-text-muted);
  }

  .guide-table__impact--high {
    border-color: rgb(37 99 235 / 0.4);
    background: rgb(37 99 235 / 0.1);
    color: var(--color-primary-hover);
  }

  .guide-table__impact--mid {
    border-color: rgb(37 99 235 / 0.25);
    background: rgb(37 99 235 / 0.05);
    color: var(--color-primary);
  }

  @media (max-width: 640px) {
    /* Kart görünümünde zebra ve vurgu kartın kendisine uygulanır (hücrelere değil). */
    .guide-table--enhanced.guide-table--stack .guide-table__scroll {
      box-shadow: none;
    }

    .guide-table--enhanced.guide-table--stack tbody tr > *,
    .guide-table--enhanced.guide-table--stack tbody tr:hover > *,
    .guide-table--enhanced.guide-table--stack tbody tr:focus-within > * {
      background: transparent;
      box-shadow: none;
    }

    .guide-table--enhanced.guide-table--stack tbody tr {
      border-color: rgb(37 99 235 / 0.2);
      border-left: 3px solid rgb(37 99 235 / 0.45);
    }

    .guide-table--enhanced.guide-table--stack tbody tr:nth-child(even) {
      background: var(--color-surface);
    }

    .guide-table--enhanced.guide-table--stack .guide-table__row-head {
      color: #1e3a8a;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .guide-table--enhanced tbody tr > * {
      transition: none;
    }
  }
</style>

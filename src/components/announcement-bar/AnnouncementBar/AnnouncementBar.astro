---
// Announcement Bar — thin strip above the Header. Independent of Header
// (never merged into it). The whole bar is a single clickable CTA (not a
// message + separate link) so the entire warm-gradient strip reads as one
// inviting action, not a passive notice with a link tacked on.
import { MapPin, ArrowRight } from "lucide-astro";

interface Props {
  /** Current URL path (from MainLayout) — picks the message that fits the page. */
  pathname?: string;
}

const { pathname = "/" } = Astro.props;

// One bar, three messages — never an unrelated one:
//   • default (home, devices, brands, prices, SGK, guides …): price + SGK — also the site-wide link that keeps
//     /isitme-cihazi-fiyatlari/ from being an orphan (QUALITY_GATES.md), so it stays the default;
//   • /degerlendirme/* (hearing test, audiometry, children, …): the free hearing test appointment;
//   • blog / contact / about / info / sitemap: one neutral site message.
const priceMessage = { message: "İşitme cihazı fiyatlarını ve SGK desteğini öğrenin", href: "/isitme-cihazi-fiyatlari/" };
const testMessage = { message: "Ücretsiz işitme testi için randevu alın", href: "/iletisim/" };
const neutralMessage = { message: "Darıca'daki SGK anlaşmalı işitme merkezimizle iletişime geçin", href: "/iletisim/" };
const neutralPrefixes = ["/blog/", "/iletisim/", "/hakkimizda/", "/bilgi-merkezi/", "/site-haritasi/"];

const { message, href: linkHref } = pathname.startsWith("/degerlendirme/")
  ? testMessage
  : neutralPrefixes.some((p) => pathname.startsWith(p))
    ? neutralMessage
    : priceMessage;
// Opens the price/SGK topic hub. It is also that page's link from the
// homepage/every page (MainLayout renders this bar sitewide), which is what
// keeps /isitme-cihazi-fiyatlari/ from being an orphan (QUALITY_GATES.md).
// The trailing "→" is the ArrowRight icon below, not part of the text.
---

<div class="announcement-bar" role="region" aria-label="Duyuru">
  <a class="announcement-bar__inner" href={linkHref}>
    <MapPin size={16} stroke-width={2} aria-hidden="true" class="announcement-bar__icon" />
    <span class="announcement-bar__message">{message}</span>
    <ArrowRight size={16} stroke-width={2} aria-hidden="true" class="announcement-bar__arrow" />
  </a>
</div>

<style>
  /* Warm amber/gold, not the previous dark navy — deliberately the one
     saturated, attention-seeking surface on the page, so it reads as "the
     first thing to notice" without borrowing red (alarm) or the site's own
     brand blue (which would just blend into the Header below it). */
  .announcement-bar {
    background: linear-gradient(90deg, #f59e0b 0%, #fbbf24 100%);
  }

  .announcement-bar__inner {
    max-width: var(--container-2xl);
    margin-inline: auto;
    /* Padding-driven (not a fixed height) — ~20% taller than the old 44px
       bar, and the extra room is real vertical padding, not just a bigger
       box, so the line sits with genuine breathing space top and bottom. */
    padding-block: 16px;
    padding-inline: var(--space-6);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    /* Dark navy instead of white — reads with far more contrast against
       the amber/gold gradient than white text did. */
    color: #12213d;
    text-decoration: none;
    transition: filter 200ms ease;
  }

  .announcement-bar__inner:hover {
    /* A quiet glow, not a color change — the gradient itself is already
       the loud part of this bar; hover should feel premium, not flashy. */
    filter: brightness(1.06);
  }

  .announcement-bar__inner:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  .announcement-bar__icon {
    flex: none;
    color: #12213d;
  }

  .announcement-bar__message {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    text-align: center;
    text-decoration: underline;
    text-decoration-color: #12213d;
    text-underline-offset: 3px;
  }

  .announcement-bar__arrow {
    flex: none;
    color: #12213d;
    transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .announcement-bar__inner:hover .announcement-bar__arrow {
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .announcement-bar__inner {
      padding-inline: var(--space-4);
    }

    .announcement-bar__message {
      font-size: var(--font-size-xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-bar__inner,
    .announcement-bar__arrow {
      transition: none;
    }
  }
</style>

---
// CallbackRequestForm — "Sizi arayalım" geri arama talebi formu: SADECE GÖRSEL TASARIM + TEKNİK HAZIRLIK.
//
// ⛔ BU FORM HİÇBİR SAYFADA KULLANILMIYOR VE HİÇBİR VERİ TOPLAMIYOR. Neden: CONVERSION_SOURCE_OF_TRUTH §2 — form "ileride"dir;
// KVKK aydınlatma/açık rıza metni, saklama süresi, veri sorumlusu ve gönderim altyapısı (e-posta/Turnstile) karara bağlanmamıştır
// ([KULLANICIDAN BİLGİ GEREKLİ]). Bu bileşen yalnızca o kararlar verildiğinde devreye alınacak arayüzdür (docs/tech/CALLBACK_FORM_PREP.md).
//
// Güvence: bileşende ağ isteği YOKTUR (fetch/XHR/beacon yok), <form>'da action/method yoktur; "Gönder" yalnızca doğrulama yapar ve
// "önizleme" mesajı gösterir. Canlıya almak için: uç nokta + onay metni + saklama kararı → `preview={false}` ve gönderim kodu eklenir.
//
// Veri minimizasyonu (tasarım kararı): yalnızca ad, telefon, konu ve uygun zaman. SAĞLIK BİLGİSİ İSTENMEZ (serbest metin alanı yok);
// kullanıcıya sağlık bilgisi yazmaması söylenir. Süre/yanıt vaadi verilmez ("en kısa sürede arayacağız" gibi doğrulanmamış söz yok).
import { Phone, ShieldCheck } from "lucide-astro";

interface Props {
  preview?: boolean;
}
const { preview = true } = Astro.props;

const topics = [
  { value: "test", label: "İşitme testi" },
  { value: "cihaz", label: "Cihaz seçimi veya deneme" },
  { value: "sgk", label: "SGK işlemleri" },
  { value: "servis", label: "Ayar, bakım veya teknik servis" },
  { value: "evde", label: "Evde hizmet" },
  { value: "diger", label: "Diğer" },
];
const times = [
  { value: "hafta-ici", label: "Hafta içi" },
  { value: "cumartesi", label: "Cumartesi" },
  { value: "fark-etmez", label: "Fark etmez" },
];
---

<section class="cb" aria-labelledby="cb-title" data-cb data-preview={preview ? "true" : "false"}>
  <div class="cb__inner">
    <header class="cb__head">
      <p class="cb__eyebrow">Geri Arama Talebi</p>
      <h2 class="cb__title" id="cb-title">Sizi Arayalım</h2>
      <p class="cb__intro">Adınızı ve telefon numaranızı bırakın; sizi arayalım.</p>
    </header>

    <form class="cb__form" novalidate data-cb-form>
      {preview && <p class="cb__preview" role="note">Önizleme: bu form henüz etkin değildir; girdiğiniz bilgi gönderilmez ve saklanmaz.</p>}

      <div class="cb__field">
        <label class="cb__label" for="cb-name">Adınız</label>
        <input class="cb__input" id="cb-name" name="name" type="text" autocomplete="given-name" required maxlength="60" aria-describedby="cb-name-err" />
        <p class="cb__err" id="cb-name-err" role="alert" hidden>Lütfen adınızı yazın.</p>
      </div>

      <div class="cb__field">
        <label class="cb__label" for="cb-phone">Telefon numaranız</label>
        <input class="cb__input" id="cb-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="20" placeholder="05XX XXX XX XX" aria-describedby="cb-phone-hint cb-phone-err" />
        <p class="cb__hint" id="cb-phone-hint">Cep telefonu numaranızı yazın.</p>
        <p class="cb__err" id="cb-phone-err" role="alert" hidden>Lütfen geçerli bir telefon numarası yazın (örn. 0533 000 00 00).</p>
      </div>

      <div class="cb__field">
        <label class="cb__label" for="cb-topic">Konu</label>
        <select class="cb__input" id="cb-topic" name="topic" required aria-describedby="cb-topic-err">
          <option value="" selected disabled>Seçiniz</option>
          {topics.map((t) => <option value={t.value}>{t.label}</option>)}
        </select>
        <p class="cb__err" id="cb-topic-err" role="alert" hidden>Lütfen bir konu seçin.</p>
      </div>

      <div class="cb__field">
        <label class="cb__label" for="cb-time">Uygun zaman</label>
        <select class="cb__input" id="cb-time" name="time">
          {times.map((t) => <option value={t.value}>{t.label}</option>)}
        </select>
      </div>

      <!-- Bot tuzağı: insanlara görünmez, doldurulursa talep reddedilir (altyapı kararı sonrası sunucu tarafında da denetlenir). -->
      <div class="cb__trap" aria-hidden="true">
        <label>Web siteniz <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>

      <p class="cb__warn">
        <ShieldCheck size={18} stroke-width={2} aria-hidden="true" />
        <span>Lütfen bu forma sağlık bilgilerinizi yazmayın; konuyu telefonda görüşürüz.</span>
      </p>

      <div class="cb__consent">
        <label class="cb__check">
          <input type="checkbox" id="cb-consent" name="consent" required aria-describedby="cb-consent-err" />
          <span>
            Kişisel verilerimin geri arama talebimin karşılanması amacıyla işlenmesine ilişkin{" "}
            <a href="/kvkk/aydinlatma-metni/">Aydınlatma Metni</a>'ni okudum ve anladım.
          </span>
        </label>
        <p class="cb__err" id="cb-consent-err" role="alert" hidden>Devam etmek için aydınlatma metnini onaylamanız gerekir.</p>
      </div>

      <button class="cb__submit" type="submit">
        <Phone size={20} stroke-width={2} aria-hidden="true" />
        <span>Beni Arayın</span>
      </button>
      <p class="cb__status" role="status" aria-live="polite" data-cb-status></p>
    </form>
  </div>
</section>

<script>
  // YALNIZCA doğrulama + önizleme mesajı. Ağ isteği yoktur.
  document.querySelectorAll<HTMLElement>("[data-cb]").forEach((root) => {
    const form = root.querySelector<HTMLFormElement>("[data-cb-form]");
    const status = root.querySelector<HTMLElement>("[data-cb-status]");
    if (!form || !status) return;
    const preview = root.dataset.preview === "true";
    const show = (id: string, on: boolean) => {
      const el = form.querySelector<HTMLElement>(`#${id}`);
      if (el) el.hidden = !on;
    };
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get("name") ?? "").trim();
      const phone = String(data.get("phone") ?? "").replace(/[\s()-]/g, "");
      const topic = String(data.get("topic") ?? "");
      const consent = data.get("consent") === "on";
      const okName = name.length >= 2;
      // Türkiye cep numarası: 05XXXXXXXXX, 5XXXXXXXXX veya +905XXXXXXXXX
      const okPhone = /^(\+90|90|0)?5\d{9}$/.test(phone);
      const checks: Array<[string, string, boolean]> = [
        ["cb-name", "cb-name-err", okName],
        ["cb-phone", "cb-phone-err", okPhone],
        ["cb-topic", "cb-topic-err", !!topic],
        ["cb-consent", "cb-consent-err", consent],
      ];
      for (const [field, err, ok] of checks) {
        show(err, !ok);
        form.querySelector(`#${field}`)?.setAttribute("aria-invalid", String(!ok));
      }
      const firstBad = checks.find((c) => !c[2]);
      if (firstBad) {
        status.textContent = "Lütfen işaretli alanları düzeltin.";
        form.querySelector<HTMLElement>(`#${firstBad[0]}`)?.focus();
        return;
      }
      if (String(data.get("website") ?? "") !== "") return; // bot
      status.textContent = preview ? "Önizleme: bilgileriniz gönderilmedi." : "";
    });
  });
</script>

<style>
  .cb {
    background: var(--color-surface);
    color: var(--color-text);
    padding-block: var(--space-12);
  }

  .cb__inner {
    max-width: 40rem;
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .cb__eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent-text);
  }

  .cb__title {
    margin: 0;
    font-size: clamp(1.625rem, 1.25rem + 1.6vw, 2.25rem);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    color: var(--brand-navy);
  }

  .cb__intro {
    margin: var(--space-3) 0 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .cb__form {
    margin-top: var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background: var(--color-background);
    display: grid;
    gap: var(--space-5);
  }

  .cb__preview {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-left: 4px solid var(--color-warning);
    border-radius: var(--radius-md);
    background: #fff8ed;
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
  }

  .cb__field {
    display: grid;
    gap: var(--space-2);
  }

  .cb__label {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
  }

  .cb__input {
    width: 100%;
    min-height: 56px;
    padding: 0 var(--space-4);
    border: 2px solid var(--color-border-hover);
    border-radius: var(--radius-lg);
    background: var(--color-background);
    color: var(--color-text);
    font: inherit;
    font-size: var(--font-size-lg);
  }

  .cb__input:focus-visible {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: var(--focus-ring);
  }

  .cb__input[aria-invalid="true"] {
    border-color: var(--color-danger);
  }

  .cb__hint {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .cb__err {
    margin: 0;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: #b42318;
  }

  .cb__err[hidden] {
    display: none;
  }

  .cb__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .cb__warn {
    margin: 0;
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .cb__warn :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--color-primary);
  }

  .cb__check {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    cursor: pointer;
  }

  .cb__check input {
    flex: none;
    width: 28px;
    height: 28px;
    margin-top: 2px;
    accent-color: var(--color-primary);
  }

  .cb__check a {
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
    text-underline-offset: 3px;
  }

  .cb__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 56px;
    padding: 0 var(--space-8);
    border: 1px solid var(--color-primary-hover);
    border-radius: var(--radius-lg);
    background: var(--color-primary);
    color: var(--color-text-inverse);
    font: inherit;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }

  .cb__submit:hover {
    background: var(--color-primary-hover);
  }

  .cb__submit:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .cb__status {
    margin: 0;
    min-height: 1.5em;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .cb__inner {
      padding-inline: var(--space-4);
    }

    .cb__form {
      padding: var(--space-4);
    }

    .cb__submit {
      width: 100%;
    }
  }
</style>

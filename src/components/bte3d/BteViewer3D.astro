---
// BteViewer3D — kulak arkası (BTE) işitme cihazının GERÇEK üç boyutlu görüntüleyicisi (WebGL, three.js).
// Metinler ve posterler: src/data/bte3d.ts · Çalışma zamanı: ./bte3d.client.js · Model: ./bte-generic.glb
// Yöntem, ölçümler, bakım: docs/tech/BTE_3D_VIEWER.md
//
// Gösterilen cihaz markasız, logosuz, özgün (jenerik) bir modeldir; bir görselin sağa sola kaydırılması değil, gerçek
// geometridir: her açıdan, sınırlı ölçüde alttan ve üstten incelenir.
//
// Etkileşim:
//   • Doğrudan cihaz üzerinde BASILI TUTUP sürükleme (fare, kalem, dokunmatik). Yatay sürükleme tam 360° döndürür,
//     dikey sürükleme bakış açısını sınırlı ölçüde (alttan ≈ 30°, üstten ≈ 46°) değiştirir.
//   • Dokunmatikte hareket DİKEY başlarsa sayfa kayar (kaydırma engellenmez); yatay başlarsa cihaz döner.
//     Fare tekerleği hiç dinlenmez: sayfa kaydırması görüntüleyicinin üstünde de aynen çalışır.
//   • Yavaş otomatik dönüş: görünür olunca ve model inince başlar; sürükleme/klavye/düğme ile DURUR ve kendiliğinden
//     yeniden başlamaz (kullanıcıyla çakışmaz); düğmeyle yeniden başlatılır/durdurulur. `prefers-reduced-motion`,
//     erişilebilirlik panelindeki "hareketi azalt" veya veri tasarrufu → kendiliğinden başlamaz.
//   • Klavye: görüntüleyici odaklanabilir (Tab); ←/→ 15° (Shift ile 45°), ↑/↓ dikey açı, Home başlangıç görünümü,
//     Boşluk/Enter otomatik dönüş, +/− yakınlaştırma, Esc dönüşü durdurur. Aynı işlevler görünür düğmelerle de vardır.
//     Durum anonsu: aria-live.
//
// Performans:
//   • Sayfa yüklenirken görüntüleyici için HİÇBİR ağ isteği yapılmaz: poster `<img>`'i saydam bir yer tutucudur
//     (boyut CSS'ten gelir → CLS yok), kod ve model sayfaya gömülü değildir.
//   • Sayfada yalnızca küçük, satır içi bir önyükleyici vardır (aşağıdaki `<script>`). Asıl kod (three.js ile birlikte
//     tek dosya) ve model ancak (1) sayfanın kendi yüklemesi bittikten (`load`) VE (2) görüntüleyici görünür alana
//     600 px yaklaştıktan sonra istenir; önce hafif poster görünür, model inince yerini canlı sahne alır.
//     Kullanıcı görüntüleyiciye dokunur/odaklanırsa beklenmeden başlar.
//   • Veri tasarrufu (Save-Data) veya 2g bağlantıda kod/model kendiliğinden inmez; yalnızca poster iner, üç boyutlu
//     görünüm kullanıcı dokununca açılır.
//   • Görünür değilken ve hareket yokken hiçbir kare çizilmez (istek üzerine çizim).
//   • WebGL yoksa, model inemezse ya da JavaScript kapalıysa poster kalır (kırık görüntüleyici yayına çıkmaz).
import { existsSync } from "node:fs";
import { join } from "node:path";
import { Play, Pause, ChevronLeft, ChevronRight, RotateCcw, ZoomIn, ZoomOut, Rotate3D, ArrowRight } from "lucide-astro";
import { bte3d } from "../../data/bte3d";
import { normalizePath } from "../../config/site-map";

interface Props {
  /** Başlık seviyesi (varsayılan h2). */
  headingLevel?: 2 | 3;
  /** Bölüm zemini: "plain" (beyaz) veya "tint" (açık marka zemini). */
  tone?: "plain" | "tint";
}

const { headingLevel = 2, tone = "tint" } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const d = bte3d;

// Derleme zamanı doğrulama: poster görselleri public/ altında bulunmalı, aksi halde bölüm çizilmez (boş sahne yayına çıkmaz).
const posterFiles = [d.posterWide, d.posterSquare].flatMap((p) => [`${p.base}.avif`, `${p.base}.webp`]);
const missing = posterFiles.filter((f) => !existsSync(join(process.cwd(), "public", f)));
const ready = missing.length === 0;
if (!ready) console.warn(`[BteViewer3D] çizilmedi: poster eksik (${missing.join(", ")}).`);

// Saydam yer tutucu: poster istenene kadar `<img>` boş ama geçerli kalır (kırık görsel simgesi çıkmaz, ağ isteği yapılmaz).
const placeholder = `data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 ${d.posterWide.width} ${d.posterWide.height}'/%3E`;
const narrow = "(max-width: 640px)";
// Görüntüleyici, bağlantının gösterdiği sayfanın kendisindeyse bağlantı çizilmez (sayfa kendine bağlanmaz).
const link = normalizePath(Astro.url.pathname) !== d.link.href ? d.link : null;
---

{
  ready && (
    <section class:list={["bte3d", `bte3d--${tone}`]} aria-labelledby={d.id} data-bte3d>
      <div class="bte3d__inner">
        <header class="bte3d__head">
          <p class="bte3d__eyebrow">{d.eyebrow}</p>
          <Heading class="bte3d__title" id={d.id}>
            {d.title}
          </Heading>
          <p class="bte3d__intro">{d.intro}</p>
        </header>

        <div class="bte3d__figure">
          <div
            class="bte3d__stage"
            role="group"
            aria-roledescription="3 boyutlu görüntüleyici"
            aria-label={`${d.alt}. Sürükleyerek veya ok tuşlarıyla her yöne çevrilebilir.`}
            tabindex="0"
            data-bte3d-stage
          >
            <picture>
              <source type="image/avif" media={narrow} data-srcset={`${d.posterSquare.base}.avif`} />
              <source type="image/avif" data-srcset={`${d.posterWide.base}.avif`} />
              <source type="image/webp" media={narrow} data-srcset={`${d.posterSquare.base}.webp`} />
              <img
                class="bte3d__poster"
                src={placeholder}
                data-src={`${d.posterWide.base}.webp`}
                alt={d.alt}
                width={d.posterWide.width}
                height={d.posterWide.height}
                draggable="false"
                decoding="async"
              />
            </picture>
            <noscript>
              <picture>
                <source type="image/avif" media={narrow} srcset={`${d.posterSquare.base}.avif`} />
                <source type="image/avif" srcset={`${d.posterWide.base}.avif`} />
                <source type="image/webp" media={narrow} srcset={`${d.posterSquare.base}.webp`} />
                <img
                  class="bte3d__poster"
                  src={`${d.posterWide.base}.webp`}
                  alt={d.alt}
                  aria-hidden="true"
                  width={d.posterWide.width}
                  height={d.posterWide.height}
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </noscript>
            <p class="bte3d__hint" data-bte3d-hint>
              <Rotate3D size={20} stroke-width={2} aria-hidden="true" />
              <span data-bte3d-hint-text>Basılı tutup sürükleyerek çevirin</span>
            </p>
            <span class="bte3d__progress" aria-hidden="true" data-bte3d-progress />
          </div>

          <div class="bte3d__controls" role="group" aria-label="Görüntüleyici denetimleri">
            <button type="button" class="bte3d__btn" data-bte3d-left aria-label="Sola döndür">
              <ChevronLeft size={22} stroke-width={2.25} aria-hidden="true" />
            </button>
            <button type="button" class="bte3d__btn bte3d__btn--auto" data-bte3d-auto aria-pressed="false">
              <Play size={20} stroke-width={2.25} aria-hidden="true" class="bte3d__ico-play" />
              <Pause size={20} stroke-width={2.25} aria-hidden="true" class="bte3d__ico-pause" />
              <span class="bte3d__auto-text">
                <span data-bte3d-auto-label>Otomatik döndür</span>
                <span class="bte3d__auto-sizer" aria-hidden="true">Otomatik döndür</span>
              </span>
            </button>
            <button type="button" class="bte3d__btn" data-bte3d-right aria-label="Sağa döndür">
              <ChevronRight size={22} stroke-width={2.25} aria-hidden="true" />
            </button>
            <button type="button" class="bte3d__btn" data-bte3d-reset aria-label="Başlangıç görünümüne dön">
              <RotateCcw size={20} stroke-width={2.25} aria-hidden="true" />
            </button>
            <button type="button" class="bte3d__btn" data-bte3d-zoom-out aria-label="Uzaklaştır" disabled>
              <ZoomOut size={20} stroke-width={2.25} aria-hidden="true" />
            </button>
            <button type="button" class="bte3d__btn" data-bte3d-zoom-in aria-label="Yakınlaştır">
              <ZoomIn size={20} stroke-width={2.25} aria-hidden="true" />
            </button>
          </div>
          <p class="bte3d__sr" aria-live="polite" data-bte3d-status />
          <p class="bte3d__failnote">Üç boyutlu görünüm bu cihazda açılamadı; cihazın görseli gösteriliyor.</p>
          <p class="bte3d__note">{d.note}</p>
          {link && (
            <p class="bte3d__link">
              <a href={link.href}>
                <span>{link.label}</span>
                <ArrowRight size={18} stroke-width={2} aria-hidden="true" />
              </a>
            </p>
          )}
        </div>
      </div>
    </section>
  )
}

<script>
  // ÖNYÜKLEYİCİ — bu küçük betik HTML'e satır içi girer (ek ağ isteği yok). Asıl görüntüleyici kodu (bte3d.client.js +
  // three.js, tek paket) ve poster sayfa açılışında İNMEZ; şu iki durumdan biri olunca istenir:
  //   1) sayfanın kendi yüklemesi bitti (`load`; çok gecikirse 4 sn) VE görüntüleyici görünür alana 600 px yaklaştı,
  //   2) kullanıcı beklemeden görüntüleyiciye dokundu / odaklandı / bir düğmesine bastı (o an, beklemeden).
  // Böylece görüntüleyici, ilk ekranın (LCP) yüklemesiyle hiçbir koşulda bant genişliği paylaşmaz.
  // `?worker&url`: Vite bu dosyayı bağımlılıklarıyla (three.js) AYRI bir paket yapar ve yalnızca adresini verir; içe
  // aktarma bir metne çözüldüğü için bu betik çalışma zamanında hiçbir şey içe aktarmaz ve Astro onu satır içi bırakır.
  // (Buraya dinamik `import()` yazılmamalı: satır içi betikte Vite'ın ön-yükleme sarmalayıcısı tanımsız kalır.)
  import clientUrl from "./bte3d.client.js?worker&url";

  const roots = [...document.querySelectorAll<HTMLElement>("[data-bte3d]")];
  if (roots.length) {
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    // Veri tasarrufu / 2g: kod ve model kendiliğinden inmez; yalnızca poster iner, 3B görünüm dokununca açılır.
    const manual = !!conn?.saveData || /(^|-)2g$/.test(conn?.effectiveType ?? "");
    const intents = ["pointerdown", "focusin", "click"] as const;
    let posterOn = false;
    let booted = false;
    let near = false;
    let armed = document.readyState === "complete";
    let pending: HTMLElement | null = null; // kod inmeden basılan düğme: kod inince yeniden tıklanır
    const showPoster = () => {
      if (posterOn) return;
      posterOn = true;
      for (const r of roots) {
        r.querySelectorAll<HTMLSourceElement>("source[data-srcset]").forEach((s) => (s.srcset = s.dataset.srcset!));
        const im = r.querySelector<HTMLImageElement>("img[data-src]");
        if (im) im.src = im.dataset.src!;
      }
    };
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) near = true;
        if (near && armed) auto();
      },
      { rootMargin: "600px 0px" },
    );
    const onIntent = (e: Event) => {
      // Kullanıcının dokunduğu görüntüleyici işaretlenir: modül onun modelini görünürlük beklemeden indirir.
      (e.currentTarget as HTMLElement).dataset.bte3dEager = "true";
      if (e.type === "click") pending = (e.target as HTMLElement).closest<HTMLElement>("button");
      boot();
    };
    const detach = () => roots.forEach((r) => intents.forEach((t) => r.removeEventListener(t, onIntent)));
    function boot() {
      if (booted) return;
      booted = true;
      io.disconnect();
      showPoster();
      const s = document.createElement("script");
      s.type = "module";
      s.src = clientUrl;
      // `load`, modül çalıştıktan (görüntüleyiciler başlatıldıktan) sonra gelir.
      s.onload = () => {
        detach();
        pending?.click();
      };
      // Kod inemediyse (çevrimdışı vb.) poster kalır; çalışmayan denetimler gizlenir.
      s.onerror = () => {
        detach();
        roots.forEach((r) => r.classList.add("is-failed"));
      };
      document.head.append(s);
    }
    function auto() {
      showPoster();
      if (manual) {
        io.disconnect();
        roots.forEach((r) => {
          const t = r.querySelector("[data-bte3d-hint-text]");
          if (t) t.textContent = "3 boyutlu görünümü açmak için dokunun";
        });
      } else boot();
    }
    const arm = () => {
      armed = true;
      if (near) auto();
    };
    roots.forEach((r) => {
      io.observe(r);
      intents.forEach((t) => r.addEventListener(t, onIntent, { passive: true }));
    });
    if (!armed) {
      window.addEventListener("load", () => window.setTimeout(arm, 250), { once: true });
      window.setTimeout(arm, 4000);
    }
  }
</script>

<style>
  .bte3d {
    color: var(--color-text);
    padding-block: var(--space-16);
  }

  .bte3d--plain {
    background: var(--color-background);
  }

  .bte3d--tint {
    background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-background) 100%);
  }

  .bte3d__inner {
    max-width: var(--container-xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
    display: grid;
    gap: var(--space-8);
  }

  .bte3d__head {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }

  .bte3d__eyebrow {
    display: inline-block;
    margin: 0 0 var(--space-3);
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-background);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .bte3d__title {
    margin: 0;
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    letter-spacing: -0.015em;
    color: var(--brand-navy);
    /* Sayfa içi bağlantıyla (#bte-3d) gelindiğinde başlık sabit üst çubuğun altında kalmasın. */
    scroll-margin-top: var(--space-24, 6rem);
  }

  .bte3d__intro {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .bte3d__figure {
    width: 100%;
    max-width: 720px;
    margin-inline: auto;
  }

  .bte3d__stage {
    /* Sahne fonu: hem bu CSS hem de WebGL sahnesi (bte3d.client.js → backdropTexture) aynı üç rengi kullanır. */
    --bte3d-bg-top: #f7fafc;
    --bte3d-bg-bottom: #dfeaf2;
    --bte3d-bg-glow: #ffffff;
    position: relative;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background:
      radial-gradient(ellipse 64% 64% at 50% 43%, var(--bte3d-bg-glow) 0%, var(--bte3d-bg-glow) 42%, transparent 100%),
      linear-gradient(180deg, var(--bte3d-bg-top) 0%, var(--bte3d-bg-bottom) 100%);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    cursor: grab;
    /* Dikey kaydırma tarayıcıda kalır; yatay başlayan hareket cihazı döndürür. */
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .bte3d__stage.is-dragging {
    cursor: grabbing;
  }

  .bte3d__stage:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .bte3d__poster {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* Tuval betikle eklenir (Astro'nun kapsam özniteliğini taşımaz) → :global. Model hazır olunca posterin üstünde belirir. */
  .bte3d__stage :global(.bte3d__canvas) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 320ms ease;
    pointer-events: none;
  }

  .bte3d.is-ready .bte3d__stage :global(.bte3d__canvas) {
    opacity: 1;
  }

  .bte3d__hint {
    position: absolute;
    left: 50%;
    bottom: var(--space-4);
    transform: translateX(-50%);
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    /* Genişlik açıkça `max-content`: simge dahil gerçek içerik genişliği; sahne dar ise metin iki satıra kırılır. */
    width: max-content;
    max-width: calc(100% - var(--space-6));
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: rgb(var(--brand-navy-rgb) / 0.92);
    color: var(--color-text-inverse);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    line-height: 1.3;
    text-align: center;
    pointer-events: none;
  }

  .bte3d__hint :global(svg) {
    flex: none;
  }

  .bte3d__hint[hidden] {
    display: none;
  }

  /* Model indirme ilerlemesi (yalnızca indirme sürerken görünür). */
  .bte3d__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    opacity: 0;
    transition: transform var(--transition-base);
  }

  .bte3d.is-loading .bte3d__progress {
    opacity: 1;
  }

  .bte3d__controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .bte3d__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 52px;
    min-height: 52px;
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border-hover);
    border-radius: var(--radius-lg);
    background: var(--color-background);
    color: var(--color-primary);
    font: inherit;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition:
      background-color var(--transition-base),
      border-color var(--transition-base);
  }

  .bte3d__btn:hover:not(:disabled) {
    background: var(--color-primary-50);
    border-color: var(--color-primary);
  }

  .bte3d__btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .bte3d__btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .bte3d__ico-pause {
    display: none;
  }

  /* Etiket "Otomatik döndür" ↔ "Dönüşü durdur" değişirken düğme genişliği sabit kalsın (komşu düğmeler kaymasın):
     görünmez boyutlayıcı en uzun etiketi taşır, iki metin aynı hücrede üst üste durur. */
  .bte3d__auto-text {
    display: inline-grid;
    justify-items: start;
  }

  .bte3d__auto-text > * {
    grid-area: 1 / 1;
  }

  .bte3d__auto-sizer {
    visibility: hidden;
  }

  .bte3d__btn--auto[aria-pressed="true"] .bte3d__ico-play {
    display: none;
  }

  .bte3d__btn--auto[aria-pressed="true"] .bte3d__ico-pause {
    display: inline-block;
  }

  .bte3d__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Üç boyutlu görünüm açılamadıysa (WebGL yok, kod/model inemedi): poster kalır, çalışmayan denetimler gizlenir. */
  .bte3d__failnote {
    display: none;
    max-width: 40rem;
    margin: var(--space-5) auto 0;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
    color: var(--color-text-muted);
    text-align: center;
  }

  .bte3d.is-failed .bte3d__failnote {
    display: block;
  }

  .bte3d.is-failed .bte3d__controls,
  .bte3d.is-failed .bte3d__hint,
  .bte3d.is-failed .bte3d__progress {
    display: none;
  }

  .bte3d.is-failed .bte3d__stage {
    cursor: default;
  }

  .bte3d__note {
    max-width: 40rem;
    margin: var(--space-5) auto 0;
    font-size: var(--font-size-sm);

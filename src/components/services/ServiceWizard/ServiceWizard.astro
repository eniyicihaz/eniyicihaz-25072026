---
// ServiceWizard — "Size Uygun Hizmeti Bulun": iki adımda (durum → ihtiyaç) mevcut sayfalara yönlendirir.
// Veri: data/services/wizard.ts (yeni bilgi yok). Hiçbir cevap kaydedilmez veya gönderilmez; WhatsApp mesajı yalnızca
// seçilen konuyla önceden doldurulur (numara değişmez).
// İlerleyici geliştirme: JS yoksa aynı bilgi sade bir bağlantı listesi olarak (statik görünüm) kalır.
import { ArrowRight, ArrowLeft, Phone, RotateCcw } from "lucide-astro";
import WhatsAppIcon from "../../shared/WhatsAppIcon/WhatsAppIcon.astro";
import { serviceWizard as w } from "../../../data/services/wizard";
import { contactConfig } from "../../../config/contact";
---

<section class="sw" aria-labelledby="sw-title" data-sw data-wa={contactConfig.whatsapp.href}>
  <div class="sw__inner">
    <header class="sw__head">
      <p class="sw__eyebrow">{w.eyebrow}</p>
      <h2 class="sw__title" id="sw-title">{w.heading}</h2>
      <p class="sw__intro">{w.intro}</p>
    </header>

    <!-- Etkileşimli görünüm (JS açıkken gösterilir) -->
    <div class="sw__app" data-sw-app hidden>
      <p class="sw__progress" data-sw-progress aria-live="polite">Adım 1 / 2</p>

      <fieldset class="sw__step" data-sw-step="1">
        <legend class="sw__legend" tabindex="-1">{w.step1}</legend>
        <div class="sw__choices">
          {
            w.groups.map((g) => (
              <label class="sw__choice">
                <input type="radio" name="sw-group" value={g.id} class="sw__radio" />
                <span class="sw__choice-body">
                  <span class="sw__choice-label">{g.label}</span>
                  <span class="sw__choice-hint">{g.hint}</span>
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      {
        w.groups.map((g) => (
          <fieldset class="sw__step" data-sw-step="2" data-group={g.id} hidden>
            <legend class="sw__legend" tabindex="-1">{g.question}</legend>
            <div class="sw__choices">
              {g.options.map((o) => (
                <label class="sw__choice">
                  <input type="radio" name={`sw-opt-${g.id}`} value={o.id} class="sw__radio" />
                  <span class="sw__choice-body">
                    <span class="sw__choice-label">{o.label}</span>
                  </span>
                </label>
              ))}
            </div>
            <button type="button" class="sw__back" data-sw-back>
              <ArrowLeft size={18} stroke-width={2.25} aria-hidden="true" />
              <span>Geri</span>
            </button>
          </fieldset>
        ))
      }

      {
        w.groups.flatMap((g) =>
          g.options.map((o) => (
            <div class="sw__result" data-sw-result data-group={g.id} data-option={o.id} data-topic={o.topic} tabindex="-1" hidden>
              <h3 class="sw__result-title">Size önerimiz</h3>
              <p class="sw__result-pick">{o.label}</p>
              <ul class="sw__links">
                {o.links.map((l, i) => (
                  <li>
                    <a class:list={["sw__link", { "sw__link--primary": i === 0 }]} href={l.href}>
                      <span class="sw__link-text">
                        <span class="sw__link-label">{l.label}</span>
                        {l.summary && <span class="sw__link-summary">{l.summary}</span>}
                      </span>
                      <ArrowRight size={20} stroke-width={2} aria-hidden="true" />
                    </a>
                  </li>
                ))}
              </ul>
              <p class="sw__ask">Sorunuz mu var? Bize yazın veya arayın:</p>
              <div class="sw__cta">
                <a class="sw__btn sw__btn--wa" href={contactConfig.whatsapp.href} data-sw-wa data-contact-action="whatsapp">
                  <WhatsAppIcon size={20} />
                  <span>WhatsApp'tan Yazın</span>
                </a>
                <a class="sw__btn" href={contactConfig.phone.href} data-contact-action="phone">
                  <Phone size={20} stroke-width={2} aria-hidden="true" />
                  <span>Bizi Arayın</span>
                </a>
                <button type="button" class="sw__restart" data-sw-restart>
                  <RotateCcw size={18} stroke-width={2.25} aria-hidden="true" />
                  <span>Baştan başla</span>
                </button>
              </div>
            </div>
          )),
        )
      }
    </div>

    <!-- Statik görünüm (JS yoksa ya da yükleniyorsa): aynı yönlendirmeler düz liste olarak -->
    <div class="sw__static" data-sw-static>
      {
        w.groups.map((g) => (
          <div class="sw__static-group">
            <h3 class="sw__static-title">{g.label}</h3>
            <ul>
              {g.options.map((o) => (
                <li>
                  <a href={o.links[0].href}>{o.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-sw]").forEach((root) => {
    const app = root.querySelector<HTMLElement>("[data-sw-app]");
    const stat = root.querySelector<HTMLElement>("[data-sw-static]");
    const progress = root.querySelector<HTMLElement>("[data-sw-progress]");
    if (!app || !stat) return;
    app.hidden = false;
    stat.hidden = true;

    const step1 = app.querySelector<HTMLElement>('[data-sw-step="1"]')!;
    const step2s = [...app.querySelectorAll<HTMLElement>('[data-sw-step="2"]')];
    const results = [...app.querySelectorAll<HTMLElement>("[data-sw-result]")];
    const waBase = root.dataset.wa ?? "";

    const hideAll = () => {
      step1.hidden = true;
      step2s.forEach((s) => (s.hidden = true));
      results.forEach((r) => (r.hidden = true));
    };
    const focusLegend = (el: HTMLElement) => (el.querySelector("legend") as HTMLElement | null)?.focus();
    const setProgress = (n: number) => {
      if (progress) progress.textContent = n === 3 ? "Sonuç" : `Adım ${n} / 2`;
    };

    const showStep1 = () => {
      hideAll();
      step1.hidden = false;
      app.querySelectorAll<HTMLInputElement>("input[type=radio]").forEach((i) => (i.checked = false));
      setProgress(1);
      focusLegend(step1);
    };

    step1.querySelectorAll<HTMLInputElement>("input[name=sw-group]").forEach((input) => {
      input.addEventListener("change", () => {
        const target = step2s.find((s) => s.dataset.group === input.value);
        if (!target) return;
        hideAll();
        target.hidden = false;
        setProgress(2);
        focusLegend(target);
      });
    });

    step2s.forEach((s) => {
      const group = s.dataset.group;
      s.querySelectorAll<HTMLInputElement>("input[type=radio]").forEach((input) => {
        input.addEventListener("change", () => {
          const r = results.find((x) => x.dataset.group === group && x.dataset.option === input.value);
          if (!r) return;
          hideAll();
          // Seçilen konuyla WhatsApp mesajını önceden doldur (numara aynı kalır).
          const a = r.querySelector<HTMLAnchorElement>("[data-sw-wa]");
          if (a) a.href = `${waBase}?text=${encodeURIComponent(`Merhaba, ${r.dataset.topic} konusunda bilgi almak istiyorum.`)}`;
          r.hidden = false;
          setProgress(3);
          r.focus();
        });
      });
      s.querySelector("[data-sw-back]")?.addEventListener("click", showStep1);
    });
    results.forEach((r) => r.querySelector("[data-sw-restart]")?.addEventListener("click", showStep1));
  });
</script>

<style>
  .sw {
    background: var(--color-background);
    color: var(--color-text);
    padding-block: var(--space-12);
  }

  .sw__inner {
    max-width: var(--container-xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .sw__head {
    max-width: 48rem;
  }

  .sw__eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent-text);
  }

  .sw__title {
    margin: 0;
    font-size: clamp(1.625rem, 1.25rem + 1.6vw, 2.25rem);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    color: var(--brand-navy);
  }

  .sw__intro {
    margin: var(--space-3) 0 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .sw__app[hidden],
  .sw__static[hidden],
  .sw__step[hidden],
  .sw__result[hidden] {
    display: none;
  }

  .sw__app {
    margin-top: var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background: var(--color-surface);
  }

  .sw__progress {
    margin: 0 0 var(--space-3);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
  }

  .sw__step {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .sw__legend {
    padding: 0;
    margin: 0 0 var(--space-4);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--brand-navy);
  }

  .sw__legend:focus-visible,
  .sw__result:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-md);
  }

  .sw__choices {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
  }

  .sw__choice {
    position: relative;
    display: flex;
    cursor: pointer;
  }

  .sw__radio {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .sw__choice-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    width: 100%;
    min-height: 56px;
    padding: var(--space-4) var(--space-5);
    border: 2px solid var(--color-border-hover);
    border-radius: var(--radius-lg);
    background: var(--color-background);
    transition: border-color var(--transition-base), background-color var(--transition-base);
  }

  .sw__choice:hover .sw__choice-body {
    border-color: var(--color-primary);
    background: var(--color-primary-50);
  }

  .sw__radio:checked + .sw__choice-body {
    border-color: var(--color-primary);
    background: var(--color-primary-50);
  }

  .sw__radio:focus-visible + .sw__choice-body {
    box-shadow: var(--focus-ring);
  }

  .sw__choice-label {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    line-height: 1.3;
  }

  .sw__choice-hint {
    font-size: var(--font-size-md);
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .sw__back,
  .sw__restart {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 48px;
    margin-top: var(--space-4);
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border-hover);
    border-radius: var(--radius-lg);
    background: var(--color-background);
    color: var(--color-primary);
    font: inherit;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }

  .sw__back:focus-visible,
  .sw__restart:focus-visible,
  .sw__btn:focus-visible,
  .sw__link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .sw__result-title {
    margin: 0;
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--brand-navy);
  }

  .sw__result-pick {
    margin: var(--space-1) 0 var(--space-4);
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
  }

  .sw__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .sw__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 56px;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border-hover);
    border-radius: var(--radius-lg);
    background: var(--color-background);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color var(--transition-base), background-color var(--transition-base);
  }

  .sw__link:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-50);
  }

  .sw__link--primary {
    border-color: var(--color-primary);
    border-width: 2px;
  }

  .sw__link-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sw__link-label {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
  }

  .sw__link-summary {
    font-size: var(--font-size-md);
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .sw__ask {
    margin: var(--space-5) 0 var(--space-2);
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
  }

  .sw__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .sw__cta .sw__restart {
    margin-top: 0;
  }

  .sw__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 52px;
    padding: 0 var(--space-5);
    border: 1px solid var(--color-border-hover);
    border-radius: var(--radius-lg);
    background: var(--color-background);
    color: var(--color-text);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .sw__btn:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-50);
  }

  .sw__static {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
  }

  .sw__static-title {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--brand-navy);
  }

  .sw__static ul {
    margin: 0;
    padding-left: var(--space-5);
  }

  .sw__static li {
    margin-bottom: var(--space-2);
    font-size: var(--font-size-md);
    line-height: 1.5;
  }

  .sw__static a {
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .sw__inner {
      padding-inline: var(--space-4);
    }

    .sw__app {
      padding: var(--space-4);
    }

    .sw__choices {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
// HomeVisitFlow — evde hizmet mini akışı: bölge → ihtiyaç → mevcut bilgi + önceden doldurulmuş WhatsApp / telefon.
// Veri: data/evde-isitme-cihazi-hizmeti/flow.ts (sayfanın kendi cümleleri; yeni vaat yok). Hiçbir cevap kaydedilmez/gönderilmez.
// JS yoksa: kısa bir açıklama + doğrudan telefon / WhatsApp düğmeleri kalır (sayfanın geri kalanı zaten tam bilgi verir).
import { ArrowLeft, Phone, RotateCcw } from "lucide-astro";
import WhatsAppIcon from "../WhatsAppIcon/WhatsAppIcon.astro";
import { homeVisitFlow as f } from "../../../data/evde-isitme-cihazi-hizmeti/flow";
import { contactConfig } from "../../../config/contact";
---

<section class="hvf" aria-labelledby="hvf-title" data-hvf data-wa={contactConfig.whatsapp.href}>
  <div class="hvf__inner">
    <header class="hvf__head">
      <p class="hvf__eyebrow">{f.eyebrow}</p>
      <h2 class="hvf__title" id="hvf-title">{f.heading}</h2>
      <p class="hvf__intro">{f.intro}</p>
    </header>

    <div class="hvf__app" data-hvf-app hidden>
      <p class="hvf__progress" data-hvf-progress aria-live="polite">Adım 1 / 2</p>

      <fieldset class="hvf__step" data-hvf-step="region">
        <legend class="hvf__legend" tabindex="-1">{f.regionQuestion}</legend>
        <div class="hvf__choices">
          {
            f.regions.map((r) => (
              <label class="hvf__choice">
                <input type="radio" class="hvf__radio" name="hvf-region" value={r.id} />
                <span class="hvf__choice-body">
                  <span class="hvf__choice-label">{r.label}</span>
                  <span class="hvf__choice-hint">{r.hint}</span>
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="hvf__step" data-hvf-step="need" hidden>
        <legend class="hvf__legend" tabindex="-1">{f.needQuestion}</legend>
        <div class="hvf__choices">
          {
            f.needs.map((n) => (
              <label class="hvf__choice">
                <input type="radio" class="hvf__radio" name="hvf-need" value={n.id} />
                <span class="hvf__choice-body">
                  <span class="hvf__choice-label">{n.label}</span>
                </span>
              </label>
            ))
          }
        </div>
        <button type="button" class="hvf__ghost" data-hvf-back>
          <ArrowLeft size={18} stroke-width={2.25} aria-hidden="true" />
          <span>Geri</span>
        </button>
      </fieldset>

      <div class="hvf__result" data-hvf-result tabindex="-1" hidden>
        <h3 class="hvf__result-title">Bilgiler</h3>
        <p class="hvf__region" data-hvf-region></p>
        <ul class="hvf__facts" data-hvf-facts>
          {f.facts.map((t) => <li>{t}</li>)}
        </ul>
        <p class="hvf__safety">{f.safety}</p>
        <div class="hvf__cta">
          <a class="hvf__btn hvf__btn--wa" href={contactConfig.whatsapp.href} data-hvf-wa data-contact-action="whatsapp">
            <WhatsAppIcon size={20} />
            <span>WhatsApp'tan Talep Gönderin</span>
          </a>
          <a class="hvf__btn" href={contactConfig.phone.href} data-contact-action="phone">
            <Phone size={20} stroke-width={2} aria-hidden="true" />
            <span>Bizi Arayın</span>
          </a>
          <button type="button" class="hvf__ghost hvf__ghost--inline" data-hvf-restart>
            <RotateCcw size={18} stroke-width={2.25} aria-hidden="true" />
            <span>Baştan başla</span>
          </button>
        </div>
      </div>
    </div>

    <div class="hvf__static" data-hvf-static>
      <p>
        Evde hizmet talebi için telefon veya WhatsApp'tan adresinizi ve ihtiyacınızı iletmeniz yeterlidir; gün ve saati birlikte belirleriz.
      </p>
      <div class="hvf__cta">
        <a class="hvf__btn hvf__btn--wa" href={contactConfig.whatsapp.href} data-contact-action="whatsapp">
          <WhatsAppIcon size={20} />
          <span>WhatsApp'tan Talep Gönderin</span>
        </a>
        <a class="hvf__btn" href={contactConfig.phone.href} data-contact-action="phone">
          <Phone size={20} stroke-width={2} aria-hidden="true" />
          <span>Bizi Arayın</span>
        </a>
      </div>
    </div>

    <script type="application/json" data-hvf-data set:html={JSON.stringify({ regions: f.regions, needs: f.needs })} />
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-hvf]").forEach((root) => {
    const app = root.querySelector<HTMLElement>("[data-hvf-app]");
    const stat = root.querySelector<HTMLElement>("[data-hvf-static]");
    const raw = root.querySelector("[data-hvf-data]")?.textContent;
    if (!app || !stat || !raw) return;
    const data = JSON.parse(raw) as {
      regions: { id: string; label: string; covered: boolean; statement: string }[];
      needs: { id: string; label: string }[];
    };
    app.hidden = false;
    stat.hidden = true;

    const progress = root.querySelector<HTMLElement>("[data-hvf-progress]");
    const stepRegion = app.querySelector<HTMLElement>('[data-hvf-step="region"]')!;
    const stepNeed = app.querySelector<HTMLElement>('[data-hvf-step="need"]')!;
    const result = app.querySelector<HTMLElement>("[data-hvf-result]")!;
    const regionP = result.querySelector<HTMLElement>("[data-hvf-region]")!;
    const facts = result.querySelector<HTMLElement>("[data-hvf-facts]")!;
    const wa = result.querySelector<HTMLAnchorElement>("[data-hvf-wa]")!;
    const waBase = root.dataset.wa ?? "";
    let region = "";

    const show = (el: HTMLElement) => {
      [stepRegion, stepNeed, result].forEach((x) => (x.hidden = x !== el));
      if (progress) progress.textContent = el === stepRegion ? "Adım 1 / 2" : el === stepNeed ? "Adım 2 / 2" : "Sonuç";
      const focusTarget = (el.querySelector("legend") as HTMLElement | null) ?? el;
      focusTarget.focus();
    };

    stepRegion.querySelectorAll<HTMLInputElement>("input").forEach((i) =>
      i.addEventListener("change", () => {
        region = i.value;
        show(stepNeed);
      }),
    );
    stepNeed.querySelectorAll<HTMLInputElement>("input").forEach((i) =>
      i.addEventListener("change", () => {
        const r = data.regions.find((x) => x.id === region);
        const n = data.needs.find((x) => x.id === i.value);
        if (!r || !n) return;
        regionP.textContent = r.statement;
        // Bölge kapsam dışıysa sayfanın evde-hizmet gerçekleri gösterilmez (yanlış beklenti yaratmasın).
        facts.hidden = !r.covered;
        const need = n.id === "emin-degilim" ? "henüz emin değilim, bilgi almak istiyorum" : n.label.toLocaleLowerCase("tr");
        const msg = r.covered
          ? `Merhaba, ${r.label} için evde hizmet talep etmek istiyorum. İhtiyacım: ${need}.`
          : `Merhaba, evde hizmetin ${r.label.toLocaleLowerCase("tr")} için mümkün olup olmadığını öğrenmek istiyorum. İhtiyacım: ${need}.`;
        wa.href = `${waBase}?text=${encodeURIComponent(msg)}`;
        show(result);
      }),
    );
    const restart = () => {
      app.querySelectorAll<HTMLInputElement>("input").forEach((i) => (i.checked = false));
      region = "";
      show(stepRegion);
    };
    root.querySelector("[data-hvf-back]")?.addEventListener("click", restart);
    root.querySelector("[data-hvf-restart]")?.addEventListener("click", restart);
  });
</script>

<style>
  .hvf {
    background: var(--color-surface);
    color: var(--color-text);
    padding-block: var(--space-12);
  }

  .hvf__inner {
    max-width: var(--container-xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .hvf__head {
    max-width: 48rem;
  }

  .hvf__eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent-text);
  }

  .hvf__title {
    margin: 0;
    font-size: clamp(1.625rem, 1.25rem + 1.6vw, 2.25rem);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    color: var(--brand-navy);
  }

  .hvf__intro {
    margin: var(--space-3) 0 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .hvf__app[hidden],
  .hvf__static[hidden],
  .hvf__step[hidden],
  .hvf__result[hidden],
  .hvf__facts[hidden] {
    display: none;
  }

  .hvf__app,
  .hvf__static {
    margin-top: var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background: var(--color-background);
  }

  .hvf__static p {
    margin: 0 0 var(--space-4);
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
  }

  .hvf__progress {
    margin: 0 0 var(--space-3);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
  }

  .hvf__step {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .hvf__legend {
    padding: 0;
    margin: 0 0 var(--space-4);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--brand-navy);
  }

  .hvf__legend:focus-visible,
  .hvf__result:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-md);
  }

  .hvf__choices {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
  }

  .hvf__choice {
    position: relative;
    display: flex;
    cursor: pointer;
  }

  .hvf__radio {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .hvf__choice-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    width: 100%;
    min-height: 56px;
    justify-content: center;
    padding: var(--space-4) var(--space-5);
    border: 2px solid var(--color-border-hover);
    border-radius: var(--radius-lg);
    background: var(--color-background);
    transition: border-color var(--transition-base), background-color var(--transition-base);
  }

  .hvf__choice:hover .hvf__choice-body,
  .hvf__radio:checked + .hvf__choice-body {
    border-color: var(--color-primary);
    background: var(--color-primary-50);
  }

  .hvf__radio:focus-visible + .hvf__choice-body {
    box-shadow: var(--focus-ring);
  }

  .hvf__choice-label {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    line-height: 1.3;
  }

  .hvf__choice-hint {
    font-size: var(--font-size-md);
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .hvf__ghost {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 48px;
    margin-top: var(--space-4);
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border-hover);
    border-radius: var(--radius-lg);
    background: var(--color-background);
    color: var(--color-primary);
    font: inherit;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }

  .hvf__ghost--inline {
    margin-top: 0;
  }

  .hvf__ghost:focus-visible,
  .hvf__btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .hvf__result-title {
    margin: 0;
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--brand-navy);
  }

  .hvf__region {
    margin: var(--space-2) 0 var(--space-3);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    line-height: 1.4;
  }

  .hvf__facts {
    margin: 0 0 var(--space-3);
    padding-left: var(--space-5);
  }

  .hvf__facts li {
    margin-bottom: var(--space-2);
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
  }

  .hvf__safety {
    margin: 0 0 var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-left: 4px solid var(--color-warning);
    border-radius: var(--radius-md);
    background: #fff8ed;
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
  }

  .hvf__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .hvf__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 52px;
    padding: 0 var(--space-5);
    border: 1px solid var(--color-border-hover);
    border-radius: var(--radius-lg);
    background: var(--color-background);
    color: var(--color-text);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .hvf__btn--wa {
    background: var(--color-primary);
    border-color: var(--color-primary-hover);
    color: var(--color-text-inverse);
  }

  .hvf__btn--wa:hover {
    background: var(--color-primary-hover);
  }

  .hvf__btn:not(.hvf__btn--wa):hover {
    border-color: var(--color-primary);
    background: var(--color-primary-50);
  }

  @media (max-width: 640px) {
    .hvf__inner {
      padding-inline: var(--space-4);
    }

    .hvf__app,
    .hvf__static {
      padding: var(--space-4);
    }

    .hvf__choices {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

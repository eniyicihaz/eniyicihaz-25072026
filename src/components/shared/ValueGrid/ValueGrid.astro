---
// ValueGrid — shared, count-agnostic value/pillar card grid built for
// Hakkımızda's "Değerlerimiz". BrandPageAdvantages was considered first
// but its bento layout requires exactly 6 items (1 hero + 5 fixed
// slots) — this page has exactly 4 real, verifiable values (from the
// business's own printed materials), and padding the grid with invented
// extra values just to fill the bento shape isn't an option. This is a
// plain auto-fit grid instead: any count of items lays out cleanly,
// bordered cards (a visible but quiet register — more presence than
// BrandPageSignalList's chrome-less list, less than a bento hero card).
export interface ValueGridItem {
  icon: any;
  title: string;
  description: string;
}

export interface ValueGridContent {
  badge: string;
  heading: string;
  intro?: string;
  items: ValueGridItem[];
  accentColor: string;
  accentColorBadgeBg: string;
  accentColorBadgeBorder: string;
  accentColorBadgeText: string;
  accentColorIconBg: string;
}

interface Props {
  data: ValueGridContent;
}

const { data } = Astro.props;
---

<section
  class="value-grid"
  aria-labelledby="value-grid-title"
  style={`--vg-accent:${data.accentColor}; --vg-badge-bg:${data.accentColorBadgeBg}; --vg-badge-border:${data.accentColorBadgeBorder}; --vg-badge-text:${data.accentColorBadgeText}; --vg-icon-bg:${data.accentColorIconBg};`}
>
  <div class="value-grid__inner">
    <div class="value-grid__header">
      <p class="value-grid__badge">{data.badge}</p>
      <h2 class="value-grid__heading" id="value-grid-title">{data.heading}</h2>
      {data.intro && <p class="value-grid__intro">{data.intro}</p>}
    </div>

    <ul class="value-grid__list">
      {data.items.map((item) => {
        const Icon = item.icon;
        return (
          <li class="value-grid__card">
            <span class="value-grid__icon" aria-hidden="true">
              <Icon size={22} stroke-width={1.75} />
            </span>
            <h3 class="value-grid__card-title">{item.title}</h3>
            <p class="value-grid__card-desc">{item.description}</p>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .value-grid {
    background: var(--color-surface);
    padding-block: var(--space-16);
  }

  .value-grid__inner {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .value-grid__header {
    max-width: 42rem;
    margin-inline: auto;
    margin-bottom: var(--space-10);
    text-align: center;
  }

  .value-grid__badge {
    display: inline-block;
    margin: 0 0 var(--space-3);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--vg-badge-border);
    border-radius: var(--radius-full);
    background: var(--vg-badge-bg);
    color: var(--vg-badge-text);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .value-grid__heading {
    margin: 0;
    font-size: clamp(1.75rem, 1.45rem + 1.4vw, 2.5rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.015em;
    color: var(--color-text);
  }

  .value-grid__intro {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .value-grid__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-5);
  }

  .value-grid__card {
    padding: var(--space-6);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xs);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);
  }

  .value-grid__card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--vg-accent);
  }

  .value-grid__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--vg-icon-bg);
    color: var(--vg-accent);
  }

  .value-grid__card-title {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .value-grid__card-desc {
    margin: 0;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .value-grid {
      padding-block: var(--space-10);
    }

    .value-grid__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .value-grid__card {
      transition: none;
    }
  }
</style>

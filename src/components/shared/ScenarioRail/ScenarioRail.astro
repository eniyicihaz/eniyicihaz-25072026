---
// ScenarioRail — shared, horizontal-scroll "day in sound" rail: a quiet
// icon+title+description card per real-life scenario, scroll-snapped,
// no bordered grid. Generic sibling of CategoryExplorer's rail
// architecture (src/components/category-explorer/CategoryExplorer/),
// which is homepage-hardcoded (imports its own fixed data) and about
// device categories, not life scenarios — built fresh for a different
// content model rather than repurposing it (Cihaz Deneme redesign plan
// §3). Cards are non-interactive (no href — scenarios don't link
// anywhere), unlike CategoryCard.
export interface ScenarioRailItem {
  icon: any;
  title: string;
  description: string;
}

export interface ScenarioRailContent {
  eyebrow: string;
  heading: string;
  intro: string;
  items: ScenarioRailItem[];
  accentColor: string;
}

interface Props {
  data: ScenarioRailContent;
}

const { data } = Astro.props;
---

<section class="scenario-rail" aria-labelledby="scenario-rail-title" style={`--sr-accent:${data.accentColor};`}>
  <div class="scenario-rail__header">
    <p class="scenario-rail__eyebrow" data-rise>{data.eyebrow}</p>
    <h2 class="scenario-rail__heading" id="scenario-rail-title" data-rise>{data.heading}</h2>
    <p class="scenario-rail__intro" data-rise>{data.intro}</p>
  </div>

  <ul class="scenario-rail__track" data-rise>
    {
      data.items.map((item) => {
        const Icon = item.icon;
        return (
          <li class="scenario-rail__card">
            <span class="scenario-rail__icon" aria-hidden="true">
              <Icon size={22} stroke-width={1.75} />
            </span>
            <p class="scenario-rail__title">{item.title}</p>
            <p class="scenario-rail__desc">{item.description}</p>
          </li>
        );
      })
    }
  </ul>
</section>

<script is:inline>
  (function () {
    var section = document.querySelector(".scenario-rail");
    if (!section) return;
    if (!("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    section.dataset.anim = "pending";

    var revealed = false;
    var ioAlive = false;
    var io;

    function reveal() {
      if (revealed) return;
      revealed = true;
      section.dataset.anim = "in";
      if (io) io.disconnect();
    }

    var failsafe = setTimeout(function () {
      if (!ioAlive) reveal();
    }, 1500);

    io = new IntersectionObserver(
      function (entries) {
        ioAlive = true;
        clearTimeout(failsafe);
        if (entries[0].isIntersecting) reveal();
      },
      { threshold: 0.15 }
    );

    io.observe(section);
  })();
</script>

<style>
  .scenario-rail {
    background: var(--color-surface);
    padding-block: var(--space-20);
  }

  .scenario-rail__header {
    max-width: var(--container-lg);
    margin-inline: auto;
    padding-inline: var(--space-6);
    text-align: center;
  }

  .scenario-rail__eyebrow {
    display: inline-block;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-background);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sr-accent);
  }

  .scenario-rail__heading {
    margin: var(--space-4) 0 0;
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .scenario-rail__intro {
    margin: var(--space-4) auto 0;
    max-width: 36rem;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  /* Horizontal scroll, not a static grid — the scroll itself is the
     "one scenario at a time" pacing, and it keeps this section visually
     distinct from every bordered-card grid elsewhere on the page. */
  .scenario-rail__track {
    list-style: none;
    margin: var(--space-12) 0 0;
    padding: var(--space-2) var(--space-6) var(--space-4);
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }

  .scenario-rail__track::-webkit-scrollbar {
    height: 6px;
  }

  .scenario-rail__track::-webkit-scrollbar-thumb {
    background: var(--color-border-hover);
    border-radius: var(--radius-full);
  }

  .scenario-rail__card {
    flex: 0 0 auto;
    width: 15rem;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--color-background);
  }

  .scenario-rail__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--sr-accent);
  }

  .scenario-rail__title {
    margin: 0;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  .scenario-rail__desc {
    margin: 0;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .scenario-rail {
      padding-block: var(--space-14);
    }

    .scenario-rail__track {
      margin-top: var(--space-8);
    }

    .scenario-rail__card {
      width: 13.5rem;
      padding: var(--space-5);
    }
  }

  .scenario-rail[data-anim="pending"] [data-rise] {
    opacity: 0;
  }

  .scenario-rail[data-anim="in"] [data-rise] {
    animation: scenario-rail-rise 600ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .scenario-rail[data-anim="in"] .scenario-rail__track {
    animation-delay: 100ms;
  }

  @keyframes scenario-rail-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scenario-rail[data-anim="in"] [data-rise] {
      animation: none;
    }
  }
</style>

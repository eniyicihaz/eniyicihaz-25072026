---
// SgkReportEDevlet — /sgk/rapor-sureci sayfasında iki resmî e-Devlet hizmetine (Rapor Bilgisi Sorgulama, Medikal Reçete
// Bilgileri Sorgulama) doğrudan bağlantı veren sade bölüm. Bağlantılar yeni sekmede açılır (rel=noopener noreferrer),
// bağlantı metni hizmetin tam adıdır ve ekran okuyucuya "(yeni sekmede açılır)" bilgisi verilir. İçerik her koşulda
// görünür (giriş animasyonu bilinçli olarak yok). Veri: ../../../data/rapor-sureci/e-devlet.
import { ExternalLink } from "lucide-astro";
import { raporSureciEDevlet as d } from "../../../data/rapor-sureci/e-devlet";
---

<section class="sgk-edevlet" aria-labelledby="sgk-edevlet-title">
  <div class="sgk-edevlet__inner">
    <header class="sgk-edevlet__head">
      <p class="sgk-edevlet__badge">{d.badge}</p>
      <h2 class="sgk-edevlet__heading" id="sgk-edevlet-title">{d.heading}</h2>
      <p class="sgk-edevlet__intro">{d.intro}</p>
    </header>

    <ul class="sgk-edevlet__list">
      {
        d.services.map((s) => (
          <li class="sgk-edevlet__item">
            <a class="sgk-edevlet__link" href={s.href} target="_blank" rel="noopener noreferrer">
              {s.label}
              <ExternalLink size={14} stroke-width={2} aria-hidden="true" />
              {" "}<span class="sgk-edevlet__sr">(yeni sekmede açılır)</span>
            </a>
            <p class="sgk-edevlet__desc">{s.description}</p>
          </li>
        ))
      }
    </ul>

    <p class="sgk-edevlet__caveat">{d.caveat}</p>
    <p class="sgk-edevlet__note">{d.newTabNote}</p>
  </div>
</section>

<style>
  .sgk-edevlet {
    background: var(--color-surface);
    padding-block: var(--space-16);
  }

  .sgk-edevlet__inner {
    max-width: 760px;
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .sgk-edevlet__head {
    text-align: center;
  }

  .sgk-edevlet__badge {
    display: inline-block;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid rgb(var(--color-primary-rgb) / 0.22);
    border-radius: var(--radius-full);
    background: rgb(var(--color-primary-rgb) / 0.08);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--color-primary) 86%, #000);
  }

  .sgk-edevlet__heading {
    margin: var(--space-5) 0 0;
    font-size: clamp(1.5rem, 1.3rem + 1vw, 2.125rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .sgk-edevlet__intro {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .sgk-edevlet__list {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .sgk-edevlet__item {
    padding: var(--space-5) var(--space-6);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xs);
  }

  .sgk-edevlet__link {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sgk-edevlet__link :global(svg) {
    display: inline-block;
    vertical-align: -2px;
    margin-left: var(--space-1);
  }

  .sgk-edevlet__link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  .sgk-edevlet__desc {
    margin: var(--space-2) 0 0;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .sgk-edevlet__caveat {
    margin: var(--space-6) 0 0;
    padding: var(--space-4) var(--space-5);
    background: rgb(var(--color-primary-rgb) / 0.05);
    border: 1px solid rgb(var(--color-primary-rgb) / 0.2);
    border-radius: var(--radius-xl);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text);
  }

  .sgk-edevlet__note {
    margin: var(--space-3) 0 0;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .sgk-edevlet__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1023px) {
    .sgk-edevlet {
      padding-block: var(--space-12);
    }
  }

  @media (max-width: 640px) {
    .sgk-edevlet__inner {
      padding-inline: var(--space-4);
    }

    .sgk-edevlet__item {
      padding: var(--space-4) var(--space-5);
    }
  }
</style>

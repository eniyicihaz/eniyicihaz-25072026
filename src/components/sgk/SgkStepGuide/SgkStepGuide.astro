---
// SgkStepGuide — "SGK Başvuru Kontrol Listesi": dört adım + başlamadan önce, işaretlenebilir ve YAZDIRILABİLİR.
// İçerik: data/sgk/step-guide.ts (sitedeki mevcut SGK sayfalarının kısa derlemesi; tutar/süre YOK).
// Yazdırma: düğme bölümü ayrı bir #print-root içine KOPYALAR, sayfanın geri kalanını yalnızca yazdırma sırasında gizler
// (body.print-guide) ve işlem bitince temizler. Kâğıt başlığı işletmenin doğrulanmış adres/telefon/saat bilgisini taşır.
import { Printer, Check } from "lucide-astro";
import { sgkGuide } from "../../../data/sgk/step-guide";
import { company } from "../../footer/Footer/data/company";
import { contactConfig } from "../../../config/contact";

const g = sgkGuide;
const hours = company.hours.map((h) => `${h.days} ${h.time}`).join(" · ");
---

<section class="sgk-guide" id="sgk-kontrol-listesi" aria-labelledby="sgk-guide-title" data-sgk-guide>
  <div class="sgk-guide__inner">
    <header class="sgk-guide__head">
      <p class="sgk-guide__eyebrow">{g.eyebrow}</p>
      <h2 class="sgk-guide__title" id="sgk-guide-title">{g.heading}</h2>
      <p class="sgk-guide__intro">{g.intro}</p>
      <button type="button" class="sgk-guide__print" data-sgk-print>
        <Printer size={20} stroke-width={2} aria-hidden="true" />
        <span>{g.printLabel}</span>
      </button>
    </header>

    <!-- Yalnızca kâğıtta görünür -->
    <div class="sgk-guide__sheet-head">
      <p class="sgk-guide__sheet-name">SGK Başvuru Kontrol Listesi</p>
      <p>{company.brand} · {company.address}</p>
      <p>Telefon / WhatsApp: {contactConfig.phone.display} · {hours}</p>
    </div>

    <ol class="sgk-guide__groups">
      {
        g.groups.map((group) => (
          <li class="sgk-guide__group" id={group.id}>
            <h3 class="sgk-guide__group-title">{group.title}</h3>
            <p class="sgk-guide__lead">{group.lead}</p>
            <ul class="sgk-guide__items">
              {group.items.map((item) => (
                <li>
                  <label class="sgk-guide__item">
                    <input type="checkbox" class="sgk-guide__box" />
                    <span class="sgk-guide__mark" aria-hidden="true">
                      <Check size={16} stroke-width={3.25} />
                    </span>
                    <span class="sgk-guide__text">{item.text}</span>
                  </label>
                </li>
              ))}
            </ul>
            <p class="sgk-guide__more">
              Ayrıntı: <a href={group.more.href}>{group.more.label}</a>
            </p>
          </li>
        ))
      }
    </ol>
    <p class="sgk-guide__note">{g.note}</p>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-sgk-guide]");
  const btn = root?.querySelector<HTMLButtonElement>("[data-sgk-print]");
  if (root && btn) {
    btn.addEventListener("click", () => {
      // İşaret durumunu kopyaya taşımak için öznitelik olarak yaz.
      root.querySelectorAll<HTMLInputElement>("input[type=checkbox]").forEach((i) => i.toggleAttribute("checked", i.checked));
      const holder = document.createElement("div");
      holder.id = "print-root";
      const copy = root.cloneNode(true) as HTMLElement;
      copy.removeAttribute("id");
      copy.querySelector("[data-sgk-print]")?.remove();
      holder.appendChild(copy);
      document.body.appendChild(holder);
      document.body.classList.add("print-guide");
      const cleanup = () => {
        document.body.classList.remove("print-guide");
        holder.remove();
        window.removeEventListener("afterprint", cleanup);
      };
      window.addEventListener("afterprint", cleanup);
      window.print();
    });
  }
</script>

<style>
  .sgk-guide {
    background: var(--color-surface);
    color: var(--color-text);
    padding-block: var(--space-16);
  }

  .sgk-guide__inner {
    max-width: var(--container-xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .sgk-guide__head {
    max-width: 52rem;
  }

  .sgk-guide__eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent-text);
  }

  .sgk-guide__title {
    margin: 0;
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    color: var(--brand-navy);
  }

  .sgk-guide__intro {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .sgk-guide__print {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 52px;
    margin-top: var(--space-5);
    padding: 0 var(--space-6);
    border: 1px solid var(--color-primary-hover);
    border-radius: var(--radius-lg);
    background: var(--color-primary);
    color: var(--color-text-inverse);
    font: inherit;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition: background-color var(--transition-base);
  }

  .sgk-guide__print:hover {
    background: var(--color-primary-hover);
  }

  .sgk-guide__print:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .sgk-guide__sheet-head {
    display: none;
  }

  .sgk-guide__groups {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    counter-reset: none;
  }

  .sgk-guide__group {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-background);
    padding: var(--space-5) var(--space-6);
    break-inside: avoid;
  }

  .sgk-guide__group:first-child {
    grid-column: 1 / -1;
  }

  .sgk-guide__group-title {
    margin: 0;
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    line-height: 1.3;
    color: var(--brand-navy);
  }

  .sgk-guide__lead {
    margin: var(--space-2) 0 0;
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .sgk-guide__items {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }

  /* 48 px dokunma hedefi: tüm satır tıklanabilir */
  .sgk-guide__item {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    min-height: 48px;
    padding: var(--space-2) var(--space-2);
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  .sgk-guide__item:hover {
    background: var(--color-primary-50);
  }

  .sgk-guide__box {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .sgk-guide__mark {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin-top: 1px;
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-sm);
    background: #fff;
    color: transparent;
  }

  .sgk-guide__box:checked + .sgk-guide__mark {
    background: var(--color-primary);
    color: var(--color-text-inverse);
  }

  .sgk-guide__box:focus-visible + .sgk-guide__mark {
    box-shadow: var(--focus-ring);
  }

  .sgk-guide__text {
    font-size: var(--font-size-md);
    line-height: 1.5;
    padding-top: 2px;
  }

  .sgk-guide__more {
    margin: var(--space-3) 0 0;
    font-size: var(--font-size-md);
  }

  .sgk-guide__more a {
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
    text-underline-offset: 4px;
  }

  .sgk-guide__note {
    margin: var(--space-6) 0 0;
    padding: var(--space-4) var(--space-5);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--color-background);
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .sgk-guide__groups {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .sgk-guide {
      padding-block: var(--space-12);
    }

    .sgk-guide__inner {
      padding-inline: var(--space-4);
    }

    .sgk-guide__group {
      padding: var(--space-4);
    }
  }
</style>

<style is:global>
  /* Yazdırma: yalnızca #print-root (kontrol listesinin kopyası) basılır. */
  @media print {
    body.print-guide > *:not(#print-root) {
      display: none !important;
    }

    body.print-guide {
      background: #fff !important;
      padding: 0 !important;
    }

    #print-root {
      display: block;
      color: #000;
      font-size: 12pt;
    }

    #print-root .sgk-guide {
      background: #fff;
      padding: 0;
    }

    #print-root .sgk-guide__inner {
      max-width: none;
      padding: 0;
    }

    #print-root .sgk-guide__sheet-head {
      display: block;
      margin: 0 0 14pt;
      padding-bottom: 8pt;
      border-bottom: 2pt solid #000;
      font-size: 10.5pt;
    }

    #print-root .sgk-guide__sheet-head p {
      margin: 2pt 0;
    }

    #print-root .sgk-guide__sheet-name {
      font-size: 14pt;
      font-weight: 700;
    }

    /* Kâğıtta ekran başlığı/giriş/düğme yok: yalnızca işletme başlığı (sheet-head) ve liste. */
    #print-root .sgk-guide__head {
      display: none;
    }

    #print-root .sgk-guide__groups {
      display: block;
      margin-top: 8pt;
    }

    #print-root .sgk-guide__group {
      border: 1pt solid #000;
      border-radius: 4pt;
      margin: 0 0 10pt;
      padding: 8pt 10pt;
      break-inside: avoid;
    }

    #print-root .sgk-guide__mark {
      border-color: #000;
      width: 16pt;
      height: 16pt;
    }

    #print-root .sgk-guide__box:checked + .sgk-guide__mark {
      background: #000;
      color: #fff;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    #print-root .sgk-guide__item {
      min-height: 0;
      padding: 2pt 0;
    }

    #print-root .sgk-guide__more {
      display: none;
    }

    #print-root .sgk-guide__note {
      border: 1pt solid #000;
      font-size: 10.5pt;
      color: #000;
    }
  }
</style>

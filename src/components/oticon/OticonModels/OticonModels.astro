---
// OticonModels — M5 of the Oticon brand page (/markalar/oticon), directly
// under OticonHeritage (M4). Independent of the /markalar hub page's
// M1...M8 modules; this page has its own component tree, one section built
// at a time.
//
// Full redesign, not an iteration on the previous 6-card version: this is a
// product showcase, not an info grid. Each of the 12 real Oticon product
// photos is the card's hero — large, front and center, sitting on its own
// soft glow backdrop — with the logo nowhere in sight. Order is
// newest/most-relevant first (Intent, Real, Own SI), specialized or older
// lines after.
import { ArrowRight } from "lucide-astro";
import { oticonHero } from "../../../data/oticon/hero";
import { oticonModels } from "../../../data/oticon/models";
---

<section
  class="oticon-models"
  aria-labelledby="oticon-models-title"
  style={`--om-accent:${oticonHero.accentColor};`}
>
  <div class="oticon-models__inner">
    <div class="oticon-models__header">
      <p class="oticon-models__badge" data-rise>{oticonModels.badge}</p>
      <h2 class="oticon-models__heading" id="oticon-models-title" data-rise>
        {oticonModels.heading}
      </h2>
      <p class="oticon-models__intro" data-rise>{oticonModels.intro}</p>
    </div>

    <div class="oticon-models__grid">
      {
        oticonModels.items.map((item) => (
          <a class="oticon-models__card" href="#" data-rise>
            <span class="oticon-models__category">{item.category}</span>

            <span class="oticon-models__media">
              <span class="oticon-models__glow" aria-hidden="true" />
              <img
                class="oticon-models__image"
                src={item.image}
                alt={item.name}
                loading="lazy"
                width="500"
                height="500"
              />
            </span>

            <span class="oticon-models__name">{item.name}</span>
            <span class="oticon-models__desc">{item.description}</span>

            <span class="oticon-models__tags">
              {item.tags.map((tag) => (
                <span class="oticon-models__tag">{tag}</span>
              ))}
            </span>

            <span class="oticon-models__link">
              <span>{oticonModels.ctaLabel}</span>
              <ArrowRight size={16} stroke-width={2} aria-hidden="true" />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    // Same entrance state-machine as every other section on the site:
    // IntersectionObserver, a failsafe timeout, and a
    // prefers-reduced-motion bail.
    var section = document.querySelector(".oticon-models");
    if (!section) return;
    if (!("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    section.dataset.anim = "pending";

    var revealed = false;
    var ioAlive = false;
    var io;

    function reveal() {
      if (revealed) return;
      revealed = true;
      section.dataset.anim = "in";
      if (io) io.disconnect();
    }

    var failsafe = setTimeout(function () {
      if (!ioAlive) reveal();
    }, 1500);

    io = new IntersectionObserver(
      function (entries) {
        ioAlive = true;
        clearTimeout(failsafe);
        if (entries[0].isIntersecting) reveal();
      },
      { threshold: 0.15 }
    );

    io.observe(section);
  })();
</script>

<style>
  .oticon-models {
    background: var(--color-background);
    color: var(--color-text);
    padding-block: var(--space-24);
    --om-ease: cubic-bezier(0.22, 1, 0.36, 1);
  }

  .oticon-models__inner {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  /* --- Header ------------------------------------------------------------- */

  .oticon-models__header {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }

  .oticon-models__badge {
    display: inline-block;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid rgb(95 184 90 / 0.35);
    border-radius: var(--radius-full);
    background: rgb(95 184 90 / 0.08);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    color: #4a9a45;
  }

  .oticon-models__heading {
    margin: var(--space-5) 0 0;
    font-size: clamp(1.875rem, 1.5rem + 1.8vw, 2.75rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .oticon-models__intro {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  /* --- Grid: 4 columns for 12 products --------------------------------------- */

  .oticon-models__grid {
    margin: var(--space-14) 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
  }

  /* Product showcase card — the photo is the hero, not a supporting icon.
     overflow:hidden on the card itself contains both the hover image-zoom
     and the glow layer within its own rounded corners. */
  .oticon-models__card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    height: 540px;
    padding: var(--space-6) var(--space-6) var(--space-5);
    background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-background) 60%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-xs);
    text-decoration: none;
    color: inherit;
    transition: transform 300ms var(--om-ease), border-color 300ms var(--om-ease), box-shadow 300ms var(--om-ease);
  }

  .oticon-models__card:hover {
    transform: translateY(-6px);
    border-color: rgb(95 184 90 / 0.5);
    box-shadow: var(--shadow-md);
  }

  .oticon-models__card:focus-visible {
    outline: none;
    box-shadow: var(--shadow-md), 0 0 0 3px rgb(95 184 90 / 0.35);
  }

  .oticon-models__category {
    flex: none;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
  }

  /* ~55% of the card's height is the photo — a soft radial glow sits
     behind it so the product reads as premium catalog photography rather
     than a flat cutout on a plain white square. */
  .oticon-models__media {
    position: relative;
    flex: none;
    width: 100%;
    height: 300px;
    margin-top: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .oticon-models__glow {
    position: absolute;
    inset: -10%;
    z-index: -1;
    background: radial-gradient(
      50% 50% at 50% 55%,
      rgb(95 184 90 / 0.14),
      transparent 72%
    );
    filter: blur(4px);
  }

  /* Deliberately sized past the media box's own inset (not object-fit:
     contain shrunk to fit safely) — "don't be afraid of it looking big." */
  .oticon-models__image {
    height: 100%;
    width: auto;
    max-width: 128%;
    object-fit: contain;
    transition: transform 400ms var(--om-ease);
  }

  .oticon-models__card:hover .oticon-models__image {
    transform: scale(1.05);
  }

  /* Second focal point. */
  .oticon-models__name {
    margin-top: var(--space-4);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  /* Third focal point — clamped to 2 lines so every card's rhythm below it
     lands in the same place regardless of copy length. */
  .oticon-models__desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin-top: var(--space-2);
    max-width: 30ch;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .oticon-models__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .oticon-models__tag {
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
  }

  .oticon-models__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: auto;
    padding-top: var(--space-4);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
  }

  .oticon-models__link svg {
    transition: transform 300ms var(--om-ease);
  }

  .oticon-models__card:hover .oticon-models__link svg {
    transform: translateX(3px);
  }

  /* --- Entrance: same fade-up state machine as every other section on the
     site (IntersectionObserver + data-anim, driven by the inline script
     above). --- */

  .oticon-models[data-anim="pending"] [data-rise] {
    opacity: 0;
  }

  .oticon-models[data-anim="in"] [data-rise] {
    animation: oticon-models-rise 600ms var(--om-ease) both;
  }

  .oticon-models[data-anim="in"] .oticon-models__card:nth-child(1) { animation-delay: 40ms; }
  .oticon-models[data-anim="in"] .oticon-models__card:nth-child(2) { animation-delay: 70ms; }
  .oticon-models[data-anim="in"] .oticon-models__card:nth-child(3) { animation-delay: 100ms; }
  .oticon-models[data-anim="in"] .oticon-models__card:nth-child(4) { animation-delay: 130ms; }
  .oticon-models[data-anim="in"] .oticon-models__card:nth-child(5) { animation-delay: 160ms; }
  .oticon-models[data-anim="in"] .oticon-models__card:nth-child(6) { animation-delay: 190ms; }
  .oticon-models[data-anim="in"] .oticon-models__card:nth-child(7) { animation-delay: 220ms; }
  .oticon-models[data-anim="in"] .oticon-models__card:nth-child(8) { animation-delay: 250ms; }
  .oticon-models[data-anim="in"] .oticon-models__card:nth-child(9) { animation-delay: 280ms; }
  .oticon-models[data-anim="in"] .oticon-models__card:nth-child(10) { animation-delay: 310ms; }
  .oticon-models[data-anim="in"] .oticon-models__card:nth-child(11) { animation-delay: 340ms; }
  .oticon-models[data-anim="in"] .oticon-models__card:nth-child(12) { animation-delay: 370ms; }

  @keyframes oticon-models-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* --- Responsive ---------------------------------------------------------- */

  @media (max-width: 1279px) {
    .oticon-models__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .oticon-models {
      padding-block: var(--space-16);
    }

    .oticon-models__grid {
      grid-template-columns: minmax(0, 1fr);
      margin-top: var(--space-10);
    }

    .oticon-models__card {
      height: auto;
      min-height: 460px;
      padding: var(--space-5);
    }

    .oticon-models__media {
      height: 220px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .oticon-models[data-anim="in"] [data-rise] {
      animation: none;
    }

    .oticon-models__card,
    .oticon-models__image,
    .oticon-models__link svg {
      transition: none;
    }
  }
</style>

---
// OticonAbout — M2 of the Oticon brand page (/markalar/oticon), directly
// under OticonHero (M1). Independent of the /markalar hub page's M1...M8
// modules; this page has its own component tree, one section built at a
// time.
//
// Purely editorial: no card, no icon, no CTA, no gradient, no shadow.
// Premium comes only from typography/space/alignment — a narrow centered
// column, short paragraphs, generous top/bottom room to let the reader
// breathe after the Hero.
import { oticonAbout } from "../../../data/oticon/about";
---

<section class="oticon-about" aria-labelledby="oticon-about-title">
  <div class="oticon-about__inner">
    <p class="oticon-about__badge" data-rise>{oticonAbout.badge}</p>

    <h2 class="oticon-about__heading" id="oticon-about-title" data-rise>
      {oticonAbout.heading}
    </h2>

    {
      oticonAbout.paragraphs.map((p) => (
        <p class="oticon-about__paragraph" data-rise>
          {p}
        </p>
      ))
    }
  </div>
</section>

<script is:inline>
  (function () {
    // Same entrance state-machine as every other section on the site:
    // IntersectionObserver, a failsafe timeout, and a
    // prefers-reduced-motion bail.
    var section = document.querySelector(".oticon-about");
    if (!section) return;
    if (!("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    section.dataset.anim = "pending";

    var revealed = false;
    var ioAlive = false;
    var io;

    function reveal() {
      if (revealed) return;
      revealed = true;
      section.dataset.anim = "in";
      if (io) io.disconnect();
    }

    var failsafe = setTimeout(function () {
      if (!ioAlive) reveal();
    }, 1500);

    io = new IntersectionObserver(
      function (entries) {
        ioAlive = true;
        clearTimeout(failsafe);
        if (entries[0].isIntersecting) reveal();
      },
      { threshold: 0.15 }
    );

    io.observe(section);
  })();
</script>

<style>
  .oticon-about {
    background: var(--color-background);
    color: var(--color-text);
    padding-block: var(--space-24);
    --oa-ease: cubic-bezier(0.22, 1, 0.36, 1);
  }

  .oticon-about__inner {
    max-width: 800px;
    margin-inline: auto;
    padding-inline: var(--space-6);
    text-align: center;
  }

  .oticon-about__badge {
    display: inline-block;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid rgb(95 184 90 / 0.35);
    border-radius: var(--radius-full);
    background: rgb(95 184 90 / 0.08);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    color: #4a9a45;
  }

  .oticon-about__heading {
    margin: var(--space-5) auto 0;
    max-width: 22ch;
    font-size: clamp(1.875rem, 1.5rem + 1.8vw, 2.75rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .oticon-about__paragraph {
    margin: var(--space-6) auto 0;
    max-width: 42ch;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .oticon-about__paragraph:first-of-type {
    margin-top: var(--space-8);
  }

  /* --- Entrance: same fade-up state machine as every other section on the
     site (IntersectionObserver + data-anim, driven by the inline script
     above). --- */

  .oticon-about[data-anim="pending"] [data-rise] {
    opacity: 0;
  }

  .oticon-about[data-anim="in"] [data-rise] {
    animation: oticon-about-rise 600ms var(--oa-ease) both;
  }

  .oticon-about[data-anim="in"] .oticon-about__badge { animation-delay: 20ms; }
  .oticon-about[data-anim="in"] .oticon-about__heading { animation-delay: 60ms; }
  .oticon-about[data-anim="in"] .oticon-about__paragraph:nth-of-type(1) { animation-delay: 110ms; }
  .oticon-about[data-anim="in"] .oticon-about__paragraph:nth-of-type(2) { animation-delay: 150ms; }
  .oticon-about[data-anim="in"] .oticon-about__paragraph:nth-of-type(3) { animation-delay: 190ms; }

  @keyframes oticon-about-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* --- Responsive ---------------------------------------------------------- */

  @media (max-width: 640px) {
    .oticon-about {
      padding-block: var(--space-16);
    }

    .oticon-about__paragraph {
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .oticon-about[data-anim="in"] [data-rise] {
      animation: none;
    }
  }
</style>

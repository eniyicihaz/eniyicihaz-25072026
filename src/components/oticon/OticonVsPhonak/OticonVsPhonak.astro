---
// OticonVsPhonak — Oticon brand page (/markalar/oticon), directly under
// OticonWhyOticon and before OticonVideoGuide. Independent of the
// /markalar hub page's M1...M8 modules; this page has its own component
// tree.
//
// Replaces the old "Oticon Mu Phonak Mı?" component, which was five
// stacked "heading -> paragraph" blocks with no visual comparison
// structure at all. Built from scratch: two mirrored "approach" cards
// (real Oticon/Phonak logos, no color-coded "team" styling, to stay
// impartial per the brief), three small topic cards below (Bluetooth
// presented as a single neutral statement since the source material
// doesn't actually differentiate the two brands there — forcing a
// difference would not be honest), a neutral editorial callout, and a
// CTA row reusing the shared CtaButton component.
import { Phone, MessageCircle } from "lucide-astro";
import CtaButton from "../../shared/CtaButton/CtaButton.astro";
import { oticonHero } from "../../../data/oticon/hero";
import { oticonVsPhonak } from "../../../data/oticon/vs-phonak";
---

<section
  class="oticon-vsp"
  aria-labelledby="oticon-vsp-title"
  style={`--color-primary:${oticonHero.accentColor}; --color-primary-hover:${oticonHero.accentColorHover};`}
>
  <div class="oticon-vsp__inner">
    <div class="oticon-vsp__header">
      <p class="oticon-vsp__badge" data-rise>{oticonVsPhonak.badge}</p>
      <h2 class="oticon-vsp__heading" id="oticon-vsp-title" data-rise>
        {oticonVsPhonak.heading}
      </h2>
      <p class="oticon-vsp__intro" data-rise>{oticonVsPhonak.intro}</p>
    </div>

    <div class="oticon-vsp__approach" data-rise>
      {
        oticonVsPhonak.approach.map((card) => (
          <div class="oticon-vsp__approach-card" data-brand={card.brand}>
            <img class="oticon-vsp__logo" src={card.logo} alt={card.name} loading="lazy" width="120" height="40" />
            <ul class="oticon-vsp__points">
              {card.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="oticon-vsp__divider" aria-hidden="true">
        <span>VS</span>
      </div>
    </div>

    <div class="oticon-vsp__topics" data-rise>
      {
        oticonVsPhonak.topics.map((topic) => (
          <div class="oticon-vsp__topic-card">
            <p class="oticon-vsp__topic-title">{topic.title}</p>
            {topic.shared ? (
              <p class="oticon-vsp__topic-shared">{topic.shared}</p>
            ) : (
              <div class="oticon-vsp__topic-split">
                <div class="oticon-vsp__topic-side">
                  <span class="oticon-vsp__topic-label">Oticon</span>
                  <p>{topic.oticon}</p>
                </div>
                <div class="oticon-vsp__topic-side">
                  <span class="oticon-vsp__topic-label">Phonak</span>
                  <p>{topic.phonak}</p>
                </div>
              </div>
            )}
          </div>
        ))
      }
    </div>

    <div class="oticon-vsp__callout" data-rise>
      <p class="oticon-vsp__callout-title">{oticonVsPhonak.calloutTitle}</p>
      <p class="oticon-vsp__callout-text">{oticonVsPhonak.calloutText}</p>
    </div>

    <div class="oticon-vsp__cta" data-rise>
      <p class="oticon-vsp__cta-text">{oticonVsPhonak.ctaText}</p>
      <div class="oticon-vsp__cta-actions">
        <CtaButton label={oticonVsPhonak.ctaPrimary.label} href={oticonVsPhonak.ctaPrimary.href} iconLeft={Phone} />
        <CtaButton
          label={oticonVsPhonak.ctaSecondary.label}
          href={oticonVsPhonak.ctaSecondary.href}
          iconLeft={MessageCircle}
          variant="outline"
        />
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    // Same entrance state-machine as every other section on the site:
    // IntersectionObserver, a failsafe timeout, and a
    // prefers-reduced-motion bail.
    var section = document.querySelector(".oticon-vsp");
    if (!section) return;
    if (!("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    section.dataset.anim = "pending";

    var revealed = false;
    var ioAlive = false;
    var io;

    function reveal() {
      if (revealed) return;
      revealed = true;
      section.dataset.anim = "in";
      if (io) io.disconnect();
    }

    var failsafe = setTimeout(function () {
      if (!ioAlive) reveal();
    }, 1500);

    io = new IntersectionObserver(
      function (entries) {
        ioAlive = true;
        clearTimeout(failsafe);
        if (entries[0].isIntersecting) reveal();
      },
      { threshold: 0.15 }
    );

    io.observe(section);
  })();
</script>

<style>
  .oticon-vsp {
    background: var(--color-surface);
    color: var(--color-text);
    padding-block: var(--space-24);
    --vsp-ease: cubic-bezier(0.22, 1, 0.36, 1);
  }

  .oticon-vsp__inner {
    max-width: var(--container-lg);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  /* --- Header ------------------------------------------------------------- */

  .oticon-vsp__header {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }

  .oticon-vsp__badge {
    display: inline-block;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid rgb(95 184 90 / 0.35);
    border-radius: var(--radius-full);
    background: rgb(95 184 90 / 0.1);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    color: #4a9a45;
  }

  .oticon-vsp__heading {
    margin: var(--space-4) 0 0;
    font-size: clamp(1.875rem, 1.5rem + 1.8vw, 2.75rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .oticon-vsp__intro {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  /* --- Approach: two mirrored cards with a VS divider ------------------------ */

  .oticon-vsp__approach {
    position: relative;
    margin: var(--space-14) 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .oticon-vsp__approach-card {
    padding: var(--space-8);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
  }

  .oticon-vsp__logo {
    display: block;
    height: 2.25rem;
    width: auto;
    object-fit: contain;
    object-position: left center;
  }

  .oticon-vsp__points {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .oticon-vsp__points li {
    position: relative;
    padding-left: var(--space-5);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text);
  }

  .oticon-vsp__points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-text-soft);
  }

  .oticon-vsp__approach-card[data-brand="oticon"] .oticon-vsp__points li::before {
    background: #5fb85a;
  }

  .oticon-vsp__divider {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-full);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.04em;
    color: var(--color-text-soft);
  }

  /* --- Topics: 3 small info cards --------------------------------------------- */

  .oticon-vsp__topics {
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .oticon-vsp__topic-card {
    padding: var(--space-6);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .oticon-vsp__topic-title {
    margin: 0;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
  }

  .oticon-vsp__topic-shared {
    margin: var(--space-3) 0 0;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .oticon-vsp__topic-split {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .oticon-vsp__topic-side {
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .oticon-vsp__topic-side:first-child {
    padding-top: 0;
    border-top: none;
  }

  .oticon-vsp__topic-label {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-soft);
  }

  .oticon-vsp__topic-side p {
    margin: var(--space-1) 0 0;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text);
  }

  /* --- Callout: neutral, impartial ------------------------------------------- */

  .oticon-vsp__callout {
    margin-top: var(--space-10);
    padding: var(--space-8) var(--space-10);
    background: #0f2547;
    border-radius: var(--radius-2xl);
    text-align: center;
  }

  .oticon-vsp__callout-title {
    margin: 0;
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
    color: var(--color-text-inverse);
  }

  .oticon-vsp__callout-text {
    margin: var(--space-3) 0 0;
    max-width: 40rem;
    margin-inline: auto;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: rgb(255 255 255 / 0.65);
  }

  /* --- CTA row --------------------------------------------------------------- */

  .oticon-vsp__cta {
    margin-top: var(--space-8);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .oticon-vsp__cta-text {
    margin: 0;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  .oticon-vsp__cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    flex: none;
  }

  /* --- Entrance: same fade-up state machine as every other section on the
     site (IntersectionObserver + data-anim, driven by the inline script
     above). --- */

  .oticon-vsp[data-anim="pending"] [data-rise] {
    opacity: 0;
  }

  .oticon-vsp[data-anim="in"] [data-rise] {
    animation: oticon-vsp-rise 600ms var(--vsp-ease) both;
  }

  .oticon-vsp[data-anim="in"] .oticon-vsp__approach { animation-delay: 80ms; }
  .oticon-vsp[data-anim="in"] .oticon-vsp__topics { animation-delay: 140ms; }
  .oticon-vsp[data-anim="in"] .oticon-vsp__callout { animation-delay: 200ms; }
  .oticon-vsp[data-anim="in"] .oticon-vsp__cta { animation-delay: 240ms; }

  @keyframes oticon-vsp-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* --- Responsive ---------------------------------------------------------- */

  @media (max-width: 1023px) {
    .oticon-vsp__topics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .oticon-vsp__approach {
      grid-template-columns: minmax(0, 1fr);
    }

    .oticon-vsp__divider {
      position: static;
      transform: none;
      margin: calc(var(--space-6) * -1) auto 0;
    }

    .oticon-vsp__topics {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .oticon-vsp {
      padding-block: var(--space-16);
    }

    .oticon-vsp__approach {
      margin-top: var(--space-10);
    }

    .oticon-vsp__callout {
      padding: var(--space-6);
    }

    .oticon-vsp__cta {
      flex-direction: column;
      align-items: stretch;
    }

    .oticon-vsp__cta-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .oticon-vsp[data-anim="in"] [data-rise] {
      animation: none;
    }
  }
</style>

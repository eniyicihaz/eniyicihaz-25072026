---
// TypeProfiles — one profile card per device type for the İşitme Cihazları
// topic hub. Where the price guide's DeviceTypeCards talks about what moves a
// price, this answers "what is it, how is it worn/used, how visible, how easy,
// how far does it reach, who is it worth evaluating for, what to watch" —
// the recognition/selection angle of the page. Image is a real
// representative photo or a neutral, text-free placeholder (never a fake).
import { ArrowRight } from "lucide-astro";
import ImagePlaceholder from "../shared/ImagePlaceholder/ImagePlaceholder.astro";
import type { TypeProfile } from "./device-guide.types";

interface Props {
  items: TypeProfile[];
}

const { items } = Astro.props;

const factLabels: [keyof TypeProfile["facts"], string][] = [
  ["howUsed", "Nasıl kullanılır?"],
  ["visibility", "Görünürlük"],
  ["ease", "Kullanım kolaylığı"],
  ["scope", "Güç ve kullanım kapsamı"],
];
---

<div class="type-profiles">
  {
    items.map((item) => (
      <article class="type-profile" id={item.id}>
        <div class="type-profile__media" data-image-slot={item.image ? undefined : item.id}>
          {
            item.image ? (
              <img
                class="type-profile__image"
                src={item.image.src}
                alt={item.image.alt}
                width={item.image.width}
                height={item.image.height}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <ImagePlaceholder alt={item.imageNeeded ?? item.name} ratio="1/1" />
            )
          }
        </div>

        <div class="type-profile__body">
          <h3 class="type-profile__title">{item.name}</h3>
          {item.alias && <p class="type-profile__alias">{item.alias}</p>}
          <p class="type-profile__what">{item.whatIs}</p>

          <dl class="type-profile__facts">
            {
              factLabels.map(([key, label]) => (
                <div class="type-profile__fact">
                  <dt>{label}</dt>
                  <dd>{item.facts[key]}</dd>
                </div>
              ))
            }
          </dl>

          <div class="type-profile__cols">
            <div>
              <h4>Kimler için değerlendirilebilir?</h4>
              <ul>{item.whoFor.map((x) => <li>{x}</li>)}</ul>
            </div>
            <div class="type-profile__watch">
              <h4>Dikkat edilecekler</h4>
              <ul>{item.watch.map((x) => <li>{x}</li>)}</ul>
            </div>
          </div>

          {
            item.href && (
              <a class="type-profile__link" href={item.href}>
                {item.linkLabel ?? "Ayrıntılı sayfayı inceleyin"}
                <ArrowRight size={16} stroke-width={2} aria-hidden="true" />
              </a>
            )
          }
        </div>
      </article>
    ))
  }
</div>

<style>
  .type-profiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .type-profile {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background: var(--color-background);
    scroll-margin-top: calc(var(--space-16) + var(--space-4));
    min-width: 0;
  }

  .type-profile__media {
    width: 160px;
    min-width: 0;
  }

  .type-profile__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    border-radius: var(--radius-xl);
    background: #fff;
    border: 1px solid var(--color-border);
  }

  .type-profile__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }

  .type-profile__title {
    margin: 0;
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    line-height: 1.2;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .type-profile__alias {
    margin: var(--space-1) 0 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-soft);
  }

  .type-profile__what {
    margin: var(--space-3) 0 0;
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text);
  }

  .type-profile__facts {
    margin: var(--space-4) 0 0;
    display: grid;
    gap: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .type-profile__fact {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
  }

  .type-profile__fact + .type-profile__fact {
    border-top: 1px solid var(--color-border);
  }

  .type-profile__fact dt {
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  .type-profile__fact dd {
    margin: 0;
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }

  .type-profile__cols {
    margin-top: var(--space-4);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .type-profile__cols h4 {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
  }

  .type-profile__cols ul {
    margin: 0;
    padding-left: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .type-profile__watch {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    background: rgb(37 99 235 / 0.05);
  }

  .type-profile__link {
    margin-top: var(--space-5);
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .type-profile__link:hover {
    text-decoration: underline;
  }

  .type-profile__link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  @media (max-width: 1279px) {
    .type-profiles {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .type-profile {
      padding: var(--space-4);
    }

    .type-profile__title {
      font-size: var(--font-size-xl);
    }

    .type-profile__fact {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }

    .type-profile__cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
// "İletişim" — the site's Local Entity Page + Contact Page + Local
// Service Hub (see the "İletişim Sayfası" plan). Not a copy of the
// markalar/hizmetlerimiz-style M1-M8 hub: every section here answers a
// real local-search/GEO question using only facts from
// src/components/footer/Footer/data/company.ts (itself sourced from
// COMPANY.md) — nothing invented.
//
// Section order (plan §2): Breadcrumb → Hero (kim/ne/nerede) →
// Fiziksel Konum Kartı (nasıl ulaşırım) → Hizmetler (neden gelmeliyim)
// → Hizmet Bölgeleri (hangi bölgelerden ulaşırım) → Ziyaret Süreci
// (merkeze geldiğimde ne olacak) → Yerel SSS → Kapanış CTA.
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../ds/components/ui/atoms/Breadcrumb/Breadcrumb.astro";
import ContactHero from "../components/contact/ContactHero/ContactHero.astro";
import ContactLocationCard from "../components/contact/ContactLocationCard/ContactLocationCard.astro";
import BrandCriteria from "../components/brands/BrandCriteria/BrandCriteria.astro";
import ContactServiceArea from "../components/contact/ContactServiceArea/ContactServiceArea.astro";
import BrandBuyingGuide from "../components/brands/BrandBuyingGuide/BrandBuyingGuide.astro";
import BrandFaq from "../components/brands/BrandFaq/BrandFaq.astro";
import BrandExpertSupport from "../components/brands/BrandExpertSupport/BrandExpertSupport.astro";

import { contactHero } from "../data/contact/hero";
import { contactLocationCard } from "../data/contact/locationCard";
import { contactServices } from "../data/contact/services";
import { contactServiceArea } from "../data/contact/serviceArea";
import { contactProcess } from "../data/contact/process";
import { contactFaq } from "../data/contact/faq";
import { contactFinalCta } from "../data/contact/finalCta";

import { company } from "../components/footer/Footer/data/company";

const breadcrumbItems = [
  { label: "Ana Sayfa", href: "/" },
  { label: "İletişim", current: true },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, "https://www.eniyicihaz.com").toString() } : {}),
  })),
};

// Extends the sitewide Organization node (MainLayout.astro) via the same
// `@id` rather than redeclaring it — one real business, described more
// fully here, not two competing entities (plan §8, finalized decision #4).
// `description` reuses the Hero's definition sentence verbatim so visible
// text and structured data never drift apart. `geo` now uses the real
// coordinates behind company.directionsHref/mapEmbedSrc (a verified Google
// Business Profile embed, not a re-geocoded guess). `priceRange` stays
// omitted: price is never published (COMPANY.md §23, PRINCIPLES.md §5).
const medicalBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "@id": "https://www.eniyicihaz.com/#organization",
  name: company.legalName,
  description: contactHero.definitionSentence,
  url: "https://www.eniyicihaz.com/iletisim",
  telephone: company.phones.map((phone) => phone.href.replace("tel:", "")),
  email: company.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Fevziçakmak Mah. Dr. Zeki Acar Cad. No:77/7 Asansör 1. Kat",
    addressLocality: "Darıca",
    addressRegion: "Kocaeli",
    addressCountry: "TR",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 40.772815433889605,
    longitude: 29.4047968764159,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "08:45",
      closes: "19:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Saturday",
      opens: "09:00",
      closes: "19:00",
    },
  ],
  areaServed: contactServiceArea.items.map((item) => item.name),
};
---

<MainLayout
  title="İletişim | Darıca, Kocaeli — Avrasya İşitme Cihazları | EniyiCihaz"
  description="Darıca, Kocaeli'deki SGK anlaşmalı işitme merkezimizin adresi, telefon numaraları, çalışma saatleri ve hizmet bölgeleri. Hemen arayın veya yol tarifi alın."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(medicalBusinessSchema)} />

  <div class="contact-breadcrumb-wrap">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <ContactHero data={contactHero} />
  <ContactLocationCard data={contactLocationCard} />
  <BrandCriteria data={contactServices} />
  <ContactServiceArea data={contactServiceArea} />
  <BrandBuyingGuide data={contactProcess} />
  <BrandFaq data={contactFaq} />
  <BrandExpertSupport data={contactFinalCta} />
</MainLayout>

<style>
  .contact-breadcrumb-wrap {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding: var(--space-6) var(--space-6) 0;
  }
</style>

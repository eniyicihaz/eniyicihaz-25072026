---
// "İletişim" — the site's Local Entity Page + Contact Page + Local
// Service Hub (see the "İletişim Sayfası" plan). Not a copy of the
// markalar/hizmetlerimiz-style M1-M8 hub: every section here answers a
// real local-search/GEO question using only facts from
// src/components/footer/Footer/data/company.ts (itself sourced from
// COMPANY.md) — nothing invented.
//
// Section order (Faz 2 P2): Breadcrumb → Hero (kim/ne/nerede) →
// Fiziksel Konum Kartı → Hizmet Bölgeleri (kanonik hat listesi, zaman
// notu tek yerde) → Evde Hizmet → Kısa yollar → Yerel SSS (5 soru) →
// Kapanış CTA. Sekiz adımlı ziyaret süreci ve 6 kartlık hizmet bölümü
// kaldırıldı (Darıca sayfası ve ilgili sayfalar kapsıyor).
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../ds/components/ui/atoms/Breadcrumb/Breadcrumb.astro";
import ContactHero from "../components/contact/ContactHero/ContactHero.astro";
import ContactLocationCard from "../components/contact/ContactLocationCard/ContactLocationCard.astro";
import ContactServiceArea from "../components/contact/ContactServiceArea/ContactServiceArea.astro";
import BrandFaq from "../components/brands/BrandFaq/BrandFaq.astro";
import BrandExpertSupport from "../components/brands/BrandExpertSupport/BrandExpertSupport.astro";

import { contactHero } from "../data/contact/hero";
import { contactLocationCard } from "../data/contact/locationCard";
import { contactShortcuts, contactHomeService } from "../data/contact/services";
import { contactServiceArea } from "../data/contact/serviceArea";
import { contactFaq } from "../data/contact/faq";
import { contactFinalCta } from "../data/contact/finalCta";

import { company } from "../components/footer/Footer/data/company";

const breadcrumbItems = [
  { label: "Ana Sayfa", href: "/" },
  { label: "İletişim", current: true },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, "https://www.eniyicihaz.com").toString() } : {}),
  })),
};

// Extends the sitewide Organization node (MainLayout.astro) via the same
// `@id` rather than redeclaring it — one real business, described more
// fully here, not two competing entities (plan §8, finalized decision #4).
// `description` reuses the Hero's definition sentence verbatim so visible
// text and structured data never drift apart. `geo` now uses the real
// coordinates behind company.directionsHref/mapEmbedSrc (a verified Google
// Business Profile embed, not a re-geocoded guess). `priceRange` stays
// omitted: price is never published (COMPANY.md §23, PRINCIPLES.md §5).
const medicalBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "@id": BUSINESS_ID,
  name: company.legalName,
  description: contactHero.definitionSentence,
  url: BUSINESS_URL,
  telephone: company.phones.map((phone) => phone.href.replace("tel:", "")),
  email: company.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Fevziçakmak Mah. Dr. Zeki Acar Cad. No:77/7 Asansör 1. Kat",
    addressLocality: "Darıca",
    addressRegion: "Kocaeli",
    postalCode: BUSINESS_POSTAL_CODE,
    addressCountry: "TR",
  },
  image: BUSINESS_IMAGE,
  geo: {
    "@type": "GeoCoordinates",
    latitude: 40.772815433889605,
    longitude: 29.4047968764159,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "08:45",
      closes: "19:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Saturday",
      opens: "09:00",
      closes: "19:00",
    },
  ],
  areaServed: SERVICE_AREA_NAMES,
};
import { BUSINESS_ID, BUSINESS_IMAGE, BUSINESS_POSTAL_CODE, BUSINESS_URL, SERVICE_AREA_NAMES } from "../lib/schema";
---

<MainLayout
  title="İletişim | Darıca, Kocaeli — Avrasya İşitme Cihazları"
  description="Darıca, Kocaeli'deki SGK anlaşmalı işitme merkezimizin adresi, telefon numaraları, çalışma saatleri ve hizmet bölgeleri. Hemen arayın veya yol tarifi alın."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(medicalBusinessSchema)} />

  <div class="contact-breadcrumb-wrap">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <ContactHero data={contactHero} />
  <ContactLocationCard data={contactLocationCard} />
  <ContactServiceArea data={contactServiceArea} />

  <section class="contact-block" aria-labelledby="contact-home-service-title">
    <div class="contact-block__inner">
      <p class="contact-block__badge">{contactHomeService.eyebrow}</p>
      <h2 class="contact-block__heading" id="contact-home-service-title">{contactHomeService.heading}</h2>
      <p class="contact-block__text">{contactHomeService.text}</p>
      <p class="contact-block__text">
        <a class="contact-inline-link" href={contactHomeService.href}>{contactHomeService.linkLabel} →</a>
      </p>
    </div>
  </section>

  <section class="contact-block contact-block--alt" aria-labelledby="contact-shortcuts-title">
    <div class="contact-block__inner">
      <p class="contact-block__badge">{contactShortcuts.eyebrow}</p>
      <h2 class="contact-block__heading" id="contact-shortcuts-title">{contactShortcuts.heading}</h2>
      <ul class="contact-shortcuts">
        {contactShortcuts.items.map((item) => (
          <li><a class="contact-shortcuts__link" href={item.href}>{item.label}</a></li>
        ))}
        <li><a class="contact-shortcuts__link" href="/kocaeli-isitme-cihazlari/">Kocaeli Geneli Hizmetler</a></li>
      </ul>
    </div>
  </section>

  <BrandFaq data={contactFaq} />
  <BrandExpertSupport data={contactFinalCta} />
</MainLayout>

<style>
  .contact-breadcrumb-wrap {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding: var(--space-6) var(--space-6) 0;
  }

  .contact-block {
    background: var(--color-background);
    padding-block: var(--space-16);
  }

  .contact-block--alt {
    background: var(--color-surface);
    padding-block: var(--space-12);
  }

  .contact-block__inner {
    max-width: 42rem;
    margin-inline: auto;
    padding-inline: var(--space-6);
    text-align: center;
  }

  .contact-block__badge {
    display: inline-block;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
  }

  .contact-block__heading {
    margin: var(--space-4) 0 0;
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .contact-block__text {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .contact-shortcuts {
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .contact-shortcuts__link {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: var(--space-2) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .contact-shortcuts__link:hover {
    text-decoration: underline;
  }

  .contact-shortcuts__link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  .contact-inline-link {
    display: inline-block;
    padding-block: var(--space-3);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .contact-inline-link:hover {
    text-decoration: underline;
  }

  .contact-inline-link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  @media (max-width: 640px) {
    .contact-block {
      padding-block: var(--space-10);
    }

    .contact-block--alt {
      padding-block: var(--space-8);
    }
  }
</style>

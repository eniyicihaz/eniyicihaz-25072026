---
// Cihaz Deneme — /uygulama-ayar/cihaz-deneme (Faz 2 P2). HİZMET sayfası:
// yalnızca kanonik deneme modeli (SERVICE_SOURCE_OF_TRUTH §1.5): merkezde
// ~20 dk ücretsiz demo (randevulu) → cihazı satın alarak en fazla 7 gün
// deneme → uygun bulunmazsa kesintisiz iade; kulak içi cihazlar 7 günlük
// deneme dışında. "Ücretsiz deneme" ifadesi kullanılmaz.
// Sıra: Hero (görselsiz) -> İki aşama -> Süreç (4 adım) -> Konum kartı ->
// SSS (6 soru) -> Son CTA -> İlgili içerikler (4 link).
// Kaldırıldı: teknoloji seviyeleri, 4 örnek model, senaryo şeridi, marka/SGK
// tanıtım blokları, kulak içi/arkası karşılaştırma, ara kontrol/uygulama
// iddiaları (doğrulanmamış veya başka sayfalara ait).
import MainLayout from "../../layouts/MainLayout.astro";
import Breadcrumb from "../../ds/components/ui/atoms/Breadcrumb/Breadcrumb.astro";
import CorporateHero from "../../components/shared/CorporateHero/CorporateHero.astro";
import BrandBuyingGuide from "../../components/brands/BrandBuyingGuide/BrandBuyingGuide.astro";
import BrandPageFaq from "../../components/brand-page/BrandPageFaq/BrandPageFaq.astro";
import BrandPageFinalCta from "../../components/brand-page/BrandPageFinalCta/BrandPageFinalCta.astro";
import BrandPageRelatedContent from "../../components/brand-page/BrandPageRelatedContent/BrandPageRelatedContent.astro";
import ContactLocationCard from "../../components/contact/ContactLocationCard/ContactLocationCard.astro";
import { cihazDenemeHero } from "../../data/cihaz-deneme/hero";
import { cihazDenemeModel } from "../../data/cihaz-deneme/overview";
import { cihazDenemeJourney } from "../../data/cihaz-deneme/journey";
import { cihazDenemeLocation } from "../../data/cihaz-deneme/location";
import { cihazDenemeFaq } from "../../data/cihaz-deneme/faq";
import { cihazDenemeFinalCta } from "../../data/cihaz-deneme/final-cta";
import { cihazDenemeRelatedContent } from "../../data/cihaz-deneme/related-content";
import { company } from "../../components/footer/Footer/data/company";

const PAGE_URL = "https://www.eniyicihaz.com/uygulama-ayar/cihaz-deneme";

const breadcrumbItems = [
  { label: "Ana Sayfa", href: "/" },
  { label: "Cihaz Deneme", current: true },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, "https://www.eniyicihaz.com").toString() } : {}),
  })),
};

// Same MedicalBusiness node as /iletisim and the redesigned Ücretsiz
// İşitme Testi page — same @id, same real NAP source, extending the
// sitewide Organization rather than declaring a second entity.
const medicalBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "@id": BUSINESS_ID,
  name: company.legalName,
  description: "Darıca, Kocaeli'de SGK anlaşmalı işitme merkezi; merkezde ücretsiz cihaz demosu ve cihazı satın alarak 7 güne kadar deneme imkânı sunar.",
  url: BUSINESS_URL,
  telephone: company.phones.map((phone) => phone.href.replace("tel:", "")),
  email: company.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Fevziçakmak Mah. Dr. Zeki Acar Cad. No:77/7 Asansör 1. Kat",
    addressLocality: "Darıca",
    addressRegion: "Kocaeli",
    postalCode: BUSINESS_POSTAL_CODE,
    addressCountry: "TR",
  },
  image: BUSINESS_IMAGE,
  geo: {
    "@type": "GeoCoordinates",
    latitude: 40.772815433889605,
    longitude: 29.4047968764159,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "08:45",
      closes: "19:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Saturday",
      opens: "09:00",
      closes: "19:00",
    },
  ],
  areaServed: SERVICE_AREA_NAMES,
};
import { BUSINESS_ID, BUSINESS_IMAGE, BUSINESS_POSTAL_CODE, BUSINESS_URL, SERVICE_AREA_NAMES } from "../../lib/schema";
---

<MainLayout
  title="Darıca'da İşitme Cihazı Deneme | Avrasya İşitme Cihazları"
  description="Darıca'daki merkezimizde ücretsiz, yaklaşık 20 dakikalık cihaz demosu; cihazı satın alarak 7 güne kadar deneme ve uygun bulunmazsa kesintisiz ücret iadesi."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(medicalBusinessSchema)} />

  <div class="cd-breadcrumb-wrap">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <CorporateHero data={cihazDenemeHero} />

  <section class="cd-model" aria-labelledby="cd-model-title">
    <div class="cd-model__inner">
      <p class="cd-model__badge">{cihazDenemeModel.eyebrow}</p>
      <h2 class="cd-model__heading" id="cd-model-title">{cihazDenemeModel.heading}</h2>
      <p class="cd-model__intro">{cihazDenemeModel.intro}</p>
      <div class="cd-model__grid">
        {cihazDenemeModel.stages.map((stage) => (
          <article class="cd-model__card">
            <p class="cd-model__label">{stage.label}</p>
            <h3 class="cd-model__title">{stage.title}</h3>
            <ul class="cd-model__points">
              {stage.points.map((pt) => <li>{pt}</li>)}
            </ul>
          </article>
        ))}
      </div>
      <p class="cd-model__note">{cihazDenemeModel.note}</p>
    </div>
  </section>

  <BrandBuyingGuide data={cihazDenemeJourney} />
  <ContactLocationCard data={cihazDenemeLocation} />
  <BrandPageFaq data={cihazDenemeFaq} />
  <BrandPageFinalCta data={cihazDenemeFinalCta} />
  <BrandPageRelatedContent data={cihazDenemeRelatedContent} />
</MainLayout>

<style>
  .cd-breadcrumb-wrap {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding: var(--space-6) var(--space-6) 0;
  }

  .cd-model {
    background: var(--color-background);
    padding-block: var(--space-16);
  }

  .cd-model__inner {
    max-width: 56rem;
    margin-inline: auto;
    padding-inline: var(--space-6);
    text-align: center;
  }

  .cd-model__badge {
    display: inline-block;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid rgb(13 148 136 / 0.35);
    border-radius: var(--radius-full);
    background: rgb(13 148 136 / 0.08);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #0f766e;
  }

  .cd-model__heading {
    margin: var(--space-4) 0 0;
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .cd-model__intro,
  .cd-model__note {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .cd-model__grid {
    margin-top: var(--space-8);
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    text-align: left;
  }

  .cd-model__card {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .cd-model__label {
    margin: 0;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #0f766e;
  }

  .cd-model__title {
    margin: var(--space-2) 0 0;
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
  }

  .cd-model__points {
    margin: var(--space-4) 0 0;
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-2);
    color: var(--color-text-muted);
    line-height: var(--line-height-relaxed);
  }

  @media (max-width: 720px) {
    .cd-model {
      padding-block: var(--space-10);
    }

    .cd-model__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
// Evde İşitme Cihazı Hizmeti — /uygulama-ayar/evde-isitme-cihazi-hizmeti.
// Konumlandırma: mevcut sayfalar (kisiye-ozel-ayar, cihaz-deneme, vb.)
// hizmetleri "merkeze gelme" varsayımıyla anlatır; bu sayfa aynı
// hizmetlerin *teslim kanalını* — evde alınabildiğini — anlatır, bu
// yüzden hiçbiriyle keyword cannibalization yaratmaz (bkz. plan).
//
// Sıra: Breadcrumb -> HomeVisitHero (özgün) -> Ne Sunuyoruz? (Intro) ->
// Hizmet Kapsamı (ScenarioRail) -> Kimler İçin Uygun? (BrandPageIdealUser)
// -> Süreç (TuningProcess) -> Merkeze Gelmeniz Gerektiğinde
// (BrandPageSignalList) -> Merkezimiz + Hizmet Bölgesi (ContactLocationCard
// + ContactServiceArea) -> SSS -> Son CTA -> İlgili İçerikler.
import MainLayout from "../../layouts/MainLayout.astro";
import Breadcrumb from "../../ds/components/ui/atoms/Breadcrumb/Breadcrumb.astro";
import HomeVisitHero from "../../components/shared/HomeVisitHero/HomeVisitHero.astro";
import BrandPageIntro from "../../components/brand-page/BrandPageIntro/BrandPageIntro.astro";
import ScenarioRail from "../../components/shared/ScenarioRail/ScenarioRail.astro";
import BrandPageIdealUser from "../../components/brand-page/BrandPageIdealUser/BrandPageIdealUser.astro";
import TuningProcess from "../../components/shared/TuningProcess/TuningProcess.astro";
import BrandPageSignalList from "../../components/brand-page/BrandPageSignalList/BrandPageSignalList.astro";
import ContactLocationCard from "../../components/contact/ContactLocationCard/ContactLocationCard.astro";
import ContactServiceArea from "../../components/contact/ContactServiceArea/ContactServiceArea.astro";
import BrandPageFaq from "../../components/brand-page/BrandPageFaq/BrandPageFaq.astro";
import BrandPageFinalCta from "../../components/brand-page/BrandPageFinalCta/BrandPageFinalCta.astro";
import BrandPageRelatedContent from "../../components/brand-page/BrandPageRelatedContent/BrandPageRelatedContent.astro";

import { evdeHizmetHero } from "../../data/evde-isitme-cihazi-hizmeti/hero";
import { evdeHizmetIntro } from "../../data/evde-isitme-cihazi-hizmeti/intro";
import { evdeHizmetScope } from "../../data/evde-isitme-cihazi-hizmeti/scope";
import { evdeHizmetIdealUser } from "../../data/evde-isitme-cihazi-hizmeti/ideal-user";
import { evdeHizmetProcess } from "../../data/evde-isitme-cihazi-hizmeti/process";
import { evdeHizmetSignalList } from "../../data/evde-isitme-cihazi-hizmeti/signal-list";
import { evdeHizmetLocation } from "../../data/evde-isitme-cihazi-hizmeti/location";
import { evdeHizmetServiceArea } from "../../data/evde-isitme-cihazi-hizmeti/service-area";
import { evdeHizmetFaq } from "../../data/evde-isitme-cihazi-hizmeti/faq";
import { evdeHizmetFinalCta } from "../../data/evde-isitme-cihazi-hizmeti/final-cta";
import { evdeHizmetRelatedContent } from "../../data/evde-isitme-cihazi-hizmeti/related-content";

import { company } from "../../components/footer/Footer/data/company";

const PAGE_URL = "https://www.eniyicihaz.com/uygulama-ayar/evde-isitme-cihazi-hizmeti";

const breadcrumbItems = [
  { label: "Ana Sayfa", href: "/" },
  { label: "Evde İşitme Cihazı Hizmeti", current: true },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, "https://www.eniyicihaz.com").toString() } : {}),
  })),
};

// Same MedicalBusiness node as /iletisim, Kişiye Özel Ayar ve Cihaz
// Deneme — same @id, same real NAP source, extending the sitewide
// Organization rather than declaring a second entity.
const medicalBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "@id": "https://www.eniyicihaz.com/#organization",
  name: company.legalName,
  description: "Darıca, Kocaeli'de SGK anlaşmalı işitme merkezi; Darıca, Gebze ve Çayırova'da evde işitme testi, cihaz denemesi, uygulama ve kişiye özel ayar hizmeti sunar.",
  url: PAGE_URL,
  telephone: company.phones.map((phone) => phone.href.replace("tel:", "")),
  email: company.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Fevziçakmak Mah. Dr. Zeki Acar Cad. No:77/7 Asansör 1. Kat",
    addressLocality: "Darıca",
    addressRegion: "Kocaeli",
    addressCountry: "TR",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 40.772815433889605,
    longitude: 29.4047968764159,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "08:45",
      closes: "19:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Saturday",
      opens: "09:00",
      closes: "19:00",
    },
  ],
  areaServed: evdeHizmetServiceArea.items.map((item) => item.name),
};
---

<MainLayout
  title="Evde İşitme Cihazı Hizmeti | Darıca, Gebze, Çayırova | EniyiCihaz"
  description="Darıca, Gebze ve Çayırova'da evde işitme testi, cihaz denemesi, uygulama ve kişiye özel ayar desteği. Avrasya İşitme Cihazları ile evinizde işitme hizmeti alın."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(medicalBusinessSchema)} />

  <div class="evde-breadcrumb-wrap">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <HomeVisitHero data={evdeHizmetHero} />
  <BrandPageIntro data={evdeHizmetIntro} />
  <ScenarioRail data={evdeHizmetScope} />
  <BrandPageIdealUser data={evdeHizmetIdealUser} />
  <TuningProcess data={evdeHizmetProcess} />
  <BrandPageSignalList data={evdeHizmetSignalList} />
  <ContactLocationCard data={evdeHizmetLocation} />
  <ContactServiceArea data={evdeHizmetServiceArea} />
  <BrandPageFaq data={evdeHizmetFaq} />
  <BrandPageFinalCta data={evdeHizmetFinalCta} />
  <BrandPageRelatedContent data={evdeHizmetRelatedContent} />
</MainLayout>

<style>
  .evde-breadcrumb-wrap {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding: var(--space-6) var(--space-6) 0;
  }
</style>

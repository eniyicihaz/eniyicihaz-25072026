---
// 404 — Cloudflare Pages serves dist/404.html with a real 404 status for any unknown URL, but ONLY when this file
// exists (without it Pages falls back to SPA mode and answers unknown URLs with the homepage HTML and 200 = soft 404).
// noindex, no canonical. Plain, static: a way back home plus the site's main entry points.
import MainLayout from "../layouts/MainLayout.astro";
import { contactConfig } from "../config/contact";

const links = [
  { label: "Ana sayfa", href: "/" },
  { label: "İşitme cihazları", href: "/isitme-cihazlari/" },
  { label: "Ücretsiz işitme testi", href: "/degerlendirme/ucretsiz-isitme-testi/" },
  { label: "SGK işitme cihazı desteği", href: "/sgk-isitme-cihazi-odemesi/" },
  { label: "Bilgi merkezi", href: "/bilgi-merkezi/" },
  { label: "İletişim", href: "/iletisim/" },
];
---

<MainLayout title="Sayfa bulunamadı | Avrasya İşitme Cihazları" description="Aradığınız sayfa bulunamadı. Ana sayfaya dönebilir veya aşağıdaki bağlantılardan devam edebilirsiniz." noindex>
  <section class="nf" aria-labelledby="nf-title">
    <div class="nf__inner">
      <p class="nf__code">404</p>
      <h1 class="nf__title" id="nf-title">Aradığınız sayfa bulunamadı</h1>
      <p class="nf__text">Adres değişmiş ya da yanlış yazılmış olabilir. Aşağıdaki bağlantılardan devam edebilirsiniz.</p>
      <h2 class="nf__sub">Devam edebileceğiniz sayfalar</h2>
      <ul class="nf__links">
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
      <!-- Eski/değişmiş adres için konuya en yakın sayfa önerisi (aşağıdaki küçük betik; betik yoksa yukarıdaki liste yeterli). -->
      <div class="nf__suggest" data-nf-suggest hidden>
        <h2 class="nf__sub">Aradığınız konu şu olabilir</h2>
        <ul class="nf__links" data-nf-suggest-list></ul>
      </div>
      <p class="nf__text">
        Yardım için <a href={contactConfig.phone.href}>bizi arayabilirsiniz</a> ya da{" "}
        <a href={contactConfig.whatsapp.href}>WhatsApp'tan yazabilirsiniz</a>.
      </p>
    </div>
  </section>
</MainLayout>

<script is:inline>
  (function () {
    var box = document.querySelector("[data-nf-suggest]");
    var list = document.querySelector("[data-nf-suggest-list]");
    if (!box || !list) return;
    var path = decodeURIComponent(location.pathname).toLowerCase();
    var rules = [
      [/oticon/, "/markalar/oticon/", "Oticon işitme cihazları"],
      [/signia|siemens/, "/markalar/signia/", "Signia işitme cihazları"],
      [/resound/, "/markalar/resound/", "ReSound işitme cihazları"],
      [/phonak/, "/markalar/phonak/", "Phonak işitme cihazları"],
      [/widex/, "/markalar/widex/", "Widex işitme cihazları"],
      [/nuear/, "/markalar/nuear/", "NuEar işitme cihazları"],
      [/unitron/, "/markalar/unitron/", "Unitron işitme cihazları"],
      [/bernafon/, "/markalar/bernafon/", "Bernafon işitme cihazları"],
      [/(^|\/)am-|a-?m-/, "/markalar/am/", "A&M işitme cihazları"],
      [/fiyat|ucret|taksit/, "/isitme-cihazi-fiyatlari/", "İşitme cihazı fiyatları"],
      [/sgk|katki|rapor|yenileme/, "/sgk-isitme-cihazi-odemesi/", "SGK işitme cihazı ödemesi ve katkı payı"],
      [/pil|aksesuar/, "/servis-bakim/pil-aksesuar/", "Pil ve aksesuar"],
      [/tamir|onar|servis|ariza/, "/servis-bakim/teknik-servis/", "Teknik servis"],
      [/test|odyo|timpano/, "/degerlendirme/ucretsiz-isitme-testi/", "Ücretsiz işitme testi"],
      [/evde/, "/uygulama-ayar/evde-isitme-cihazi-hizmeti/", "Evde işitme cihazı hizmeti"],
      [/ayar|program/, "/uygulama-ayar/kisiye-ozel-ayar/", "Kişiye özel ayar"],
      [/marka|model|hakkinda-bilgi/, "/isitme-cihazlari/", "İşitme cihazları"],
    ];
    var seen = {};
    rules.forEach(function (r) {
      if (!r[0].test(path) || seen[r[1]]) return;
      seen[r[1]] = true;
      var li = document.createElement("li");
      var a = document.createElement("a");
      a.href = r[1];
      a.textContent = r[2];
      li.appendChild(a);
      list.appendChild(li);
    });
    if (list.children.length) box.hidden = false;
  })();
</script>

<style>
  .nf {
    background: var(--color-background);
    padding-block: var(--space-20);
  }

  .nf__inner {
    max-width: 40rem;
    margin-inline: auto;
    padding-inline: var(--space-6);
    text-align: center;
  }

  .nf__code {
    margin: 0;
    font-size: clamp(3rem, 2rem + 5vw, 5rem);
    font-weight: var(--font-weight-bold);
    line-height: 1;
    color: var(--color-primary);
  }

  .nf__title {
    margin: var(--space-4) 0 0;
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.25rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.02em;
  }

  .nf__text {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .nf__text a,
  .nf__links a {
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .nf__text a:hover,
  .nf__links a:hover {
    text-decoration: underline;
  }

  .nf__sub {
    margin: var(--space-8) 0 0;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
  }

  .nf__links {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3) var(--space-6);
  }

  @media (max-width: 640px) {
    .nf {
      padding-block: var(--space-12);
    }

    .nf__inner {
      padding-inline: var(--space-4);
    }
  }
</style>

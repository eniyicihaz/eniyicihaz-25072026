---
// Hakkımızda — /hakkimizda. Kurumsal, Darıca odaklı, gerçek merkez
// fotoğraflarıyla desteklenen sayfa. Mevcut sayfaların hiçbirine
// benzemeyecek şekilde özgün bir Hero (CorporateHero) ve editorial foto
// galerisi (CenterGallery) kullanılıyor; geri kalan bölümler projede
// zaten var olan, sayfa-agnostik component'lerle (BrandPageIntro,
// BrandPageSignalList, ProcessTimeline, BrandShowcase, ContactLocationCard,
// ContactServiceArea, BrandPageFaq, BrandPageFinalCta) dolduruluyor.
//
// Sıra: Breadcrumb -> CorporateHero -> Kurumsal Giriş -> Darıca'daki
// Merkezimiz (CenterGallery) -> Sadece Cihaz Satmıyoruz -> Değerlerimiz
// -> Nasıl Çalışıyoruz? -> Marka ve Teknoloji Yaklaşımımız -> Darıca'daki
// Merkezimize Ulaşın -> Hizmet Bölgemiz -> SSS -> Son CTA.
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../ds/components/ui/atoms/Breadcrumb/Breadcrumb.astro";
import CorporateHero from "../components/shared/CorporateHero/CorporateHero.astro";
import BrandPageIntro from "../components/brand-page/BrandPageIntro/BrandPageIntro.astro";
import CenterGallery from "../components/shared/CenterGallery/CenterGallery.astro";
import BrandPageSignalList from "../components/brand-page/BrandPageSignalList/BrandPageSignalList.astro";
import ValueGrid from "../components/shared/ValueGrid/ValueGrid.astro";
import ProcessTimeline from "../components/shared/ProcessTimeline/ProcessTimeline.astro";
import BrandShowcase from "../components/brands/BrandShowcase/BrandShowcase.astro";
import ContactLocationCard from "../components/contact/ContactLocationCard/ContactLocationCard.astro";
import ContactServiceArea from "../components/contact/ContactServiceArea/ContactServiceArea.astro";
import BrandPageFaq from "../components/brand-page/BrandPageFaq/BrandPageFaq.astro";
import BrandPageFinalCta from "../components/brand-page/BrandPageFinalCta/BrandPageFinalCta.astro";
import BrandPageRelatedContent from "../components/brand-page/BrandPageRelatedContent/BrandPageRelatedContent.astro";

import { hakkimizdaHero } from "../data/hakkimizda/hero";
import { hakkimizdaIntro } from "../data/hakkimizda/intro";
import { hakkimizdaCenterGallery } from "../data/hakkimizda/center-gallery";
import { hakkimizdaSignalList } from "../data/hakkimizda/signal-list";
import { hakkimizdaValues } from "../data/hakkimizda/values";
import { hakkimizdaProcess } from "../data/hakkimizda/process";
import { hakkimizdaLocation } from "../data/hakkimizda/location";
import { hakkimizdaServiceArea } from "../data/hakkimizda/service-area";
import { hakkimizdaFaq } from "../data/hakkimizda/faq";
import { hakkimizdaFinalCta } from "../data/hakkimizda/final-cta";
import { hakkimizdaRelatedContent } from "../data/hakkimizda/related-content";
import { brandShowcase } from "../data/brands/showcase";

import { company } from "../components/footer/Footer/data/company";

const PAGE_URL = "https://www.eniyicihaz.com/hakkimizda";

const breadcrumbItems = [
  { label: "Ana Sayfa", href: "/" },
  { label: "Hakkımızda", current: true },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, "https://www.eniyicihaz.com").toString() } : {}),
  })),
};

// Same MedicalBusiness node as /iletisim, Kişiye Özel Ayar, Cihaz Deneme
// ve Evde İşitme Cihazı Hizmeti — same @id, same real NAP source.
const medicalBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "@id": "https://www.eniyicihaz.com/#organization",
  name: company.legalName,
  description: company.about,
  url: PAGE_URL,
  telephone: company.phones.map((phone) => phone.href.replace("tel:", "")),
  email: company.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Fevziçakmak Mah. Dr. Zeki Acar Cad. No:77/7 Asansör 1. Kat",
    addressLocality: "Darıca",
    addressRegion: "Kocaeli",
    addressCountry: "TR",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 40.772815433889605,
    longitude: 29.4047968764159,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "08:45",
      closes: "19:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Saturday",
      opens: "09:00",
      closes: "19:00",
    },
  ],
  areaServed: ["Darıca", "Gebze", "Çayırova", "Kocaeli"],
};
---

<MainLayout
  title="Avrasya İşitme Cihazları Hakkında | Darıca İşitme Merkezi | EniyiCihaz"
  description="Avrasya İşitme Cihazları, 2009'dan beri Darıca'da SGK anlaşmalı bir işitme merkezidir. Değerlendirme, cihaz uygulaması ve satış sonrası destekle Gebze ve Çayırova'dan gelenlere de hizmet veriyoruz."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(medicalBusinessSchema)} />

  <div class="hakkimizda-breadcrumb-wrap">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <CorporateHero data={hakkimizdaHero} />
  <BrandPageIntro data={hakkimizdaIntro} />
  <CenterGallery data={hakkimizdaCenterGallery} />
  <BrandPageSignalList data={hakkimizdaSignalList} />
  <ValueGrid data={hakkimizdaValues} />
  <ProcessTimeline data={hakkimizdaProcess} />
  <BrandShowcase data={brandShowcase} />
  <ContactLocationCard data={hakkimizdaLocation} />
  <ContactServiceArea data={hakkimizdaServiceArea} />
  <BrandPageFaq data={hakkimizdaFaq} />
  <BrandPageRelatedContent data={hakkimizdaRelatedContent} />
  <BrandPageFinalCta data={hakkimizdaFinalCta} />
</MainLayout>

<style>
  .hakkimizda-breadcrumb-wrap {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding: var(--space-6) var(--space-6) 0;
  }
</style>

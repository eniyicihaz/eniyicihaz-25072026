---
// Kocaeli — il düzeyinde YÖNLENDİRİCİ sayfa (Faz 2 P2, Kocaeli V1).
// LOCAL_SOURCE_OF_TRUTH §7: Kocaeli sayfası Darıca'nın ve pillar sayfaların
// önüne geçmez. Tek fiziksel merkez Darıca'da; başka ilçede şube yok.
// Yapı: hero (görselsiz) → ilçelerden ulaşım → evde hizmet → konum kartı →
// kısa yollar → SSS → final CTA. Genel işitme cihazı rehberi içeriği
// (tür, fiyat, seçim, marka) kaldırıldı; kendi sayfalarına link verilir.
// Schema: aynı gerçek MedicalBusiness kaydı (areaServed: Darıca, Gebze,
// Çayırova, Kocaeli — src/lib/schema.ts). Dilovası/Tuzla/Pendik
// areaServed'de BİLİNÇLİ olarak yoktur; Kocaeli için ayrı adres yoktur.
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../ds/components/ui/atoms/Breadcrumb/Breadcrumb.astro";
import CorporateHero from "../components/shared/CorporateHero/CorporateHero.astro";
import ContactLocationCard from "../components/contact/ContactLocationCard/ContactLocationCard.astro";
import BrandPageFaq from "../components/brand-page/BrandPageFaq/BrandPageFaq.astro";
import BrandPageFinalCta from "../components/brand-page/BrandPageFinalCta/BrandPageFinalCta.astro";

import { kocaeliHero } from "../data/kocaeli/hero";
import { kocaeliDistricts, kocaeliHomeService, kocaeliShortcuts } from "../data/kocaeli/copy-blocks";
import { kocaeliLocation } from "../data/kocaeli/location";
import { kocaeliFaq } from "../data/kocaeli/faq";
import { kocaeliFinalCta } from "../data/kocaeli/final-cta";

import { buildMedicalBusinessSchema } from "../lib/schema";
import { contactHero } from "../data/contact/hero";

const PAGE_URL = "https://www.eniyicihaz.com/kocaeli-isitme-cihazlari/";

const breadcrumbItems = [
  { label: "Ana Sayfa", href: "/" },
  { label: "Kocaeli İşitme Cihazları", current: true },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, "https://www.eniyicihaz.com").toString() } : {}),
  })),
};

const medicalBusinessSchema = buildMedicalBusinessSchema(PAGE_URL, contactHero.definitionSentence);
---

<MainLayout
  title="Kocaeli İşitme Cihazları | Tek Merkezimiz Darıca'da"
  description="Tek fiziksel merkezimiz Darıca'da. Kocaeli'nin ilçelerinden otobüs hatları, adres, çalışma saatleri, yol tarifi ve Kocaeli genelinde evde hizmet bilgisi."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(medicalBusinessSchema)} />

  <div class="kocaeli-breadcrumb-wrap">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <CorporateHero data={kocaeliHero} />

  <section class="kocaeli-block" aria-labelledby="kocaeli-districts-title">
    <div class="kocaeli-block__inner">
      <p class="kocaeli-block__badge">{kocaeliDistricts.eyebrow}</p>
      <h2 class="kocaeli-block__heading" id="kocaeli-districts-title">{kocaeliDistricts.heading}</h2>
      <p class="kocaeli-block__text">{kocaeliDistricts.intro}</p>
      <ul class="kocaeli-districts">
        {kocaeliDistricts.items.map((d) => (
          <li class="kocaeli-districts__item">
            {d.href ? (
              <a class="kocaeli-districts__name kocaeli-districts__name--link" href={d.href}>{d.name}</a>
            ) : (
              <span class="kocaeli-districts__name">{d.name}</span>
            )}
            <span class="kocaeli-districts__lines"><span class="kocaeli-districts__lines-label">Hat</span> {d.lines}</span>
          </li>
        ))}
      </ul>
      <p class="kocaeli-block__note">{kocaeliDistricts.timeNote}</p>
    </div>
  </section>

  <section class="kocaeli-block kocaeli-block--alt" aria-labelledby="kocaeli-home-title">
    <div class="kocaeli-block__inner">
      <p class="kocaeli-block__badge">{kocaeliHomeService.eyebrow}</p>
      <h2 class="kocaeli-block__heading" id="kocaeli-home-title">{kocaeliHomeService.heading}</h2>
      <p class="kocaeli-block__text">{kocaeliHomeService.text}</p>
      <p class="kocaeli-block__text">
        <a class="kocaeli-link" href={kocaeliHomeService.href}>{kocaeliHomeService.linkLabel} →</a>
      </p>
    </div>
  </section>

  <ContactLocationCard data={kocaeliLocation} />

  <section class="kocaeli-block" aria-labelledby="kocaeli-shortcuts-title">
    <div class="kocaeli-block__inner">
      <p class="kocaeli-block__badge">{kocaeliShortcuts.eyebrow}</p>
      <h2 class="kocaeli-block__heading" id="kocaeli-shortcuts-title">{kocaeliShortcuts.heading}</h2>
      <ul class="kocaeli-shortcuts">
        {kocaeliShortcuts.items.map((item) => (
          <li><a class="kocaeli-shortcuts__link" href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <BrandPageFaq data={kocaeliFaq} />

  <BrandPageFinalCta data={kocaeliFinalCta} />
</MainLayout>

<style>
  .kocaeli-breadcrumb-wrap {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding: var(--space-6) var(--space-6) 0;
  }

  .kocaeli-block {
    background: var(--color-background);
    padding-block: var(--space-16);
  }

  .kocaeli-block--alt {
    background: var(--color-surface);
    padding-block: var(--space-12);
  }

  .kocaeli-block__inner {
    max-width: 42rem;
    margin-inline: auto;
    padding-inline: var(--space-6);
    text-align: center;
  }

  .kocaeli-block__badge {
    display: inline-block;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
  }

  .kocaeli-block__heading {
    margin: var(--space-4) 0 0;
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .kocaeli-block__text {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .kocaeli-block__note {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
  }

  .kocaeli-districts {
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }

  .kocaeli-districts__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 3rem;
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    text-align: left;
  }

  .kocaeli-districts__name {
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
  }

  .kocaeli-districts__name--link {
    color: var(--color-primary);
    text-decoration: none;
  }

  .kocaeli-districts__name--link:hover {
    text-decoration: underline;
  }

  .kocaeli-districts__lines {
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    text-align: right;
  }

  .kocaeli-districts__lines-label {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .kocaeli-shortcuts {
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .kocaeli-shortcuts__link,
  .kocaeli-link {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .kocaeli-shortcuts__link {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: var(--space-2) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
  }

  .kocaeli-shortcuts__link:hover,
  .kocaeli-link:hover,
  .kocaeli-districts__name--link:hover {
    text-decoration: underline;
  }

  .kocaeli-shortcuts__link:focus-visible,
  .kocaeli-link:focus-visible,
  .kocaeli-districts__name--link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  @media (max-width: 640px) {
    .kocaeli-block {
      padding-block: var(--space-10);
    }

    .kocaeli-block--alt {
      padding-block: var(--space-8);
    }
  }
</style>

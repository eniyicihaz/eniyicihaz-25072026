---
// "Bilgi Merkezi" — the page Header ▸ Bilgi Merkezi (top-level nav
// item) links to, mirroring /markalar's role for the Markalar item.
// Built up modularly using the same M1-M8 hub-page system /markalar
// pioneered (see src/components/brands/) — those 8 components are now
// generic (data prop instead of a fixed import), so this page supplies
// its own data/knowledge/* content while sharing the exact markup/CSS.
//
// M1 (Hero), M2 (Showcase: the 6 knowledgeMega "Rehberler" pages — the
// flagship educational guides), M3 (Criteria: which content category
// covers what), M4 (Decision: scenario-matching to a specific piece of
// content), M5 (Buying Guide: self-assessment questions before
// searching), M6 (Extended: the remaining 12 knowledgeMega pages — SGK
// & Haklar + Blog & Haberler), M7 (Expert Support) and M8 (FAQ) — M8 is
// the page's final section. Do not add later modules until they're
// specifically requested.
import MainLayout from "../layouts/MainLayout.astro";
import KnowledgeHero from "../components/brands/KnowledgeHero/KnowledgeHero.astro";
import BrandShowcase from "../components/brands/BrandShowcase/BrandShowcase.astro";
import BrandCriteria from "../components/brands/BrandCriteria/BrandCriteria.astro";
import BrandDecision from "../components/brands/BrandDecision/BrandDecision.astro";
import BrandBuyingGuide from "../components/brands/BrandBuyingGuide/BrandBuyingGuide.astro";
import BrandExtended from "../components/brands/BrandExtended/BrandExtended.astro";
import BrandExpertSupport from "../components/brands/BrandExpertSupport/BrandExpertSupport.astro";
import BrandFaq from "../components/brands/BrandFaq/BrandFaq.astro";

import { knowledgeHero } from "../data/knowledge/hero";
import { knowledgeHeroPanel } from "../data/knowledge/hero-panel";
import { knowledgeShowcase } from "../data/knowledge/showcase";
import { knowledgeCriteria } from "../data/knowledge/criteria";
import { knowledgeDecision } from "../data/knowledge/decision";
import { knowledgeBuyingGuide } from "../data/knowledge/buying-guide";
import { knowledgeExtended } from "../data/knowledge/extended";
import { knowledgeExpertSupport } from "../data/knowledge/expert-support";
import { knowledgeFaq } from "../data/knowledge/faq";
---

<MainLayout
  title="Bilgi Merkezi | İşitme Sağlığı Hakkında Her Şey"
  description="İşitme kaybından cihaz bakımına, SGK sürecinden güncel teknolojilere kadar tüm rehber ve içeriklerimizi tek sayfada keşfedin."
>
  <KnowledgeHero data={knowledgeHero} panel={knowledgeHeroPanel} />
  <BrandShowcase data={knowledgeShowcase} />
  <BrandCriteria data={knowledgeCriteria} />
  <BrandDecision data={knowledgeDecision} />
  <BrandBuyingGuide data={knowledgeBuyingGuide} />
  <BrandExtended data={knowledgeExtended} />
  <BrandExpertSupport data={knowledgeExpertSupport} />
  <BrandFaq data={knowledgeFaq} />
</MainLayout>

<style is:global>
  /* /bilgi-merkezi'ne özel kart düzeni. Bu blok yalnızca bu sayfanın CSS
     paketine girer; ortak BrandShowcase / BrandExtended diğer sayfalarda
     (hizmetlerimiz, markalar, isitme-cihazlari...) olduğu gibi kalır.
     Seçiciler `body` ile öne alınır: bileşenlerin kapsamlı (data-astro-cid)
     kuralları ve :hover kuralları aynı özgüllükte olduğundan. */

  /* Sticky header (~79px) hash hedeflerini örtmesin. */
  html {
    scroll-padding-top: var(--space-24);
  }

  /* --- 6 rehber kartı (BrandShowcase) ------------------------------------- */

  body .brand-showcase .brand-showcase__card {
    --tone: var(--color-primary);
    gap: var(--space-3);
    padding: var(--space-8) var(--space-6);
    background: var(--color-background);
    box-shadow: var(--shadow-xs);
  }

  body .brand-showcase .brand-showcase__card:hover,
  body .brand-showcase .brand-showcase__card:focus-visible {
    transform: translateY(-3px) !important;
    background: color-mix(in srgb, var(--tone) 4%, var(--color-background));
    border-color: var(--tone);
    box-shadow: var(--shadow-md);
  }

  body .brand-showcase .brand-showcase__card:focus-visible {
    box-shadow: var(--shadow-md), var(--focus-ring);
  }

  body .brand-showcase .brand-showcase__icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--tone) 10%, var(--color-background));
    color: var(--tone);
    opacity: 1;
    transition: background-color 300ms var(--bs-ease);
  }

  body .brand-showcase .brand-showcase__icon-wrap svg {
    width: 32px;
    height: 32px;
  }

  body .brand-showcase .brand-showcase__card:hover .brand-showcase__icon-wrap[class],
  body .brand-showcase .brand-showcase__card:focus-visible .brand-showcase__icon-wrap[class] {
    background: color-mix(in srgb, var(--tone) 16%, var(--color-background));
    color: var(--tone);
  }

  body .brand-showcase .brand-showcase__name {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    line-height: 1.3;
    color: var(--color-text);
  }

  /* "Rehberi Oku": normal durumda da görünür (bileşen varsayılanı gizli). */
  body .brand-showcase .brand-showcase__cta {
    opacity: 1;
    transform: none;
    color: var(--color-primary);
  }

  /* --- 12 kategori kartı (BrandExtended) ---------------------------------- */
  /* Renk, sıraya değil bağlantının kendisine bağlı: /sgk… = SGK ve haklar
     (turkuaz), /blog/ = blog ve haberler (amber). Sıra değişse de bozulmaz. */

  body .brand-extended .brand-extended__card {
    --tone: var(--color-primary);
    flex-direction: row;
    justify-content: flex-start;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--color-background);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xs);
    text-align: left;
  }

  body .brand-extended .brand-extended__card[href^="/sgk"] {
    --tone: #0f766e;
  }

  body .brand-extended .brand-extended__card[href^="/blog/"] {
    --tone: #b45309;
  }

  body .brand-extended .brand-extended__card:hover,
  body .brand-extended .brand-extended__card:focus-visible {
    transform: translateY(-2px) !important;
    background: color-mix(in srgb, var(--tone) 4%, var(--color-background));
    border-color: var(--tone);
    box-shadow: var(--shadow-md);
  }

  body .brand-extended .brand-extended__card:focus-visible {
    box-shadow: var(--shadow-md), var(--focus-ring);
  }

  body .brand-extended .brand-extended__icon-wrap {
    flex: none;
    align-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--tone) 10%, var(--color-background));
    color: var(--tone);
    opacity: 1;
    transition: background-color 300ms var(--be-ease);
  }

  body .brand-extended .brand-extended__icon-wrap svg {
    width: 28px;
    height: 28px;
  }

  body .brand-extended .brand-extended__card:hover .brand-extended__icon-wrap[class],
  body .brand-extended .brand-extended__card:focus-visible .brand-extended__icon-wrap[class] {
    background: color-mix(in srgb, var(--tone) 16%, var(--color-background));
    color: var(--tone);
  }

  body .brand-extended .brand-extended__name {
    min-width: 0;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    line-height: 1.3;
    color: var(--color-text);
  }

  @media (max-width: 1279px) {
    body .brand-extended .brand-extended__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 1023px) {
    body .brand-extended .brand-extended__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    body .brand-showcase .brand-showcase__card {
      padding: var(--space-6) var(--space-4);
    }

    body .brand-extended .brand-extended__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    body .brand-showcase .brand-showcase__card:hover,
    body .brand-showcase .brand-showcase__card:focus-visible,
    body .brand-extended .brand-extended__card:hover,
    body .brand-extended .brand-extended__card:focus-visible {
      transform: none !important;
    }

    body .brand-showcase .brand-showcase__icon-wrap,
    body .brand-extended .brand-extended__icon-wrap {
      transition: none;
    }
  }
</style>

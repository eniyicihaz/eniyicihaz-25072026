---
// Gebze İşitme Cihazı Hizmeti — /gebze-isitme-cihazlari.
//
// KRİTİK ÇERÇEVE (LOCAL_SOURCE_OF_TRUTH §5): Gebze'de fiziksel şube YOK.
// Sayfa "Gebze'den Darıca merkezimize" modeliyle yazıldı (P1-B): Gebze'den
// gelen kullanıcının gerçek soruları — nasıl gelinir (doğrulanmış otobüs
// hatları), merkez nerede, randevusuz gelinir mi, evde hizmet kapsıyor mu.
// Darıca sayfasıyla ortak olan genel şablon blokları (değerlendirme süreci,
// cihaz türleri, marka şeridi, SGK kartları, genel karar faktörleri)
// P1-B'de kaldırıldı; bu konular inline linklerle pillar sayfalara
// yönlendiriliyor. Yerel bilgi yoksa sayfa yapay olarak uzatılmıyor.
// CenterGallery kullanılmıyor (Gebze'de merkez fotoğrafı yok).
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../ds/components/ui/atoms/Breadcrumb/Breadcrumb.astro";
import CorporateHero from "../components/shared/CorporateHero/CorporateHero.astro";
import BrandCriteria from "../components/brands/BrandCriteria/BrandCriteria.astro";
import ContactLocationCard from "../components/contact/ContactLocationCard/ContactLocationCard.astro";
import BrandPageFaq from "../components/brand-page/BrandPageFaq/BrandPageFaq.astro";
import BrandPageFinalCta from "../components/brand-page/BrandPageFinalCta/BrandPageFinalCta.astro";

import { gebzeHero } from "../data/gebze/hero";
import { gebzeIntro, gebzeHomeService } from "../data/gebze/copy-blocks";
import { gebzeServices } from "../data/gebze/services";
import { gebzeLocation } from "../data/gebze/location";
import { gebzeFaq } from "../data/gebze/faq";
import { gebzeFinalCta } from "../data/gebze/final-cta";

import { buildMedicalBusinessSchema } from "../lib/schema";
import { contactHero } from "../data/contact/hero";

const PAGE_URL = "https://www.eniyicihaz.com/gebze-isitme-cihazlari/";

const breadcrumbItems = [
  { label: "Ana Sayfa", href: "/" },
  { label: "Gebze İşitme Cihazları", current: true },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, "https://www.eniyicihaz.com").toString() } : {}),
  })),
};

// Aynı kanonik tanım cümlesi + aynı gerçek MedicalBusiness kaydı (aynı
// @id, aynı gerçek Darıca adresi) — Gebze için AYRI bir işletme/adres
// ASLA oluşturulmadı. Gebze zaten `areaServed` dizisinde var (bkz.
// src/lib/schema.ts + src/data/contact/serviceArea.ts) — burada hiçbir
// değişiklik gerekmedi.
const medicalBusinessSchema = buildMedicalBusinessSchema(PAGE_URL, contactHero.definitionSentence);
---

<MainLayout
  title="Gebze İşitme Cihazları | Avrasya İşitme"
  description="Gebze'de işitme cihazı arıyorsanız doğru yerdesiniz. Ücretsiz değerlendirme, SGK desteği, marka seçenekleri ve cihaz deneme süreci hakkında bilgi alın."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(medicalBusinessSchema)} />

  <div class="gebze-breadcrumb-wrap">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <CorporateHero data={gebzeHero} />

  <section class="gebze-copy-block" aria-labelledby="gebze-intro-title">
    <div class="gebze-copy-block__inner">
      <p class="gebze-copy-block__badge">{gebzeIntro.badge}</p>
      <h2 class="gebze-copy-block__heading" id="gebze-intro-title">{gebzeIntro.heading}</h2>
      {gebzeIntro.paragraphs.map((p) => <p class="gebze-copy-block__paragraph">{p}</p>)}
    </div>
  </section>

  <p class="gebze-inline-link-wrap">
    <a class="gebze-inline-link" href="/degerlendirme/ucretsiz-isitme-testi/">Gelmeden önce ücretsiz işitme testi sürecini inceleyin →</a>
  </p>

  <BrandCriteria data={gebzeServices} />
  <p class="gebze-inline-link-wrap">
    <a class="gebze-inline-link" href="/sgk-isitme-cihazi-odemesi/">SGK ile işitme cihazı sürecini inceleyin →</a>
  </p>

  <section class="gebze-copy-block" aria-labelledby="gebze-home-service-title">
    <div class="gebze-copy-block__inner">
      <p class="gebze-copy-block__badge">{gebzeHomeService.badge}</p>
      <h2 class="gebze-copy-block__heading" id="gebze-home-service-title">{gebzeHomeService.heading}</h2>
      {gebzeHomeService.paragraphs.map((p) => <p class="gebze-copy-block__paragraph">{p}</p>)}
    </div>
  </section>
  <p class="gebze-inline-link-wrap">
    <a class="gebze-inline-link" href="/uygulama-ayar/evde-isitme-cihazi-hizmeti/">Evde işitme cihazı hizmetini inceleyin →</a>
  </p>

  <BrandPageFaq data={gebzeFaq} />

  <ContactLocationCard data={gebzeLocation} />
  <p class="gebze-inline-link-wrap">
    <a class="gebze-inline-link" href="/darica-isitme-cihazlari/">Darıca'daki merkezimizin sayfasını inceleyin →</a>
  </p>

  <BrandPageFinalCta data={gebzeFinalCta} />
</MainLayout>

<style>
  .gebze-breadcrumb-wrap {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding: var(--space-6) var(--space-6) 0;
  }

  /* Darıca sayfasının page-scoped "copy block" deseniyle birebir aynı
     (bkz. src/pages/darica-isitme-cihazlari.astro) — yeni
     bir shared component icat edilmedi, aynı DS token'ları kullanılıyor. */
  .gebze-copy-block {
    background: var(--color-background);
    padding-block: var(--space-16);
  }

  .gebze-copy-block__inner {
    max-width: 42rem;
    margin-inline: auto;
    padding-inline: var(--space-6);
    text-align: center;
  }

  .gebze-copy-block__badge {
    display: inline-block;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
  }

  .gebze-copy-block__heading {
    margin: var(--space-4) 0 0;
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .gebze-copy-block__paragraph {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .gebze-inline-link-wrap {
    margin: 0;
    padding: 0 var(--space-6) var(--space-4);
    max-width: var(--container-2xl);
    margin-inline: auto;
    text-align: center;
    background: var(--color-surface);
  }

  .gebze-inline-link-wrap:last-of-type {
    padding-bottom: var(--space-16);
  }

  .gebze-inline-link {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .gebze-inline-link:hover {
    text-decoration: underline;
  }

  .gebze-inline-link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  /* Brands'ın hemen altındaki tek satırlık, link içermeyen doğal not —
     ayrı bir bölüm/component değil, sadece kısa bir bağlam cümlesi. */
  .gebze-plain-note {
    margin: 0;
    padding: 0 var(--space-6) var(--space-16);
    max-width: var(--container-2xl);
    margin-inline: auto;
    text-align: center;
    background: var(--color-surface);
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .gebze-copy-block {
      padding-block: var(--space-10);
    }

    .gebze-inline-link-wrap:last-of-type {
      padding-bottom: var(--space-10);
    }

    .gebze-plain-note {
      padding-bottom: var(--space-10);
    }
  }
</style>

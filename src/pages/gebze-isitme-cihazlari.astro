---
// Gebze İşitme Cihazları — /gebze-isitme-cihazlari (Gebze nihai paket).
//
// KRİTİK ÇERÇEVE (LOCAL_SOURCE_OF_TRUTH §5): Gebze'de fiziksel şube YOK.
// Sayfa "Gebze'den Darıca'daki merkezimize" modelinde, Gebze'den arayanın karar
// yolculuğunu izler: Hero → Hizmetler (ücret/randevu/süre tablosu) → Ulaşım ve
// erişim + konum kartı → Gelmeden önce → SGK işlem desteği → Her işlem için
// gelmek gerekir mi? → İlk ziyaret → Fiyat → Satış sonrası → SSS → Son CTA.
// Hat numaraları [TIME-SENSITIVE]. Mesafe/güzergâh/otobüs süresi/ücret tutarı/
// hastane adı/metro uydurulmaz. Gebze için ayrı adres/NAP/schema yok;
// MedicalBusiness şeması Darıca'daki tek gerçek işletme kaydıdır (aynı @id).
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../ds/components/ui/atoms/Breadcrumb/Breadcrumb.astro";
import CorporateHero from "../components/shared/CorporateHero/CorporateHero.astro";
import ContactLocationCard from "../components/contact/ContactLocationCard/ContactLocationCard.astro";
import BrandPageFaq from "../components/brand-page/BrandPageFaq/BrandPageFaq.astro";
import BrandPageFinalCta from "../components/brand-page/BrandPageFinalCta/BrandPageFinalCta.astro";

import { gebzeHero } from "../data/gebze/hero";
import {
  gebzeServices,
  gebzeRoute,
  gebzeBeforeVisit,
  gebzeCtaAfterBefore,
  gebzeSgk,
  gebzeRemote,
  gebzeRemoteLinks,
  gebzeFirstVisit,
  gebzePrice,
  gebzeCtaAfterPrice,
  gebzeAfterSales,
} from "../data/gebze/copy-blocks";
import { contactConfig } from "../config/contact";
import { CTA_CALL, CTA_WHATSAPP } from "../lib/cta-labels";
import { gebzeLocation } from "../data/gebze/location";
import { gebzeFaq } from "../data/gebze/faq";
import { gebzeFinalCta } from "../data/gebze/final-cta";

import { buildMedicalBusinessSchema } from "../lib/schema";
import { contactHero } from "../data/contact/hero";

const PAGE_URL = "https://www.eniyicihaz.com/gebze-isitme-cihazlari/";

const breadcrumbItems = [
  { label: "Ana Sayfa", href: "/" },
  { label: "Gebze İşitme Cihazları", current: true },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, "https://www.eniyicihaz.com").toString() } : {}),
  })),
};

// Aynı kanonik tanım cümlesi + aynı gerçek MedicalBusiness kaydı (aynı
// @id, aynı gerçek Darıca adresi) — Gebze için AYRI bir işletme/adres
// ASLA oluşturulmadı.
const medicalBusinessSchema = buildMedicalBusinessSchema(PAGE_URL, contactHero.definitionSentence);
---

<MainLayout
  title="Gebze İşitme Cihazları: Test, SGK ve Ulaşım | Darıca Merkez"
  description="Merkezimiz Darıca'dadır; Gebze'de şubemiz yok. Gebze'den ulaşım, randevu, SGK işlem desteği, ücretsiz işitme testi ve evde hizmet seçeneklerini öğrenin."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(medicalBusinessSchema)} />

  <div class="gebze-breadcrumb-wrap">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <CorporateHero data={gebzeHero} />

  <section class="gebze-block gebze-services" aria-labelledby="gebze-services-title">
    <div class="gebze-block__inner gebze-block__inner--table">
      <p class="gebze-block__badge">{gebzeServices.eyebrow}</p>
      <h2 class="gebze-block__heading" id="gebze-services-title">{gebzeServices.heading}</h2>
      <p class="gebze-block__text">{gebzeServices.intro}</p>
      <div class="gebze-table-wrap">
        <table class="gebze-table">
          <thead>
            <tr>{gebzeServices.columns.map((col) => <th scope="col">{col}</th>)}</tr>
          </thead>
          <tbody>
            {gebzeServices.rows.map((row) => (
              <tr>
                {row.map((cell, i) => (
                  i === 0
                    ? <th scope="row">{cell}</th>
                    : <td data-label={gebzeServices.columns[i]}>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {gebzeServices.note && <p class="gebze-route__note">{gebzeServices.note}</p>}
    </div>
  </section>

  <section class="gebze-block gebze-route" aria-labelledby="gebze-route-title">
    <div class="gebze-block__inner">
      <p class="gebze-block__badge">{gebzeRoute.eyebrow}</p>
      <h2 class="gebze-block__heading" id="gebze-route-title">{gebzeRoute.heading}</h2>
      <p class="gebze-block__text">{gebzeRoute.landmark}</p>
      <ul class="gebze-route__lines" aria-label={gebzeRoute.linesLabel}>
        {gebzeRoute.lines.map((line) => (
          <li class="gebze-route__line">
            <span class="gebze-route__line-label">Hat</span>
            <span class="gebze-route__line-number">{line}</span>
          </li>
        ))}
      </ul>
      <p class="gebze-route__note">{gebzeRoute.timeNote}</p>
    </div>
  </section>

  <ContactLocationCard data={gebzeLocation} />
  <p class="gebze-links-row">
    <a class="gebze-link" href="/darica-isitme-cihazlari/">Darıca merkezimizin sayfası →</a>
    <a class="gebze-link" href="/iletisim/">İletişim sayfası →</a>
  </p>

  <section class="gebze-block gebze-before" aria-labelledby="gebze-before-title">
    <div class="gebze-block__inner gebze-block__inner--wide">
      <p class="gebze-block__badge">{gebzeBeforeVisit.eyebrow}</p>
      <h2 class="gebze-block__heading" id="gebze-before-title">{gebzeBeforeVisit.heading}</h2>
      <p class="gebze-block__text">{gebzeBeforeVisit.intro}</p>
      <ul class="gebze-points">
        {gebzeBeforeVisit.points.map((point) => <li>{point}</li>)}
      </ul>
      {gebzeBeforeVisit.note && <p class="gebze-route__note">{gebzeBeforeVisit.note}</p>}
      <div class="gebze-cta">
        <p class="gebze-cta__text">{gebzeCtaAfterBefore.text}</p>
        <div class="gebze-cta__actions">
          <a class="gebze-cta__btn gebze-cta__btn--solid" href={contactConfig.phone.href}>{CTA_CALL}</a>
          <a class="gebze-cta__btn" href={contactConfig.whatsapp.href}>{CTA_WHATSAPP}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="gebze-block gebze-sgk" aria-labelledby="gebze-sgk-title">
    <div class="gebze-block__inner gebze-block__inner--wide">
      <p class="gebze-block__badge">{gebzeSgk.eyebrow}</p>
      <h2 class="gebze-block__heading" id="gebze-sgk-title">{gebzeSgk.heading}</h2>
      <p class="gebze-block__text">{gebzeSgk.intro}</p>
      <ul class="gebze-points">
        {gebzeSgk.points.map((point) => <li>{point}</li>)}
      </ul>
      {gebzeSgk.note && <p class="gebze-route__note">{gebzeSgk.note}</p>}
      <p class="gebze-block__links">
        {gebzeSgk.links?.map((link) => <a class="gebze-link" href={link.href}>{link.label} →</a>)}
      </p>
    </div>
  </section>

  <section class="gebze-block gebze-remote" aria-labelledby="gebze-remote-title">
    <div class="gebze-block__inner gebze-block__inner--table">
      <p class="gebze-block__badge">{gebzeRemote.eyebrow}</p>
      <h2 class="gebze-block__heading" id="gebze-remote-title">{gebzeRemote.heading}</h2>
      <p class="gebze-block__text">{gebzeRemote.intro}</p>
      <div class="gebze-table-wrap">
        <table class="gebze-table gebze-table--wide">
          <thead>
            <tr>{gebzeRemote.columns.map((col) => <th scope="col">{col}</th>)}</tr>
          </thead>
          <tbody>
            {gebzeRemote.rows.map((row) => (
              <tr>
                {row.map((cell, i) => (
                  i === 0
                    ? <th scope="row">{cell}</th>
                    : <td data-label={gebzeRemote.columns[i]}>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {gebzeRemote.note && <p class="gebze-route__note">{gebzeRemote.note}</p>}
      <p class="gebze-block__links">
        {gebzeRemoteLinks.map((link) => <a class="gebze-link" href={link.href}>{link.label} →</a>)}
      </p>
    </div>
  </section>

  <section class="gebze-block gebze-first" aria-labelledby="gebze-first-title">
    <div class="gebze-block__inner gebze-block__inner--wide">
      <p class="gebze-block__badge">{gebzeFirstVisit.eyebrow}</p>
      <h2 class="gebze-block__heading" id="gebze-first-title">{gebzeFirstVisit.heading}</h2>
      <p class="gebze-block__text">{gebzeFirstVisit.intro}</p>
      <ol class="gebze-points gebze-points--steps">
        {gebzeFirstVisit.points.map((point) => <li>{point}</li>)}
      </ol>
      <p class="gebze-block__links">
        {gebzeFirstVisit.links?.map((link) => <a class="gebze-link" href={link.href}>{link.label} →</a>)}
      </p>
    </div>
  </section>

  <section class="gebze-block gebze-price" aria-labelledby="gebze-price-title">
    <div class="gebze-block__inner gebze-block__inner--wide">
      <p class="gebze-block__badge">{gebzePrice.eyebrow}</p>
      <h2 class="gebze-block__heading" id="gebze-price-title">{gebzePrice.heading}</h2>
      <p class="gebze-block__text">{gebzePrice.intro}</p>
      <ul class="gebze-points">
        {gebzePrice.points.map((point) => <li>{point}</li>)}
      </ul>
      <p class="gebze-block__links">
        {gebzePrice.links?.map((link) => <a class="gebze-link" href={link.href}>{link.label} →</a>)}
      </p>
      <div class="gebze-cta">
        <p class="gebze-cta__text">{gebzeCtaAfterPrice.text}</p>
        <div class="gebze-cta__actions">
          <a class="gebze-cta__btn gebze-cta__btn--solid" href={contactConfig.phone.href}>{CTA_CALL}</a>
          <a class="gebze-cta__btn" href={contactConfig.whatsapp.href}>{CTA_WHATSAPP}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="gebze-block gebze-after" aria-labelledby="gebze-after-title">
    <div class="gebze-block__inner gebze-block__inner--wide">
      <p class="gebze-block__badge">{gebzeAfterSales.eyebrow}</p>
      <h2 class="gebze-block__heading" id="gebze-after-title">{gebzeAfterSales.heading}</h2>
      <p class="gebze-block__text">{gebzeAfterSales.intro}</p>
      <ul class="gebze-points">
        {gebzeAfterSales.points.map((point) => <li>{point}</li>)}
      </ul>
      <p class="gebze-block__links">
        {gebzeAfterSales.links?.map((link) => <a class="gebze-link" href={link.href}>{link.label} →</a>)}
      </p>
    </div>
  </section>

  <BrandPageFaq data={gebzeFaq} />

  <BrandPageFinalCta data={gebzeFinalCta} />
</MainLayout>

<style>
  .gebze-breadcrumb-wrap {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding: var(--space-6) var(--space-6) 0;
  }

  .gebze-block {
    background: var(--color-background);
    padding-block: var(--space-16);
  }

  .gebze-services,
  .gebze-before,
  .gebze-remote,
  .gebze-price {
    background: var(--color-surface);
  }

  .gebze-block__inner {
    max-width: 42rem;
    margin-inline: auto;
    padding-inline: var(--space-6);
    text-align: center;
  }

  .gebze-block__inner--wide {
    max-width: 52rem;
  }

  .gebze-block__badge {
    display: inline-block;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
  }

  .gebze-block__heading {
    margin: var(--space-4) 0 0;
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .gebze-block__text {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  /* --- Hat rozetleri -------------------------------------------------- */
  .gebze-route__lines {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .gebze-route__line {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
  }

  .gebze-route__line-label {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .gebze-route__line-number {
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2rem);
    font-weight: var(--font-weight-bold);
    line-height: 1;
    color: var(--color-primary);
  }

  .gebze-route__note {
    margin: var(--space-6) 0 0;
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
  }

  /* --- Linkler (>=48px dokunma hedefi) --------------------------------- */
  .gebze-links-row {
    margin: 0;
    padding: 0 var(--space-6) var(--space-12);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-6);
    background: var(--color-surface);
  }

  .gebze-link {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .gebze-link--inline {
    display: inline-flex;
    margin-inline-start: var(--space-2);
  }

  .gebze-link:hover {
    text-decoration: underline;
  }

  .gebze-link:focus-visible,
  .gebze-shortcuts__link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  /* --- Kısa yollar ------------------------------------------------------ */
  .gebze-shortcuts__list {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .gebze-shortcuts__link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-background);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .gebze-shortcuts__link:hover {
    border-color: var(--color-primary);
  }

  .gebze-block__inner--table {
    max-width: 64rem;
  }

  /* --- Madde listeleri, tablolar, CTA şeridi ---------------------------- */
  .gebze-points {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    text-align: left;
  }

  .gebze-points li {
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-lg);
    background: var(--color-background);
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text);
  }

  .gebze-points--steps {
    counter-reset: gebze-step;
  }

  .gebze-points--steps li {
    counter-increment: gebze-step;
    position: relative;
    padding-left: var(--space-12);
  }

  .gebze-points--steps li::before {
    content: counter(gebze-step);
    position: absolute;
    left: var(--space-4);
    top: var(--space-4);
    width: 1.75rem;
    height: 1.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: #fff;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
  }

  .gebze-block__links {
    margin: var(--space-6) 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-6);
  }

  .gebze-table-wrap {
    margin-top: var(--space-8);
    text-align: left;
  }

  .gebze-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-background);
    font-size: var(--font-size-md);
  }

  .gebze-table th,
  .gebze-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
    line-height: var(--line-height-normal, 1.5);
    text-align: left;
    color: var(--color-text);
  }

  .gebze-table thead th {
    background: var(--color-surface);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .gebze-table tbody th {
    font-weight: var(--font-weight-semibold);
  }

  .gebze-table tbody tr:last-child th,
  .gebze-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .gebze-cta {
    margin-top: var(--space-8);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-background);
  }

  .gebze-cta__text {
    margin: 0;
    font-size: var(--font-size-md);
    color: var(--color-text);
  }

  .gebze-cta__actions {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .gebze-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 var(--space-6);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-lg);
    background: transparent;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .gebze-cta__btn--solid {
    background: var(--color-primary);
    color: #fff;
  }

  .gebze-cta__btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  @media (max-width: 720px) {
    .gebze-table,
    .gebze-table thead,
    .gebze-table tbody,
    .gebze-table tr,
    .gebze-table th,
    .gebze-table td {
      display: block;
    }

    .gebze-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .gebze-table tbody tr {
      padding: var(--space-3) 0;
      border-bottom: 1px solid var(--color-border);
    }

    .gebze-table tbody tr:last-child {
      border-bottom: 0;
    }

    .gebze-table th,
    .gebze-table td {
      border-bottom: 0;
      padding: var(--space-1) var(--space-4);
    }

    .gebze-table td::before {
      content: attr(data-label) ": ";
      font-weight: var(--font-weight-semibold);
      color: var(--color-text-muted);
    }

    .gebze-cta__btn {
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .gebze-block {
      padding-block: var(--space-10);
    }

    .gebze-route__lines {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gebze-shortcuts__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .gebze-links-row {
      padding-bottom: var(--space-8);
    }
  }
</style>

---
// Gebze İşitme Cihazları — /gebze-isitme-cihazlari (Faz 2 P2, Gebze V1).
//
// KRİTİK ÇERÇEVE (LOCAL_SOURCE_OF_TRUTH §5): Gebze'de fiziksel şube YOK.
// Sayfa tek soruya cevap verir: "Gebze'den Darıca'daki merkezinize nasıl
// gelirim?" Bölüm sırası: Hero → Ulaşım (hat rozetleri) → Konum kartı →
// Gelmeden önce → Kısa yollar → SSS (3 soru) → Son CTA. Cihaz türü/marka/
// model/deneme-ayar kartı/SGK anlatımı yok; bunlar pillar sayfalarda ve
// kısa yollar şeridinde link olarak.
// Hat numaraları [TIME-SENSITIVE] (LOCAL_SOT §5). Mesafe/süre/ücret/metro
// uydurulmaz. Gebze için ayrı adres/NAP/schema yok.
// Meta/schema/OG bu turda DEĞİŞTİRİLMEDİ (Faz 3).
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../ds/components/ui/atoms/Breadcrumb/Breadcrumb.astro";
import CorporateHero from "../components/shared/CorporateHero/CorporateHero.astro";
import ContactLocationCard from "../components/contact/ContactLocationCard/ContactLocationCard.astro";
import BrandPageFaq from "../components/brand-page/BrandPageFaq/BrandPageFaq.astro";
import BrandPageFinalCta from "../components/brand-page/BrandPageFinalCta/BrandPageFinalCta.astro";

import { gebzeHero } from "../data/gebze/hero";
import { gebzeRoute, gebzeBeforeVisit, gebzeShortcuts } from "../data/gebze/copy-blocks";
import { gebzeLocation } from "../data/gebze/location";
import { gebzeFaq } from "../data/gebze/faq";
import { gebzeFinalCta } from "../data/gebze/final-cta";

import { buildMedicalBusinessSchema } from "../lib/schema";
import { contactHero } from "../data/contact/hero";

const PAGE_URL = "https://www.eniyicihaz.com/gebze-isitme-cihazlari/";

const breadcrumbItems = [
  { label: "Ana Sayfa", href: "/" },
  { label: "Gebze İşitme Cihazları", current: true },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, "https://www.eniyicihaz.com").toString() } : {}),
  })),
};

// Aynı kanonik tanım cümlesi + aynı gerçek MedicalBusiness kaydı (aynı
// @id, aynı gerçek Darıca adresi) — Gebze için AYRI bir işletme/adres
// ASLA oluşturulmadı.
const medicalBusinessSchema = buildMedicalBusinessSchema(PAGE_URL, contactHero.definitionSentence);
---

<MainLayout
  title="Gebze İşitme Cihazları | Avrasya İşitme"
  description="Gebze'de işitme cihazı arıyorsanız doğru yerdesiniz. Ücretsiz değerlendirme, SGK desteği, marka seçenekleri ve cihaz deneme süreci hakkında bilgi alın."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(medicalBusinessSchema)} />

  <div class="gebze-breadcrumb-wrap">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <CorporateHero data={gebzeHero} />

  <section class="gebze-block gebze-route" aria-labelledby="gebze-route-title">
    <div class="gebze-block__inner">
      <p class="gebze-block__badge">{gebzeRoute.eyebrow}</p>
      <h2 class="gebze-block__heading" id="gebze-route-title">{gebzeRoute.heading}</h2>
      <p class="gebze-block__text">{gebzeRoute.landmark}</p>
      <ul class="gebze-route__lines" aria-label={gebzeRoute.linesLabel}>
        {gebzeRoute.lines.map((line) => (
          <li class="gebze-route__line">
            <span class="gebze-route__line-label">Hat</span>
            <span class="gebze-route__line-number">{line}</span>
          </li>
        ))}
      </ul>
      <p class="gebze-route__note">{gebzeRoute.timeNote}</p>
    </div>
  </section>

  <ContactLocationCard data={gebzeLocation} />
  <p class="gebze-links-row">
    <a class="gebze-link" href="/darica-isitme-cihazlari/">Darıca merkezimizin sayfası →</a>
    <a class="gebze-link" href="/iletisim/">İletişim sayfası →</a>
  </p>

  <section class="gebze-block gebze-before" aria-labelledby="gebze-before-title">
    <div class="gebze-block__inner">
      <p class="gebze-block__badge">{gebzeBeforeVisit.eyebrow}</p>
      <h2 class="gebze-block__heading" id="gebze-before-title">{gebzeBeforeVisit.heading}</h2>
      {gebzeBeforeVisit.points.map((p) => <p class="gebze-block__text">{p}</p>)}
      <p class="gebze-block__text">
        {gebzeBeforeVisit.homeService.text}
        <a class="gebze-link gebze-link--inline" href={gebzeBeforeVisit.homeService.href}>{gebzeBeforeVisit.homeService.linkLabel} →</a>
      </p>
    </div>
  </section>

  <section class="gebze-block gebze-shortcuts" aria-labelledby="gebze-shortcuts-title">
    <div class="gebze-block__inner gebze-block__inner--wide">
      <p class="gebze-block__badge">{gebzeShortcuts.eyebrow}</p>
      <h2 class="gebze-block__heading" id="gebze-shortcuts-title">{gebzeShortcuts.heading}</h2>
      <ul class="gebze-shortcuts__list">
        {gebzeShortcuts.items.map((item) => (
          <li>
            <a class="gebze-shortcuts__link" href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <BrandPageFaq data={gebzeFaq} />

  <BrandPageFinalCta data={gebzeFinalCta} />
</MainLayout>

<style>
  .gebze-breadcrumb-wrap {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding: var(--space-6) var(--space-6) 0;
  }

  .gebze-block {
    background: var(--color-background);
    padding-block: var(--space-16);
  }

  .gebze-before,
  .gebze-shortcuts {
    background: var(--color-surface);
  }

  .gebze-block__inner {
    max-width: 42rem;
    margin-inline: auto;
    padding-inline: var(--space-6);
    text-align: center;
  }

  .gebze-block__inner--wide {
    max-width: 52rem;
  }

  .gebze-block__badge {
    display: inline-block;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
  }

  .gebze-block__heading {
    margin: var(--space-4) 0 0;
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .gebze-block__text {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  /* --- Hat rozetleri -------------------------------------------------- */
  .gebze-route__lines {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .gebze-route__line {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
  }

  .gebze-route__line-label {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .gebze-route__line-number {
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2rem);
    font-weight: var(--font-weight-bold);
    line-height: 1;
    color: var(--color-primary);
  }

  .gebze-route__note {
    margin: var(--space-6) 0 0;
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
  }

  /* --- Linkler (>=48px dokunma hedefi) --------------------------------- */
  .gebze-links-row {
    margin: 0;
    padding: 0 var(--space-6) var(--space-12);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-6);
    background: var(--color-surface);
  }

  .gebze-link {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .gebze-link--inline {
    display: inline-flex;
    margin-inline-start: var(--space-2);
  }

  .gebze-link:hover {
    text-decoration: underline;
  }

  .gebze-link:focus-visible,
  .gebze-shortcuts__link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  /* --- Kısa yollar ------------------------------------------------------ */
  .gebze-shortcuts__list {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .gebze-shortcuts__link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-background);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .gebze-shortcuts__link:hover {
    border-color: var(--color-primary);
  }

  @media (max-width: 640px) {
    .gebze-block {
      padding-block: var(--space-10);
    }

    .gebze-route__lines {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gebze-shortcuts__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .gebze-links-row {
      padding-bottom: var(--space-8);
    }
  }
</style>

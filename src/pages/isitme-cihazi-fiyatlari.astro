---
// /isitme-cihazi-fiyatlari/ — "İşitme cihazı fiyatları" KONU MERKEZİ (topic
// hub), bir fiyat listesi değil. Bu sayfada uygulanan iskelet, sonraki tüm
// konu merkezi sayfalarının da şablonudur:
//
//   ARAMA NİYETİ → ANA SORGU → İLİŞKİLİ SORGULAR → KULLANICI SORULARI →
//   LOKAL BAĞLAM → KAPSAMLI VE ÖZGÜN CEVAP → İÇ BAĞLANTILAR → DÖNÜŞÜM
//
// Politika: site fiyat yayımlamaz/tahmin etmez (COMPANY.md §23, PRINCIPLES.md
// §5) ve Product/Offer şemasına fiyat girmez (QUALITY_GATES.md §4). TEK İSTİSNA
// bu sayfadır (DECISIONS K-Fiyat-1, 2026-10-11): onaylı başlangıç fiyatı ve taksit
// mesajı data/isitme-cihazi-fiyatlari/pricing.ts'ten gelir ve hero, kısa cevap,
// "Fiyat ve Ödeme Seçenekleri" bölümü ile SSS'te kullanılır; model bazında fiyat
// listesi yoktur ve hiçbir şemaya fiyat yazılmaz. Video yok.
//
// Hero: sayfaya özel PriceGuideHero (ortak GuideHero değişmez). Tablolar: ortak
// GuideTable'ın opt-in `variant="enhanced"` + `mobile="stack"` modu (varsayılan
// görünüm diğer sayfalarda aynen kalır).
//
// İçerik data/isitme-cihazi-fiyatlari/* altındadır; görünüm mevcut
// componentlerin (MainLayout, Breadcrumb, BrandPageFaq, BrandPageModels,
// BrandPageRelatedContent, Brands, ContactLocationCard, CtaButton,
// ImagePlaceholder) yeniden kullanımı + components/price-guide/* ile kurulur.
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../ds/components/ui/atoms/Breadcrumb/Breadcrumb.astro";
import Brands from "../components/brands/Brands/Brands.astro";
import BrandPageModels from "../components/brand-page/BrandPageModels/BrandPageModels.astro";
import BrandPageFaq from "../components/brand-page/BrandPageFaq/BrandPageFaq.astro";
import BrandPageRelatedContent from "../components/brand-page/BrandPageRelatedContent/BrandPageRelatedContent.astro";
import ContactLocationCard from "../components/contact/ContactLocationCard/ContactLocationCard.astro";

import PriceGuideHero from "../components/price-guide/PriceGuideHero.astro";
import GuideToc from "../components/price-guide/GuideToc.astro";
import DirectAnswer from "../components/price-guide/DirectAnswer.astro";
import GuideSection from "../components/price-guide/GuideSection.astro";
import InfoGrid from "../components/price-guide/InfoGrid.astro";
import GuideTable from "../components/price-guide/GuideTable.astro";
import DeviceTypeCards from "../components/price-guide/DeviceTypeCards.astro";
import QaStack from "../components/price-guide/QaStack.astro";
import GuideNotice from "../components/price-guide/GuideNotice.astro";
import GuideCta from "../components/price-guide/GuideCta.astro";

import { buildMedicalBusinessSchema } from "../lib/schema";
import { daricaLocation } from "../data/darica/location";
import { pageMeta, breadcrumbItems, toc, PAGE_URL } from "../data/isitme-cihazi-fiyatlari/page";
import { priceGuideHero } from "../data/isitme-cihazi-fiyatlari/hero";
import { quickAnswer } from "../data/isitme-cihazi-fiyatlari/quick-answer";
import {
  paymentSection, paymentCards, paymentNote, paymentLinks, aiTechNote, aiTechLinks,
} from "../data/isitme-cihazi-fiyatlari/payment";
import {
  factorsSection, factors, totalCostSection, totalCost, totalCostInsight, techLevelsTable,
} from "../data/isitme-cihazi-fiyatlari/factors";
import { deviceTypesSection, deviceTypes } from "../data/isitme-cihazi-fiyatlari/device-types";
import {
  comparisonsSection, deviceTypesTable, priorityTable, chargingTable, featuresTable,
} from "../data/isitme-cihazi-fiyatlari/comparisons";
import { featuresSection, features, scenariosSection, scenarios } from "../data/isitme-cihazi-fiyatlari/features";
import { brandModelSection, brandLinks, brandNote, modelsShowcase } from "../data/isitme-cihazi-fiyatlari/brand-model";
import {
  buyingSection, buyingQuestions, lowPriceSection, lowPricePoints, lowPriceLinks,
} from "../data/isitme-cihazi-fiyatlari/buying-questions";
import {
  sgkSection, sgkBlocks, sgkLinks, sgkNote, includedSection, includedServices, includedNote,
} from "../data/isitme-cihazi-fiyatlari/sgk-included";
import { localSection, localContent } from "../data/isitme-cihazi-fiyatlari/local";
import { priceGuideFaq } from "../data/isitme-cihazi-fiyatlari/faq";
import { priceGuideRelated, priceGuideCta } from "../data/isitme-cihazi-fiyatlari/related-cta";

// Schema — yalnızca sayfada görünür olan gerçek bilgi. FAQPage şeması,
// görünür SSS verisinden BrandPageFaq içinde üretilir. Product/Offer/fiyat yok.
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, "https://www.eniyicihaz.com").toString() } : { item: PAGE_URL }),
  })),
};
const medicalBusinessSchema = buildMedicalBusinessSchema(PAGE_URL, pageMeta.schemaDescription);

// Darıca konum kartı — aynı gerçek veri, bu sayfaya uygun başlık.
const locationCard = {
  ...daricaLocation,
  eyebrow: "DARICA'DAKİ MERKEZİMİZ",
  heading: "Merkezimizin Adresi ve Çalışma Saatleri",
  intro: "Randevusuz gelebilirsiniz; işitme testi gibi hizmetler randevuyla verildiği için önce aramanız iyi olur.",
  addressNote: "Palandöken Eczanesi'nin üst katında, Farabi Devlet Hastanesi durağının karşısında.",
  largeTargets: true,
};
---

<MainLayout title={pageMeta.title} description={pageMeta.description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(medicalBusinessSchema)} />

  <div class="pg-breadcrumb">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <PriceGuideHero data={priceGuideHero} />
  <GuideToc links={toc} />

  <DirectAnswer data={quickAnswer} />

  <GuideSection {...paymentSection} tone="alt">
    <InfoGrid cards={paymentCards} columns={4} />
    <GuideNotice text={paymentNote} links={paymentLinks} />
  </GuideSection>

  <GuideSection {...factorsSection}>
    <InfoGrid cards={factors} columns={3} />
  </GuideSection>

  <GuideSection {...totalCostSection} tone="alt">
    <InfoGrid cards={totalCost} columns={4} />
    <GuideNotice text={totalCostInsight} />
  </GuideSection>

  <GuideSection id={techLevelsTable.id} eyebrow={techLevelsTable.eyebrow} heading={techLevelsTable.heading} intro={techLevelsTable.intro}>
    <GuideTable data={{ ...techLevelsTable, id: `${techLevelsTable.id}-tablo` }} bare variant="enhanced" mobile="stack" />
    <GuideNotice text={aiTechNote} links={aiTechLinks} />
  </GuideSection>

  <GuideSection {...deviceTypesSection} tone="alt">
    <DeviceTypeCards items={deviceTypes} />
  </GuideSection>

  <GuideSection {...comparisonsSection}>
    <GuideTable data={deviceTypesTable} variant="enhanced" mobile="stack" />
    <GuideTable data={priorityTable} variant="enhanced" mobile="stack" />
    <GuideTable data={chargingTable} variant="enhanced" mobile="stack" />
    <GuideTable data={featuresTable} variant="enhanced" mobile="stack" />
  </GuideSection>

  <GuideSection {...featuresSection} tone="alt">
    <InfoGrid cards={features} columns={4} />
  </GuideSection>

  <GuideSection {...scenariosSection}>
    <InfoGrid cards={scenarios} columns={3} />
  </GuideSection>

  <GuideSection {...brandModelSection} tone="alt">
    <div class="pg-brands">
      <Brands embedded />
    </div>
    <InfoGrid cards={brandLinks} columns={3} />
    <GuideNotice text={brandNote} links={[{ label: "Tüm markalar", href: "/markalar/" }]} />
  </GuideSection>
  <div class="pg-models">
    <BrandPageModels data={modelsShowcase} compact />
  </div>

  <GuideSection {...buyingSection} tone="alt">
    <QaStack items={buyingQuestions} />
  </GuideSection>

  <GuideSection {...lowPriceSection}>
    <GuideNotice points={lowPricePoints} links={lowPriceLinks} />
  </GuideSection>

  <GuideSection {...sgkSection} tone="alt">
    <InfoGrid cards={sgkBlocks} columns={3} />
    <GuideNotice text={sgkNote} links={sgkLinks} />
  </GuideSection>

  <GuideSection {...includedSection}>
    <InfoGrid cards={includedServices} columns={4} />
    <GuideNotice text={includedNote} />
  </GuideSection>

  <GuideSection {...localSection} tone="alt">
    <div class="pg-local">
      <div class="pg-local__main">
        {localContent.paragraphs.map((t) => <p class="pg-local__p">{t}</p>)}
        <ul class="pg-local__items">
          {localContent.items.map((it) => <li><strong>{it.title}.</strong> {it.text}</li>)}
        </ul>
      </div>
      <div class="pg-local__areas">
        <p class="pg-local__areas-text">{localContent.otherAreas}</p>
        <ul class="pg-local__links">
          {localContent.links.map((l) => <li><a class="pg-local__link" href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
    </div>
  </GuideSection>

  <ContactLocationCard data={locationCard} />

  <div id="sss" class="pg-anchor">
    <BrandPageFaq data={priceGuideFaq} />
  </div>

  <BrandPageRelatedContent data={priceGuideRelated} />

  <GuideCta data={priceGuideCta} />
</MainLayout>

<style>
  /* Yerel bölüm ("Darıca · Merkezimiz"): GuideSection başlığı kapsayıcının sol kenarına hizalıdır;
     içerik de aynı sol kenardan, aynı genişlikte başlar (önceden 42rem'lik ortalanmış bir blok ve
     ortalanmış metin, başlıktan kopuk ikinci bir sütun oluşturuyordu). ≥900 px: solda ziyaret
     metni + hazırlık listesi, sağda Gebze/Çayırova ve bağlantılar (üst hizalar aynı). Altında tek sütun. */
  .pg-local {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }

  .pg-local__main {
    display: grid;
    gap: var(--space-4);
    max-width: 44rem;
  }

  .pg-local__p {
    margin: 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .pg-local__items {
    margin: var(--space-2) 0 0;
    padding: var(--space-5) 0 0;
    list-style: none;
    display: grid;
    gap: var(--space-3);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    line-height: var(--line-height-relaxed);
  }

  .pg-local__items li {
    position: relative;
    padding-left: var(--space-6);
  }

  /* Liste işareti: dekoratif nokta (anlam metindedir). */
  .pg-local__items li::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 0.65em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .pg-local__items strong {
    color: var(--color-text);
  }

  .pg-local__areas {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-background);
  }

  .pg-local__areas-text {
    margin: 0;
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .pg-local__links {
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (min-width: 900px) {
    .pg-local {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: var(--space-12);
    }
  }

  .pg-local__link {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: var(--space-2) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .pg-local__link:hover {
    text-decoration: underline;
  }

  .pg-local__link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  .pg-breadcrumb {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding: var(--space-4) var(--space-6) 0;
  }

  .pg-brands {
    margin-bottom: var(--space-8);
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-border);
    overflow: hidden;
  }

  .pg-brands + :global(.info-grid) {
    margin-top: 0;
  }

  /* "Fiyat ve Ödeme" bölümü eklenince bölüm ritmi kaydı: marka bölümü artık "alt" tonda, model vitrini beyaz. */
  .pg-models {
    background: var(--color-background);
  }

  .pg-anchor {
    scroll-margin-top: calc(var(--space-16) + var(--space-4));
  }

  @media (max-width: 640px) {
    .pg-breadcrumb {
      padding-inline: var(--space-4);
    }

    .pg-local__p {
      font-size: var(--font-size-md);
    }

    .pg-local__areas {
      padding: var(--space-5);
    }
  }
</style>

---
// Ana Sayfa — Faz 2 P2 (onay V1) yapısı, 8 bölüm:
// 1 HomeHero (tek statik hero; 6 slaytlı carousel kaldırıldı)
// → 2 HomeLocal (Merkezimiz ve Ulaşım)
// → 3 HomeJourney (Ana hizmet yolları)
// → 4 HomeTrust (Güven / kurumsal bilgiler)
// → 5 HomeExplore (İşitme cihazları ve markalar kısa özeti)
// → 6 HomeStory (ses odası deneyimi)
// → 7 HomeKnowledge (Bilgi Merkezi + SSS)
// → 8 Closing.
// BuyingCriteria, Chooser ve HomeShowroom (model vitrini) ana sayfadan
// kaldırıldı; ayrıntılı seçim kriterleri ve karşılaştırmalar kendi pillar
// sayfalarında kalır. Title/description ve schema bu adımda değişmedi.
import MainLayout from "../layouts/MainLayout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeLocal from "../components/home/HomeLocal.astro";
import HomeJourney from "../components/home/HomeJourney.astro";
import HomeTrust from "../components/home/HomeTrust.astro";
import HomeExplore from "../components/home/HomeExplore.astro";
import HomeStory from "../components/home/HomeStory.astro";
import HomeKnowledge from "../components/home/HomeKnowledge.astro";
import Closing from "../components/closing/Closing/Closing.astro";

import { homeHero } from "../data/home/hero";
import { buildMedicalBusinessSchema } from "../lib/schema";

// Extends the sitewide Organization node (MainLayout.astro) via the same
// `@id` rather than redeclaring it — same real business, described more
// fully here, not a second entity (see src/lib/schema.ts). `description`
// is the same entity-definition sentence the previous Hero slide 1 used
// (kept verbatim in data/home/hero.ts), so the structured data output is
// unchanged in this step.
const medicalBusinessSchema = buildMedicalBusinessSchema(
  "https://www.eniyicihaz.com/",
  homeHero.definitionSentence,
);
---

<MainLayout
  title="Avrasya İşitme Cihazları | Darıca, Kocaeli SGK Anlaşmalı Merkez"
  description="Avrasya İşitme Cihazları; Darıca, Kocaeli'de SGK anlaşmalı işitme merkezi. Ücretsiz işitme testi, cihaz uygulaması ve SGK danışmanlığı sunuyoruz."
>
  <script type="application/ld+json" set:html={JSON.stringify(medicalBusinessSchema)} />

  <HomeHero data={homeHero} />
  <HomeLocal />
  <HomeJourney />
  <HomeTrust />
  <HomeExplore />
  <HomeStory />
  <HomeKnowledge />
  <Closing />
</MainLayout>

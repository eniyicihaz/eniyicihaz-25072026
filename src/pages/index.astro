---
// Ana Sayfa — kurumsal yenileme (araştırma raporu R4 + proje kararı), 9 bölüm:
// 1 HomeHero (birincil CTA: Ücretsiz İşitme Testi; ikincil: telefon ve WhatsApp)
// → 2 HomeRouter (Size nasıl yardımcı olabiliriz? — niyete göre 6 kart)
// → 3 HomeTrust (güven / kurumsal bilgiler, yalnızca doğrulanmış olgular)
// → 4 HomeJourney (hizmetler: testten servise akış)
// → 5 HomeExplore (cihaz türleri ve markalar)
//   + BteViewer3D (markasız, temsili bir kulak arkası cihazın gerçek 3 boyutlu, sürükle-döndür görünümü; kod ve model tembel yüklenir)
// → 6 HomeLocal (Merkezimiz ve ulaşım)
// → 7 HomeStory (ses odası deneyimi)
// → 8 HomeKnowledge (Bilgi Merkezi + SSS)
// → 9 Closing (güçlü kapanış iletişim alanı).
// Eski sıradan fark: Merkez/ulaşım bloğu hizmetlerin önünden alındı (mobilde ilk hizmet kartına ulaşmak için üç
// ekran kaydırma gerekiyordu) ve niyet yönlendirme eklendi. Hiçbir mevcut bölüm veya içerik kaldırılmadı.
import MainLayout from "../layouts/MainLayout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeRouter from "../components/home/HomeRouter.astro";
import HomeLocal from "../components/home/HomeLocal.astro";
import HomeJourney from "../components/home/HomeJourney.astro";
import HomeTrust from "../components/home/HomeTrust.astro";
import HomeExplore from "../components/home/HomeExplore.astro";
import HomeStory from "../components/home/HomeStory.astro";
import HomeKnowledge from "../components/home/HomeKnowledge.astro";
import Closing from "../components/closing/Closing/Closing.astro";
import BteViewer3D from "../components/bte3d/BteViewer3D.astro";

import { homeHero } from "../data/home/hero";
import { buildMedicalBusinessSchema, ORGANIZATION_ID, WEBSITE_ID } from "../lib/schema";

// Extends the sitewide Organization node (MainLayout.astro) via the same
// `@id` rather than redeclaring it — same real business, described more
// fully here, not a second entity (see src/lib/schema.ts). `description`
// is the same entity-definition sentence the previous Hero slide 1 used
// (kept verbatim in data/home/hero.ts), so the structured data output is
// unchanged in this step.
const medicalBusinessSchema = buildMedicalBusinessSchema(
  "https://www.eniyicihaz.com/",
  homeHero.definitionSentence,
);

// WebSite node — homepage only. It adds no business data of its own: it only
// points at the sitewide Organization node (MainLayout.astro) as publisher.
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": WEBSITE_ID,
  url: "https://www.eniyicihaz.com/",
  name: "Avrasya İşitme Cihazları",
  inLanguage: "tr",
  publisher: { "@id": ORGANIZATION_ID },
};
---

<MainLayout
  title="Avrasya İşitme Cihazları | Darıca, Kocaeli SGK Anlaşmalı Merkez"
  description="Avrasya İşitme Cihazları; Darıca, Kocaeli'de SGK anlaşmalı işitme merkezi. Ücretsiz işitme testi, cihaz uygulaması ve SGK danışmanlığı sunuyoruz."
>
  <script type="application/ld+json" set:html={JSON.stringify(medicalBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

  <HomeHero data={homeHero} />
  <HomeRouter />
  <HomeTrust />
  <HomeJourney />
  <HomeExplore />
  <BteViewer3D />
  <HomeLocal />
  <HomeStory />
  <HomeKnowledge />
  <Closing />
</MainLayout>

---
// Ana Sayfa — 10 ana bölümlü vitrin (2026-09 mimari karar: 20 bölümlü uzun
// sayfa yerine daha kısa, öz ve güçlü bir sayfa; detaylar alt sayfalara
// bırakıldı, içerik kaybı yok — tekrarlar ve bölüm ek yükü azaltıldı).
// Sıra: 1 Hero (dokunulmadı) → 2 HomeStory (Empathy + SoundRoom + Solution)
// → 3 BuyingCriteria → 4 HomeExplore (CategoryExplorer + DeviceComparison)
// → 5 Chooser → 6 HomeShowroom (Brands + Model Showcase) → 7 HomeJourney
// (Hizmetler + Guide + Service Journey) → 8 HomeLocal (Trust + CenterGallery
// + ServiceNetwork + SGK) → 9 HomeKnowledge (KnowledgeGate + FAQ) →
// 10 Closing. DailyLife artık render edilmiyor (component/data dosyaları
// ileride kullanım için duruyor). Title/description sayfaya özel.
import MainLayout from "../layouts/MainLayout.astro";
import Hero from "../components/hero/Hero/Hero.astro";
import HomeStory from "../components/home/HomeStory.astro";
import BuyingCriteria from "../components/buying-criteria/BuyingCriteria/BuyingCriteria.astro";
import HomeExplore from "../components/home/HomeExplore.astro";
import Chooser from "../components/chooser/Chooser/Chooser.astro";
import HomeShowroom from "../components/home/HomeShowroom.astro";
import HomeJourney from "../components/home/HomeJourney.astro";
import HomeLocal from "../components/home/HomeLocal.astro";
import HomeKnowledge from "../components/home/HomeKnowledge.astro";
import Closing from "../components/closing/Closing/Closing.astro";

import { hero } from "../components/hero/Hero/hero.data";
import { buildMedicalBusinessSchema } from "../lib/schema";

// Extends the sitewide Organization node (MainLayout.astro) via the same
// `@id` rather than redeclaring it — same real business, described more
// fully here, not a second entity (see src/lib/schema.ts). `description`
// reuses Hero slide 1's own entity-definition sentence verbatim (now
// hero.slides[0].body[0] under the 6-slide carousel data shape) so visible
// copy and structured data never say two different things (GEO
// non-contradiction, SEARCH_STRATEGY.md §9) — the same discipline already
// used on /iletisim.
const medicalBusinessSchema = buildMedicalBusinessSchema(
  "https://www.eniyicihaz.com/",
  hero.slides[0].body?.[0] ?? "",
);
---

<MainLayout
  title="Avrasya İşitme Cihazları | Darıca, Kocaeli SGK Anlaşmalı İşitme Merkezi | EniyiCihaz"
  description="Avrasya İşitme Cihazları; Darıca, Kocaeli'de SGK anlaşmalı işitme merkezi. Ücretsiz işitme testi, cihaz uygulaması ve SGK danışmanlığı sunuyoruz."
>
  <script type="application/ld+json" set:html={JSON.stringify(medicalBusinessSchema)} />

  <Hero />
  <HomeStory />
  <BuyingCriteria />
  <HomeExplore />
  <Chooser />
  <HomeShowroom />
  <HomeJourney />
  <HomeLocal />
  <HomeKnowledge />
  <Closing />
</MainLayout>

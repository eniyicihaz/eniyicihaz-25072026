---
// Ücretsiz İşitme Testi — /degerlendirme/ucretsiz-isitme-testi/ (URL DEĞİŞMEDİ).
// "İşitme testi" KONU MERKEZİ: test nedir, neden ve kimler için, nasıl yapılır, hangi
// ölçümler, ne kadar sürer, sonuç nasıl okunur (odyogram), test sonrası, online test
// farkı, çocuk/yaşlı ve Darıca / Gebze / Çayırova / Kocaeli'de işitme testi. Eski
// "Darıca'da Ücretsiz İşitme Testi" hizmet sayfası, aynı hub iskeletiyle
// (/isitme-cihazlari/, /isitme-cihazi-fiyatlari/, /isitme-cihazi-markalari/) yeniden
// yapılandırıldı; doğrulanmış içerik (5 aşamalı süreç, güvenlik uyarıları, online/merkez
// karşılaştırması, test sonrası, "Neden Avrasya İşitme", ContactLocationCard, doğru SSS
// cevapları) korunarak birleştirildi.
//
//   ARAMA SORGUSU → DOĞRUDAN CEVAP → AYRINTILI AÇIKLAMA → İLGİLİ SORULAR →
//   TABLO / GÖRSEL → YEREL BAĞLAM → İÇ BAĞLANTI → CTA
//
// Politika: tıbbi kesinlik / teşhis yok; ani kayıp, ağrı, akıntıda KBB uyarısı görünür
// (PRINCIPLES.md §5, §11). Fiyat yok; Product/Offer/HowTo/MedicalTest şeması yok.
// Gebze/Çayırova'da şube iddiası yok (COMPANY.md §17). Doğrulanmamış vaatler ("aynı gün
// sonuç", kesin süre, ücretsiz kapsamın ek testleri, çocuk/yaş sınırı) YAZILMADI.
// Video yok. Marka tanıtımı yok (→ /isitme-cihazi-markalari/). Odyogram, gerçek sonuç
// içermeyen, erişilebilir bir SVG şemasıdır (components/hearing-test/).
// Görünüm mevcut componentlerin yeniden kullanımıdır (price-guide/*, ProcessTimeline,
// ContactLocationCard, BrandPageFaq, BrandPageRelatedContent); yeni yalnızca
// AudiogramDiagram. İçerik data/ucretsiz-isitme-testi/* altındadır.
import { TriangleAlert } from "lucide-astro";
import { Phone, MessageCircle, Headphones, UserCheck } from "lucide-astro";
import MainLayout from "../../layouts/MainLayout.astro";
import Breadcrumb from "../../ds/components/ui/atoms/Breadcrumb/Breadcrumb.astro";
import ProcessTimeline from "../../components/shared/ProcessTimeline/ProcessTimeline.astro";
import ContactLocationCard from "../../components/contact/ContactLocationCard/ContactLocationCard.astro";
import BrandPageFaq from "../../components/brand-page/BrandPageFaq/BrandPageFaq.astro";
import BrandPageRelatedContent from "../../components/brand-page/BrandPageRelatedContent/BrandPageRelatedContent.astro";

import GuideHero from "../../components/price-guide/GuideHero.astro";
import GuideToc from "../../components/price-guide/GuideToc.astro";
import DirectAnswer from "../../components/price-guide/DirectAnswer.astro";
import GuideSection from "../../components/price-guide/GuideSection.astro";
import InfoGrid from "../../components/price-guide/InfoGrid.astro";
import GuideTable from "../../components/price-guide/GuideTable.astro";
import GuideNotice from "../../components/price-guide/GuideNotice.astro";
import LocalBlocks from "../../components/price-guide/LocalBlocks.astro";
import GuideCta from "../../components/price-guide/GuideCta.astro";
import AudiogramDiagram from "../../components/hearing-test/AudiogramDiagram.astro";

import { buildMedicalBusinessSchema } from "../../lib/schema";
import { pageMeta, breadcrumbItems, toc, PAGE_URL } from "../../data/ucretsiz-isitme-testi/page";
import { testHero, testHeroExtra } from "../../data/ucretsiz-isitme-testi/hero";
import { testQuickAnswer, basicsCards } from "../../data/ucretsiz-isitme-testi/answer";
import {
  whySection, whyCards, whenSection, signsCards, noiseCard, contextCards, entSection, entPoints, entNote,
} from "../../data/ucretsiz-isitme-testi/reasons";
import { freeTestSection, freeTestTable, trustCards } from "../../data/ucretsiz-isitme-testi/free-test";
import { howProcess, howDetails } from "../../data/ucretsiz-isitme-testi/how";
import {
  measureSection, measureCards, measureTable, prepareSection, prepareCards, durationSection, durationPoints,
} from "../../data/ucretsiz-isitme-testi/measurements";
import { resultsSection, audiogram, resultsCards, degreeTable, resultsNotice } from "../../data/ucretsiz-isitme-testi/results";
import {
  afterSection, afterCards, afterLinks, deviceTestSection, deviceTestPoints, deviceTestLinks,
  onlineSection, onlineTable, childrenSection, childrenCards, elderlySection, elderlyCards,
} from "../../data/ucretsiz-isitme-testi/after";
import { localBlocks } from "../../data/ucretsiz-isitme-testi/local";
import { ucretsizIsitmeTestiLocation } from "../../data/ucretsiz-isitme-testi/location";
import { testFaq } from "../../data/ucretsiz-isitme-testi/faq";
import { testCta, testRelated } from "../../data/ucretsiz-isitme-testi/cta-related";

// Schema — yalnızca sayfada görünür olan gerçek bilgi. FAQPage şeması, görünür SSS
// verisinden BrandPageFaq içinde üretilir. Ortak MedicalBusiness builder'ı, sitenin
// tek gerçek işletme varlığını (@id ortak) tanımlar; doktor/hastane/klinik/ürün/fiyat yok.
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, "https://www.eniyicihaz.com").toString() } : { item: PAGE_URL }),
  })),
};
const medicalBusinessSchema = buildMedicalBusinessSchema(PAGE_URL, pageMeta.schemaDescription);

const noticeLinks = (cards: { href?: string; linkLabel?: string }[]) =>
  cards.filter((c) => c.href).map((c) => ({ label: c.linkLabel ?? "Devamı", href: c.href as string }));
---

<MainLayout title={pageMeta.title} description={pageMeta.description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(medicalBusinessSchema)} />

  <div class="uit-breadcrumb">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <GuideHero data={testHero} extraCta={testHeroExtra} />
  <GuideToc links={toc} />

  <!-- 1. İşitme testi nedir? (kısa cevap + devamı) -->
  <DirectAnswer data={testQuickAnswer} />
  <div class="uit-cont">
    <InfoGrid cards={basicsCards} columns={2} headingLevel="h3" />
  </div>

  <!-- 2. Neden yapılır? -->
  <GuideSection {...whySection} tone="alt">
    <InfoGrid cards={whyCards} columns={4} />
  </GuideSection>

  <!-- 3. Ne zaman yaptırmalısınız? -->
  <GuideSection {...whenSection}>
    <h3 class="uit-h3">İşitme kaybı düşündürebilecek belirtiler</h3>
    <InfoGrid cards={signsCards} columns={3} headingLevel="h4" />

    <h3 class="uit-h3">Gürültüye maruz kalma</h3>
    <p class="uit-p">{noiseCard.text}</p>

    <h3 class="uit-h3">Yaş, aile öyküsü ve diğer durumlar</h3>
    <InfoGrid cards={contextCards} columns={3} headingLevel="h4" />

    <GuideNotice
      text="İşitmenizi merak ediyorsanız test için beklemeyin; bir randevuyla işitme durumunuzu birlikte değerlendirebiliriz."
      links={[{ label: "Randevu ve iletişim", href: "/iletisim/" }, { label: "İşitme kaybı nedir?", href: "/rehberler/isitme-kaybi-nedir/" }]}
    />
  </GuideSection>

  <!-- 4. KBB uyarısı (görünür güvenlik bölümü) -->
  <GuideSection {...entSection} tone="alt">
    <div class="uit-alert" role="note" aria-label="Tıbbi uyarı">
      <div class="uit-alert__head">
        <TriangleAlert size={22} stroke-width={2} aria-hidden="true" />
        <p>Aşağıdaki durumlarda önce bir KBB uzmanına veya sağlık kuruluşuna başvurun.</p>
      </div>
      <ul class="uit-alert__list">
        {
          entPoints.map((p) => (
            <li>
              <strong>{p.title}</strong>
              <span>{p.text}</span>
            </li>
          ))
        }
      </ul>
      <p class="uit-alert__note">{entNote}</p>
    </div>
  </GuideSection>

  <!-- 5. Ücretsiz işitme testi nedir, neleri kapsar? -->
  <GuideSection {...freeTestSection}>
    <GuideTable data={freeTestTable} />
    <div class="uit-spaced">
      <InfoGrid cards={trustCards} columns={3} />
    </div>
  </GuideSection>

  <!-- 6. İşitme testi nasıl yapılır? -->
  <div id="nasil-yapilir" class="uit-anchor">
    <ProcessTimeline data={howProcess} />
  </div>
  <div class="uit-cont">
    <InfoGrid cards={howDetails} columns={4} headingLevel="h3" />
  </div>

  <!-- 7. Hangi ölçümler yapılır? -->
  <GuideSection {...measureSection} tone="alt">
    <InfoGrid cards={measureCards} columns={4} />
    <div class="uit-spaced">
      <GuideTable data={measureTable} />
    </div>
  </GuideSection>

  <!-- 8. Hazırlık -->
  <GuideSection {...prepareSection}>
    <InfoGrid cards={prepareCards} columns={3} />
  </GuideSection>

  <!-- 9. Ne kadar sürer? -->
  <GuideSection {...durationSection} tone="alt">
    <GuideNotice points={durationPoints} />
  </GuideSection>

  <!-- 10. Sonuç nasıl okunur? (odyogram) -->
  <GuideSection {...resultsSection}>
    <div class="uit-audiogram">
      <AudiogramDiagram data={audiogram} />
    </div>
    <div class="uit-spaced">
      <InfoGrid cards={resultsCards} columns={3} />
    </div>
    <div class="uit-spaced">
      <GuideTable data={degreeTable} />
    </div>
    <GuideNotice text={resultsNotice} links={[{ label: "Odyometri", href: "/degerlendirme/odyometri/" }, { label: "İşitme kaybı nedir?", href: "/rehberler/isitme-kaybi-nedir/" }]} />
  </GuideSection>

  <!-- 11. Test sonrası -->
  <GuideSection {...afterSection} tone="alt">
    <InfoGrid cards={afterCards} columns={4} />
    <GuideNotice text="Cihaz gündeme gelirse şu rehberlerden ayrıntı bulabilirsiniz." links={afterLinks} />
  </GuideSection>

  <!-- 12. İşitme cihazı için test gerekli mi? -->
  <GuideSection {...deviceTestSection}>
    <GuideNotice points={deviceTestPoints} links={deviceTestLinks} />
  </GuideSection>

  <!-- 13. Online test farkı -->
  <GuideSection {...onlineSection} tone="alt">
    <GuideTable data={onlineTable} bare />
  </GuideSection>

  <!-- 14. Çocuklarda -->
  <GuideSection {...childrenSection}>
    <GuideNotice text={childrenCards[0].text} links={noticeLinks(childrenCards)} />
  </GuideSection>

  <!-- 15. Yaşlılarda -->
  <GuideSection {...elderlySection} tone="alt">
    <GuideNotice text={elderlyCards[0].text} links={noticeLinks(elderlyCards)} />
  </GuideSection>

  <!-- 16–19. Yerel bölümler: Darıca (ana merkez) → Gebze → Çayırova → Kocaeli -->
  <div class="uit-local">
    <LocalBlocks blocks={localBlocks} headingLevel="h2" />
  </div>

  <!-- 20. Merkezimize ulaşın -->
  <ContactLocationCard data={ucretsizIsitmeTestiLocation} />

  <!-- 21. SSS -->
  <div id="sss" class="uit-anchor">
    <BrandPageFaq data={testFaq} />
  </div>

  <!-- 22. Final CTA + ilgili içerikler -->
  <GuideCta data={testCta} icons={[Phone, MessageCircle, Headphones, UserCheck]} />
  <BrandPageRelatedContent data={testRelated} />
</MainLayout>

<style>
  .uit-breadcrumb {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding: var(--space-4) var(--space-6) 0;
  }

  /* Continuation of the "İşitme testi nedir?" / "nasıl yapılır?" sections: H3 cards
     that live directly under the section's own H2 block. */
  .uit-cont {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding: var(--space-8) var(--space-6) var(--space-16);
  }

  .uit-h3 {
    margin: var(--space-10) 0 var(--space-4);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .uit-h3:first-of-type {
    margin-top: 0;
  }

  .uit-p {
    margin: 0;
    max-width: 46rem;
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .uit-spaced {
    margin-top: var(--space-8);
  }

  .uit-audiogram {
    max-width: 52rem;
    margin-inline: auto;
  }

  .uit-anchor {
    scroll-margin-top: calc(var(--space-16) + var(--space-4));
  }

  /* Medical safety block — deliberately more visible than the calm GuideNotice. */
  .uit-alert {
    border: 1px solid #f5c26b;
    border-left-width: 6px;
    border-radius: var(--radius-xl);
    background: #fff8ea;
    padding: var(--space-6);
    color: #4a3200;
  }

  .uit-alert__head {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    color: #8a5a00;
  }

  .uit-alert__head :global(svg) {
    flex: none;
    margin-top: 2px;
  }

  .uit-alert__head p {
    margin: 0;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: #6b4300;
  }

  .uit-alert__list {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-4);
  }

  .uit-alert__list li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid #f0d9a8;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: #4a3200;
  }

  .uit-alert__list strong {
    font-size: var(--font-size-md);
    color: #3b2700;
  }

  .uit-alert__note {
    margin: var(--space-5) 0 0;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
  }

  @media (max-width: 640px) {
    .uit-breadcrumb {
      padding-inline: var(--space-4);
    }

    .uit-cont {
      padding: var(--space-6) var(--space-4) var(--space-10);
    }

    .uit-alert {
      padding: var(--space-4);
    }
  }
</style>

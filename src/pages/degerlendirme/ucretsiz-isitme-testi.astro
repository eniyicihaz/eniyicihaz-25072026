---
// Ücretsiz İşitme Testi — /degerlendirme/ucretsiz-isitme-testi/ (URL DEĞİŞMEDİ).
// "İşitme testi" KONU MERKEZİ: test nedir, ne için ve ne zaman, KBB uyarısı, nasıl yapılır
// (hazırlık + süre dahil), hangi değerlendirmeler, ücretsiz test, sonuç nasıl okunur (odyogram),
// test sonrası (cihaz dahil), evde/online test, çocuk ve yaşlı, Darıca merkezi ve ulaşım.
//
// EDİTORYAL SADELEŞTİRME (kapsam korunarak): aynı bilgiyi farklı başlıklarla yeniden anlatan
// bölümler birleştirildi — neden+ne zaman tek bölüm; 5 adım + detay kartları tek zaman çizelgesi;
// hazırlık ve süre "nasıl yapılır" altında H3; ücretsiz tablosu + ölçüm tabloları tek tablo;
// test sonrası + cihaz tek bölüm; çocuk + yaşlı tek bölüm; Darıca/Gebze/Çayırova/Kocaeli/ulaşım
// tek yerel bölüm; SSS yalnızca sayfada cevaplanmamış sorular; tek kapanış CTA (iletişim kartı).
//
//   ARAMA SORGUSU → DOĞRUDAN CEVAP → AYRINTILI AÇIKLAMA → TABLO / GÖRSEL → YEREL BAĞLAM →
//   İÇ BAĞLANTI → CTA
//
// Politika: tıbbi kesinlik / teşhis yok; ani kayıp, ağrı, akıntıda KBB uyarısı görünür
// (PRINCIPLES.md §5, §11). Fiyat yok; Product/Offer/HowTo/MedicalTest şeması yok.
// Gebze/Çayırova'da şube iddiası yok (COMPANY.md §17). Doğrulanmamış vaatler ("aynı gün
// sonuç", kesin süre, ücretsiz kapsamın ek testleri, ses yalıtımı, kalibre cihaz) YAZILMADI.
// Video yok. Marka tanıtımı yok (→ /isitme-cihazi-markalari/). Odyogram, gerçek sonuç
// içermeyen, erişilebilir bir SVG şemasıdır (components/hearing-test/).
// Görünüm mevcut componentlerin yeniden kullanımıdır (price-guide/*, ProcessTimeline,
// ContactLocationCard, BrandPageFaq, BrandPageRelatedContent); yeni yalnızca
// AudiogramDiagram. İçerik data/ucretsiz-isitme-testi/* altındadır.
import { TriangleAlert } from "lucide-astro";
import MainLayout from "../../layouts/MainLayout.astro";
import Breadcrumb from "../../ds/components/ui/atoms/Breadcrumb/Breadcrumb.astro";
import ProcessTimeline from "../../components/shared/ProcessTimeline/ProcessTimeline.astro";
import ContactLocationCard from "../../components/contact/ContactLocationCard/ContactLocationCard.astro";
import BrandPageFaq from "../../components/brand-page/BrandPageFaq/BrandPageFaq.astro";
import BrandPageRelatedContent from "../../components/brand-page/BrandPageRelatedContent/BrandPageRelatedContent.astro";

import GuideHero from "../../components/price-guide/GuideHero.astro";
import GuideToc from "../../components/price-guide/GuideToc.astro";
import DirectAnswer from "../../components/price-guide/DirectAnswer.astro";
import GuideSection from "../../components/price-guide/GuideSection.astro";
import InfoGrid from "../../components/price-guide/InfoGrid.astro";
import GuideTable from "../../components/price-guide/GuideTable.astro";
import GuideNotice from "../../components/price-guide/GuideNotice.astro";
import LocalBlocks from "../../components/price-guide/LocalBlocks.astro";
import AudiogramDiagram from "../../components/hearing-test/AudiogramDiagram.astro";

import { buildMedicalBusinessSchema } from "../../lib/schema";
import { pageMeta, breadcrumbItems, toc, PAGE_URL } from "../../data/ucretsiz-isitme-testi/page";
import { testHero, testHeroExtra } from "../../data/ucretsiz-isitme-testi/hero";
import { testQuickAnswer, basicsCards } from "../../data/ucretsiz-isitme-testi/answer";
import {
  whenSection, purposeText, signsCards, contextCards, entSection, entPoints, entNote,
} from "../../data/ucretsiz-isitme-testi/reasons";
import { freeTestSection, freeTestCards } from "../../data/ucretsiz-isitme-testi/free-test";
import { howProcess } from "../../data/ucretsiz-isitme-testi/how";
import {
  measureSection, measureCards, measureTable, prepareHeading, prepareIntro, prepareCards,
  durationHeading, durationIntro, durationPoints,
} from "../../data/ucretsiz-isitme-testi/measurements";
import { resultsSection, audiogram, resultsCards, degreeTable, resultsNotice } from "../../data/ucretsiz-isitme-testi/results";
import {
  afterSection, afterCards, afterLinks, onlineSection, onlineTable,
  ageSection, childrenText, childrenLinks, elderlyText, elderlyLinks,
} from "../../data/ucretsiz-isitme-testi/after";
import { localSection, localBlocks } from "../../data/ucretsiz-isitme-testi/local";
import { ucretsizIsitmeTestiLocation } from "../../data/ucretsiz-isitme-testi/location";
import { testFaq } from "../../data/ucretsiz-isitme-testi/faq";
import { testRelated } from "../../data/ucretsiz-isitme-testi/cta-related";

// Schema — yalnızca sayfada görünür olan gerçek bilgi. FAQPage şeması, görünür SSS
// verisinden BrandPageFaq içinde üretilir. Ortak MedicalBusiness builder'ı, sitenin
// tek gerçek işletme varlığını (@id ortak) tanımlar; doktor/hastane/klinik/ürün/fiyat yok.
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, "https://www.eniyicihaz.com").toString() } : { item: PAGE_URL }),
  })),
};
const medicalBusinessSchema = buildMedicalBusinessSchema(PAGE_URL, pageMeta.schemaDescription);
---

<MainLayout title={pageMeta.title} description={pageMeta.description}>
  <div class="uit-page">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(medicalBusinessSchema)} />

  <div class="uit-breadcrumb">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <GuideHero data={testHero} extraCta={testHeroExtra} />
  <GuideToc links={toc} />

  <!-- 1. İşitme testi nedir? (kısa cevap + devamı) -->
  <DirectAnswer data={testQuickAnswer} />
  <div class="uit-cont">
    <InfoGrid cards={basicsCards} columns={2} headingLevel="h3" />
  </div>

  <!-- 2. Ne için ve ne zaman? (eski "neden" + "ne zaman") — bu bölümün sonunda tek CTA -->
  <GuideSection {...whenSection} tone="alt">
    <p class="uit-p uit-p--wide">{purposeText}</p>

    <h3 class="uit-h3 uit-h3--after">İşitme kaybı düşündürebilecek belirtiler</h3>
    <ul class="uit-facts">
      {
        signsCards.map((c) => (
          <li>
            <strong>{c.title}</strong>
            <span>{c.text}</span>
          </li>
        ))
      }
    </ul>

    <h3 class="uit-h3 uit-h3--after">Gürültü, yaş ve aile öyküsü</h3>
    <ul class="uit-facts">
      {
        contextCards.map((c) => (
          <li>
            <strong>{c.title}</strong>
            <span>{c.text}</span>
            {c.href && <a href={c.href}>{c.linkLabel} →</a>}
          </li>
        ))
      }
    </ul>

    <GuideNotice
      text="İşitmenizi merak ediyorsanız test için beklemeyin; bir randevuyla işitme durumunuzu birlikte değerlendirebiliriz."
      links={[{ label: "Randevu ve iletişim", href: "/iletisim/" }, { label: "İşitme kaybı nedir?", href: "/rehberler/isitme-kaybi-nedir/" }]}
    />
  </GuideSection>

  <!-- 3. KBB uyarısı (sayfadaki tek tam güvenlik bölümü) -->
  <GuideSection {...entSection}>
    <div class="uit-alert" role="note" aria-label="Tıbbi uyarı">
      <div class="uit-alert__head">
        <TriangleAlert size={22} stroke-width={2} aria-hidden="true" />
        <p>Aşağıdaki durumlarda önce bir KBB uzmanına veya sağlık kuruluşuna başvurun.</p>
      </div>
      <ul class="uit-alert__list">
        {
          entPoints.map((p) => (
            <li>
              <strong>{p.title}</strong>
              <span>{p.text}</span>
            </li>
          ))
        }
      </ul>
      <p class="uit-alert__note">{entNote}</p>
    </div>
  </GuideSection>

  <!-- 4. İşitme testi nasıl yapılır? (tek zaman çizelgesi + hazırlık + süre H3'leri) -->
  <div id="nasil-yapilir" class="uit-anchor">
    <ProcessTimeline data={howProcess} />
  </div>
  <div class="uit-cont">
    <h3 class="uit-h3" id="hazirlik">{prepareHeading}</h3>
    <p class="uit-p uit-p--lead">{prepareIntro}</p>
    <div class="uit-spaced">
      <InfoGrid cards={prepareCards} columns={3} headingLevel="h4" />
    </div>

    <h3 class="uit-h3 uit-h3--after" id="sure">{durationHeading}</h3>
    <p class="uit-p">{durationIntro}</p>
    <ul class="uit-list">
      {
        durationPoints.map((p) => (
          <li>
            <strong>{p.title}</strong>
            <span>{p.text}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- 5. Hangi değerlendirmeler yer alabilir? (3 ölçüm + tek birleşik tablo) -->
  <GuideSection {...measureSection} tone="alt">
    <InfoGrid cards={measureCards} columns={3} />
    <div class="uit-spaced">
      <GuideTable data={measureTable} mobile="stack" />
    </div>
  </GuideSection>

  <!-- 6. Ücretsiz işitme testi: neleri kapsar? (tabloyu tekrarlamaz) -->
  <GuideSection {...freeTestSection}>
    <InfoGrid cards={freeTestCards} columns={3} />
  </GuideSection>

  <!-- 7. Sonuç nasıl okunur? Sıra: grafik → derece tablosu → 4 açıklama kartı -->
  <GuideSection {...resultsSection} tone="alt">
    <div class="uit-audiogram">
      <AudiogramDiagram data={audiogram} />
    </div>
    <div class="uit-spaced">
      <GuideTable data={degreeTable} mobile="fit" />
    </div>
    <div class="uit-spaced">
      <InfoGrid cards={resultsCards} columns={2} />
    </div>
    <div class="uit-spaced">
      <GuideNotice text={resultsNotice} links={[{ label: "Odyometri", href: "/degerlendirme/odyometri/" }, { label: "İşitme kaybı nedir?", href: "/rehberler/isitme-kaybi-nedir/" }]} />
    </div>
  </GuideSection>

  <!-- 8. Test sonrası (KBB · takip · cihaz gündeme gelirse) -->
  <GuideSection {...afterSection}>
    <InfoGrid cards={afterCards} columns={3} />
    <div class="uit-spaced">
      <GuideNotice text="Cihaz gündeme gelirse şu rehberlerden ayrıntı bulabilirsiniz." links={afterLinks} />
    </div>
  </GuideSection>

  <!-- 9. Evde / online test -->
  <GuideSection {...onlineSection} tone="alt">
    <GuideTable data={onlineTable} bare mobile="stack" />
  </GuideSection>

  <!-- 10. Çocuklarda ve yaşlılarda -->
  <GuideSection {...ageSection}>
    <h3 class="uit-h3">Çocuklarda</h3>
    <GuideNotice text={childrenText} links={childrenLinks} />
    <h3 class="uit-h3 uit-h3--after">Yaşa bağlı işitme kaybında</h3>
    <GuideNotice text={elderlyText} links={elderlyLinks} />
  </GuideSection>

  <!-- 11. Darıca'daki merkezimiz ve ulaşım (tek yerel bölüm: Darıca · Gebze/Çayırova · Kocaeli) -->
  <GuideSection {...localSection} tone="alt">
    <LocalBlocks blocks={localBlocks} headingLevel="h3" />
  </GuideSection>

  <!-- 12. SSS (yalnızca sayfada cevaplanmamış sorular) -->
  <div id="sss" class="uit-anchor">
    <BrandPageFaq data={testFaq} />
  </div>

  <!-- 13. Randevu ve iletişim (tek kapanış CTA'sı) + ilgili içerikler -->
  <div id="merkez-ulasim" class="uit-anchor">
    <ContactLocationCard data={ucretsizIsitmeTestiLocation} />
  </div>
  <BrandPageRelatedContent data={testRelated} />
  </div>
</MainLayout>

<style>
  /* WCAG AA: the shared price-guide components render the TOC label and the table corner
     header in --color-text-soft (#94a3b8, 2.56:1 on white). Scoped to this page only; the
     same defect exists on the other hubs' shared components and is reported separately. */
  .uit-page :global(.guide-toc__label),
  .uit-page :global(.guide-table__corner) {
    color: var(--color-text-muted);
  }

  /* Darıca block has no checklist any more; keep the text column centred next to the photo instead of top-aligned with empty space below. */
  .uit-page :global(.local-block--center .local-block__body) {
    align-self: center;
  }

  /* Shared ContactLocationCard sets the grid's top margin to var(--space-14), a token that is not defined
     (resolves to 0), so the heading block touches the card. Fixed here for this page only (/iletisim/ untouched). */
  .uit-page :global(.contact-location__grid) {
    margin-top: var(--space-12);
  }

  .uit-breadcrumb {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding: var(--space-4) var(--space-6) 0;
  }

  /* Continuation of the "İşitme testi nedir?" / "nasıl yapılır?" sections: H3 cards
     that live directly under the section's own H2 block. */
  .uit-cont {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding: var(--space-8) var(--space-6) var(--space-16);
  }

  .uit-h3 {
    margin: var(--space-10) 0 var(--space-4);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .uit-h3:first-of-type {
    margin-top: 0;
  }

  .uit-p {
    margin: 0;
    max-width: 46rem;
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .uit-p--wide {
    max-width: 52rem;
  }

  .uit-facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-8);
  }

  .uit-facts li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3) 0 var(--space-3) var(--space-4);
    border-left: 3px solid var(--color-border);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .uit-facts strong {
    font-size: var(--font-size-md);
    color: var(--color-text);
  }

  .uit-facts a {
    margin-top: 2px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .uit-facts a:hover {
    text-decoration: underline;
  }

  .uit-p--wide + .uit-h3 {
    margin-top: var(--space-10);
  }

  .uit-p--lead {
    margin-bottom: 0;
  }

  .uit-h3--after {
    margin-top: var(--space-12);
  }

  .uit-list {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    max-width: 46rem;
    display: grid;
    gap: var(--space-3);
  }

  .uit-list li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-border);
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .uit-list strong {
    color: var(--color-text);
  }

  .uit-spaced {
    margin-top: var(--space-8);
  }

  .uit-audiogram {
    max-width: 52rem;
    margin-inline: auto;
  }

  .uit-anchor {
    scroll-margin-top: calc(var(--space-16) + var(--space-4));
  }

  /* Medical safety block — deliberately more visible than the calm GuideNotice. */
  .uit-alert {
    border: 1px solid #f5c26b;
    border-left-width: 6px;
    border-radius: var(--radius-xl);
    background: #fff8ea;
    padding: var(--space-6);
    color: #4a3200;
  }

  .uit-alert__head {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    color: #8a5a00;
  }

  .uit-alert__head :global(svg) {
    flex: none;
    margin-top: 2px;
  }

  .uit-alert__head p {
    margin: 0;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: #6b4300;
  }

  .uit-alert__list {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-4);
  }

  .uit-alert__list li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid #f0d9a8;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: #4a3200;
  }

  .uit-alert__list strong {
    font-size: var(--font-size-md);
    color: #3b2700;
  }

  .uit-alert__note {
    margin: var(--space-5) 0 0;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
  }

  @media (max-width: 640px) {
    .uit-breadcrumb {
      padding-inline: var(--space-4);
    }

    .uit-cont {
      padding: var(--space-6) var(--space-4) var(--space-10);
    }

    .uit-alert {
      padding: var(--space-4);
    }

    .uit-facts {
      grid-template-columns: minmax(0, 1fr);
    }

    .uit-page :global(.contact-location__grid) {
      margin-top: var(--space-8);
    }
  }
</style>

---
import DSLayout from "../../../ds/layouts/DSLayout.astro";

import PageHeader from "../../../ds/components/docs/PageHeader/PageHeader.astro";
import ComponentMeta from "../../../ds/components/docs/ComponentMeta/ComponentMeta.astro";
import Section from "../../../ds/components/docs/Section/Section.astro";
import Preview from "../../../ds/components/docs/Preview/Preview.astro";
import PropsTable from "../../../ds/components/docs/PropsTable/PropsTable.astro";
import DoDont from "../../../ds/components/docs/DoDont/DoDont.astro";
import Divider from "../../../ds/components/docs/Divider/Divider.astro";

import TreeView from "../../../ds/components/ui/atoms/TreeView/TreeView.astro";

const props = [
    {
        name: "items",
        type: "TreeItem[]",
        default: "[]",
        description: "Tree nodes."
    },
    {
        name: "expanded",
        type: "string[]",
        default: "[]",
        description: "Expanded node ids."
    },
    {
        name: "selected",
        type: "string",
        default: "—",
        description: "Selected node id."
    },
    {
        name: "selectable",
        type: "boolean",
        default: "true",
        description: "Allows node selection."
    }
];
---

<DSLayout title="Tree">

    <PageHeader
        badge="Atom"
        title="Tree"
        description="Trees display hierarchical data with expandable and collapsible nodes."
    />

    <ComponentMeta
        category="Atom"
        status="Stable"
        since="1.0.0"
    />

    <Section
        title="Preview"
        description="Basic tree example."
    >

        <Preview title="Tree">

            <TreeView
                expanded={["components"]}
                items={[
                    {
                        id: "components",
                        label: "Components",
                        children: [
                            {
                                id: "button",
                                label: "Button"
                            },
                            {
                                id: "input",
                                label: "Input"
                            },
                            {
                                id: "card",
                                label: "Card"
                            }
                        ]
                    }
                ]}
            />

        </Preview>

    </Section>

    <Divider label="API" />

    <Section
        title="Props"
        description="Supported component properties."
    >

        <PropsTable items={props} />

    </Section>

    <Section
        title="Usage"
        description="Best practices."
    >

        <DoDont>

            <Fragment slot="do">

                <ul>
                    <li>Use trees for hierarchical data.</li>
                    <li>Keep nesting levels reasonable.</li>
                    <li>Highlight the selected node.</li>
                </ul>

            </Fragment>

            <Fragment slot="dont">

                <ul>
                    <li>Don't overload trees with unnecessary depth.</li>
                    <li>Don't use trees for flat lists.</li>
                    <li>Don't hide important content several levels deep.</li>
                </ul>

            </Fragment>

        </DoDont>

    </Section>

</DSLayout>
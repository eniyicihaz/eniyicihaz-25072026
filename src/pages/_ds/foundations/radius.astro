---
import DSLayout from "../../../ds/layouts/DSLayout.astro";

import PageHeader from "../../../ds/components/docs/PageHeader/PageHeader.astro";
import ComponentMeta from "../../../ds/components/docs/ComponentMeta/ComponentMeta.astro";
import Section from "../../../ds/components/docs/Section/Section.astro";
import Preview from "../../../ds/components/docs/Preview/Preview.astro";
import Divider from "../../../ds/components/docs/Divider/Divider.astro";
import Note from "../../../ds/components/docs/Note/Note.astro";

const radius = [
    "0px",
    "4px",
    "8px",
    "12px",
    "16px",
    "20px",
    "24px",
    "32px",
    "999px"
];
---

<DSLayout title="Radius">

    <PageHeader
        badge="Foundation"
        title="Radius"
        description="Border radius tokens provide consistent corner treatments throughout the interface."
    />

    <ComponentMeta
        category="Foundation"
        status="Stable"
        since="1.0.0"
    />

    <Note
        variant="info"
        title="Design Principle"
    >
        Use radius tokens instead of arbitrary border-radius values.
    </Note>

    <Divider label="Radius Scale" />

    <Section
        title="Corner Radius"
        description="Standard border radius values used by the design system."
    >

        <Preview title="Radius Preview">

            <div style="display:flex;flex-direction:column;gap:24px;">

                {
                    radius.map(value => (
                        <div style="display:flex;align-items:center;gap:24px;">

                            <div style="width:80px;font-weight:600;">
                                {value}
                            </div>

                            <div
                                style={`
                                    width:140px;
                                    height:72px;
                                    border-radius:${value};
                                    background:var(--primary-light);
                                    border:1px solid var(--border);
                                `}
                            />

                        </div>
                    ))
                }

            </div>

        </Preview>

    </Section>

</DSLayout>
---
// Çayırova — "Çayırova'dan Darıca'daki merkezimize ulaşım" (Faz 2 P2, V1).
// Çayırova'da fiziksel şube YOK; merkez Darıca'da (LOCAL_SOURCE_OF_TRUTH §6).
// Doğrulanmış yerel bilgi sınırlı (550 hattı, evde hizmet alanı); bu yüzden
// sayfa bilinçli olarak kısa: hero (görselsiz) → ulaşım → konum kartı →
// gelmeden önce → SSS → final CTA. Gebze'nin bölüm yapısı kopyalanmıyor.
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../ds/components/ui/atoms/Breadcrumb/Breadcrumb.astro";
import CorporateHero from "../components/shared/CorporateHero/CorporateHero.astro";
import ContactLocationCard from "../components/contact/ContactLocationCard/ContactLocationCard.astro";
import BrandPageFaq from "../components/brand-page/BrandPageFaq/BrandPageFaq.astro";
import BrandPageFinalCta from "../components/brand-page/BrandPageFinalCta/BrandPageFinalCta.astro";

import { cayirovaHero } from "../data/cayirova/hero";
import { cayirovaRoute, cayirovaBeforeVisit } from "../data/cayirova/copy-blocks";
import { cayirovaLocation } from "../data/cayirova/location";
import { cayirovaFaq } from "../data/cayirova/faq";
import { cayirovaFinalCta } from "../data/cayirova/final-cta";

import { buildMedicalBusinessSchema } from "../lib/schema";
import { contactHero } from "../data/contact/hero";

const PAGE_URL = "https://www.eniyicihaz.com/cayirova-isitme-cihazlari/";

const breadcrumbItems = [
  { label: "Ana Sayfa", href: "/" },
  { label: "Çayırova İşitme Cihazları", current: true },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, "https://www.eniyicihaz.com").toString() } : {}),
  })),
};

// Aynı kanonik tanım cümlesi + aynı gerçek MedicalBusiness kaydı (aynı
// @id, aynı gerçek Darıca adresi) — Çayırova için AYRI bir işletme/adres
// ASLA oluşturulmadı. Çayırova zaten `areaServed` dizisinde var (bkz.
// src/lib/schema.ts + src/data/contact/serviceArea.ts) — burada hiçbir
// değişiklik gerekmedi.
const medicalBusinessSchema = buildMedicalBusinessSchema(PAGE_URL, contactHero.definitionSentence);
---

<MainLayout
  title="Çayırova'dan Darıca İşitme Merkezine Ulaşım | Avrasya İşitme"
  description="Merkezimiz Darıca'da. Çayırova'dan 550 numaralı hatla ulaşım, adres, çalışma saatleri, yol tarifi ve evde hizmet bilgisi."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(medicalBusinessSchema)} />

  <div class="cayirova-breadcrumb-wrap">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <CorporateHero data={cayirovaHero} />

  <section class="cayirova-block" aria-labelledby="cayirova-route-title">
    <div class="cayirova-block__inner">
      <p class="cayirova-block__badge">{cayirovaRoute.eyebrow}</p>
      <h2 class="cayirova-block__heading" id="cayirova-route-title">{cayirovaRoute.heading}</h2>
      {cayirovaRoute.paragraphs.map((p) => <p class="cayirova-block__text">{p}</p>)}
      <p class="cayirova-block__text">
        <a class="cayirova-link" href={cayirovaRoute.testLink.href}>{cayirovaRoute.testLink.label} →</a>
      </p>
    </div>
  </section>

  <ContactLocationCard data={cayirovaLocation} />

  <section class="cayirova-block cayirova-block--note" aria-label="Gelmeden önce">
    <div class="cayirova-block__inner">
      {cayirovaBeforeVisit.paragraphs.map((p) => <p class="cayirova-block__text">{p}</p>)}
      <p class="cayirova-block__text">
        {cayirovaBeforeVisit.homeService.text}
        <a class="cayirova-link" href={cayirovaBeforeVisit.homeService.href}>{cayirovaBeforeVisit.homeService.linkLabel} →</a>
      </p>
    </div>
  </section>

  <BrandPageFaq data={cayirovaFaq} />

  <BrandPageFinalCta data={cayirovaFinalCta} />
  <p class="cayirova-links-row">
    <a class="cayirova-link" href="/darica-isitme-cihazlari/">Darıca merkezimizin sayfası →</a>
  </p>
</MainLayout>

<style>
  .cayirova-breadcrumb-wrap {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding: var(--space-6) var(--space-6) 0;
  }

  .cayirova-block {
    background: var(--color-background);
    padding-block: var(--space-16);
  }

  .cayirova-block--note {
    padding-block: var(--space-10);
    background: var(--color-surface);
  }

  .cayirova-block__inner {
    max-width: 42rem;
    margin-inline: auto;
    padding-inline: var(--space-6);
    text-align: center;
  }

  .cayirova-block__badge {
    display: inline-block;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
  }

  .cayirova-block__heading {
    margin: var(--space-4) 0 0;
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .cayirova-block__text {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .cayirova-links-row {
    margin: 0;
    padding: var(--space-6);
    text-align: center;
    background: var(--color-surface);
  }

  .cayirova-link {
    display: inline-block;
    padding-block: var(--space-3);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .cayirova-link:hover {
    text-decoration: underline;
  }

  .cayirova-link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  @media (max-width: 640px) {
    .cayirova-block {
      padding-block: var(--space-10);
    }
  }
</style>

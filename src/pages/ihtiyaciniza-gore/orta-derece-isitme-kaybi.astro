import BrandPageExpertOpinion from "../../components/brand-page/BrandPageExpertOpinion/BrandPageExpertOpinion.astro";
import BrandPageFaq from "../../components/brand-page/BrandPageFaq/BrandPageFaq.astro";
import BrandPageFinalCta from "../../components/brand-page/BrandPageFinalCta/BrandPageFinalCta.astro";
import KulakArkasiComparison from "../../components/kulak-arkasi/KulakArkasiComparison/KulakArkasiComparison.astro";

import { ortaDereceIsitmeKaybiHero } from "../../data/orta-derece-isitme-kaybi/hero";
import { ortaDereceIsitmeKaybiIntro } from "../../data/orta-derece-isitme-kaybi/intro";
import { ortaDereceIsitmeKaybiIdealUser } from "../../data/orta-derece-isitme-kaybi/ideal-user";
import { ortaDereceIsitmeKaybiAdvantages } from "../../data/orta-derece-isitme-kaybi/advantages";
import { ortaDereceIsitmeKaybiConsiderations } from "../../data/orta-derece-isitme-kaybi/considerations";
import { ortaDereceIsitmeKaybiEvolution } from "../../data/orta-derece-isitme-kaybi/evolution";
import { ortaDereceIsitmeKaybiUseCases } from "../../data/orta-derece-isitme-kaybi/use-cases";
import { ortaDereceIsitmeKaybiTechnology } from "../../data/orta-derece-isitme-kaybi/technology";

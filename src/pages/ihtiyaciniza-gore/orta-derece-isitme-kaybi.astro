---
// Orta Derece İşitme Kaybı — /ihtiyaciniza-gore/orta-derece-isitme-kaybi.
// Second page of the "İhtiyacınıza Göre" product-page series (see
// header.data.ts's devicesMega third column), built directly on the
// Hafif İşitme Kaybı master template
// (/ihtiyaciniza-gore/hafif-isitme-kaybi) — same shared, data-driven
// Brand Component Architecture, same KulakArkasiComparison component
// (already generic, reused as-is), same accent-scoping pattern with its
// own yeşil/green (#16a34a) category accent.
//
// A health-classification topic, handled with the same care as the Hafif
// İşitme Kaybı and Tinnitus pages: self-diagnosis is never implied, and
// every section (Nedir?, Belirtiler, Dikkat Edilmesi Gerekenler, Uzman
// Yorumu, FAQ) routes back to a proper audiometric test (odyometri) as
// the only way to confirm degree and type.
//
// 14-section flow, in order: Hero -> Nedir? + Nasıl Anlaşılır? ->
// Günlük Yaşamdaki Belirtiler -> Avantajları -> Dikkat Edilmesi
// Gerekenler -> Derecelere Göre (Orta Derecenin Yeri) -> Öne Çıkan
// Özellikler -> Teknolojiler -> Önerilen Marka ve Modeller -> Orta vs
// İleri Derece -> Uzman Yorumu -> SSS -> Premium CTA -> İlgili
// İçerikler.
// (Same repurposing as the Hafif İşitme Kaybı page: BTE's "Kimler İçin
// Uygun" slot becomes everyday recognizable symptoms rather than
// candidacy, and BTE's hearing-loss-level slot becomes the genuine
// dB-based degree ladder, this time positioning "orta" as the current
// stage; see evolution.ts and ideal-user.ts.)
import MainLayout from "../../layouts/MainLayout.astro";
import BrandPageHero from "../../components/brand-page/BrandPageHero/BrandPageHero.astro";
import BrandPageIntro from "../../components/brand-page/BrandPageIntro/BrandPageIntro.astro";
import BrandPageIdealUser from "../../components/brand-page/BrandPageIdealUser/BrandPageIdealUser.astro";
import BrandPageAdvantages from "../../components/brand-page/BrandPageAdvantages/BrandPageAdvantages.astro";
import BrandPageTechEvolution from "../../components/brand-page/BrandPageTechEvolution/BrandPageTechEvolution.astro";
import BrandPageTechnology from "../../components/brand-page/BrandPageTechnology/BrandPageTechnology.astro";
import BrandPageEcosystem from "../../components/brand-page/BrandPageEcosystem/BrandPageEcosystem.astro";

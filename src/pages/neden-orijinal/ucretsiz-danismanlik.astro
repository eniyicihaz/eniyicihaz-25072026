import { ucretsizDanismanlikFinalCta } from "../../data/ucretsiz-danismanlik/final-cta";
---

<MainLayout
  title="Ücretsiz Danışmanlık: İşitme Cihazı Seçiminde Uzman Desteği | EniyiCihaz"
  description="Ücretsiz işitme testi ve uzman danışmanlığımızla size en uygun işitme cihazını satış baskısı olmadan birlikte belirleyin. SGK bilgilendirmesi ve demo cihaz deneme imkânı."
>
  <BrandPageHero data={ucretsizDanismanlikHero} />

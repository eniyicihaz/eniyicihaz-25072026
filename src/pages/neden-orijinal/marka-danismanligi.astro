---
// Marka Danışmanlığı — /neden-orijinal/marka-danismanligi. Mega menüde
// "Marka Desteği" kolonunun 4. öğesi; diğer 3 öğe (Orijinallik Garantisi,
// Yetkili Servis, Aksesuar & Yedek) zaten var olan kardeş sayfalara
// (guvenilir-teknoloji, yaygin-servis-agi, orijinal-aksesuar) bağlandı —
// bu konu ("hangi marka bana uygun?") derinlemesine işlenen tek gerçekten
// boş konuydu (bkz. implementasyon planı). Konumlandırma: "Marka Değil,
// Size Uyan Çözüm" — üstünlük iddiası yok, ihtiyaç odaklı danışmanlık.
//
// Sıra: Breadcrumb -> Hero (DecisionCockpit) -> Hızlı Bilgiler -> Marka
// Seçmeden Önce İhtiyacınızı Tanıyın -> 6 Soruda İhtiyacınız -> Farklı
// Markalar, Farklı Yaklaşımlar -> Karşılaştırırken Bakılacak Kriterler ->
// Darıca'da Marka Danışmanlığı -> SSS -> Son CTA -> İlgili İçerikler.
import MainLayout from "../../layouts/MainLayout.astro";
import { imageDims } from "../../lib/responsive-images";
import Breadcrumb from "../../ds/components/ui/atoms/Breadcrumb/Breadcrumb.astro";
import DecisionCockpit from "../../components/shared/DecisionCockpit/DecisionCockpit.astro";
import BrandPageOverview from "../../components/brand-page/BrandPageOverview/BrandPageOverview.astro";
import BrandPageIntro from "../../components/brand-page/BrandPageIntro/BrandPageIntro.astro";
import BrandPageSignalList from "../../components/brand-page/BrandPageSignalList/BrandPageSignalList.astro";
import BrandCriteriaGrid from "../../components/shared/BrandCriteriaGrid/BrandCriteriaGrid.astro";
import ContactLocationCard from "../../components/contact/ContactLocationCard/ContactLocationCard.astro";
import BrandPageFaq from "../../components/brand-page/BrandPageFaq/BrandPageFaq.astro";
import BrandPageFinalCta from "../../components/brand-page/BrandPageFinalCta/BrandPageFinalCta.astro";
import BrandPageRelatedContent from "../../components/brand-page/BrandPageRelatedContent/BrandPageRelatedContent.astro";

import { markaDanismanligiHero } from "../../data/marka-danismanligi/hero";
import { markaDanismanligiOverview } from "../../data/marka-danismanligi/overview";
import { markaDanismanligiIntro } from "../../data/marka-danismanligi/intro";
import { markaDanismanligiSignalQuestions } from "../../data/marka-danismanligi/signal-questions";
import { markaDanismanligiCriteria } from "../../data/marka-danismanligi/criteria";
import { markaDanismanligiLocation } from "../../data/marka-danismanligi/location";
import { markaDanismanligiFaq } from "../../data/marka-danismanligi/faq";
import { markaDanismanligiFinalCta } from "../../data/marka-danismanligi/final-cta";
import { markaDanismanligiRelatedContent } from "../../data/marka-danismanligi/related-content";

import { brandShowcase } from "../../data/brands/showcase";
import { brandExtended } from "../../data/brands/extended";
import { company } from "../../components/footer/Footer/data/company";

const allBrands = [...brandShowcase.brands, ...brandExtended.brands];

// Logo dosyaları 612x408 / 707x353 / 1774x887 tuvallerin ortasında, her yanında
// farklı ve simetrik olmayan şeffaf boşlukla duruyor. Kartın içinde tuval değil
// logonun kendisi hizalansın ve boyutlansın diye her logonun görünen alanı
// (alfa > 8, her yana ~%1.2 güvenlik payıyla) ölçüldü: [tuvalW, tuvalH, x, y, w, h].
// Dosyalar değişirse buradaki ölçü de güncellenmeli; kaydı olmayan logo,
// tuvalin tamamı kutuya sığdırılarak (contain) gösterilir.
const LOGO_BOX: Record<string, [number, number, number, number, number, number]> = {
  "/images/brands/am-logo-seffaf.webp": [612, 408, 188, 93, 246, 230],
  "/images/brands/audifon-logo-seffaf.webp": [612, 408, 83, 146, 446, 108],
  "/images/brands/audio-service-logo-seffaf.webp": [612, 408, 125, 128, 371, 137],
  "/images/brands/beltone-logo-seffaf.webp": [612, 408, 86, 153, 447, 92],
  "/images/brands/bernafon-logo-seffaf.webp": [612, 408, 90, 150, 453, 107],
  "/images/brands/coselgi-logo-seffaf.webp": [612, 408, 145, 152, 327, 100],
  "/images/brands/maico-logo-seffaf.webp": [612, 408, 80, 145, 458, 112],
  "/images/brands/nuear-logo-seffaf.webp": [612, 408, 41, 150, 550, 96],
  "/images/brands/oticon-logo-seffaf.webp": [1774, 887, 150, 227, 1481, 401],
  "/images/brands/philips-logo-seffaf.webp": [612, 408, 98, 151, 435, 90],
  "/images/brands/phonak-logo-seffaf.webp": [707, 353, 60, 107, 590, 126],
  "/images/brands/resound-logo-seffaf.webp": [707, 353, 65, 71, 577, 207],
  "/images/brands/rexton-logo-seffaf.webp": [612, 408, 88, 156, 449, 85],
  "/images/brands/signia-logo-seffaf.webp": [707, 353, 69, 86, 581, 168],
  "/images/brands/sonic-logo-seffaf.webp": [612, 408, 117, 131, 387, 139],
  "/images/brands/unitron-logo-seffaf.webp": [612, 408, 98, 133, 451, 110],
  "/images/brands/vista-logo-seffaf.webp": [612, 408, 146, 131, 330, 135],
  "/images/brands/widex-logo-seffaf.webp": [707, 353, 64, 90, 618, 167],
};

function logoMarkStyle(logo?: string): string | undefined {
  const box = logo ? LOGO_BOX[logo] : undefined;
  if (!box) return undefined;
  const [cw, ch, x, y, w, h] = box;
  const pct = (n: number) => `${+(n * 100).toFixed(3)}%`;
  return `--mark-ar:${+(w / h).toFixed(4)};--mark-img-w:${pct(cw / w)};--mark-img-x:${pct(-x / w)};--mark-img-y:${pct(-y / h)};`;
}

const PAGE_URL = "https://www.eniyicihaz.com/neden-orijinal/marka-danismanligi";

const breadcrumbItems = [
  { label: "Ana Sayfa", href: "/" },
  { label: "Marka Danışmanlığı", current: true },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, "https://www.eniyicihaz.com").toString() } : {}),
  })),
};

// Same MedicalBusiness node as every other page on the site — same @id,
// same real NAP source, extending the sitewide Organization.
const medicalBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "@id": BUSINESS_ID,
  name: company.legalName,
  description: "Darıca, Kocaeli'de SGK anlaşmalı işitme merkezi; ihtiyacınıza uygun işitme cihazı markasını belirlemenize yardımcı olur.",
  url: BUSINESS_URL,
  telephone: company.phones.map((phone) => phone.href.replace("tel:", "")),
  email: company.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Fevziçakmak Mah. Dr. Zeki Acar Cad. No:77/7 Asansör 1. Kat",
    addressLocality: "Darıca",
    addressRegion: "Kocaeli",
    postalCode: BUSINESS_POSTAL_CODE,
    addressCountry: "TR",
  },
  image: BUSINESS_IMAGE,
  geo: {
    "@type": "GeoCoordinates",
    latitude: 40.772815433889605,
    longitude: 29.4047968764159,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "08:45",
      closes: "19:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Saturday",
      opens: "09:00",
      closes: "19:00",
    },
  ],
  areaServed: SERVICE_AREA_NAMES,
};
import { BUSINESS_ID, BUSINESS_IMAGE, BUSINESS_POSTAL_CODE, BUSINESS_URL, SERVICE_AREA_NAMES } from "../../lib/schema";
---

<MainLayout
  title="Marka Danışmanlığı | Size Uygun İşitme Cihazı Markası"
  description="Darıca'daki merkezimizde 18 marka arasından ihtiyacınıza uygun işitme cihazı marka ve model ailesini birlikte değerlendiriyoruz. Marka değil, size uyan çözüm."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(medicalBusinessSchema)} />

  <div class="md-breadcrumb-wrap">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <DecisionCockpit data={markaDanismanligiHero} />
  <BrandPageOverview data={markaDanismanligiOverview} />
  <BrandPageIntro data={markaDanismanligiIntro} />
  <BrandPageSignalList data={markaDanismanligiSignalQuestions} />

  <section class="md-brand-grid" aria-labelledby="md-brand-grid-title">
    <div class="md-brand-grid__header">
      <p class="md-brand-grid__eyebrow">FARKLI MARKALAR, FARKLI YAKLAŞIMLAR</p>
      <h2 class="md-brand-grid__heading" id="md-brand-grid-title">Çalıştığımız Markalar</h2>
      <p class="md-brand-grid__intro">Hiçbirini diğerine üstün göstermeden, tamamını inceleyebilirsiniz.</p>
    </div>
    <div class="md-brand-grid__grid">
      {allBrands.map((brand) => (
        <a class="md-brand-grid__logo" href={brand.href} aria-label={brand.name}>
          <span class="md-brand-grid__mark" style={logoMarkStyle(brand.logo)} data-fit={LOGO_BOX[brand.logo ?? ""] ? "box" : "contain"}>
            <img src={brand.logo} alt={brand.name} width={imageDims(brand.logo ?? "")?.width} height={imageDims(brand.logo ?? "")?.height} loading="lazy" />
          </span>
        </a>
      ))}
    </div>
  </section>

  <BrandCriteriaGrid data={markaDanismanligiCriteria} />

  <ContactLocationCard data={markaDanismanligiLocation} />

  <BrandPageFaq data={markaDanismanligiFaq} />
  <BrandPageFinalCta data={markaDanismanligiFinalCta} />
  <BrandPageRelatedContent data={markaDanismanligiRelatedContent} />
</MainLayout>

<style>
  .md-breadcrumb-wrap {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding: var(--space-6) var(--space-6) 0;
  }

  .md-brand-grid {
    background: var(--color-background);
    padding-block: var(--space-20);
  }

  .md-brand-grid__header {
    max-width: 44rem;
    margin-inline: auto;
    padding-inline: var(--space-6);
    text-align: center;
  }

  .md-brand-grid__eyebrow {
    margin: 0;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #b45309;
  }

  .md-brand-grid__heading {
    margin: var(--space-4) 0 0;
    font-size: clamp(1.875rem, 1.5rem + 1.8vw, 2.75rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .md-brand-grid__intro {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .md-brand-grid__grid {
    max-width: var(--container-2xl);
    margin: var(--space-12) auto 0;
    padding-inline: var(--space-6);
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .md-brand-grid__logo {
    display: grid;
    place-items: center;
    height: 88px;
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .md-brand-grid__logo:hover {
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-xs);
  }

  .md-brand-grid__logo:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* Mark = logonun görünen alanı. Oranı logodan gelir, boyutu kartın içeriğine
     göre sınırlanır; img tuvalini mark'a göre konumlandırır, böylece tuvaldeki
     şeffaf boşluk yerleşimi etkilemez. */
  .md-brand-grid__mark {
    --mark-max-h: 44px;
    position: relative;
    display: block;
    width: min(88%, calc(var(--mark-max-h) * var(--mark-ar, 3)));
    aspect-ratio: var(--mark-ar, 3);
    overflow: hidden;
  }

  .md-brand-grid__mark img {
    position: absolute;
    left: var(--mark-img-x);
    top: var(--mark-img-y);
    width: var(--mark-img-w);
    max-width: none;
    height: auto;
  }

  .md-brand-grid__mark[data-fit="contain"] img {
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (max-width: 1023px) {
    .md-brand-grid__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .md-brand-grid {
      padding-block: var(--space-12);
    }

    .md-brand-grid__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-3);
      margin-top: var(--space-8);
    }

    .md-brand-grid__logo {
      height: 68px;
      padding: var(--space-2);
    }

    .md-brand-grid__mark {
      --mark-max-h: 34px;
      width: min(92%, calc(var(--mark-max-h) * var(--mark-ar, 3)));
    }
  }
</style>

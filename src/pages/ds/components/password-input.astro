---
import DSLayout from "../../../ds/layouts/DSLayout.astro";

import "../../../ds/patterns/patterns.css";
import "../../../ds/patterns/PasswordInput/PasswordInputPatterns.css";

import PasswordInput from "../../../ds/components/ui/atoms/PasswordInput/PasswordInput.astro";
import Button from "../../../ds/components/ui/atoms/Button/Button.astro";

import {
    loginField,
    signupField,
    adminField,
    vaultEntry,
    lockedField
} from "../../../ds/patterns/PasswordInput/passwordinput.data";
---

<DSLayout title="Password Input">

<div class="pl">

    <header class="pl-head">

        <span class="pl-head__eyebrow">Pattern Library</span>

        <h1 class="pl-head__title">Password Input</h1>

        <p class="pl-head__lede">
            Five password moments — a clinic login, a signup form with a
            validation error, an admin confirmation, a credential vault
            entry and a locked account.
        </p>

    </header>

    <!-- 01 — Clinic account login -->

    <figure class="pl-example">

        <figcaption class="pl-example__bar">
            <span class="pl-example__index">01</span>
            <span class="pl-example__name">Account Login</span>
            <span class="pl-example__tags">Hearing care · Reveal button</span>
        </figcaption>

        <div class="pl-example__canvas">

            <section class="pwd-login">

                <div class="pwd-login__card">

                    <span class="pwd-login__kicker">Hasta portalı</span>
                    <h2 class="pwd-login__title">Giriş yap</h2>

                    <div class="pwd-login__field">
                        <label class="pwd-login__label" for={loginField.id}>{loginField.label}</label>
                        <PasswordInput
                            id={loginField.id}
                            placeholder={loginField.placeholder}
                            autocomplete={loginField.autocomplete}
                        />
                    </div>

                    <a class="pwd-login__forgot" href="#0">Şifrenizi mi unuttunuz?</a>

                    <Button size="lg" fullWidth>Giriş yap</Button>

                </div>

            </section>

        </div>

    </figure>

    <!-- 02 — Signup form, dark, invalid -->

    <figure class="pl-example">

        <figcaption class="pl-example__bar">
            <span class="pl-example__index">02</span>
            <span class="pl-example__name">Signup Form</span>
            <span class="pl-example__tags">Dark · Invalid state</span>
        </figcaption>

        <div class="pl-example__canvas">

            <section class="pwd-signup">

                <div class="pwd-signup__card">

                    <h2 class="pwd-signup__title">Create your account</h2>
                    <p class="pwd-signup__sub">Join 40,000 teams already on the platform</p>

                    <label class="pwd-signup__label" for={signupField.id}>{signupField.label}</label>
                    <PasswordInput
                        id={signupField.id}
                        placeholder={signupField.placeholder}
                        autocomplete={signupField.autocomplete}
                        invalid={signupField.invalid}
                    />
                    <p class="pwd-signup__error">⚠ {signupField.error}</p>

                </div>

            </section>

        </div>

    </figure>

    <!-- 03 — Admin security confirmation -->

    <figure class="pl-example">

        <figcaption class="pl-example__bar">
            <span class="pl-example__index">03</span>
            <span class="pl-example__name">Security Confirmation</span>
            <span class="pl-example__tags">Admin panel · Required field</span>
        </figcaption>

        <div class="pl-example__canvas">

            <section class="pwd-admin">

                <div class="pwd-admin__card">

                    <div class="pwd-admin__icon">⚠</div>
                    <h2 class="pwd-admin__title">Delete production database</h2>
                    <p class="pwd-admin__sub">
                        This will permanently delete <strong>prod-primary</strong> and
                        all its backups. This cannot be undone.
                    </p>

                    <label class="pwd-admin__label" for={adminField.id}>
                        {adminField.label}<span class="pwd-admin__required">*</span>
                    </label>
                    <PasswordInput
                        id={adminField.id}
                        placeholder={adminField.placeholder}
                        autocomplete={adminField.autocomplete}
                        required
                    />

                    <div class="pwd-admin__actions">
                        <Button variant="outline" fullWidth>Cancel</Button>
                        <Button variant="danger" fullWidth>Delete database</Button>
                    </div>

                </div>

            </section>

        </div>

    </figure>

    <!-- 04 — Credential vault entry -->

    <figure class="pl-example">

        <figcaption class="pl-example__bar">
            <span class="pl-example__index">04</span>
            <span class="pl-example__name">Vault Entry</span>
            <span class="pl-example__tags">Password manager · Stored credential</span>
        </figcaption>

        <div class="pl-example__canvas">

            <section class="pwd-vault">

                <div class="pwd-vault__card">

                    <div class="pwd-vault__head">Stored credentials</div>

                    <div class="pwd-vault__row">
                        <label class="pwd-vault__service" for={vaultEntry.id}>{vaultEntry.service}</label>
                        <p class="pwd-vault__updated">{vaultEntry.updated}</p>
                        <PasswordInput
                            id={vaultEntry.id}
                            value={vaultEntry.value}
                            placeholder={vaultEntry.placeholder}
                            readonly
                        />
                    </div>

                </div>

            </section>

        </div>

    </figure>

    <!-- 05 — Locked account -->

    <figure class="pl-example">

        <figcaption class="pl-example__bar">
            <span class="pl-example__index">05</span>
            <span class="pl-example__name">Locked Account</span>
            <span class="pl-example__tags">Security · Disabled field</span>
        </figcaption>

        <div class="pl-example__canvas">

            <section class="pwd-locked">

                <div class="pwd-locked__card">

                    <div class="pwd-locked__icon">🔒</div>
                    <h2 class="pwd-locked__title">This account is temporarily locked</h2>
                    <p class="pwd-locked__sub">
                        We noticed several failed sign-in attempts and locked this
                        account to keep it safe.
                    </p>

                    <label class="pwd-locked__label" for={lockedField.id}>{lockedField.label}</label>
                    <PasswordInput
                        id={lockedField.id}
                        placeholder={lockedField.placeholder}
                        disabled
                    />

                    <p class="pwd-locked__note">⏱ {lockedField.note}</p>

                </div>

            </section>

        </div>

    </figure>

</div>

</DSLayout>

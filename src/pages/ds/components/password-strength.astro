---
import DSLayout from "../../../ds/layouts/DSLayout.astro";

import "../../../ds/patterns/patterns.css";
import "../../../ds/patterns/PasswordStrength/PasswordStrengthPatterns.css";

import PasswordStrength from "../../../ds/components/ui/atoms/PasswordStrength/PasswordStrength.astro";
import PasswordInput from "../../../ds/components/ui/atoms/PasswordInput/PasswordInput.astro";

import {
    signupStrength,
    weakStrength,
    enterpriseStrength,
    emptyStrength,
    bankStrength
} from "../../../ds/patterns/PasswordStrength/passwordstrength.data";
---

<DSLayout title="Password Strength">

<div class="pl">

    <header class="pl-head">

        <span class="pl-head__eyebrow">Pattern Library</span>

        <h1 class="pl-head__title">Password Strength</h1>

        <p class="pl-head__lede">
            Five strength readings — a strong clinic signup, a weak dev
            console secret, an enterprise checklist, a fresh empty field
            and a fair-strength bank password.
        </p>

    </header>

    <!-- 01 — Clinic signup, strong -->

    <figure class="pl-example">

        <figcaption class="pl-example__bar">
            <span class="pl-example__index">01</span>
            <span class="pl-example__name">Account Signup</span>
            <span class="pl-example__tags">Hearing care · Strong password</span>
        </figcaption>

        <div class="pl-example__canvas">

            <section class="pws-signup">

                <div class="pws-signup__card">

                    <span class="pws-signup__kicker">Hasta portalı</span>
                    <h2 class="pws-signup__title">Hesap oluştur</h2>

                    <label class="pws-signup__label" for={signupStrength.id}>Şifre oluştur</label>
                    <PasswordInput id={signupStrength.id} value={signupStrength.value} />
                    <PasswordStrength
                        score={signupStrength.score}
                        label={signupStrength.strengthLabel}
                    />

                </div>

            </section>

        </div>

    </figure>

    <!-- 02 — Dark dev console, weak -->

    <figure class="pl-example">

        <figcaption class="pl-example__bar">
            <span class="pl-example__index">02</span>
            <span class="pl-example__name">API Secret</span>
            <span class="pl-example__tags">Dark · Weak password warning</span>
        </figcaption>

        <div class="pl-example__canvas">

            <section class="pws-weak">

                <div class="pws-weak__card">

                    <span class="pws-weak__crumb">Settings / Security / Master password</span>
                    <h2 class="pws-weak__title">Set your master password</h2>

                    <PasswordInput id={weakStrength.id} value={weakStrength.value} invalid />
                    <PasswordStrength
                        score={weakStrength.score}
                        label={weakStrength.strengthLabel}
                    />

                </div>

            </section>

        </div>

    </figure>

    <!-- 03 — Enterprise onboarding, requirement checklist -->

    <figure class="pl-example">

        <figcaption class="pl-example__bar">
            <span class="pl-example__index">03</span>
            <span class="pl-example__name">Enterprise Onboarding</span>
            <span class="pl-example__tags">SaaS · Excellent · Live requirements</span>
        </figcaption>

        <div class="pl-example__canvas">

            <section class="pws-enterprise">

                <div class="pws-enterprise__card">

                    <h2 class="pws-enterprise__title">Set a workspace password</h2>
                    <p class="pws-enterprise__sub">Required for all accounts with admin access</p>

                    <PasswordInput id={enterpriseStrength.id} value={enterpriseStrength.value} />
                    <PasswordStrength
                        score={enterpriseStrength.score}
                        label={enterpriseStrength.strengthLabel}
                    />

                    <div class="pws-enterprise__checklist">
                        {enterpriseStrength.requirements.map(req => (
                            <div class:list={["pws-enterprise__req", req.met && "pws-enterprise__req--met"]}>
                                <span class="pws-enterprise__check">{req.met ? "✓" : "○"}</span>
                                <span>{req.label}</span>
                            </div>
                        ))}
                    </div>

                </div>

            </section>

        </div>

    </figure>

    <!-- 04 — Fresh field, empty state -->

    <figure class="pl-example">

        <figcaption class="pl-example__bar">
            <span class="pl-example__index">04</span>
            <span class="pl-example__name">Empty State</span>
            <span class="pl-example__tags">Before typing · Score 0</span>
        </figcaption>

        <div class="pl-example__canvas">

            <section class="pws-empty">

                <div class="pws-empty__card">

                    <h2 class="pws-empty__title">Choose a password</h2>
                    <p class="pws-empty__sub">Strength updates as you type</p>

                    <PasswordInput id={emptyStrength.id} />
                    <PasswordStrength score={emptyStrength.score} />

                    <p class="pws-empty__hint">Use 8 or more characters with a mix of letters, numbers &amp; symbols</p>

                </div>

            </section>

        </div>

    </figure>

    <!-- 05 — Banking app, medium strength -->

    <figure class="pl-example">

        <figcaption class="pl-example__bar">
            <span class="pl-example__index">05</span>
            <span class="pl-example__name">Change Password</span>
            <span class="pl-example__tags">Banking · Fair strength</span>
        </figcaption>

        <div class="pl-example__canvas">

            <section class="pws-bank">

                <div class="pws-bank__card">

                    <span class="pws-bank__kicker">Account security</span>
                    <h2 class="pws-bank__title">Change your password</h2>

                    <label class="pws-bank__label" for={bankStrength.id}>New password</label>
                    <PasswordInput id={bankStrength.id} value={bankStrength.value} />
                    <PasswordStrength
                        score={bankStrength.score}
                        label={bankStrength.strengthLabel}
                    />

                </div>

            </section>

        </div>

    </figure>

</div>

</DSLayout>

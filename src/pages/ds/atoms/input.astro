---
import DSLayout from "../../../ds/layouts/DSLayout.astro";

import PageHeader from "../../../ds/components/docs/PageHeader/PageHeader.astro";
import ComponentMeta from "../../../ds/components/docs/ComponentMeta/ComponentMeta.astro";
import Preview from "../../../ds/components/docs/Preview/Preview.astro";

import Input from "../../../ds/components/ui/atoms/Input/Input.astro";
import { Search, Mail, Lock, User } from "lucide-astro";
---

<DSLayout>
  <section class="page">

    <PageHeader
      category="ATOM"
      title="Input"
      description="Premium input component."
    />

    <ComponentMeta
      version="1.1.0"
      status="stable"
    />

    <Preview title="Variants">
      <Input placeholder="Default" />

      <Input
        variant="filled"
        placeholder="Filled"
      />

      <Input
        variant="outline"
        placeholder="Outline"
      />

      <Input
        variant="ghost"
        placeholder="Ghost"
      />
    </Preview>

    <Preview title="Sizes">
      <Input
        size="sm"
        placeholder="Small"
      />

      <Input
        size="md"
        placeholder="Medium"
      />

      <Input
        size="lg"
        placeholder="Large"
      />
    </Preview>

    <Preview title="States">
      <Input
        placeholder="Normal"
      />

      <Input
        success
        placeholder="Success"
      />

      <Input
        error
        placeholder="Error"
      />

      <Input
        disabled
        placeholder="Disabled"
      />
    </Preview>

    <Preview title="Icons">
      <Input
        leftIcon={Search}
        placeholder="Search..."
      />

      <Input
        leftIcon={Mail}
        placeholder="Email"
      />

      <Input
        leftIcon={Lock}
        placeholder="Password"
        type="password"
      />

      <Input
        rightIcon={User}
        placeholder="Username"
      />
    </Preview>

    <Preview title="Helper Text">
      <Input
        helperText="Bu alan zorunludur."
        placeholder="Ad Soyad"
      />

      <Input
        error
        helperText="Lütfen geçerli bir e-posta giriniz."
        placeholder="E-posta"
      />

      <Input
        success
        helperText="E-posta doğrulandı."
        placeholder="E-posta"
      />
    </Preview>

    <Preview title="Full Width">
      <Input
        fullWidth
        placeholder="Full Width"
      />
    </Preview>

  </section>

  <style>
    .page {
      max-width: 1300px;
    }
  </style>
</DSLayout>
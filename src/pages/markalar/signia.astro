---
// Signia marka sayfası (/markalar/signia) — özgün içerik çalışması: içerik src/data/brand-unique/signia.ts'te,
// yalnızca sitedeki model verisinden ve SoT'ta doğrulanmış hizmet olgularından üretilir (üretici kaynaklı bilgi,
// uzman yorumu, grup/sahiplik ve doğrulanmamış iddialar yoktur). Model fotoğrafları ve hero görseli değiştirilmedi.
import MainLayout from "../../layouts/MainLayout.astro";
import BrandSimplePage from "../../components/brand-page/BrandSimplePage/BrandSimplePage.astro";
import { buildUniqueBrandPage } from "../../data/brand-unique/build";
import { signiaUnique } from "../../data/brand-unique/signia";
import { signiaHero } from "../../data/signia/hero";
import { signiaModels } from "../../data/signia/models";
import { signiaFaq } from "../../data/signia/faq";
import { signiaFinalCta } from "../../data/signia/final-cta";

const page = buildUniqueBrandPage(
  { hero: signiaHero, models: signiaModels, faq: signiaFaq, finalCta: signiaFinalCta },
  signiaUnique,
);
---

<MainLayout title={page.meta.title} description={page.meta.description}>
  <BrandSimplePage page={page} />
</MainLayout>

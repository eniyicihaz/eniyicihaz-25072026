---
// Bernafon marka sayfası (/markalar/bernafon) — özgün içerik çalışması: içerik src/data/brand-unique/bernafon.ts'te,
// yalnızca sitedeki model verisinden ve SoT'ta doğrulanmış hizmet olgularından üretilir (üretici kaynaklı bilgi,
// uzman yorumu, grup/sahiplik ve doğrulanmamış iddialar yoktur). Model fotoğrafları ve hero görseli değiştirilmedi.
import MainLayout from "../../layouts/MainLayout.astro";
import BrandSimplePage from "../../components/brand-page/BrandSimplePage/BrandSimplePage.astro";
import { buildUniqueBrandPage } from "../../data/brand-unique/build";
import { bernafonUnique } from "../../data/brand-unique/bernafon";
import { bernafonHero } from "../../data/bernafon/hero";
import { bernafonModels } from "../../data/bernafon/models";
import { bernafonFaq } from "../../data/bernafon/faq";
import { bernafonFinalCta } from "../../data/bernafon/final-cta";

const page = buildUniqueBrandPage(
  { hero: bernafonHero, models: bernafonModels, faq: bernafonFaq, finalCta: bernafonFinalCta },
  bernafonUnique,
);
---

<MainLayout title={page.meta.title} description={page.meta.description}>
  <BrandSimplePage page={page} />
</MainLayout>

---
// Phonak marka sayfası (/markalar/phonak/) — 2026-11-14 yeniden tasarım.
// Önceki sürüm ortak BrandSimplePage şablonunu kullanıyordu; ortak şablon ve diğer marka sayfaları DEĞİŞTİRİLMEDİ.
// İçerik: src/data/phonak/families.ts · Bileşenler: src/components/phonak/
import MainLayout from "../../layouts/MainLayout.astro";

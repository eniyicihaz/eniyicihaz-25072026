---
// Darıca İşitme Cihazları — /darica-isitme-cihazlari (Faz 2 P2, Darıca V1).
// Konumlandırma: "Darıca'daki merkezimize gelmeden önce bilmeniz
// gerekenler". Ana sayfa marka + genel hizmetleri anlatır; bu sayfa
// fiziksel merkezi, ziyareti ve yerel niyeti anlatır — ana sayfayla aynı
// genel blokları (cihaz türleri, marka logo duvarı, "Neden Avrasya")
// tekrar etmez. URL değişmedi.
//
// Sıra (onay V1):
// 1 Hero (CorporateHero; markasız H1, adres odaklı açıklama, Ara / Yol
//   tarifi / WhatsApp)
// 2 Merkezin Konumu, Erişim ve Çalışma Saatleri (ContactLocationCard)
// 3 İlk Ziyaretinizde Neler Olur? (ProcessTimeline)
// 4 Merkezimizde Verilen Hizmetler + markalar hub linki (BrandCriteria)
// 5 SGK İşlemleri Merkezimizde Nasıl Yürür? (ValueGrid) + SGK pillar linki
// 6 Ekibimiz ve Merkezimiz (CenterGallery) + Hakkımızda linki
// 7 SSS (BrandPageFaq)
// 8 Son CTA (BrandPageFinalCta; Ara / WhatsApp / Yol tarifi)
// Tüm içerik SoT'ta doğrulanmış bilgiye dayanır; kaynak notları her veri
// dosyasının başında. Title/description ve schema bu adımda değişmedi
// (Faz 3).
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../ds/components/ui/atoms/Breadcrumb/Breadcrumb.astro";
import CorporateHero from "../components/shared/CorporateHero/CorporateHero.astro";
import ContactLocationCard from "../components/contact/ContactLocationCard/ContactLocationCard.astro";
import ProcessTimeline from "../components/shared/ProcessTimeline/ProcessTimeline.astro";
import BrandCriteria from "../components/brands/BrandCriteria/BrandCriteria.astro";
import ValueGrid from "../components/shared/ValueGrid/ValueGrid.astro";
import CenterGallery from "../components/shared/CenterGallery/CenterGallery.astro";
import BrandPageFaq from "../components/brand-page/BrandPageFaq/BrandPageFaq.astro";
import BrandPageFinalCta from "../components/brand-page/BrandPageFinalCta/BrandPageFinalCta.astro";

import { daricaHero } from "../data/darica/hero";
import { daricaVisitLocation } from "../data/darica/location";
import { daricaProcess } from "../data/darica/process";
import { daricaServices } from "../data/darica/services";
import { daricaSgk } from "../data/darica/sgk";
import { daricaCenterGallery } from "../data/darica/center-gallery";
import { daricaFaq } from "../data/darica/faq";
import { daricaFinalCta } from "../data/darica/final-cta";

import { buildMedicalBusinessSchema } from "../lib/schema";
import { contactHero } from "../data/contact/hero";

const PAGE_URL = "https://www.eniyicihaz.com/darica-isitme-cihazlari/";

const breadcrumbItems = [
  { label: "Ana Sayfa", href: "/" },
  { label: "Darıca İşitme Cihazları", current: true },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, "https://www.eniyicihaz.com").toString() } : {}),
  })),
};

// Aynı kanonik tanım cümlesi homepage ve /iletisim'de kullanılıyor —
// GEO non-contradiction (SEARCH_STRATEGY.md §9), burada yeni bir cümle
// icat edilmedi.
const medicalBusinessSchema = buildMedicalBusinessSchema(PAGE_URL, contactHero.definitionSentence);
---

<MainLayout
  title="Darıca İşitme Cihazları | Avrasya İşitme"
  description="Darıca, Kocaeli'de SGK anlaşmalı Avrasya İşitme Cihazları merkezi. Ücretsiz işitme değerlendirmesi, 18 marka seçeneği ve kişiye özel uygulama. Randevu alın."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(medicalBusinessSchema)} />

  <div class="darica-breadcrumb-wrap">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <div class="darica-hero">
    <CorporateHero data={daricaHero} />
  </div>

  <ContactLocationCard data={daricaVisitLocation} />

  <div class="darica-band darica-band--plain">
    <ProcessTimeline data={daricaProcess} />
  </div>

  <div class="darica-band darica-band--services">
    <BrandCriteria data={daricaServices} />
  </div>

  <div class="darica-band darica-band--plain">
    <ValueGrid data={daricaSgk} />
    <p class="darica-inline-link-wrap">
      <a class="darica-inline-link darica-inline-link--button" href="/sgk-isitme-cihazi-odemesi/">SGK ile işitme cihazı ödemesi hakkında ayrıntılı bilgi →</a>
    </p>
  </div>

  <div class="darica-band darica-band--tint">
    <CenterGallery data={daricaCenterGallery} />
    <p class="darica-inline-link-wrap">
      <a class="darica-inline-link" href="/hakkimizda/">Avrasya İşitme Cihazları hakkında daha fazla bilgi →</a>
    </p>
  </div>

  <BrandPageFaq data={daricaFaq} />
  <BrandPageFinalCta data={daricaFinalCta} />
</MainLayout>

<style>
  .darica-breadcrumb-wrap {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding: var(--space-6) var(--space-6) 0;
  }

  /* Hero legibility — this page's hero carries a longer, address-led
     description and three CTAs, so the text block reaches the photo's
     brighter areas (window, illuminated sign). A stronger, page-scoped
     scrim keeps text contrast; the photo crop (object-position) is
     unchanged and other CorporateHero pages are not affected. */
  .darica-hero :global(.corporate-hero__scrim) {
    background:
      linear-gradient(90deg, rgb(15 23 42 / 0.8) 0%, rgb(15 23 42 / 0.6) 40%, rgb(15 23 42 / 0.15) 70%, transparent 100%),
      linear-gradient(0deg, var(--color-text) 0%, rgb(15 23 42 / 0.35) 40%, transparent 70%);
  }

  .darica-hero :global(.corporate-hero__location) {
    background: rgb(15 23 42 / 0.5);
  }

  @media (max-width: 768px) {
    .darica-hero :global(.corporate-hero__scrim) {
      background: linear-gradient(0deg, var(--color-text) 0%, rgb(15 23 42 / 0.82) 55%, rgb(15 23 42 / 0.62) 100%);
    }
  }

  /* Section rhythm — page-scoped background overrides so neighbouring
     shared sections alternate (surface / plain) instead of merging into
     one block. Only this page is affected; the components' own defaults
     stay unchanged everywhere else. */
  .darica-band--plain {
    background: var(--color-background);
  }

  .darica-band--plain :global(.process-timeline),
  .darica-band--plain :global(.value-grid) {
    background: var(--color-background);
  }

  .darica-band--tint {
    background: var(--color-surface);
  }

  .darica-band--tint :global(.center-gallery) {
    background: var(--color-surface);
  }

  /* BrandCriteria's closing link ("Markaları inceleyin →") — 48px tap
     target on this page only. */
  .darica-band--services :global(.brand-criteria__closing-cta a) {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
  }

  /* Text links under a section — deliberately not repeated CTA buttons,
     except the SGK pillar link, which gets a quiet outline button. Every
     link keeps a 48px tap target. */
  .darica-inline-link-wrap {
    margin: 0;
    padding: 0 var(--space-6) var(--space-16);
    max-width: var(--container-2xl);
    margin-inline: auto;
    text-align: center;
  }

  .darica-inline-link {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .darica-inline-link:hover {
    text-decoration: underline;
  }

  .darica-inline-link--button {
    padding: var(--space-2) var(--space-6);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-lg);
    background: var(--color-background);
  }

  .darica-inline-link--button:hover {
    background: rgb(37 99 235 / 0.06);
    text-decoration: none;
  }

  .darica-inline-link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  @media (max-width: 640px) {
    .darica-inline-link-wrap {
      padding-bottom: var(--space-10);
    }
  }
</style>

---
// "İşitme Cihazları" — the page Header ▸ İşitme Cihazları (top-level
// nav item) links to, mirroring /markalar's role for the Markalar item.
// Built up modularly using the same M1-M8 hub-page system /markalar
// pioneered (see src/components/brands/) — those 8 components are now
// generic (data prop instead of a fixed import), so this page supplies
// its own data/devices/* content while sharing the exact markup/CSS.
//
// M1 (Hero), M2 (Device-Type Showcase: the 7 devicesMega "İşitme Cihazı
// Çeşitleri" pages, 6 shown), M3 (Criteria: device-type decision axes),
// M4 (Decision: scenario-matching to a device type), M5 (Buying Guide:
// self-assessment questions, distinct framing from /markalar's M5), M6
// (Extended: the remaining 15 devicesMega pages — Suya Dayanıklı +
// Teknolojilere Göre + İhtiyacınıza Göre), M7 (Expert Support) and M8
// (FAQ) — M8 is the page's final section. Do not add later modules
// until they're specifically requested.
import MainLayout from "../../layouts/MainLayout.astro";
import BrandHero from "../../components/brands/BrandHero/BrandHero.astro";
import BrandShowcase from "../../components/brands/BrandShowcase/BrandShowcase.astro";
import BrandCriteria from "../../components/brands/BrandCriteria/BrandCriteria.astro";
import BrandDecision from "../../components/brands/BrandDecision/BrandDecision.astro";
import BrandBuyingGuide from "../../components/brands/BrandBuyingGuide/BrandBuyingGuide.astro";
import BrandExtended from "../../components/brands/BrandExtended/BrandExtended.astro";
import BrandExpertSupport from "../../components/brands/BrandExpertSupport/BrandExpertSupport.astro";
import BrandFaq from "../../components/brands/BrandFaq/BrandFaq.astro";

import { devicesHero } from "../../data/devices/hero";
import { devicesShowcase } from "../../data/devices/showcase";
import { devicesCriteria } from "../../data/devices/criteria";
import { devicesDecision } from "../../data/devices/decision";
import { devicesBuyingGuide } from "../../data/devices/buying-guide";
import { devicesExtended } from "../../data/devices/extended";
import { devicesExpertSupport } from "../../data/devices/expert-support";
import { devicesFaq } from "../../data/devices/faq";
---

<MainLayout
  title="İşitme Cihazı Çeşitleri | Tüm Modeller ve Teknolojiler | EniyiCihaz"
  description="Kulak arkası, kulak içi, görünmez ve şarj edilebilir işitme cihazı çeşitlerini; yapay zeka destekli ve bağlantılı teknolojileri tek sayfada keşfedin."
>
  <BrandHero data={devicesHero} />
  <BrandShowcase data={devicesShowcase} />
  <BrandCriteria data={devicesCriteria} />
  <BrandDecision data={devicesDecision} />
  <BrandBuyingGuide data={devicesBuyingGuide} />
  <BrandExtended data={devicesExtended} />
  <BrandExpertSupport data={devicesExpertSupport} />
  <BrandFaq data={devicesFaq} />
</MainLayout>

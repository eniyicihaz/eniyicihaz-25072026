---
// /isitme-cihazi-markalari/ — "İşitme cihazı markaları" KONU MERKEZİ (topic hub):
// marka, model, marka karşılaştırması, marka + cihaz türü, marka + kullanım
// senaryosu. Bir logo duvarı DEĞİL; bir marka sıralaması da DEĞİL.
//
//   ARAMA NİYETİ → ANA SORGU → İLİŞKİLİ SORGULAR → KULLANICI SORULARI →
//   LOKAL BAĞLAM → MARKA → MODEL → ÖZELLİK → KULLANIM SENARYOSU → İÇ BAĞLANTI → DÖNÜŞÜM
//
// Üç sayfa ayrımı: /isitme-cihazlari/ (cihaz türleri, özellikler, seçim),
// /isitme-cihazi-markalari/ (bu sayfa: marka, model, karşılaştırma),
// /isitme-cihazi-fiyatlari/ (fiyat ve SGK). Fiyat ve SGK burada yalnızca kısa yönlendirmedir.
//
// Politika: "en iyi marka X'tir" veya herhangi bir marka sıralaması YOKTUR
// (PRINCIPLES.md §5). Site fiyat yayımlamaz (COMPANY.md §23); Product/Offer şemasına
// fiyat girmez (QUALITY_GATES.md §4). Gebze ve Çayırova'da şube iddiası yoktur
// (COMPANY.md §17). Video yok. Yeni görsel üretilmedi — hero alanı nötr yer tutucudur
// (bkz. hero.ts `imageNeeded`).
//
// Marka ve model bilgisi sitedeki doğrulanmış marka verisinden (src/data/{marka}/*)
// okunur; karşılaştırma tabloları model etiketlerinden HESAPLANIR. Model sayfası
// olmadığından tüm bağlantılar gerçek marka sayfalarına gider (sahte URL yok).
//
// Görünüm mevcut componentlerin (price-guide/*, Brands, BrandPageModels, BrandPageFaq,
// BrandExtended, ContactLocationCard) yeniden kullanımıdır; yalnızca BrandProfile
// (components/brand-guide/) bu sayfa için yenidir. İçerik data/isitme-cihazi-markalari/*.
import { LayoutGrid, Stethoscope, Compass, Tag, MessageCircle, MapPin, Phone } from "lucide-astro";
import WhatsAppIcon from "../components/shared/WhatsAppIcon/WhatsAppIcon.astro";
import { contactAction } from "../lib/contact-action";
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../ds/components/ui/atoms/Breadcrumb/Breadcrumb.astro";
import Brands from "../components/brands/Brands/Brands.astro";
import BrandExtended from "../components/brands/BrandExtended/BrandExtended.astro";
import BrandPageModels from "../components/brand-page/BrandPageModels/BrandPageModels.astro";
import BrandPageFaq from "../components/brand-page/BrandPageFaq/BrandPageFaq.astro";
import BrandPageRelatedContent from "../components/brand-page/BrandPageRelatedContent/BrandPageRelatedContent.astro";
import ContactLocationCard from "../components/contact/ContactLocationCard/ContactLocationCard.astro";

import BrandsGuideHero from "../components/brand-guide/BrandsGuideHero.astro";
import GuideToc from "../components/price-guide/GuideToc.astro";
import DirectAnswer from "../components/price-guide/DirectAnswer.astro";
import GuideSection from "../components/price-guide/GuideSection.astro";
import InfoGrid from "../components/price-guide/InfoGrid.astro";
import GuideTable from "../components/price-guide/GuideTable.astro";
import GuideNotice from "../components/price-guide/GuideNotice.astro";
import QaStack from "../components/price-guide/QaStack.astro";
import GuideCta from "../components/price-guide/GuideCta.astro";
import BrandProfile from "../components/brand-guide/BrandProfile.astro";
import BrandCompareTable from "../components/brand-guide/BrandCompareTable.astro";
import BrandMatrixTable from "../components/brand-guide/BrandMatrixTable.astro";

import { buildMedicalBusinessSchema } from "../lib/schema";
import { daricaLocation } from "../data/darica/location";
import { pageMeta, breadcrumbItems, toc, PAGE_URL } from "../data/isitme-cihazi-markalari/page";
import { brandsHero, brandsHeroExtra, contactLinks } from "../data/isitme-cihazi-markalari/hero";
import { brandsQuickAnswer } from "../data/isitme-cihazi-markalari/quick-answer";
import { profilesIntro, brandSections, brandProfiles } from "../data/isitme-cihazi-markalari/profiles";
import { comparisonSection, brandTable, matrixSection, matrixTable, matrixAnswers } from "../data/isitme-cihazi-markalari/comparison";
import { modelsShowcase } from "../data/isitme-cihazi-markalari/showcase";
import {
  scenarioSection, scenarioCards, brandVsModelSection, brandVsModel, askSection, askCards,
} from "../data/isitme-cihazi-markalari/selection";
import { otherBrands, priceSgkSection, priceSgkCards } from "../data/isitme-cihazi-markalari/others";
import { localSection, localContent } from "../data/isitme-cihazi-markalari/local";
import { brandsFaq } from "../data/isitme-cihazi-markalari/faq";
import { brandsRelated, brandsCta } from "../data/isitme-cihazi-markalari/related-cta";

// Schema — yalnızca sayfada görünür olan gerçek bilgi. FAQPage şeması, görünür SSS
// verisinden BrandPageFaq içinde üretilir. Marka/model için Product/Offer/Brand
// şeması KASITLI olarak yok: ürün sayfası değil, fiyatsız bir rehber; yalnızca
// görünür 6 marka profilinin gerçek sayfalarına işaret eden ItemList var.
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, "https://www.eniyicihaz.com").toString() } : { item: PAGE_URL }),
  })),
};
const medicalBusinessSchema = buildMedicalBusinessSchema(PAGE_URL, pageMeta.schemaDescription);

const brandsListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "İşitme cihazı markaları",
  itemListElement: brandProfiles.map((brand, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: brand.name,
    url: new URL(brand.brandHref, "https://www.eniyicihaz.com").toString(),
  })),
};

// Darıca konum kartı — aynı gerçek veri, bu sayfaya uygun başlık.
const locationCard = {
  ...daricaLocation,
  eyebrow: "DARICA'DAKİ MERKEZİMİZ",
  heading: "Merkezimizin Adresi ve Çalışma Saatleri",
  intro:
    "Randevusuz gelebilirsiniz; işitme testi gibi hizmetler randevuyla verildiği için önce aramanız iyi olur.",
  addressNote: "Palandöken Eczanesi'nin üst katında, Farabi Devlet Hastanesi durağının karşısında.",
  largeTargets: true,
};
---

<MainLayout title={pageMeta.title} description={pageMeta.description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(medicalBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(brandsListSchema)} />

  <div class="bg-breadcrumb">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <BrandsGuideHero data={brandsHero} icons={{ primary: LayoutGrid, secondary: Stethoscope }} extraCta={brandsHeroExtra} />

  <div class="bg-contact-strip" role="group" aria-label="Hızlı iletişim">
    <a class="bg-contact-strip__btn bg-contact-strip__btn--solid" href={contactLinks.phone} data-contact-action={contactAction(contactLinks.phone)} data-contact-size="sm"><Phone size={20} stroke-width={2} aria-hidden="true" /><span>Bizi Arayın</span></a>
    <a class="bg-contact-strip__btn" href={contactLinks.whatsapp} data-contact-action={contactAction(contactLinks.whatsapp)} data-contact-size="sm"><WhatsAppIcon size={20} /><span>WhatsApp'tan Yazın</span></a>
  </div>
  <GuideToc links={toc} />

  <!-- B. Kısa doğrudan cevap -->
  <DirectAnswer data={brandsQuickAnswer} />

  <!-- C. Marka karşılaştırma tablosu -->
  <GuideSection {...comparisonSection} tone="alt">
    <BrandCompareTable data={brandTable} />
  </GuideSection>

  <!-- Ana markalar: giriş + logo şeridi -->
  <GuideSection {...profilesIntro}>
    <div class="bg-logos">
      <Brands embedded />
    </div>
    <GuideNotice
      text="Bu rehber markaları karşılaştırma ve seçim açısından ele alır; aşağıdaki profiller her markanın kendi sayfasındaki doğrulanmış bilgilerden derlendi. Tüm markaların dizinine ve marka sayfalarına ise Tüm Markalar sayfasından ulaşabilirsiniz. Marka logoları ilgili üreticilere aittir."
      links={[{ label: "Tüm Markaları Görüntüleyin", href: "/markalar/" }]}
    />
  </GuideSection>

  <!-- D–I. Marka profilleri -->
  {
    brandProfiles.map((brand, index) => {
      const key = brand.id;
      return (
        <GuideSection {...brandSections[key]} tone={index % 2 === 0 ? "alt" : "plain"}>
          <BrandProfile data={brand} />
        </GuideSection>
      );
    })
  }

  <!-- J. Gerçek model keşfi -->
  <div class="bg-models" id="modeller">
    <BrandPageModels data={modelsShowcase} compact />
  </div>

  <!-- K. Marka × cihaz türü / özellik -->
  <GuideSection {...matrixSection}>
    <BrandMatrixTable data={matrixTable} />
    <div class="bg-spaced">
      <QaStack items={matrixAnswers} />
    </div>
  </GuideSection>

  <!-- L. Marka × kullanım senaryosu -->
  <GuideSection {...scenarioSection} tone="alt">
    <InfoGrid cards={scenarioCards} columns={4} />
  </GuideSection>

  <!-- M. Marka mı model mi -->
  <GuideSection {...brandVsModelSection}>
    <QaStack items={brandVsModel} />
  </GuideSection>

  <!-- N. Karşılaştırırken sorulacaklar -->
  <GuideSection {...askSection} tone="alt">
    <InfoGrid cards={askCards} columns={3} />
  </GuideSection>

  <!-- Diğer 12 marka -->
  <div class="bg-others" id="diger-markalar">
    <BrandExtended data={otherBrands} />
  </div>

  <!-- O + P. Fiyat ve SGK (kısa yönlendirme) -->
  <GuideSection {...priceSgkSection} tone="alt">
    <InfoGrid cards={priceSgkCards} columns={2} />
  </GuideSection>

  <!-- Q. Lokal bölümler -->
  <GuideSection {...localSection}>
    <div class="bg-local">
      {localContent.paragraphs.map((t) => <p class="bg-local__p">{t}</p>)}
      <ul class="bg-local__links">
        {localContent.links.map((l) => <li><a class="bg-local__link" href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </GuideSection>

  <ContactLocationCard data={locationCard} />

  <!-- R. SSS -->
  <div id="sss" class="bg-anchor">
    <BrandPageFaq data={brandsFaq} />
  </div>

  <BrandPageRelatedContent data={brandsRelated} />

  <!-- S. Final CTA -->
  <GuideCta data={brandsCta} icons={[Stethoscope, Compass, Tag, MessageCircle, MapPin]} />
</MainLayout>

<style>
  .bg-contact-strip {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding: var(--space-4) var(--space-6);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .bg-contact-strip__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: var(--space-2) var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .bg-contact-strip__btn--solid {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  .bg-contact-strip__btn:hover,
  .bg-local__link:hover {
    text-decoration: underline;
  }

  .bg-contact-strip__btn:focus-visible,
  .bg-local__link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .bg-local {
    max-width: 42rem;
    margin-inline: auto;
    text-align: center;
  }

  .bg-local__p {
    margin: var(--space-4) 0 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .bg-local__links {
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .bg-local__link {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: var(--space-2) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
  }

  .bg-breadcrumb {
    max-width: var(--container-2xl);
    margin-inline: auto;
    padding: var(--space-4) var(--space-6) 0;
  }

  .bg-logos {
    margin-bottom: var(--space-6);
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-border);
    overflow: hidden;
  }

  .bg-spaced {
    margin-top: var(--space-8);
  }

  .bg-models {
    background: var(--color-surface);
  }

  .bg-anchor,
  .bg-others {
    scroll-margin-top: calc(var(--space-16) + var(--space-4));
  }

  @media (max-width: 640px) {
    .bg-breadcrumb {
      padding-inline: var(--space-4);
    }
  }
</style>

<style is:global>
  /* "Marka Karşılaştırması" bölüm başlığı (yalnızca bu bölüm): daha net hiyerarşi, tabloya yakın. */
  #marka-karsilastirma {
    padding-block: var(--space-12);
  }

  #marka-karsilastirma .guide-section__header {
    max-width: 42rem;
    margin-bottom: var(--space-6);
  }

  #marka-karsilastirma .guide-section__heading {
    margin-top: var(--space-3);
    font-size: clamp(1.75rem, 1.35rem + 1.7vw, 2.5rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  #marka-karsilastirma .guide-section__intro {
    margin-top: var(--space-3);
    max-width: 38rem;
    font-size: var(--font-size-md);
    line-height: 1.65;
  }

  /* ===== CTA renk tutarlılığı (yalnızca bu sayfa) ==================================
     Ortak GuideCta / ContactLocationCard / contact-actions.css DEĞİŞMEZ; bu blok yalnızca bu sayfanın
     CSS paketine girer. İşlev → görünüm:
       Ücretsiz işitme testi = kurumsal mavi dolu (zaten)   · Telefon = mavi dolu (ortak stil, değişmedi)
       İşitme cihazlarını keşfet = açık mavi yüzey (ikincil) · Fiyat / Darıca sayfası = sade çerçeveli (bilgi)
       WhatsApp = resmî yeşil #25D366 dolu, koyu metin/ikon  · Yol tarifi = ortak açık mavi stil
     Darıca Merkezimiz bir SAYFA bağlantısıdır (harita değil); yol tarifi stili almaz. */

  /* WhatsApp: bu sayfada her yerde (iletişim şeridi, harita kartı, sıradaki adım) aynı yeşil buton.
     Yeşil, logonun resmî rengidir; üstünde beyaz değil koyu metin/ikon kullanılır (kontrast ≈ 9:1). */
  html body main a[href][data-contact-action][data-contact-action][data-contact-action="whatsapp"] {
    background: #25d366;
    border-color: #25d366;
    color: #0f172a;
  }

  html body main a[href][data-contact-action][data-contact-action][data-contact-action="whatsapp"]:hover {
    transform: none;
    box-shadow: none;
    background: #1fbd5b;
    border-color: #1fbd5b;
    color: #0f172a;
  }

  html body main a[href][data-contact-action][data-contact-action][data-contact-action="whatsapp"] > svg {
    color: #0f172a;
  }

  /* Sıradaki Adım kartı: lacivert zemin üstünde tüm düğmeler aynı boyut ve belirgin odak halkası. */
  html body main .guide-cta a.guide-cta__btn {
    min-height: 52px;
    height: auto;
    padding-inline: var(--space-6);
    font-size: var(--font-size-md);
    letter-spacing: normal;
  }

  /* WhatsApp düğmesi ortak stilin sabit 56px yüksekliğini taşır; kartın diğer düğmeleriyle aynı ölçüye getirilir. */
  html body main .guide-cta a[href][data-contact-action][data-contact-action][data-contact-action="whatsapp"] {
    height: auto;
    min-height: 52px;
    padding-inline: var(--space-6);
    font-size: var(--font-size-md);
    letter-spacing: normal;
  }

  html body main .guide-cta a.guide-cta__btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
    box-shadow: none;
  }

  /* İşitme Cihazlarını Keşfet: ikincil — açık mavi yüzey, koyu mavi metin (birincil mavi dolu ile yarışmaz). */
  html body main .guide-cta a.guide-cta__btn[href="/isitme-cihazlari/"] {
    background: #eff6ff;
    border-color: #bfdbfe;
    color: #1e3a8a;
  }

  html body main .guide-cta a.guide-cta__btn[href="/isitme-cihazlari/"]:hover {
    background: #dbeafe;
    border-color: #93c5fd;
    color: #1e3a8a;
  }

  /* Harita kartındaki "Google Haritalar'da aç" (izin yedeği) gerçekten harita bağlantısıdır: ortak yol tarifi stili. */
  html body main a.btn[href^="https://maps.app.goo.gl/"]:not([data-contact-action]) {
    background: #eff6ff;
    border-color: #bfdbfe;
    color: #1e3a8a;
  }

  html body main a.btn[href^="https://maps.app.goo.gl/"]:not([data-contact-action]):hover {
    background: #dbeafe;
    border-color: #93c5fd;
    color: #1e3a8a;
  }

  @media (max-width: 640px) {
    #marka-karsilastirma {
      padding-block: var(--space-10);
    }
  }
</style>

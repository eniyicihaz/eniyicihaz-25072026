---
// Onarım Takibi — /servis-bakim/onarim-takibi. Sixth and final page of
// the "Servis & Bakım" series (see header.data.ts's servicesMega third
// column), following Teknik Servis, Periyodik Bakım, Cihaz Temizliği,
// Pil & Aksesuar and Garanti İşlemleri. Every item in this column is
// now a real route.
//
// This page covers the STATUS TRACKING experience itself — once a
// device has already been sent for repair (Teknik Servis) or a
// warranty claim (Garanti İşlemleri), how the customer follows its
// progress stage by stage. evolution.ts is repurposed as literal
// package-tracker-style stages rather than a clinic-visit sequence.
//
// accentColor: eflatun / fuchsia-600 (#c026d3) — sixth and final color
// in the fresh accent rotation opened for this series; see hero.ts for
// the full rationale.
//
// 14-section flow, in order: Hero -> Nedir? + Neyi Kapsar? -> Kimler
// İçin Uygundur? -> Avantajları -> Dikkat Edilmesi Gerekenler -> Takip
// Aşamaları -> Neler Sunulur -> Teknolojiler -> Markalara Göre
// İnceleyin -> Yerinde vs Üretici Servisi Takibi -> Uzman Yorumu -> SSS
// -> Premium CTA -> İlgili İçerikler.
import MainLayout from "../../layouts/MainLayout.astro";
import BrandPageHero from "../../components/brand-page/BrandPageHero/BrandPageHero.astro";
import BrandPageIntro from "../../components/brand-page/BrandPageIntro/BrandPageIntro.astro";
import BrandPageIdealUser from "../../components/brand-page/BrandPageIdealUser/BrandPageIdealUser.astro";
import BrandPageAdvantages from "../../components/brand-page/BrandPageAdvantages/BrandPageAdvantages.astro";
import OnarimTakipTimeline from "../../components/brand-page/OnarimTakipTimeline/OnarimTakipTimeline.astro";
import BrandPageEcosystem from "../../components/brand-page/BrandPageEcosystem/BrandPageEcosystem.astro";
import BrandPageRelatedContent from "../../components/brand-page/BrandPageRelatedContent/BrandPageRelatedContent.astro";
import BrandPageExpertOpinion from "../../components/brand-page/BrandPageExpertOpinion/BrandPageExpertOpinion.astro";
import BrandPageFaq from "../../components/brand-page/BrandPageFaq/BrandPageFaq.astro";
import BrandPageFinalCta from "../../components/brand-page/BrandPageFinalCta/BrandPageFinalCta.astro";

import { onarimTakibiHero } from "../../data/onarim-takibi/hero";
import { onarimTakibiIntro } from "../../data/onarim-takibi/intro";
import { onarimTakibiIdealUser } from "../../data/onarim-takibi/ideal-user";
import { onarimTakibiAdvantages } from "../../data/onarim-takibi/advantages";
import { onarimTakibiConsiderations } from "../../data/onarim-takibi/considerations";
import { onarimTakibiTechnology } from "../../data/onarim-takibi/technology";
import { onarimTakibiExpertOpinion } from "../../data/onarim-takibi/expert-opinion";
import { onarimTakibiFaq } from "../../data/onarim-takibi/faq";
import { onarimTakibiRelatedContent } from "../../data/onarim-takibi/related-content";
import { onarimTakibiFinalCta } from "../../data/onarim-takibi/final-cta";
---

<MainLayout
  title="Onarım Takibi | Servis Kaydı ve Durum Bilgisi"
  description="Cihazınızı servise teslim ettiyseniz: dijital servis kaydı, gerektiğinde SMS/WhatsApp ile manuel bilgilendirme ve telefon veya WhatsApp'tan durum sorma yolları."
>
  <BrandPageHero data={onarimTakibiHero} />
  <BrandPageIntro data={onarimTakibiIntro} />
  <BrandPageIdealUser data={onarimTakibiIdealUser} />
  <BrandPageAdvantages data={onarimTakibiAdvantages} />
  <BrandPageIdealUser data={onarimTakibiConsiderations} />
  <OnarimTakipTimeline />
  <BrandPageEcosystem data={onarimTakibiTechnology} />
  <BrandPageExpertOpinion data={onarimTakibiExpertOpinion} />
  <BrandPageFaq data={onarimTakibiFaq} />
  <BrandPageFinalCta data={onarimTakibiFinalCta} />
  <BrandPageRelatedContent data={onarimTakibiRelatedContent} />
</MainLayout>

<style is:global>
  /* Bu sayfanın "Bilgi Alırken Bilmeniz Gerekenler" bölümünde model listesi anlamlı değildir (ortak bileşenin sabit "Kullanıldığı Modeller" bloğu);
     yalnızca bu sayfanın CSS paketinde gizlenir, ortak bileşen değişmez. */
  .brand-page-eco__block:has(> .brand-page-eco__tags),
  .brand-page-eco__block:has(.brand-page-eco__tags) {
    display: none;
  }
</style>

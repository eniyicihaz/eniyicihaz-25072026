---
// Garanti İşlemleri — /servis-bakim/garanti-islemleri. Fifth page of
// the "Servis & Bakım" series (see header.data.ts's servicesMega third
// column), following Teknik Servis, Periyodik Bakım, Cihaz Temizliği
// and Pil & Aksesuar.
//
// Genre note: the existing /neden-orijinal/kolay-degisim page already
// covers the SATISFACTION-BASED exchange guarantee (trial
// dissatisfaction, changing needs, model swaps). This page deliberately
// does not repeat that — it covers the technical WARRANTY CLAIM
// process: manufacturing-defect coverage, what voids it, required
// documentation, and the claim process itself. comparison.ts makes the
// distinction between the two processes explicit.
//
// accentColor: çivit / indigo-600 (#4f46e5) — fifth color in the fresh
// accent rotation opened for this series; see hero.ts for the full
// rationale.
//
// 14-section flow, in order: Hero -> Nedir? + Neyi Kapsar? -> Kimler
// İçin Uygundur? -> Avantajları -> Dikkat Edilmesi Gerekenler -> Süreç
// Adımları -> Kapsamda Neler Yer Alır -> Teknolojiler -> Markalara Göre
// İnceleyin -> Garanti vs Kolay Değişim -> Uzman Yorumu -> SSS ->
// Premium CTA -> İlgili İçerikler.
import MainLayout from "../../layouts/MainLayout.astro";
